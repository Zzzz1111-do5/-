---------------------------------------------------------------- 兵种：导入的原模型

-- 槽位：各兵种的 model，加上步兵组用的道具（值是道具沿前后方向的长度，格）
local PROPLEN = { prop_javelin = 2.6, prop_stinger = 3.4, prop_mortar = 2.4, prop_mg = 2.8 }
local SLOTS = {}
for name in pairs(PROPLEN) do SLOTS[name] = true end
for _, d in pairs(Config.Units) do
  if d.model then SLOTS[d.model] = true end
end
local TEMPLATES = {}   -- 槽位 → { parts = { { part, role } }, pivots = {…}, h = 高度 }
local MARKS = { _Front = true, _Top = true, _PivotTurret = true, _PivotRotor = true, _PivotTail = true, _AxisTail = true }

local function rotOnly(cf)
  return cf - cf.Position
end

-- 一组零件的包围盒（世界坐标，按每个零件的 8 个角）
local function bounds(parts)
  local mn = V(math.huge, math.huge, math.huge)
  local mx = V(-math.huge, -math.huge, -math.huge)
  for _, p in ipairs(parts) do
    local h = p.Size / 2
    for _, sx in ipairs({ -1, 1 }) do
      for _, sy in ipairs({ -1, 1 }) do
        for _, sz in ipairs({ -1, 1 }) do
          local w = p.CFrame:PointToWorldSpace(V(h.X * sx, h.Y * sy, h.Z * sz))
          mn = V(math.min(mn.X, w.X), math.min(mn.Y, w.Y), math.min(mn.Z, w.Z))
          mx = V(math.max(mx.X, w.X), math.max(mx.Y, w.Y), math.max(mx.Z, w.Z))
        end
      end
    end
  end
  return mn, mx
end

-- 合并包 all_units.glb 里零件名带兵种前缀（tank__Turret_1、heli___PivotRotor）：拆成 兵种、原名
local function splitName(n)
  local slot, rest = string.match(n, "^(.-)__(.+)$")
  if slot and SLOTS[slot] then return slot, rest end
  return nil, n
end

-- 把导入的模型整理成模板：用 _Front / _Top 标记摆正（不管导入时坐标怎么换的），缩放到长度 len（士兵按身高 5.2），底面中心放到原点，读转轴标记
local function prepare(slot, model)
  local parts, marks = {}, {}
  for _, d in ipairs(model:GetDescendants()) do
    if d:IsA("BasePart") then
      d.Anchored = true   -- 导入时没锚定的话，一开始游戏就会往下掉、散开
      local s2, rest = splitName(d.Name)
      if s2 == slot then d.Name = rest end
      if MARKS[d.Name] then marks[d.Name] = d else table.insert(parts, d) end
    end
  end
  if #parts == 0 then return nil end
  local all = {}
  for _, p in ipairs(parts) do table.insert(all, p) end
  for _, p in pairs(marks) do table.insert(all, p) end
  local mn, mx = bounds(parts)
  local c = (mn + mx) / 2
  -- 1）摆正：前 = 指向 _Front，上 = 指向 _Top
  local cur = CF(c)
  if marks._Front and marks._Top then
    local up = (marks._Top.CFrame.Position - c).Unit
    local f = marks._Front.CFrame.Position - c
    local fwd = (f - up * f:Dot(up)).Unit
    local right = fwd:Cross(up)
    cur = CFrame.fromMatrix(c, right, up, -fwd)
  end
  local inv = cur:Inverse()
  for _, p in ipairs(all) do p.CFrame = inv * p.CFrame end
  -- 2）缩放
  mn, mx = bounds(parts)
  local size = mx - mn
  local def = Config.Units[slot]
  local k
  if slot == "soldier" then k = 5.2 / math.max(0.01, size.Y)
  elseif PROPLEN[slot] then k = PROPLEN[slot] / math.max(0.01, size.Z)
  else k = (def and def.len or 15) / math.max(0.01, size.Z) end
  for _, p in ipairs(all) do
    local pos = p.CFrame.Position * k
    p.Size = p.Size * k
    p.CFrame = CF(pos) * rotOnly(p.CFrame)
  end
  -- 3）底面中心到原点
  mn, mx = bounds(parts)
  local shift = V((mn.X + mx.X) / 2, mn.Y, (mn.Z + mx.Z) / 2)
  for _, p in ipairs(all) do p.CFrame = p.CFrame - shift end
  mn, mx = bounds(parts)
  local T = { parts = {}, pivots = {}, h = mx.Y - mn.Y, len = mx.Z - mn.Z }
  for name, p in pairs(marks) do T.pivots[name] = p.CFrame.Position end
  for _, p in ipairs(parts) do
    local role = "Body"
    local n = p.Name
    if n:sub(1, 9) == "TailRotor" then role = "Tail"
    elseif n:sub(1, 5) == "Rotor" then role = "Rotor"
    elseif n:sub(1, 6) == "Turret" then role = "Turret"
    end
    if role == "Turret" and not T.pivots._PivotTurret then role = "Body" end
    if role == "Rotor" and not T.pivots._PivotRotor then role = "Body" end
    if role == "Tail" and not T.pivots._PivotTail then role = "Body" end
    table.insert(T.parts, { part = p, role = role })
  end
  return T
end

-- 开服时找导入的模型，整理成模板收进 ServerStorage：
--   ① 叫兵种名的 Model（一个一个导入的 tank.glb……；放在 ReplicatedStorage.UnitModels、ServerStorage、Workspace、ReplicatedStorage 里，套几层都行）
--   ② 合并包 all_units.glb 导进来的：零件名带「兵种名__」前缀，不管 Studio 保没保留层级，都按前缀分回各个兵种
function Models.loadImported()
  local store = Instance.new("Folder")
  store.Name = "UnitTemplates"
  store.Parent = ServerStorage
  local places = { ServerStorage, workspace, RS }
  local um = RS:FindFirstChild("UnitModels")
  if um then table.insert(places, 1, um) end
  local found = {}
  local function take(slot, model)
    local ok, T = pcall(prepare, slot, model)
    if ok and T then
      TEMPLATES[slot] = T
      model.Name = slot
      model.Parent = store
      table.insert(found, slot)
    elseif not ok then
      warn("[军事大亨] 导入的模型 " .. slot .. " 整理失败：" .. tostring(T))
    end
  end
  -- ①
  for _, place in ipairs(places) do
    for _, ch in ipairs(place:GetDescendants()) do
      if ch:IsA("Model") and SLOTS[ch.Name] and not TEMPLATES[ch.Name] and not ch:IsDescendantOf(store) then take(ch.Name, ch) end
    end
  end
  -- ②
  local groups = {}
  for _, place in ipairs(places) do
    for _, d in ipairs(place:GetDescendants()) do
      if d:IsA("BasePart") and not d:IsDescendantOf(store) then
        local slot = splitName(d.Name)
        if slot and not TEMPLATES[slot] then
          groups[slot] = groups[slot] or {}
          table.insert(groups[slot], d)
        end
      end
    end
  end
  local emptied = {}
  for slot, list in pairs(groups) do
    local m = Instance.new("Model")
    m.Name = slot
    for _, p in ipairs(list) do
      if p.Parent then emptied[p.Parent] = true end
      p.Parent = m
    end
    take(slot, m)
  end
  -- 合并包导进来剩下的空壳（Model / 文件夹）收掉，免得留在地图里
  for holder in pairs(emptied) do
    local top = holder
    while top.Parent and top.Parent ~= workspace and top.Parent ~= RS and top.Parent ~= ServerStorage and top.Parent ~= um do top = top.Parent end
    if top ~= workspace and top ~= RS and top ~= ServerStorage and top ~= um and top.Parent then
      local anyPart = false
      for _, d in ipairs(top:GetDescendants()) do
        if d:IsA("BasePart") then
          anyPart = true
          break
        end
      end
      if not anyPart then top:Destroy() end
    end
  end
  table.sort(found)
  return found
end

---------------------------------------------------------------- 兵种：生成

-- 兵种的高度（血条、瞄准点）：导入模型按模板，零件模型按设计
-- 几个兵种共用一个导入模型（重型坦克用坦克的、巡飞弹用无人机的……）：按各自的长度缩放
local function tplK(def, T)
  if T and T.len and T.len > 0.01 and def.len then return def.len / T.len end
  return def.boss and 1.36 or 1
end

local function heightOf(t)
  local def = Config.Units[t]
  if def.foot then return 5.2 end
  local T = TEMPLATES[def.model]
  if T then return T.h * tplK(def, T) end
  local k = def.boss and 1.36 or 1
  local P = PART[t] or PART.tank
  local base = P.h or (def.air and 5 or 4.6)
  return base * ((def.len or 4) / P.len) * k
end
Models.heightOf = heightOf

-- 炮口（模型坐标，炮塔不转时）：大致在车头、炮塔高度
local MUZ = { at = V(-1.3, 4.4, -1.6), manpad = V(-1.3, 4.7, -1.6), mortar = V(0, 2.2, -0.4), mg = V(0, 0.7, -4.2) }
function Models.muzzle(t)
  local def = Config.Units[t]
  local h = heightOf(t)
  if MUZ[t] then return MUZ[t] end
  if def.foot then return V(0.5, 3.1, -2.6) end
  if def.bombs then return V(0, h * 0.25, 0) end
  if def.jet then return V(0, h * 0.35, -def.len * 0.45) end
  if def.air then return V(def.len * 0.08, h * 0.35, -def.len * 0.3) end
  if def.side then return V(def.size * 0.45, h * 0.75, 0) end
  return V(0, h * 0.62, -(def.len or 10) * 0.55)
end

local function ring(m, root, size, color)
  local r = newPart(m, V(0.12, size, size), CF(0, 0.12, 0) * UP, color, MAT.Neon, CYL)
  r.Name = "TeamRing"
  r.Transparency = 0.45
  r.CastShadow = false
  r.CanQuery = false
  weld(root, r, CF(0, 0.12, 0) * UP)
end

local function newRoot()
  local m = Instance.new("Model")
  local root = Instance.new("Part")
  root.Name = "Root"
  root.Anchored = true
  root.CanCollide = false
  root.CanTouch = false
  root.Transparency = 1
  root.Size = V(1, 1, 1)
  root.CFrame = CF()
  root.Parent = m
  m.PrimaryPart = root
  return m, root
end

-- 往模型里加一份模板（k 额外放大，offs 一个或几个摆放位置（CFrame）——步兵组是几个士兵；flat 全部焊死在 Root 上，不建炮塔、旋翼）
local function addTemplate(m, root, T, k, offs, flat)
  local hubs = {}
  local function hubFor(role)
    if hubs[role] then return hubs[role] end
    local h
    if role == "Turret" then h = hub(m, root, "Turret", T.pivots._PivotTurret * k)
    elseif role == "Rotor" then h = hub(m, root, "Rotor", T.pivots._PivotRotor * k, "Rotor")
    else
      h = hub(m, root, "Tail", T.pivots._PivotTail * k, "TailRotor")
      local ax = T.pivots._AxisTail and (T.pivots._AxisTail - T.pivots._PivotTail) or V(1, 0, 0)
      h:FindFirstChild("TailMotor"):SetAttribute("Axis", ax.Unit)
    end
    hubs[role] = h
    return h
  end
  for _, off in ipairs(offs) do
    for _, e in ipairs(T.parts) do
      local p = e.part:Clone()
      p.Anchored = false
      p.CanCollide = false
      p.CanTouch = false
      p.Massless = true
      p.Size = p.Size * k
      local cf = off * CF(p.CFrame.Position * k) * rotOnly(p.CFrame)
      p.CFrame = cf
      p.Parent = m
      if e.role == "Body" or flat then
        weld(root, p, cf)
      else
        local h = hubFor(e.role)
        weld(h, p, h:FindFirstChildOfClass("Motor6D").C0:Inverse() * cf)
      end
    end
  end
end

-- 步兵组：几个士兵的站位，武器道具摆在哪（机枪、迫击炮在地上，标枪、毒刺扛在第一个人右肩上）
local FOOT = { [2] = { CF(-1.8, 0, 0.6), CF(1.8, 0, 0.6) }, [3] = { CF(-2.6, 0, 1.6), CF(2.6, 0, 1.6), CF(0, 0, -2.2) } }
local PROPAT = {
  prop_mg = CF(0, 0, -2.9), prop_mortar = CF(0, 0, 0.1),
  prop_javelin = CF(-1.3, 4.25, 0.9), prop_stinger = CF(-1.3, 4.25, 0.9) * CFrame.Angles(math.rad(20), 0, 0),
}

-- 兵种模型（还没放进 workspace；放进去以后改 root.CFrame 摆位置）。color 是队伍颜色（零件模型的车身、脚下的色圈）
function Models.unit(t, color)
  local def = Config.Units[t]
  local T = TEMPLATES[def.model]
  local k = def.boss and 1.36 or 1
  local m, root
  if T and def.foot then
    m, root = newRoot()
    addTemplate(m, root, T, 1, FOOT[def.squad or 3], true)
    local P = def.prop and TEMPLATES[def.prop]
    if P then addTemplate(m, root, P, 1, { PROPAT[def.prop] }, true) end
  elseif T then
    m, root = newRoot()
    addTemplate(m, root, T, tplK(def, T), { CF() }, false)
  else
    local P = PART[t] or PART.tank
    local K
    m, root, K = kit(((def.len or P.len) / P.len) * k * (def.foot and 1.27 or 1))
    local col = color:Lerp(C.olive, 0.2)
    if def.boss then col = RGB(40, 40, 44) end
    P.build(K, col, def)
  end
  ring(m, root, def.size * 0.95 * k, color)
  if def.jet then m:SetAttribute("Jet", true) end
  m:SetAttribute("H", heightOf(t))   -- 模型多高：客户端把名字、选中框摆在头顶
  m.Name = t
  return m, root
end

-- 血条（战斗时才显示）
function Models.hpBar(root, height, color)
  local bb = Instance.new("BillboardGui")
  bb.Name = "HP"
  bb.Size = UDim2.fromOffset(50, 6)
  bb.StudsOffsetWorldSpace = V(0, height, 0)
  bb.AlwaysOnTop = true
  bb.LightInfluence = 0
  bb.MaxDistance = 1400
  bb.Enabled = false
  local bg = Instance.new("Frame")
  bg.Size = UDim2.fromScale(1, 1)
  bg.BackgroundColor3 = RGB(20, 20, 20)
  bg.BorderSizePixel = 0
  bg.Parent = bb
  local fill = Instance.new("Frame")
  fill.Name = "Fill"
  fill.Size = UDim2.fromScale(1, 1)
  fill.BackgroundColor3 = color
  fill.BorderSizePixel = 0
  fill.Parent = bg
  bb.Parent = root
  return bb, fill
end

---------------------------------------------------------------- 补给空投箱

-- 根零件是箱子（锚定，服务器挪它落下来），捆带、伞（子模型 Chute，落地后拆掉）、绿色信标焊在上面；返回 模型、箱子、伞、头顶的字
function Models.crate(parent, pos, text)
  local m = Instance.new("Model")
  m.Name = "SupplyCrate"
  local box = Instance.new("Part")
  box.Name = "Box"
  box.Size = V(4.2, 3.2, 4.2)
  box.Color = RGB(104, 116, 74)
  box.Material = MAT.WoodPlanks
  box.Anchored = true
  box.CanCollide = false
  box.TopSurface = Enum.SurfaceType.Smooth
  box.BottomSurface = Enum.SurfaceType.Smooth
  box.CFrame = CF(pos + V(0, 71.5, 0))
  box.Parent = m
  m.PrimaryPart = box
  local function deco(holder, size, off, color, mat, shape, tr)
    local p = newPart(holder, size, box.CFrame * off, color, mat, shape)
    p.CanQuery = false
    if tr then p.Transparency = tr end
    weld(box, p, off)
    return p
  end
  deco(m, V(4.35, 0.18, 0.7), CF(0, 1.62, 0), RGB(40, 40, 36), MAT.Metal)
  deco(m, V(0.7, 0.18, 4.35), CF(0, 1.62, 0), RGB(40, 40, 36), MAT.Metal)
  deco(m, V(4.35, 0.7, 0.18), CF(0, 0, 2.12), RGB(236, 236, 230), MAT.SmoothPlastic)
  local beacon = deco(m, V(70, 1.1, 1.1), CF(0, 36.6, 0) * UP, RGB(90, 255, 130), MAT.Neon, CYL, 0.45)
  beacon.CastShadow = false
  local chute = Instance.new("Model")
  chute.Name = "Chute"
  chute.Parent = m
  local canopy = deco(chute, V(16, 5, 16), CF(0, 13, 0), RGB(232, 120, 40), MAT.Fabric, BALL)
  canopy.CastShadow = false
  for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
    local a = V(c[1] * 1.9, 1.6, c[2] * 1.9)
    local b = V(c[1] * 6.5, 11.5, c[2] * 6.5)
    local mid = (a + b) / 2
    deco(chute, V(0.08, 0.08, (b - a).Magnitude), CFrame.lookAt(mid, b), RGB(220, 220, 210), MAT.SmoothPlastic)
  end
  local bb = Models.sign(box, text, 4.2, 12, 2.2, RGB(150, 255, 170), 400)
  bb.AlwaysOnTop = true
  m.Parent = parent
  return m, box, chute, bb
end

---------------------------------------------------------------- 武器（玩家背包里的工具）

-- 枪：Handle 的原点在握把，枪口朝 −Z（Roblox 工具默认握法下朝前）；Muzzle 附件在枪口
local GUNS = {
  rifle = { len = 3.2, parts = { { V(0.32, 0.55, 2.0), V(0, 0.08, -0.4) }, { V(0.28, 0.5, 0.9), V(0, 0, 1.0) }, { V(0.14, 0.14, 1.4), V(0, 0.14, -2.0) }, { V(0.22, 0.7, 0.35), V(0, -0.45, -0.6) } }, col = RGB(40, 42, 40) },
  smg = { len = 2.2, parts = { { V(0.3, 0.5, 1.4), V(0, 0.06, -0.3) }, { V(0.12, 0.12, 0.7), V(0, 0.12, -1.3) }, { V(0.2, 0.8, 0.3), V(0, -0.5, -0.3) } }, col = RGB(52, 54, 58) },
  sniper = { len = 4.6, parts = { { V(0.3, 0.5, 2.2), V(0, 0.06, -0.4) }, { V(0.26, 0.5, 1.2), V(0, -0.02, 1.2) }, { V(0.14, 0.14, 2.4), V(0, 0.12, -2.7) }, { V(0.24, 0.24, 1.0), V(0, 0.48, -0.4) } }, col = RGB(70, 76, 58) },
  rpg = { len = 4.2, parts = { { V(0.5, 0.5, 4.2), V(0, 0.25, -0.6) }, { V(0.7, 0.7, 1.0), V(0, 0.25, -2.9) }, { V(0.2, 0.6, 0.3), V(0, -0.3, -0.2) } }, col = RGB(72, 86, 60) },
}
function Models.tool(id)
  local w = Config.Weapons[id]
  local G = GUNS[id] or GUNS.rifle
  local tool = Instance.new("Tool")
  tool.Name = w.name
  tool.ToolTip = w.name
  tool.CanBeDropped = false
  tool.RequiresHandle = true
  tool:SetAttribute("Weapon", id)
  local handle = Instance.new("Part")
  handle.Name = "Handle"
  handle.Size = V(0.3, 0.3, 0.6)
  handle.Color = G.col
  handle.Material = MAT.Metal
  handle.CanCollide = false
  handle.Massless = true
  handle.TopSurface = Enum.SurfaceType.Smooth
  handle.BottomSurface = Enum.SurfaceType.Smooth
  handle.Parent = tool
  for i, e in ipairs(G.parts) do
    local p = Instance.new("Part")
    p.Name = "Gun" .. i
    p.Size = e[1]
    p.Color = G.col
    p.Material = MAT.Metal
    p.CanCollide = false
    p.CanTouch = false
    p.Massless = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.CFrame = CF(e[2])
    p.Parent = tool
    weld(handle, p, CF(e[2]))
  end
  local mz = Instance.new("Attachment")
  mz.Name = "Muzzle"
  mz.Position = V(0, 0.14, -G.len + 0.2)
  mz.Parent = handle
  return tool
end

return Models
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000C">
<Properties>
<string name="Name">Scenery</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：场景——光影、地形世界（起伏的山丘和树林、四周的雪山、基地后面的湖、战场北边的河和桥）、
-- 基地外围（带立柱和铁丝网的围墙、四角哨塔和探照灯、北门岗亭和栏杆、路灯、沙袋、物资堆、停着的卡车）、
-- 战场战区（绿野、沙漠、雪原、城市废墟、火山：地面材质、两边地形、主题道具，换战区时整个重摆）
-- 都是锚定的静态零件和地形；小装饰不挡人、不挡射线、不投影，省性能
local Lighting = game:GetService("Lighting")

local Scenery = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local MAT = Enum.Material
local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local UP = CFrame.Angles(0, 0, math.pi / 2)   -- Roblox 圆柱的轴在 X：转 90° 立起来

-- 零件：solid 挡人（墙、塔、楼），否则是装饰（不挡人、不挡射线、小的不投影）
local function part(parent, size, cf, color, mat, shape, solid)
  local p = Instance.new("Part")
  if shape then p.Shape = shape end
  p.Anchored = true
  p.Size = size
  p.CFrame = cf
  p.Color = color
  p.Material = mat or MAT.SmoothPlastic
  p.TopSurface = Enum.SurfaceType.Smooth
  p.BottomSurface = Enum.SurfaceType.Smooth
  if not solid then
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    if size.Magnitude < 6 then p.CastShadow = false end
  end
  p.Parent = parent
  return p
end
Scenery.part = part
local function cyl(parent, h, dia, cf, color, mat, solid)   -- 竖直圆柱：cf 是中心
  return part(parent, V(h, dia, dia), cf * UP, color, mat, CYL, solid)
end
local function ball(parent, d, cf, color, mat)
  return part(parent, V(d, d, d), cf, color, mat, BALL, false)
end

---------------------------------------------------------------- 光影

function Scenery.lighting()
  pcall(function()
    Lighting.ClockTime = 14.6
    Lighting.GeographicLatitude = 32
    Lighting.Brightness = 3
    Lighting.GlobalShadows = true
    Lighting.Ambient = RGB(64, 66, 74)
    Lighting.OutdoorAmbient = RGB(128, 132, 140)
    Lighting.ColorShift_Top = RGB(255, 242, 222)
    Lighting.EnvironmentDiffuseScale = 1
    Lighting.EnvironmentSpecularScale = 1
    Lighting.ShadowSoftness = 0.22
    Lighting.ExposureCompensation = 0.1
  end)
  local function ensure(cls, props)
    local o = Lighting:FindFirstChildOfClass(cls)
    if not o then
      o = Instance.new(cls)
      for k, v in pairs(props) do pcall(function() o[k] = v end) end
      o.Parent = Lighting
    end
    return o
  end
  ensure("Atmosphere", { Density = 0.3, Offset = 0.22, Haze = 1.5, Glare = 0.35, Color = RGB(200, 214, 232), Decay = RGB(104, 112, 128) })
  ensure("Sky", { SunAngularSize = 12, MoonAngularSize = 9, StarCount = 3000, CelestialBodiesShown = true })
  ensure("BloomEffect", { Intensity = 0.55, Size = 26, Threshold = 1.35 })
  ensure("ColorCorrectionEffect", { Contrast = 0.08, Saturation = 0.12, Brightness = 0.02, TintColor = RGB(255, 250, 242) })
  ensure("SunRaysEffect", { Intensity = 0.06, Spread = 0.55 })
  -- 体积云
  pcall(function()
    local T = workspace.Terrain
    if not T:FindFirstChildOfClass("Clouds") then
      local c = Instance.new("Clouds")
      c.Cover = 0.52
      c.Density = 0.55
      c.Color = RGB(250, 250, 252)
      c.Parent = T
    end
    T.Decoration = true   -- 草地上长草
    T.WaterColor = RGB(38, 92, 112)
    T.WaterTransparency = 0.6
    T.WaterReflectance = 0.6
    T.WaterWaveSize = 0.12
    T.WaterWaveSpeed = 9
  end)
end

---------------------------------------------------------------- 地形世界

-- 地形要避开的地方：基地、路、战场、空军基地跑道、竞技场（返回 true 表示这里不能起伏）
local function reserved(Config, x, z, margin)
  local F = Config.Field
  margin = margin or 0
  local hs = Config.BaseSize / 2
  for i = 1, Config.PlotCount do
    local cx = (i - (Config.PlotCount + 1) / 2) * Config.PlotSpacing
    local dx = x - cx
    if math.abs(dx) < hs + 30 + margin and z > -hs - 30 - margin and z < hs + 40 + margin then return true end              -- 基地
    if math.abs(dx) < F.width / 2 + 30 + margin and z > hs - margin and z < F.center + F.length / 2 + 40 + margin then return true end   -- 路 + 战场
    if dx > 150 - margin and dx < 262 + margin and z > -hs - 20 - margin and z < hs + margin then return true end           -- 空军基地
    local I = Config.Industry
    if dx > I.x0 - 12 - margin and dx < I.x1 + margin and z > I.z0 - 12 - margin and z < I.z1 + 12 + margin then return true end   -- 西边工业区
    if math.abs(dx) < 404 + margin and z > -314 - margin and z < -126 + margin then return true end   -- 南门外的路、重生开放的三块新区域
    if math.abs(dx) < 36 + margin and z > -356 - margin and z < -300 + margin then return true end    -- 港口区伸进湖里的码头
  end
  for _, ax in ipairs(Config.Arena.xs) do
    if math.abs(x - ax) < F.width / 2 + 40 + margin and z > Config.Arena.z + F.center - F.length / 2 - 40 - margin and z < Config.Arena.z + F.center + F.length / 2 + 40 + margin then return true end
  end
  return false
end
Scenery.reserved = reserved

-- 铺地形；返回 groundY(x, z)（山丘表面的高度，种树用）和河、湖的范围
function Scenery.terrain(Config)
  local T = workspace.Terrain
  local F = Config.Field
  local rng = Random.new(20241106)
  local W = Config.PlotCount * Config.PlotSpacing / 2
  local X0, X1 = -W - 700, W + 700
  local Z0, Z1 = -1050, Config.Arena.z + F.center + F.length / 2 + 650
  -- 1) 底：一整层草地，顶面 y = 0（分块填）
  local x = X0
  while x < X1 do
    local w = math.min(512, X1 - x)
    local z = Z0
    while z < Z1 do
      local d = math.min(512, Z1 - z)
      T:FillBlock(CFrame.new(x + w / 2, -8, z + d / 2), V(w, 16, d), MAT.Grass)
      z = z + d
    end
    x = x + w
  end
  local hills = {}
  local function hill(cx, cz, r, mat, k)
    local cy = -r * (k or 0.55)
    T:FillBall(V(cx, cy, cz), r, mat or MAT.Grass)
    table.insert(hills, { x = cx, y = cy, z = cz, r = r })
  end
  -- 2) 湖：基地后面一长条（先挖空、再灌水、两边沙滩）
  local lakeZ0, lakeZ1 = -330, -470
  T:FillBlock(CFrame.new(0, -1, (lakeZ0 + lakeZ1) / 2), V(X1 - X0, 2, lakeZ0 - lakeZ1 + 50), MAT.Sand)
  T:FillBlock(CFrame.new(0, -6, (lakeZ0 + lakeZ1) / 2), V(X1 - X0 - 40, 12, lakeZ0 - lakeZ1), MAT.Air)
  T:FillBlock(CFrame.new(0, -7.5, (lakeZ0 + lakeZ1) / 2), V(X1 - X0 - 40, 9, lakeZ0 - lakeZ1), MAT.Water)
  -- 3) 河：战场北边、竞技场南边
  local rz0 = F.center + F.length / 2 + 120
  local rz1 = rz0 + 90
  T:FillBlock(CFrame.new(0, -1, (rz0 + rz1) / 2), V(X1 - X0, 2, rz1 - rz0 + 40), MAT.Sand)
  T:FillBlock(CFrame.new(0, -6, (rz0 + rz1) / 2), V(X1 - X0, 12, rz1 - rz0), MAT.Air)
  T:FillBlock(CFrame.new(0, -7.5, (rz0 + rz1) / 2), V(X1 - X0, 9, rz1 - rz0), MAT.Water)
  -- 4) 起伏的山丘：基地之间、战场之间的空地（避开基地、路、战场、跑道），草地上点缀林地、泥土、岩石
  local tries = 0
  local placed = 0
  while placed < 150 and tries < 3000 do
    tries = tries + 1
    local hx = rng:NextNumber(X0 + 200, X1 - 200)
    local hz = rng:NextNumber(-300, Config.Arena.z + F.center + F.length / 2 + 200)
    local r = rng:NextNumber(55, 130)
    local inRiver = hz + r > rz0 - 30 and hz - r < rz1 + 30
    if not inRiver and not reserved(Config, hx, hz, r * 0.75) then
      local m = MAT.Grass
      local roll = rng:NextNumber()
      if roll < 0.3 then m = MAT.LeafyGrass elseif roll < 0.4 then m = MAT.Ground end
      hill(hx, hz, r, m, rng:NextNumber(0.5, 0.7))
      if rng:NextNumber() < 0.25 then T:FillBall(V(hx + rng:NextNumber(-r, r) * 0.4, -r * 0.2, hz + rng:NextNumber(-r, r) * 0.4), r * 0.35, MAT.Rock) end
      placed = placed + 1
    end
  end
  -- 5) 四周的大山（顶上积雪）：南边湖后面、北边竞技场后面、东西两头
  local function mountain(mx, mz, r)
    local cy = -r * 0.25
    T:FillBall(V(mx, cy, mz), r, MAT.Rock)
    T:FillBall(V(mx, cy - r * 0.15, mz), r * 1.08, MAT.Grass)
    T:FillBall(V(mx, cy + r * 0.62, mz), r * 0.42, MAT.Snow)
    T:FillBall(V(mx + r * 0.25, cy + r * 0.45, mz - r * 0.1), r * 0.3, MAT.Slate)
  end
  for mx = X0 + 100, X1 - 100, 380 do
    mountain(mx + rng:NextNumber(-80, 80), lakeZ1 - 330 + rng:NextNumber(-60, 60), rng:NextNumber(230, 360))
    mountain(mx + rng:NextNumber(-80, 80), Z1 - 120 + rng:NextNumber(-60, 60), rng:NextNumber(250, 380))
  end
  for mz = -300, Z1 - 300, 420 do
    mountain(X0 + 40 + rng:NextNumber(-40, 40), mz + rng:NextNumber(-80, 80), rng:NextNumber(220, 340))
    mountain(X1 - 40 + rng:NextNumber(-40, 40), mz + rng:NextNumber(-80, 80), rng:NextNumber(220, 340))
  end
  local function groundY(px, pz)
    local y = 0
    for _, h in ipairs(hills) do
      local dx, dz = px - h.x, pz - h.z
      local d2 = dx * dx + dz * dz
      if d2 < h.r * h.r then y = math.max(y, h.y + math.sqrt(h.r * h.r - d2)) end
    end
    return y
  end
  return groundY, { rz0 = rz0, rz1 = rz1, lakeZ0 = lakeZ0, lakeZ1 = lakeZ1, X0 = X0, X1 = X1, hills = hills }
end

---------------------------------------------------------------- 植物、石头

-- 阔叶树：树干 + 几团树冠；针叶树：树干 + 一层层往上收的「圆盘」；snow 给针叶树顶上积雪
local function broadleaf(f, pos, rng, s)
  s = s or 1
  local h = rng:NextNumber(7, 12) * s
  cyl(f, h, 1.6 * s, CF(pos + V(0, h / 2, 0)), RGB(98, 74, 52), MAT.Wood)
  local g = RGB(52 + rng:NextInteger(0, 26), 108 + rng:NextInteger(0, 40), 44)
  for i = 1, 3 do
    local d = rng:NextNumber(7, 12) * s
    local o = V(rng:NextNumber(-2.5, 2.5) * s, h + rng:NextNumber(-1, 3) * s, rng:NextNumber(-2.5, 2.5) * s)
    if i == 1 then o = V(0, h + 2 * s, 0) end
    ball(f, d, CF(pos + o), g:Lerp(RGB(30, 60, 20), rng:NextNumber() * 0.25), MAT.Grass)
  end
end
local function pine(f, pos, rng, s, snow)
  s = s or 1
  local h = rng:NextNumber(14, 22) * s
  cyl(f, h * 0.45, 1.1 * s, CF(pos + V(0, h * 0.22, 0)), RGB(84, 62, 44), MAT.Wood)
  local g = snow and RGB(46, 78, 58) or RGB(38 + rng:NextInteger(0, 18), 82 + rng:NextInteger(0, 26), 46)
  local n = 5
  for i = 1, n do
    local k = (i - 1) / (n - 1)
    local dia = (10 - 7.5 * k) * s
    local y = h * (0.22 + 0.66 * k)
    cyl(f, 2.6 * s, dia, CF(pos + V(0, y, 0)), g, MAT.Grass)
    if snow then cyl(f, 0.5 * s, dia * 0.86, CF(pos + V(0, y + 1.4 * s, 0)), RGB(240, 244, 250), MAT.Snow) end
  end
end
local function rock(f, pos, rng, s)
  local d = rng:NextNumber(3, 8) * (s or 1)
  local p = part(f, V(d, d * rng:NextNumber(0.5, 0.8), d * rng:NextNumber(0.7, 1.1)), CF(pos + V(0, d * 0.2, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
    RGB(118, 116, 110):Lerp(RGB(80, 80, 76), rng:NextNumber()), MAT.Slate, BALL)
  return p
end
local function bush(f, pos, rng)
  for _ = 1, 3 do
    local d = rng:NextNumber(3, 5.5)
    ball(f, d, CF(pos + V(rng:NextNumber(-1.5, 1.5), d * 0.3, rng:NextNumber(-1.5, 1.5))), RGB(58, 100 + rng:NextInteger(0, 30), 46), MAT.Grass)
  end
end
Scenery.broadleaf, Scenery.pine, Scenery.rock, Scenery.bush = broadleaf, pine, rock, bush

-- 地图上的树林（长在山丘上、湖边、河边）、石头、灌木，河上的桥
function Scenery.nature(parent, Config, groundY, info)
  local f = Instance.new("Folder")
  f.Name = "Nature"
  local rng = Random.new(77001)
  local F = Config.Field
  local n, tries = 0, 0
  while n < 460 and tries < 9000 do
    tries = tries + 1
    local x = rng:NextNumber(info.X0 + 250, info.X1 - 250)
    local z = rng:NextNumber(-300, Config.Arena.z + F.center + F.length / 2 + 220)
    local inRiver = z > info.rz0 - 25 and z < info.rz1 + 25
    if not inRiver and not reserved(Config, x, z, 6) then
      local y = groundY(x, z)
      local pos = V(x, y - 0.5, z)
      local r = rng:NextNumber()
      -- 山丘上（高处）多针叶，平地多阔叶
      if r < 0.45 then
        pine(f, pos, rng, rng:NextNumber(0.8, 1.3), false)
      elseif r < 0.8 then
        broadleaf(f, pos, rng, rng:NextNumber(0.8, 1.25))
      elseif r < 0.92 then
        bush(f, pos, rng)
      else
        rock(f, pos, rng, rng:NextNumber(0.8, 2))
      end
      n = n + 1
    end
  end
  -- 湖边一排树
  for x = info.X0 + 300, info.X1 - 300, 34 do
    if rng:NextNumber() < 0.6 then
      local z = info.lakeZ0 + rng:NextNumber(10, 40)
      if not reserved(Config, x, z, 4) then
        if rng:NextNumber() < 0.5 then pine(f, V(x, -0.5, z), rng, 1) else broadleaf(f, V(x, -0.5, z), rng, 1) end
      end
    end
  end
  -- 河上的桥：每个基地正北一座（木桥面、石墩、栏杆）
  for i = 1, Config.PlotCount do
    local cx = (i - (Config.PlotCount + 1) / 2) * Config.PlotSpacing
    local len = info.rz1 - info.rz0 + 60
    local zc = (info.rz0 + info.rz1) / 2
    part(f, V(24, 1.6, len), CF(cx, 1.6, zc), RGB(122, 92, 62), MAT.WoodPlanks, nil, true)
    for _, s in ipairs({ -1, 1 }) do
      part(f, V(1, 3.4, len), CF(cx + s * 11.5, 4.1, zc), RGB(104, 78, 54), MAT.Wood, nil, true)
      for k = -2, 2 do part(f, V(4, 12, 4), CF(cx + s * 9, -4, zc + k * len / 5), RGB(128, 126, 120), MAT.Cobblestone) end
    end
  end
  f.Parent = parent
  return f
end

---------------------------------------------------------------- 基地外围

-- 一块基地的围墙、哨塔、大门、路灯、沙袋、物资堆、停着的卡车（origin 是基地中心地面，color 是队伍色）
function Scenery.base(f, origin, color, Config)
  local base = CF(origin)
  local hs = Config.BaseSize / 2
  local g = Instance.new("Folder")
  g.Name = "Perimeter"
  local WALL = RGB(150, 150, 142)
  local DARK = RGB(48, 50, 52)
  local rng = Random.new(math.floor(origin.X) + 5)
  -- 围墙：墙身 + 每 26 格一根立柱 + 顶上两道铁丝 + 斜撑
  local function wall(x0, z0, x1, z1, h)
    local a, b = V(x0, 0, z0), V(x1, 0, z1)
    local len = (b - a).Magnitude
    local mid = (a + b) / 2
    local rot = CFrame.lookAt(mid, b)
    part(g, V(1.6, h, len), base * CF(mid + V(0, 1 + h / 2, 0)) * (rot - rot.Position), WALL, MAT.Concrete, nil, true)
    part(g, V(2.2, 0.5, len), base * CF(mid + V(0, 1 + h + 0.25, 0)) * (rot - rot.Position), RGB(120, 120, 114), MAT.Concrete)
    local n = math.max(1, math.floor(len / 26))
    for k = 0, n do
      local p = a:Lerp(b, k / n)
      part(g, V(2.8, h + 1.2, 2.8), base * CF(p + V(0, 1 + (h + 1.2) / 2, 0)) * (rot - rot.Position), RGB(132, 132, 126), MAT.Concrete, nil, true)
      part(g, V(0.25, 2.6, 0.25), base * CF(p + V(0, 1 + h + 1.8, 0)), DARK, MAT.Metal)
    end
    for _, dy in ipairs({ 1.4, 2.6 }) do
      part(g, V(0.12, 0.12, len), base * CF(mid + V(0, 1 + h + dy, 0)) * (rot - rot.Position), RGB(70, 70, 72), MAT.Metal)
    end
  end
  -- 后墙：中间开南门（门外一条东西向的大路，通重生开放的新区域）
  local sg0, sg1 = Config.SouthGate[1], Config.SouthGate[2]
  wall(-hs, -hs, sg0 - 3, -hs, 8)
  wall(sg1 + 3, -hs, hs, -hs, 8)
  for _, gx in ipairs({ sg0 - 2.5, sg1 + 2.5 }) do
    part(g, V(5, 12, 5), base * CF(gx, 7, -hs), RGB(124, 124, 118), MAT.Concrete, nil, true)
    part(g, V(5.6, 0.8, 5.6), base * CF(gx, 13.4, -hs), RGB(100, 100, 96), MAT.Concrete)
    part(g, V(1, 1, 1), base * CF(gx, 14.3, -hs), RGB(255, 170, 60), MAT.Neon):SetAttribute("Anim", "blink")
  end
  local sl = part(g, V(sg1 - sg0 + 6, 2.4, 1), base * CF((sg0 + sg1) / 2, 14, -hs), RGB(214, 170, 40), MAT.SmoothPlastic)
  for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
    local sg = Instance.new("SurfaceGui")
    sg.Face = face
    sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.PixelsPerStud = 24
    sg.LightInfluence = 0
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Font = Enum.Font.GothamBlack
    t.TextScaled = true
    t.TextColor3 = RGB(40, 36, 30)
    t.Text = (face == Enum.NormalId.Back) and "南门 · 新区域" or "回基地"
    t.Parent = sg
    sg.Parent = sl
  end
  -- 门外的大路（东西向，接三块新区域）和门口那一小段
  local R = Config.SouthRoad
  local rz = (R.z0 + R.z1) / 2
  part(g, V(800, 1, R.z1 - R.z0 + 4), base * CF(0, 0.5, rz), RGB(150, 150, 142), MAT.Concrete, nil, true)
  part(g, V(sg1 - sg0 + 4, 1, -hs - R.z1 + 1), base * CF((sg0 + sg1) / 2, 0.5, (R.z1 - hs) / 2), RGB(150, 150, 142), MAT.Concrete, nil, true)
  part(g, V(796, 0.1, R.z1 - R.z0), base * CF(0, 1.05, rz), RGB(62, 64, 68), MAT.Asphalt)
  for x = -390, 390, 16 do part(g, V(6, 0.06, 0.5), base * CF(x, 1.12, rz), RGB(236, 232, 210), MAT.SmoothPlastic) end
  -- 左墙（西）：南段开一个工业区大门（门柱、门楣上写「工业区」）
  local gz0, gz1 = Config.Industry.gate[1], Config.Industry.gate[2]
  wall(-hs, -hs, -hs, gz0 - 3, 8)
  wall(-hs, gz1 + 3, -hs, hs, 8)
  for _, gz in ipairs({ gz0 - 2.5, gz1 + 2.5 }) do
    part(g, V(5, 12, 5), base * CF(-hs, 7, gz), RGB(124, 124, 118), MAT.Concrete, nil, true)
    part(g, V(5.6, 0.8, 5.6), base * CF(-hs, 13.4, gz), RGB(100, 100, 96), MAT.Concrete)
    part(g, V(1, 1, 1), base * CF(-hs, 14.3, gz), RGB(255, 170, 60), MAT.Neon):SetAttribute("Anim", "blink")
  end
  local lintel = part(g, V(1, 2.4, gz1 - gz0 + 6), base * CF(-hs, 14, (gz0 + gz1) / 2), RGB(214, 170, 40), MAT.SmoothPlastic)
  for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
    local sg = Instance.new("SurfaceGui")
    sg.Face = face
    sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.PixelsPerStud = 24
    sg.LightInfluence = 0
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Font = Enum.Font.GothamBlack
    t.TextScaled = true
    t.TextColor3 = RGB(40, 36, 30)
    t.Text = (face == Enum.NormalId.Right) and "工业区 →" or "← 回基地"
    t.Parent = sg
    sg.Parent = lintel
  end
  wall(hs, -hs, hs, hs, 8)             -- 右墙
  -- 前面（朝战场）：两段矮墙，中间是大门（和中间那条路对齐）
  local g0, g1 = -72, 52
  wall(-hs, hs, g0 - 6, hs, 4)
  wall(g1 + 6, hs, hs, hs, 4)
  for _, gx in ipairs({ g0 - 3, g1 + 3 }) do
    part(g, V(5, 12, 5), base * CF(gx, 7, hs), RGB(124, 124, 118), MAT.Concrete, nil, true)
    part(g, V(5.6, 0.8, 5.6), base * CF(gx, 13.4, hs), RGB(100, 100, 96), MAT.Concrete)
    part(g, V(1, 1, 1), base * CF(gx, 14.3, hs), RGB(255, 170, 60), MAT.Neon):SetAttribute("Anim", "blink")
  end
  -- 门楣横幅（队伍色）
  part(g, V(g1 - g0 + 6, 2.2, 1), base * CF((g0 + g1) / 2, 14, hs), color, MAT.SmoothPlastic)
  -- 抬起的栏杆 + 岗亭
  for _, side in ipairs({ { g0 + 4, 1 }, { g1 - 4, -1 } }) do
    local bx, dir = side[1], side[2]
    part(g, V(1.4, 3, 1.4), base * CF(bx, 2.5, hs + 4), RGB(220, 200, 60), MAT.SmoothPlastic)
    part(g, V(26, 0.5, 0.5), base * CF(bx + dir * 6, 3.8 + 6, hs + 4) * CFrame.Angles(0, 0, dir * math.rad(62)), RGB(236, 70, 60), MAT.SmoothPlastic)
  end
  local function booth(x, z)
    part(g, V(7, 0.6, 7), base * CF(x, 1.3, z), RGB(120, 120, 114), MAT.Concrete)
    part(g, V(6, 6, 6), base * CF(x, 4.6, z), RGB(214, 210, 196), MAT.SmoothPlastic, nil, true)
    part(g, V(6.2, 1.6, 6.2), base * CF(x, 5.4, z), RGB(70, 110, 140), MAT.Glass)
    part(g, V(7.4, 0.6, 7.4), base * CF(x, 7.9, z), DARK, MAT.Metal)
  end
  booth(g0 - 12, hs + 8)
  booth(g1 + 12, hs + 8)
  -- 四角的哨塔：四条腿、平台、岗楼、屋顶、探照灯
  local function tower(x, z, faceX, faceZ)
    local c = base * CF(x, 0, z)
    for _, o in ipairs({ { -2.6, -2.6 }, { 2.6, -2.6 }, { -2.6, 2.6 }, { 2.6, 2.6 } }) do
      part(g, V(0.8, 16, 0.8), c * CF(o[1], 9, o[2]), RGB(86, 82, 74), MAT.Metal, nil, true)
    end
    part(g, V(8, 0.6, 8), c * CF(0, 17, 0), RGB(96, 92, 84), MAT.WoodPlanks, nil, true)
    part(g, V(7, 1.4, 7), c * CF(0, 18, 0), RGB(84, 96, 70), MAT.Concrete)
    part(g, V(6.6, 2.2, 6.6), c * CF(0, 19.8, 0), RGB(70, 104, 130), MAT.Glass)
    part(g, V(8.4, 0.6, 8.4), c * CF(0, 21.2, 0), DARK, MAT.Metal)
    local lamp = cyl(g, 1.2, 1.6, c * CF(0, 22.2, 0), RGB(40, 40, 42), MAT.Metal)
    local head = part(g, V(1.4, 1.4, 1.8), CFrame.lookAt((c * CF(0, 22.6, 0)).Position, (base * CF(faceX, 0, faceZ)).Position), RGB(230, 230, 220), MAT.Neon)
    local sl = Instance.new("SpotLight")
    sl.Brightness = 3
    sl.Range = 70
    sl.Angle = 40
    sl.Face = Enum.NormalId.Front
    sl.Color = RGB(255, 246, 220)
    sl.Parent = head
    head:SetAttribute("Anim", "spin")
    head:SetAttribute("Spd", 0.05)
    lamp.CastShadow = false
  end
  tower(-hs + 4, -hs + 4, 0, 0)
  tower(hs - 4, -hs + 4, 0, 0)
  tower(-hs + 4, hs - 4, 0, hs + 200)
  tower(hs - 4, hs - 4, 0, hs + 200)
  -- 路灯：横路两边、中间那条路两边
  local function lamp(x, z)
    cyl(g, 10, 0.5, base * CF(x, 6, z), RGB(70, 72, 76), MAT.Metal)
    part(g, V(3, 0.4, 0.9), base * CF(x + 1.2, 11, z), RGB(70, 72, 76), MAT.Metal)
    local bulb = part(g, V(1.2, 0.4, 0.8), base * CF(x + 2.2, 10.7, z), RGB(255, 236, 190), MAT.Neon)
    local pl = Instance.new("PointLight")
    pl.Brightness = 1.2
    pl.Range = 26
    pl.Color = RGB(255, 228, 180)
    pl.Parent = bulb
  end
  for _, x in ipairs({ -120, -70, 50, 100 }) do lamp(x, 76) end
  for _, z in ipairs({ 96, 118 }) do
    lamp(-74, z)
    lamp(54, z)
  end
  -- 沙袋掩体（大门里面两侧）
  local function sandbags(x, z, w, rot)
    local c = base * CF(x, 0, z) * CFrame.Angles(0, rot or 0, 0)
    for row = 0, 2 do
      for k = -math.floor(w / 2), math.floor(w / 2) do
        part(g, V(1.9, 0.9, 1.1), c * CF(k * 1.95 + (row % 2) * 0.95, 1.45 + row * 0.85, 0), RGB(176, 158, 112), MAT.Fabric)
      end
    end
  end
  sandbags(g0 + 14, hs - 12, 6, 0)
  sandbags(g1 - 14, hs - 12, 6, 0)
  -- 物资堆：沿左墙内侧一排（木箱、绿色弹药箱、油桶），右墙内侧几堆
  local function crates(x, z)
    local c = base * CF(x, 0, z) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0)
    for i = 1, rng:NextInteger(3, 6) do
      local s = rng:NextNumber(2.2, 3.4)
      local col = (rng:NextNumber() < 0.5) and RGB(150, 116, 74) or RGB(84, 98, 62)
      part(g, V(s, s * 0.8, s), c * CF(rng:NextNumber(-3, 3), 1 + s * 0.4 + ((i > 3) and s * 0.8 or 0), rng:NextNumber(-3, 3)), col, (col.R > 0.5) and MAT.WoodPlanks or MAT.Metal)
    end
  end
  local function drums(x, z)
    for i = 1, rng:NextInteger(3, 7) do
      local col = (rng:NextNumber() < 0.6) and RGB(60, 84, 60) or RGB(160, 50, 40)
      cyl(g, 2.6, 1.8, base * CF(x + (i % 3) * 2 - 2, 2.3, z + math.floor(i / 3) * 2 - 2), col, MAT.Metal)
    end
  end
  for z = -110, 110, 44 do
    if rng:NextNumber() < 0.5 then crates(-121, z) else drums(-121, z) end
  end
  crates(120, 40)
  drums(120, 64)
  crates(121, -60)
  -- 停着的军用卡车（右墙内侧，车头朝北）
  local function truck(x, z, col)
    local c = base * CF(x, 0, z)
    for _, sx in ipairs({ -1.4, 1.4 }) do
      for _, sz in ipairs({ -3.2, 0.6, 3.0 }) do part(g, V(0.8, 2.2, 2.2), c * CF(sx, 2.1, sz), RGB(30, 30, 32), MAT.SmoothPlastic, CYL) end
    end
    part(g, V(3.4, 0.8, 10), c * CF(0, 2.6, 0), RGB(50, 52, 50), MAT.Metal)
    part(g, V(3.2, 2.6, 2.8), c * CF(0, 4.3, -3.6), col, MAT.Metal, nil, true)
    part(g, V(3.0, 1.0, 0.2), c * CF(0, 4.9, -5.05), RGB(60, 90, 110), MAT.Glass)
    part(g, V(3.4, 3.2, 6.2), c * CF(0, 4.6, 1.6), col:Lerp(RGB(40, 40, 40), 0.15), MAT.Fabric, nil, true)
  end
  truck(-113, 64, RGB(86, 98, 66))
  truck(-113, -12, RGB(86, 98, 66))
  -- 伪装网棚（左后角）
  for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do cyl(g, 7, 0.4, base * CF(-108 + o[1] * 9, 4.5, -118 + o[2] * 5), RGB(90, 74, 50), MAT.Wood) end
  local net = part(g, V(22, 0.3, 14), base * CF(-108, 8.2, -118), RGB(80, 98, 58), MAT.Fabric)
  net.Transparency = 0.1
  g.Parent = f
  return g
end

---------------------------------------------------------------- 战场战区

local TH_TINT = { grass = RGB(150, 140, 100), desert = RGB(214, 190, 140), snow = RGB(236, 240, 246), urban = RGB(140, 138, 132), volcano = RGB(70, 62, 58) }
local THEME = {
  grass = { field = RGB(104, 122, 72), fmat = MAT.Grass, road = RGB(128, 104, 72), flank = MAT.Grass, crater = RGB(84, 74, 54), ground = RGB(116, 96, 70) },
  desert = { field = RGB(214, 190, 138), fmat = MAT.Sand, road = RGB(180, 150, 104), flank = MAT.Sand, crater = RGB(164, 136, 96), ground = RGB(200, 172, 120) },
  snow = { field = RGB(232, 238, 246), fmat = MAT.Snow, road = RGB(170, 160, 150), flank = MAT.Snow, crater = RGB(150, 146, 140), ground = RGB(220, 226, 236) },
  urban = { field = RGB(118, 118, 120), fmat = MAT.Concrete, road = RGB(62, 62, 66), flank = MAT.Concrete, crater = RGB(70, 68, 66), ground = RGB(130, 128, 124) },
  volcano = { field = RGB(62, 56, 54), fmat = MAT.Basalt, road = RGB(44, 40, 40), flank = MAT.Basalt, crater = RGB(40, 34, 32), ground = RGB(70, 62, 58) },
}
Scenery.THEME = THEME

-- 一辆打坏的车（坦克或卡车的残骸，焦黑），可以冒烟
local function wreck(g, cf, rng, smoke)
  local c = RGB(44, 40, 36)
  if rng:NextNumber() < 0.5 then
    part(g, V(7, 2, 11), cf * CF(0, 1.6, 0), c, MAT.CorrodedMetal)
    part(g, V(5, 1.6, 5), cf * CF(0.5, 3.4, 0.6) * CFrame.Angles(0, 0.5, 0.15), c, MAT.CorrodedMetal)
    part(g, V(0.6, 0.6, 7), cf * CF(1.5, 3.6, -3) * CFrame.Angles(0.3, 0.6, 0), RGB(30, 30, 30), MAT.Metal)
  else
    part(g, V(4, 2.6, 9), cf * CF(0, 2, 0) * CFrame.Angles(0, 0, 0.3), c, MAT.CorrodedMetal)
    part(g, V(3.6, 2.4, 3), cf * CF(0.6, 3.6, -3) * CFrame.Angles(0, 0, 0.3), c, MAT.CorrodedMetal)
  end
  if smoke then
    local s = Instance.new("Smoke")
    s.Color = RGB(52, 50, 48)
    s.Opacity = 0.18
    s.RiseVelocity = 7
    s.Size = 6
    local holder = part(g, V(1, 1, 1), cf * CF(0, 4, 0), c, MAT.SmoothPlastic)
    holder.Transparency = 1
    s.Parent = holder
    if rng:NextNumber() < 0.5 then
      local fire = Instance.new("Fire")
      fire.Size = 5
      fire.Heat = 9
      fire.Parent = holder
    end
  end
end

-- 战壕（一段一段，中间留口子给部队过）：深色壕沟 + 朝敌人那边一溜沙袋
local function trench(g, base, z, facing, half, gap, rng, colTrench, colBag)
  local x = -half
  while x < half do
    local len = rng:NextNumber(40, 70)
    local x1 = math.min(half, x + len)
    local mid, w = (x + x1) / 2, x1 - x
    part(g, V(w, 0.12, 5), base * CF(mid, 1.07, z), colTrench, MAT.Mud)
    part(g, V(w, 1.2, 1.8), base * CF(mid, 1.6, z + facing * 3.3), colBag, MAT.Fabric)
    part(g, V(w - 2, 0.9, 1.2), base * CF(mid, 2.6, z + facing * 3.4), colBag:Lerp(RGB(120, 108, 80), 0.2), MAT.Fabric)
    x = x1 + gap
  end
end

-- 铁丝网：一排 X 形木桩 + 两道铁丝
local function wire(g, base, z, x0, x1)
  local len = x1 - x0
  for k = 0, math.floor(len / 12) do
    local x = x0 + k * 12
    part(g, V(0.3, 3.6, 0.3), base * CF(x, 2.4, z) * CFrame.Angles(0, 0, 0.5), RGB(92, 74, 52), MAT.Wood)
    part(g, V(0.3, 3.6, 0.3), base * CF(x, 2.4, z) * CFrame.Angles(0, 0, -0.5), RGB(92, 74, 52), MAT.Wood)
  end
  for _, y in ipairs({ 2.2, 3.4 }) do part(g, V(len, 0.1, 0.1), base * CF((x0 + x1) / 2, y, z), RGB(70, 70, 70), MAT.Metal) end
end

-- 反坦克拒马（三根交叉的钢梁）
local function hedgehog(g, cf)
  local c = RGB(70, 66, 60)
  part(g, V(0.6, 0.6, 6), cf * CF(0, 1.9, 0) * CFrame.Angles(0.7, 0, 0), c, MAT.Metal)
  part(g, V(0.6, 0.6, 6), cf * CF(0, 1.9, 0) * CFrame.Angles(-0.7, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), c, MAT.Metal)
  part(g, V(6, 0.6, 0.6), cf * CF(0, 1.9, 0) * CFrame.Angles(0, 0.4, 0.7), c, MAT.Metal)
end

-- 一栋打坏的房子（墙、窗洞、塌掉的屋顶）：style = brick / adobe / cabin / concrete
local function ruin(g, cf, rng, style)
  local col, mat = RGB(150, 84, 64), MAT.Brick
  if style == "adobe" then col, mat = RGB(196, 160, 112), MAT.Sandstone
  elseif style == "cabin" then col, mat = RGB(110, 80, 56), MAT.WoodPlanks
  elseif style == "concrete" then col, mat = RGB(150, 148, 142), MAT.Concrete end
  local w, d = rng:NextNumber(14, 24), rng:NextNumber(12, 20)
  local floors = (style == "concrete") and rng:NextInteger(2, 4) or 1
  local h = 7 * floors
  -- 四面墙各自有高有低（塌了一部分），留窗洞
  local sides = { { V(w, 0, 0), V(0, 0, -d / 2), 0 }, { V(w, 0, 0), V(0, 0, d / 2), 0 }, { V(d, 0, 0), V(-w / 2, 0, 0), math.pi / 2 }, { V(d, 0, 0), V(w / 2, 0, 0), math.pi / 2 } }
  for _, sd in ipairs(sides) do
    local len = sd[1].X
    local hh = h * rng:NextNumber(0.45, 1)
    local segs = math.max(2, math.floor(len / 5))
    for k = 0, segs - 1 do
      local sh = hh * rng:NextNumber(0.6, 1)
      if rng:NextNumber() > 0.12 then
        local x = -len / 2 + (k + 0.5) * len / segs
        part(g, V(len / segs - ((k % 2 == 1) and 1.6 or 0), sh, 1.2), cf * CF(sd[2]) * CFrame.Angles(0, sd[3], 0) * CF(x, 1 + sh / 2, 0), col:Lerp(RGB(60, 56, 52), rng:NextNumber() * 0.25), mat, nil, true)
      end
    end
  end
  for f2 = 1, floors - 1 do   -- 楼板（塌了一角）
    part(g, V(w * 0.8, 0.8, d * 0.7), cf * CF(-w * 0.08, 1 + f2 * 7, d * 0.1) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.1, 0.1)), RGB(140, 138, 132), MAT.Concrete, nil, true)
  end
  for _ = 1, rng:NextInteger(5, 10) do   -- 瓦砾
    local s = rng:NextNumber(1, 3)
    part(g, V(s, s * 0.6, s), cf * CF(rng:NextNumber(-w / 2, w / 2), 1.2, rng:NextNumber(-d / 2 - 3, d / 2 + 3)) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), 0), col, mat)
  end
end

local function palm(g, pos, rng)
  local h = rng:NextNumber(12, 18)
  local lean = rng:NextNumber(-0.25, 0.25)
  for k = 0, 5 do
    local y = k * h / 6
    part(g, V(1.3 - k * 0.1, h / 6 + 0.3, 1.3 - k * 0.1), CF(pos + V(lean * y, y + h / 12, 0)) * CFrame.Angles(0, 0, -lean), RGB(130, 100, 64), MAT.Wood)
  end
  local top = pos + V(lean * h, h, 0)
  for i = 1, 7 do
    local a = i / 7 * math.pi * 2
    part(g, V(1.6, 0.2, 9), CF(top) * CFrame.Angles(0, a, 0) * CFrame.Angles(-0.45, 0, 0) * CF(0, -1.2, -4), RGB(70, 130, 50), MAT.Grass)
  end
end

-- 战区：地面材质、两边的地形、道具（g 是这一块战场的装饰文件夹，清空重摆）
---------------------------------------------------------------- 西边工业区的场地（围墙外，从西墙南段的大门出去）

-- 硬化地面（一直铺到围墙）、从大门过来的路、南北主路和两条支路、三面围栏、路灯、门口的指示牌、几堆管子和油桶
function Scenery.industry(f, origin, Config)
  local I = Config.Industry
  local hs = Config.BaseSize / 2
  local base = CF(origin)
  local g = Instance.new("Folder")
  g.Name = "Industry"
  local x0, x1, z0, z1 = I.x0, -hs - 1, I.z0, I.z1
  local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
  part(g, V(x1 - x0, 1, z1 - z0), base * CF(cx, 0.5, cz), RGB(158, 152, 136), MAT.Concrete, nil, true)
  local ROAD, LINE = RGB(62, 64, 68), RGB(236, 232, 210)
  local gz = (I.gate[1] + I.gate[2]) / 2
  local rx = I.roadX
  part(g, V(x1 - rx + 7, 0.1, 16), base * CF((x1 + rx - 7) / 2, 1.05, gz), ROAD, MAT.Asphalt)
  part(g, V(14, 0.1, z1 - z0 - 10), base * CF(rx, 1.05, cz), ROAD, MAT.Asphalt)
  for z = z0 + 12, z1 - 12, 14 do part(g, V(0.5, 0.06, 6), base * CF(rx, 1.12, z), LINE, MAT.SmoothPlastic) end
  for _, az in ipairs({ -64, 4 }) do
    part(g, V(rx - x0 - 14, 0.1, 10), base * CF((rx + x0 + 14) / 2, 1.05, az), ROAD, MAT.Asphalt)
    for x = rx - 14, x0 + 22, -14 do part(g, V(6, 0.06, 0.5), base * CF(x, 1.12, az), LINE, MAT.SmoothPlastic) end
  end
  -- 围栏：北、西、南三面（立柱、铁丝网、顶上一道铁丝）
  local function fence(ax, az, bx, bz)
    local a, b = V(ax, 0, az), V(bx, 0, bz)
    local len = (b - a).Magnitude
    local mid = (a + b) / 2
    local rot = CFrame.lookAt(mid, b)
    rot = rot - rot.Position
    local mesh = part(g, V(0.15, 5.2, len), base * CF(mid + V(0, 3.6, 0)) * rot, RGB(150, 156, 160), MAT.SmoothPlastic, nil, true)
    mesh.Transparency = 0.82
    part(g, V(0.2, 0.2, len), base * CF(mid + V(0, 6.3, 0)) * rot, RGB(70, 72, 76), MAT.Metal)
    local n = math.max(1, math.floor(len / 18))
    for k = 0, n do cyl(g, 6.4, 0.45, base * CF(a:Lerp(b, k / n) + V(0, 4.2, 0)), RGB(84, 86, 90), MAT.Metal, true) end
  end
  fence(x0, z1, x1, z1)
  fence(x0, z0, x0, z1)
  fence(x0, z0, x1, z0)
  -- 路灯（主路东边）
  for _, z in ipairs({ z0 + 18, -40, 20, z1 - 16 }) do
    local x = rx + 9.5
    cyl(g, 11, 0.5, base * CF(x, 6.5, z), RGB(70, 72, 76), MAT.Metal, true)
    part(g, V(3.2, 0.4, 0.9), base * CF(x - 1.3, 11.8, z), RGB(70, 72, 76), MAT.Metal)
    local bulb = part(g, V(1.2, 0.4, 0.8), base * CF(x - 2.4, 11.5, z), RGB(255, 236, 190), MAT.Neon)
    local pl = Instance.new("PointLight")
    pl.Brightness, pl.Range, pl.Color = 1.2, 28, RGB(255, 228, 180)
    pl.Parent = bulb
  end
  -- 门口的指示牌：工业区里能盖什么
  local board = part(g, V(0.6, 7, 14), base * CF(rx + 12, 6.5, gz + 16), RGB(36, 52, 40), MAT.SmoothPlastic, nil, true)
  for _, sx in ipairs({ -5.5, 5.5 }) do cyl(g, 6, 0.5, base * CF(rx + 12, 3, gz + 16 + sx), RGB(80, 82, 86), MAT.Metal, true) end
  local sg = Instance.new("SurfaceGui")
  sg.Face = Enum.NormalId.Right
  sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
  sg.PixelsPerStud = 24
  sg.LightInfluence = 0
  local t = Instance.new("TextLabel")
  t.Size = UDim2.fromScale(1, 1)
  t.BackgroundTransparency = 1
  t.Font = Enum.Font.GothamBold
  t.TextScaled = true
  t.TextColor3 = RGB(255, 236, 170)
  t.Text = "西 · 工业区\n油井 → 炼油厂（油井 ×1.5）\n弹药厂 → 钢铁厂 → 矿场\n核电站（工厂再 ×1.3）"
  t.Parent = sg
  sg.Parent = board
  -- 几堆管子、油桶
  for k = 0, 2 do part(g, V(16, 1.2, 1.2), base * CF(x0 + 30, 1.6 + k * 1.1, z1 - 14 + (k % 2) * 0.6), RGB(120, 124, 128), MAT.Metal, CYL, true) end
  for i = 0, 5 do cyl(g, 2.6, 1.8, base * CF(x0 + 52 + (i % 3) * 2.1, 2.3, z1 - 16 + math.floor(i / 3) * 2.1), (i % 2 == 0) and RGB(60, 84, 60) or RGB(160, 50, 40), MAT.Metal) end
  g.Parent = f
  return g
end

function Scenery.theater(plot, theater, Config)
  local F = Config.Field
  local th = THEME[theater] or THEME.grass
  local base = CF(plot.origin)
  local T = workspace.Terrain
  -- 地面零件换材质、颜色
  if plot.field then
    plot.field.Material = th.fmat
    plot.field.Color = th.field
  end
  -- 战场两边的地形换成这个战区的（草地 / 沙地 / 雪地 / 水泥 / 玄武岩）
  local z0, z1 = F.center - F.length / 2, F.center + F.length / 2
  for _, s in ipairs({ -1, 1 }) do
    T:FillBlock(CFrame.new(plot.origin + V(s * (F.width / 2 + 75), -1.5, F.center)), V(150, 3, F.length + 40), th.flank)
  end
  T:FillBlock(CFrame.new(plot.origin + V(0, -1.5, z1 + 40)), V(F.width + 300, 3, 70), th.flank)
  -- 装饰重摆
  local old = plot.folder:FindFirstChild("Decor")
  if old then old:Destroy() end
  local g = Instance.new("Folder")
  g.Name = "Decor"
  local rng = Random.new(plot.index * 1000 + #theater * 17)
  -- 中间的土路
  part(g, V(26, 0.1, F.length - 8), base * CF(0, 1.05, F.center), th.road, (theater == "urban") and MAT.Asphalt or MAT.Ground)
  if theater == "urban" then
    for k = 0, math.floor((F.length - 20) / 18) do part(g, V(0.8, 0.12, 8), base * CF(0, 1.1, z0 + 14 + k * 18), RGB(230, 220, 120), MAT.SmoothPlastic) end
  end
  -- 弹坑
  for _ = 1, 22 do
    local d = rng:NextNumber(8, 22)
    local x, z = rng:NextNumber(-F.width / 2 + 20, F.width / 2 - 20), rng:NextNumber(F.deploy[2] + 20, F.enemy[1] - 20)
    part(g, V(0.12, d, d), base * CF(x, 1.06, z) * UP, th.crater, MAT.Ground, CYL)
    part(g, V(0.4, d + 3, d + 3), base * CF(x, 1.02, z) * UP, th.ground, MAT.Ground, CYL)
  end
  -- 两条战壕（我方部署区前面、敌军区前面）、两道铁丝网、拒马
  local half = F.width / 2 - 12
  trench(g, base, F.deploy[2] + 14, 1, half, 18, rng, RGB(70, 58, 44):Lerp(th.crater, 0.4), RGB(176, 158, 112))
  trench(g, base, F.enemy[1] - 14, -1, half, 18, rng, RGB(70, 58, 44):Lerp(th.crater, 0.4), RGB(150, 136, 100))
  for _, z in ipairs({ F.deploy[2] + 110, F.enemy[1] - 110 }) do
    local x = -half
    while x < half do
      local x1 = math.min(half, x + rng:NextNumber(50, 90))
      wire(g, base, z, x, x1)
      x = x1 + rng:NextNumber(30, 50)
    end
  end
  for _ = 1, 14 do
    local x = rng:NextNumber(-half, half)
    local z = (rng:NextNumber() < 0.5) and (F.deploy[2] + rng:NextNumber(30, 60)) or (F.enemy[1] - rng:NextNumber(30, 60))
    hedgehog(g, base * CF(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0))
  end
  -- 中间地带的残骸（几辆冒烟）、沙袋机枪巢
  for i = 1, 9 do
    local x, z = rng:NextNumber(-half + 20, half - 20), rng:NextNumber(F.deploy[2] + 80, F.enemy[1] - 80)
    wreck(g, base * CF(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), rng, i <= 4)
  end
  for _ = 1, 6 do
    local x, z = rng:NextNumber(-half + 30, half - 30), rng:NextNumber(F.deploy[2] + 60, F.enemy[1] - 60)
    local c = base * CF(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
    for k = 1, 7 do   -- 一圈沙袋（缺一个口）
      local a = k / 8 * math.pi * 2
      part(g, V(3.6, 1.6, 1.4), c * CFrame.Angles(0, a, 0) * CF(0, 1.8, -4.4), RGB(176, 158, 112):Lerp(TH_TINT[theater] or RGB(176, 158, 112), 0.3), MAT.Fabric)
    end
    part(g, V(0.25, 0.25, 3), c * CF(0, 3, -4.6), RGB(40, 40, 40), MAT.Metal)
  end
  -- 两边（|x| > 190）的主题道具：废墟、树、主题特色
  local function flankPos()
    local s = (rng:NextNumber() < 0.5) and -1 or 1
    return s * rng:NextNumber(F.width / 2 - 62, F.width / 2 - 16), rng:NextNumber(z0 + 30, z1 - 30)
  end
  local style = ({ grass = "brick", desert = "adobe", snow = "cabin", urban = "concrete", volcano = "concrete" })[theater]
  for _ = 1, (theater == "urban") and 15 or 5 do
    local x, z = flankPos()
    ruin(g, base * CF(x, 0, z) * CFrame.Angles(0, rng:NextInteger(0, 3) * math.pi / 2, 0), rng, style)
  end
  for _ = 1, 26 do
    local x, z = flankPos()
    local p = (base * CF(x, 0.5, z)).Position
    if theater == "grass" then
      if rng:NextNumber() < 0.6 then broadleaf(g, p, rng, 0.9) else bush(g, p, rng) end
    elseif theater == "desert" then
      if rng:NextNumber() < 0.45 then palm(g, p, rng) else rock(g, p, rng, 1.4) end
    elseif theater == "snow" then
      if rng:NextNumber() < 0.7 then pine(g, p, rng, 1, true) else part(g, V(rng:NextNumber(6, 12), 3, rng:NextNumber(6, 12)), CF(p + V(0, 1, 0)), RGB(240, 244, 250), MAT.Snow, BALL) end
    elseif theater == "urban" then
      if rng:NextNumber() < 0.5 then   -- 路灯杆、水泥隔离墩
        cyl(g, 12, 0.5, CF(p + V(0, 6, 0)), RGB(80, 82, 86), MAT.Metal)
      else
        part(g, V(8, 2.6, 1.6), CF(p + V(0, 1.3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), RGB(170, 168, 160), MAT.Concrete, nil, true)
      end
    elseif theater == "volcano" then   -- 玄武岩柱、烧焦的树
      if rng:NextNumber() < 0.6 then
        local h = rng:NextNumber(8, 26)
        part(g, V(rng:NextNumber(4, 8), h, rng:NextNumber(4, 8)), CF(p + V(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.08, 0.08)), RGB(46, 42, 42), MAT.Basalt, nil, true)
      else
        cyl(g, 9, 0.9, CF(p + V(0, 4.5, 0)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), 0, 0), RGB(28, 24, 22), MAT.Wood)
      end
    end
  end
  -- 主题特色
  if theater == "grass" then   -- 草垛、木栅栏
    for _ = 1, 8 do
      local x, z = flankPos()
      part(g, V(4, 5, 5), base * CF(x, 3.5, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), RGB(214, 180, 90), MAT.Fabric, CYL)
    end
    for _ = 1, 5 do
      local x, z = flankPos()
      for k = 0, 5 do part(g, V(0.4, 3, 0.4), base * CF(x + k * 3, 2.5, z), RGB(120, 92, 60), MAT.Wood) end
      part(g, V(15, 0.4, 0.3), base * CF(x + 7.5, 3, z), RGB(120, 92, 60), MAT.Wood)
    end
  elseif theater == "desert" then   -- 帐篷、油桶
    for _ = 1, 5 do
      local x, z = flankPos()
      part(g, V(8, 4, 8), base * CF(x, 3, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), RGB(196, 176, 130), MAT.Fabric)
    end
  elseif theater == "urban" then   -- 烧毁的汽车
    for _ = 1, 10 do
      local x, z = flankPos()
      local c = base * CF(x * 0.85, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), rng:NextNumber(-0.1, 0.1))
      part(g, V(4.6, 1.6, 9), c * CF(0, 1.9, 0), RGB(48, 44, 40), MAT.CorrodedMetal)
      part(g, V(4.2, 1.4, 4.5), c * CF(0, 3.3, 0.5), RGB(40, 38, 36), MAT.CorrodedMetal)
    end
  elseif theater == "volcano" then   -- 熔岩池、熔岩裂缝（发光、有热光）、冒烟的地缝
    for _ = 1, 4 do
      local x, z = flankPos()
      local pool = part(g, V(0.3, rng:NextNumber(18, 30), rng:NextNumber(18, 30)), base * CF(x, 1.1, z) * UP, RGB(255, 100, 20), MAT.Neon, CYL)
      local pl = Instance.new("PointLight")
      pl.Color = RGB(255, 110, 30)
      pl.Brightness = 3
      pl.Range = 40
      pl.Parent = pool
      part(g, V(0.5, pool.Size.Y + 4, pool.Size.Z + 4), base * CF(x, 1.0, z) * UP, RGB(40, 34, 32), MAT.Basalt, CYL)
    end
    for _ = 1, 24 do
      local x, z = rng:NextNumber(-half, half), rng:NextNumber(z0 + 30, z1 - 30)
      if math.abs(x) > 40 then
        local crack = part(g, V(rng:NextNumber(1.2, 2.4), 0.16, rng:NextNumber(14, 34)), base * CF(x, 1.08, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), RGB(255, 110, 30), MAT.Neon)
        if rng:NextNumber() < 0.35 then
          local pl = Instance.new("PointLight")
          pl.Color = RGB(255, 120, 40)
          pl.Brightness = 2
          pl.Range = 24
          pl.Parent = crack
          local s = Instance.new("Smoke")
          s.Color = RGB(60, 56, 54)
          s.Opacity = 0.15
          s.RiseVelocity = 5
          s.Size = 4
          s.Parent = crack
        end
      end
    end
  end
  -- 部署区四角的旗子（队伍色）、敌军区四角红旗
  for _, e in ipairs({ { F.deploy[1], plot.color }, { F.deploy[2], plot.color }, { F.enemy[1], RGB(200, 50, 45) }, { F.enemy[2], RGB(200, 50, 45) } }) do
    for _, s in ipairs({ -1, 1 }) do
      cyl(g, 14, 0.4, base * CF(s * (F.width / 2 - 4), 8, e[1]), RGB(170, 170, 170), MAT.Metal)
      part(g, V(0.15, 3, 5), base * CF(s * (F.width / 2 - 4), 13.4, e[1] + 2.6), e[2], MAT.Fabric)
    end
  end
  g.Parent = plot.folder
  plot.theater = theater
  plot.folder:SetAttribute("Theater", theater)   -- 客户端按它下天气、换天色
  return g
end

return Scenery
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000D">
<Properties>
<string name="Name">Skills</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：战场支援技能（打仗时玩家自己放的：迫击炮急袭、战地急救、炮火覆盖、空投援军、空袭、巡航导弹；盖了雷达站冷却快两成）
-- 客户端点技能键、再点战场上的位置 → Action "skill"（id，x，z：相对战场原点）；服务器检查盖没盖那栋楼、冷却、在不在打仗，再放；
-- 伤害、援军强度跟着全军战力（军工科技 × 重生）走；冷却每一仗开打时清零
local Skills = {}

function Skills.init(G)
  local Config, Battle = G.Config, G.Battle
  local V = Vector3.new
  local F = Config.Field
  local RB = G.R.Battle

  -- 这个玩家有哪些技能、各还要冷却几秒（跟着状态发给客户端画技能栏）
  function G.skillInfo(st)
    local d = st.data
    local out = {}
    local now = os.clock()
    st.skillCD = st.skillCD or {}
    for _, sk in ipairs(Config.Skills) do
      if d.owned[sk.need] then
        table.insert(out, { id = sk.id, left = math.max(0, math.ceil((st.skillCD[sk.id] or 0) - now)) })
      end
    end
    return out
  end
  function G.skillsReset(st)
    st.skillCD = {}
  end

  -- 支援炮弹从己方后方远处打过来（客户端画弧线）；空袭从己方一侧飞过来
  local function rear(B, team, x)
    local z = (team == 1) and (F.deploy[1] - 160) or (F.enemy[2] + 160)
    return B.origin + V(x + math.random(-80, 80), 60, z)
  end

  function G.useSkill(st, id, x, z)
    local B = st.battle
    local sk = type(id) == "string" and Config.SkillById[id]
    if not sk or not B or B.over then return end
    if type(x) ~= "number" or type(z) ~= "number" or x ~= x or z ~= z then return end
    if not st.data.owned[sk.need] then
      G.toast(st, "先盖「" .. Config.BuildingById[sk.need].name .. "」才有「" .. sk.name .. "」", "bad")
      return
    end
    st.skillCD = st.skillCD or {}
    local now = os.clock()
    if now < (st.skillCD[id] or 0) then return end
    local cd = Config.SkillCD(sk, st.data.owned)
    st.skillCD[id] = now + cd
    local team = B.teamOf[st.pl] or 1
    x = math.clamp(x, -Battle.XMAX, Battle.XMAX)
    z = math.clamp(z, Battle.ZMIN, Battle.ZMAX)
    local power = G.powerOf(st.data)
    local src = { team = team, player = st.pl, skill = id }
    local dir = (team == 1) and 1 or -1   -- 进攻方向：第 1 队往 +Z 打
    if sk.kind == "barrage" then
      local def = { dmg = sk.dmg, splash = sk.splash, vsArmor = sk.vsArmor, vsInf = sk.vsInf, vsAir = 0, fxu = (id == "mortar") and "mortar" or "heavyarty" }
      local gap = (id == "mortar") and 0.18 or 0.22
      for i = 1, sk.n do
        task.delay((i - 1) * gap, function()
          if B.over then return end
          Battle.strike(B, team, def, power, x, z, sk.r, sk.flight + math.random() * 0.5, "shell", src, rear(B, team, x))
        end)
      end
    elseif sk.kind == "strike" then
      local def = { dmg = sk.dmg, splash = sk.splash, vsArmor = sk.vsArmor, vsInf = sk.vsInf, vsAir = 0, fxu = "bomber" }
      local z0 = z - dir * sk.len / 2
      G.fx({ k = "flyover", a = B.origin + V(x, 95, z0 - dir * 420), b = B.origin + V(x, 95, z0 + dir * (sk.len + 420)), t = 4.2, jet = true })
      for i = 1, sk.n do
        local bz = z0 + dir * (i - 1) * sk.len / math.max(1, sk.n - 1)
        task.delay(1.55 + (i - 1) * 0.11, function()
          if B.over then return end
          Battle.strike(B, team, def, power, x + math.random(-6, 6), bz, 4, 1.1, "bomb", src, B.origin + V(x, 92, bz - dir * 30))
        end)
      end
    elseif sk.kind == "missile" then   -- 巡航导弹：发射井的井盖拉开、冒烟，导弹从工业区升空，划一道高弧线落到目标
      local def = { dmg = sk.dmg, splash = sk.splash, vsArmor = sk.vsArmor, vsInf = sk.vsInf, vsAir = 0, fxu = "cruise" }
      local sb = Config.BuildingById.silo
      local pad = st.plot.origin + V(sb.x, 1, sb.z)
      G.fx({ k = "silo", p = pad })
      task.delay(1.0, function()
        if B.over then return end
        Battle.strike(B, team, def, power, x, z, 0, sk.flight, "cruise", src, pad + V(0, 6, 0))
      end)
    elseif sk.kind == "heal" then
      local r2 = sk.r * sk.r
      local n = 0
      for _, u in ipairs(B.units) do
        if u.alive and u.team == team then
          local dx, dz = u.x - x, u.z - z
          if dx * dx + dz * dz <= r2 then
            if u.hero then
              local hum = u.model and u.model:FindFirstChildOfClass("Humanoid")
              if hum and hum.Health > 0 then hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * sk.pct) end
            else
              u.hp = math.min(u.max, u.hp + u.max * sk.pct)
              B.cb.hurt(u)
            end
            n = n + 1
          end
        end
      end
      G.fx({ k = "heal", p = B.origin + V(x, 1, z), s = sk.r })
      G.toast(st, "战地急救：" .. n .. " 个单位回了血", (n > 0) and "good" or "info")
    elseif sk.kind == "drop" then
      local folder = st.plot and st.plot.Units
      local h = (team == 1) and math.pi or 0
      G.fx({ k = "flyover", a = B.origin + V(x - 60, 70, z - dir * 380), b = B.origin + V(x + 60, 70, z + dir * 380), t = 3.2, heli = true })
      local spawnSrc = { owner = st, team = team, h = h, dm = power, model = { Parent = folder } }
      for i = 1, sk.squads do
        task.delay(1.4 + i * 0.25, function()
          if B.over or not B.cb.spawn then return end
          local a = (i / sk.squads) * math.pi * 2
          local px = math.clamp(x + math.cos(a) * 12, -Battle.XMAX, Battle.XMAX)
          local pz = math.clamp(z + math.sin(a) * 12, Battle.ZMIN, Battle.ZMAX)
          local bu = B.cb.spawn(spawnSrc, "inf", px, pz)
          if bu then
            bu.owner = st
            table.insert(B.units, bu)   -- 不在推演那一步里：直接加
            G.fx({ k = "drop", p = B.origin + V(px, 1, pz), s = 1 })
          end
        end)
      end
    end
    RB:FireClient(st.pl, { phase = "skill", id = id, cd = cd })
    G.progress(st, "skill", 1)
  end
end

return Skills
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000E">
<Properties>
<string name="Name">Store</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：存档（DataStore）、突袭用的防线快照、积分匹配、排行榜（最高关卡、突袭积分、对战积分）、被突袭记录
-- 读档失败的玩家不存档（别拿新档盖掉老进度）；所有 DataStore 调用都包在 pcall 里（Studio 没开 API 访问时整个存档功能关掉，照样能玩）
local DSS = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Store = {}

function Store.init(G)
  local Config = G.Config
  local UNITS, BDEF = Config.Units, Config.BuildingById

  local function ds(name, ordered)
    local ok, res = pcall(function()
      if ordered then return DSS:GetOrderedDataStore(name) end
      return DSS:GetDataStore(name)
    end)
    if ok then return res end
    warn("[军事大亨] DataStore 不可用（" .. name .. "）：" .. tostring(res))
    return nil
  end
  local main = ds(Config.SaveKey)
  local defense = ds("MilitaryTycoon_def_v1")
  local raidlog = ds("MilitaryTycoon_raidlog_v1")
  local byRating = ds("MilitaryTycoon_rating_v1", true)
  local byLevel = ds("MilitaryTycoon_level_v1", true)
  local byPvp = ds("MilitaryTycoon_pvp_v1", true)

  function G.newData()
    return {
      cash = Config.StartCash, level = 1, best = 1, owned = {}, lv = {}, hq = 0, tech = 0, army = {}, wins = 0,
      rebirth = 0, xp = 0, kills = 0, weapons = { rifle = true }, rating = Config.Raid.start, raidWins = 0, duelWins = 0,
      pvp = Config.Match.start, pvpWins = 0, pvpGames = 0,
      daily = { day = 0, streak = 0 }, missions = { day = 0, list = {} },
    }
  end

  local function num(v, lo, hi, def)
    if type(v) ~= "number" or v ~= v then return def end
    if lo then v = math.max(lo, v) end
    if hi then v = math.min(hi, v) end
    return v
  end

  -- 读到的存档逐项检查（坏数据、老版本的存档、改过的配置都别让脚本出错）
  function G.cleanData(raw)
    local d = G.newData()
    if type(raw) ~= "table" then return d end
    d.cash = num(raw.cash, 0, nil, d.cash)
    d.level = math.floor(num(raw.level, 1, nil, 1))
    d.best = math.max(d.level, math.floor(num(raw.best, 1, nil, 1)))
    d.wins = num(raw.wins, 0, nil, 0)
    d.tech = math.floor(num(raw.tech, 0, Config.Tech.max, 0))
    d.rebirth = math.floor(num(raw.rebirth, 0, Config.Rebirth.max, 0))
    d.xp = math.floor(num(raw.xp, 0, nil, 0))
    d.kills = math.floor(num(raw.kills, 0, nil, 0))
    d.rating = math.floor(num(raw.rating, 0, nil, Config.Raid.start))
    d.raidWins = math.floor(num(raw.raidWins, 0, nil, 0))
    d.duelWins = math.floor(num(raw.duelWins, 0, nil, 0))
    d.pvp = math.floor(num(raw.pvp, 0, nil, Config.Match.start))
    d.pvpWins = math.floor(num(raw.pvpWins, 0, nil, 0))
    d.pvpGames = math.max(d.pvpWins, math.floor(num(raw.pvpGames, 0, nil, 0)))
    if type(raw.owned) == "table" then
      for id, v in pairs(raw.owned) do   -- 没开放的新区域里的楼不认（重生次数不够）
        if BDEF[id] and v and Config.AreaOpen(BDEF[id], d.rebirth) then d.owned[id] = true end
      end
    end
    if type(raw.lv) == "table" then   -- 建筑级数：只认盖了的、有收入的
      for id, v in pairs(raw.lv) do
        local b = BDEF[id]
        if b and b.income and d.owned[id] and type(v) == "number" then d.lv[id] = math.floor(num(v, 1, Config.Upgrade.max, 1)) end
      end
    end
    d.hq = math.floor(num(raw.hq, 0, #BDEF.hq.cap, 0))
    if d.owned.hq then d.hq = math.max(1, d.hq) else d.hq = 0 end
    if type(raw.army) == "table" then
      for _, a in ipairs(raw.army) do
        if type(a) == "table" and UNITS[a.t] and not UNITS[a.t].boss and type(a.x) == "number" and type(a.z) == "number" then
          table.insert(d.army, { t = a.t, x = a.x, z = a.z, v = math.floor(num(a.v, 0, 1000, 0)) })
        end
      end
    end
    if type(raw.weapons) == "table" then
      for id, v in pairs(raw.weapons) do
        if Config.Weapons[id] and v then d.weapons[id] = true end
      end
    end
    if type(raw.daily) == "table" then
      d.daily.day = math.floor(num(raw.daily.day, 0, nil, 0))
      d.daily.streak = math.floor(num(raw.daily.streak, 0, Config.Daily.max, 0))
    end
    if type(raw.missions) == "table" and type(raw.missions.list) == "table" then
      d.missions.day = math.floor(num(raw.missions.day, 0, nil, 0))
      for _, m in ipairs(raw.missions.list) do
        if type(m) == "table" and type(m.id) == "string" then
          table.insert(d.missions.list, { id = m.id, prog = num(m.prog, 0, nil, 0), claimed = m.claimed == true })
        end
      end
    end
    d.t = num(raw.t, 0, nil, nil)
    return d
  end

  local function armyList(st)
    local army = {}
    for _, u in pairs(st.units) do
      table.insert(army, { t = u.t, x = math.floor(u.sx * 10 + 0.5) / 10, z = math.floor(u.sz * 10 + 0.5) / 10, v = u.v or 0 })
    end
    return army
  end

  local function serialize(st)
    local d = st.data
    local owned, weapons, lv = {}, {}, {}
    for id in pairs(d.owned) do owned[id] = true end
    for id, v in pairs(d.lv or {}) do if v > 1 then lv[id] = v end end
    for id in pairs(d.weapons) do weapons[id] = true end
    local ml = {}
    for _, m in ipairs(d.missions.list) do table.insert(ml, { id = m.id, prog = m.prog, claimed = m.claimed }) end
    return {
      v = 2, cash = math.floor(d.cash), level = d.level, best = d.best, owned = owned, lv = lv, hq = d.hq, tech = d.tech, army = armyList(st),
      wins = d.wins or 0, rebirth = d.rebirth, xp = d.xp, kills = d.kills, weapons = weapons, rating = d.rating,
      raidWins = d.raidWins, duelWins = d.duelWins, pvp = d.pvp, pvpWins = d.pvpWins, pvpGames = d.pvpGames, daily = { day = d.daily.day, streak = d.daily.streak },
      missions = { day = d.missions.day, list = ml }, t = os.time(),
    }
  end

  -- 存档；同时更新防线快照（别人突袭打的就是它）和排行榜
  function G.save(st)
    if not main or not st.canSave or not st.data then return end
    local data = serialize(st)
    local key = "u" .. st.pl.UserId
    local ok, err = pcall(function() main:SetAsync(key, data) end)
    if ok then
      st.savedAt = os.time()   -- 界面上显示「已自动保存」
    else
      warn("[军事大亨] 存档失败：" .. tostring(err))
    end
    if #data.army > 0 and defense then
      pcall(function()
        defense:SetAsync(key, { name = st.pl.DisplayName, level = data.level, tech = data.tech, rebirth = data.rebirth, rating = data.rating, army = data.army, t = data.t })
      end)
    end
    if byRating then pcall(function() byRating:SetAsync(key, math.floor(data.rating)) end) end
    if byLevel then pcall(function() byLevel:SetAsync(key, math.floor(data.best)) end) end
    if byPvp and data.pvpGames > 0 then pcall(function() byPvp:SetAsync(key, math.floor(data.pvp)) end) end
  end

  function G.loadData(pl)
    if not main then return nil, false end
    for _ = 1, 3 do
      local ok, res = pcall(function() return main:GetAsync("u" .. pl.UserId) end)
      if ok then return res, true end
      warn("[军事大亨] 读档失败：" .. tostring(res))
      task.wait(1.5)
    end
    return nil, false
  end

  -- 突袭找对手：积分差不多的玩家里随机挑一个（不在线也行），读他的防线快照；找不到返回 nil（调用方换成 AI 指挥官）
  function G.findOpponent(st)
    if not byRating or not defense then return nil end
    local r = st.data.rating
    local R = Config.Raid.range
    local ok, page = pcall(function() return byRating:GetSortedAsync(false, 50, math.max(0, r - R), r + R) end)
    if not ok or not page then return nil end
    local list = {}
    local ok2, items = pcall(function() return page:GetCurrentPage() end)
    if not ok2 or type(items) ~= "table" then return nil end
    for _, it in ipairs(items) do
      if it.key ~= "u" .. st.pl.UserId then table.insert(list, it.key) end
    end
    for _ = 1, 3 do
      if #list == 0 then return nil end
      local k = table.remove(list, math.random(1, #list))
      local ok3, snap = pcall(function() return defense:GetAsync(k) end)
      if ok3 and type(snap) == "table" and type(snap.army) == "table" and #snap.army >= Config.Raid.minUnits then
        local army = {}
        for _, a in ipairs(snap.army) do
          if type(a) == "table" and UNITS[a.t] and not UNITS[a.t].boss and type(a.x) == "number" and type(a.z) == "number" then
            table.insert(army, { t = a.t, x = a.x, z = a.z, v = math.floor(num(a.v, 0, 1000, 0)) })
          end
          if #army >= Config.MaxEnemy then break end
        end
        if #army > 0 then
          return {
            key = k, name = tostring(snap.name or "某位指挥官"), level = math.floor(num(snap.level, 1, nil, 1)),
            tech = math.floor(num(snap.tech, 0, Config.Tech.max, 0)), rebirth = math.floor(num(snap.rebirth, 0, nil, 0)),
            rating = math.floor(num(snap.rating, 0, nil, Config.Raid.start)), army = army,
          }
        end
      end
    end
    return nil
  end

  -- 被突袭记录：记到防守方名下，他上线时看得到
  function G.logRaid(defKey, entry)
    if not raidlog or type(defKey) ~= "string" then return end
    task.spawn(function()
      pcall(function()
        raidlog:UpdateAsync(defKey, function(old)
          local list = type(old) == "table" and old or {}
          table.insert(list, 1, entry)
          while #list > 10 do table.remove(list) end
          return list
        end)
      end)
    end)
  end
  function G.readRaidLog(pl)
    if not raidlog then return nil end
    local key = "u" .. pl.UserId
    local ok, list = pcall(function() return raidlog:GetAsync(key) end)
    if not ok or type(list) ~= "table" or #list == 0 then return nil end
    pcall(function() raidlog:SetAsync(key, {}) end)
    return list
  end

  -- 排行榜：三个榜各取前 10（名字按 UserId 查，查过的记住）
  local names = {}
  local function nameOf(key)
    if names[key] then return names[key] end
    local id = tonumber(string.sub(key, 2))
    local n = "玩家" .. tostring(id or "?")
    if id then
      local ok, res = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
      if ok and res then n = res end
    end
    names[key] = n
    return n
  end
  local function top(store)
    if not store then return {} end
    local ok, page = pcall(function() return store:GetSortedAsync(false, 10) end)
    if not ok or not page then return {} end
    local ok2, items = pcall(function() return page:GetCurrentPage() end)
    if not ok2 or type(items) ~= "table" then return {} end
    local out = {}
    for i, it in ipairs(items) do out[i] = { name = nameOf(it.key), value = it.value } end
    return out
  end
  function G.readBoards()
    return top(byLevel), top(byRating), top(byPvp)
  end
  G.storeOK = main ~= nil
end

return Store
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000F">
<Properties>
<string name="Name">Weapons</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：玩家本人的武器（背包里的枪）：发枪、开枪（服务器校验射速、弹匣、射程，射线判定打中谁）、
-- 火箭筒弹道和溅射；打仗时打敌方单位，约战时也能打对面的玩家本人；不在打仗时开枪只有特效
local Weapons = {}

function Weapons.init(G)
  local Config, Models, Battle = G.Config, G.Models, G.Battle
  local V = Vector3.new
  local TOOLS = {}
  for _, id in ipairs(Config.WeaponOrder) do TOOLS[id] = Models.tool(id) end

  -- 背包里补上买了的枪（每次复活都要发）
  function G.giveTools(st)
    local pl = st.pl
    local bp = pl:FindFirstChild("Backpack")
    if not bp or not st.data then return end
    local have = {}
    local char = pl.Character
    for _, holder in ipairs({ bp, char }) do
      if holder then
        for _, c in ipairs(holder:GetChildren()) do
          if c:IsA("Tool") then have[c:GetAttribute("Weapon") or ""] = true end
        end
      end
    end
    for _, id in ipairs(Config.WeaponOrder) do
      if st.data.weapons[id] and not have[id] then TOOLS[id]:Clone().Parent = bp end
    end
  end

  local function ammoOf(st, id)
    st.ammo = st.ammo or {}
    local a = st.ammo[id]
    if not a then
      a = { n = Config.Weapons[id].mag, r = 0 }
      st.ammo[id] = a
    end
    if a.r > 0 and os.clock() >= a.r then
      a.n = Config.Weapons[id].mag
      a.r = 0
    end
    return a
  end

  function G.reload(st, id)
    local w = Config.Weapons[id]
    if not w then return end
    local a = ammoOf(st, id)
    if a.r > 0 or a.n >= w.mag then return end
    a.r = os.clock() + w.reload
  end

  -- 打中的零件属于哪个战斗单位（单位模型、玩家角色上都有 BU 属性）
  local function unitOf(B, inst)
    local m = inst
    while m and m ~= workspace do
      if m:IsA("Model") then
        local bid = m:GetAttribute("BU")
        if bid then return B.byId[bid] end
      end
      m = m.Parent
    end
    return nil
  end

  local function hitUnit(B, st, team, w, inst)
    local bu = unitOf(B, inst)
    if not bu or not bu.alive or bu.team == team then return end
    if bu.hero then   -- 约战：打到对面的玩家本人
      local hum = bu.model and bu.model:FindFirstChildOfClass("Humanoid")
      if hum and hum.Health > 0 then
        hum:TakeDamage(w.dmg * (w.pvp or 1))
        if hum.Health <= 0 then G.addXP(st, 10) end
      end
      return
    end
    Battle.damage(B, bu, w.dmg * Battle.mult(w, bu.def), { team = team, player = st.pl })
  end

  -- 火箭弹落地：地面单位（和玩家本人）按溅射，直升机要打得够近
  local function explode(B, st, team, w, pos)
    if B.over then return end
    local rel = pos - B.origin
    local src = { team = team, player = st.pl }
    Battle.splash(B, team, w, rel.X, rel.Z, w.splash, w.dmg, nil, src)
    for _, bu in ipairs(B.units) do
      if bu.alive and bu.team ~= team and bu.def.air then
        local p = B.origin + V(bu.x, 1 + bu.y + 3, bu.z)
        if (p - pos).Magnitude < bu.def.size * 0.6 + 4 then Battle.damage(B, bu, w.dmg * Battle.mult(w, bu.def), src) end
      end
    end
    G.fx({ k = "boom", p = pos, s = 1.2 })
  end

  local params = RaycastParams.new()
  params.FilterType = Enum.RaycastFilterType.Exclude

  function G.shoot(st, id, aim)
    local w = Config.Weapons[id]
    if not w or not st.ready or not st.data.weapons[id] or typeof(aim) ~= "Vector3" or aim.X ~= aim.X then return end
    local char = st.pl.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local head = char and char:FindFirstChild("Head")
    if not hum or hum.Health <= 0 or not head or st.driving then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or tool:GetAttribute("Weapon") ~= id then return end
    local now = os.clock()
    st.lastShot = st.lastShot or {}
    if now - (st.lastShot[id] or 0) < w.rate * 0.8 then return end
    local a = ammoOf(st, id)
    if a.r > 0 or a.n <= 0 then return end
    st.lastShot[id] = now
    a.n = a.n - 1
    if a.n <= 0 then a.r = now + w.reload end
    local origin = head.Position
    local dir = aim - origin
    if dir.Magnitude < 0.5 then return end
    dir = dir.Unit
    if w.spread > 0 then
      local s = math.rad(w.spread)
      dir = (dir + V((math.random() - 0.5) * 2 * s, (math.random() - 0.5) * 2 * s, (math.random() - 0.5) * 2 * s)).Unit
    end
    params.FilterDescendantsInstances = { char }
    local res = workspace:Raycast(origin, dir * w.range, params)
    local hitPos = res and res.Position or (origin + dir * w.range)
    local handle = tool:FindFirstChild("Handle")
    local mz = handle and handle:FindFirstChild("Muzzle")
    local muzzle = mz and mz.WorldPosition or origin
    local flight = nil
    if w.proj then flight = (hitPos - muzzle).Magnitude / w.speed end
    G.fx({ k = "gun", w = id, a = muzzle, b = hitPos, by = st.pl.UserId, t = flight })
    local B = st.battle
    if not B or B.over then return end
    local team = B.teamOf[st.pl]
    if w.proj then
      task.delay(flight, function() explode(B, st, team, w, hitPos) end)
    elseif res then
      hitUnit(B, st, team, w, res.Instance)
    end
  end
end

return Weapons
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000010">
<Properties>
<string name="Name">World</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：地图（光影、地形世界、六块基地、约战竞技场；场景细节在 Scenery 里）
local World = {}

function World.init(G)
  local Config, Models = G.Config, G.Models
  local Scenery = require(script.Parent:WaitForChild("Scenery"))
  G.Scenery = Scenery
  local V = Vector3.new

  Scenery.lighting()
  -- 地形：一整层草地（顶面 y = 0），基地之间的山丘、四周的雪山、湖、河；树林、桥
  local groundY, info = Scenery.terrain(Config)
  G.mapInfo = info
  G.try("种树", Scenery.nature, workspace, Config, groundY, info)

  local PlotsF = Instance.new("Folder")
  PlotsF.Name = "Plots"
  PlotsF.Parent = workspace
  G.plots = {}
  for i = 1, Config.PlotCount do
    local cx = (i - (Config.PlotCount + 1) / 2) * Config.PlotSpacing
    local f = Instance.new("Folder")
    f.Name = "Plot" .. i
    local plot = { index = i, origin = V(cx, 0, 0), folder = f, color = Config.PlotColors[i] or Color3.new(1, 1, 1) }
    local info = Models.plot(f, plot.origin, plot.color, i)
    plot.field = info.field
    plot.sign = info.sign
    plot.board = info.board
    for _, name in ipairs({ "Buildings", "Pads", "Units", "Enemies", "Drops", "Areas" }) do
      local sub = Instance.new("Folder")
      sub.Name = name
      sub.Parent = f
      plot[name] = sub
    end
    G.try("基地外围", Scenery.base, f, plot.origin, plot.color, Config)
    G.try("工业区", Scenery.industry, f, plot.origin, Config)
    G.try("战区", Scenery.theater, plot, "grass", Config)
    f.Parent = PlotsF
    G.plots[i] = plot
  end

  local ArenasF = Instance.new("Folder")
  ArenasF.Name = "Arenas"
  ArenasF.Parent = workspace
  G.arenas = {}
  for i, ax in ipairs(Config.Arena.xs) do
    local f = Instance.new("Folder")
    f.Name = "Arena" .. i
    local origin = V(ax, 0, Config.Arena.z)
    local info = Models.arena(f, origin, i)
    local units = Instance.new("Folder")
    units.Name = "Units"
    units.Parent = f
    -- 竞技场也有战区样子：1 号城市废墟、2 号沙漠
    G.try("竞技场战区", Scenery.theater, { origin = origin, folder = f, field = info.field, index = 20 + i, color = Color3.fromRGB(60, 140, 230) }, (i == 1) and "urban" or "desert", Config)
    f.Parent = ArenasF
    G.arenas[i] = { index = i, origin = origin, folder = f, field = info.field, Units = units, busy = false }
  end

  -- 换战区：这块战场的地面、两边地形、道具全换（打掉首领、进新战区时；进服按关卡）
  function G.setTheater(st, th)
    if st.plot.theater == th.id then return false end
    G.try("换战区", Scenery.theater, st.plot, th.id, Config)
    return true
  end

  -- 单位的位置：战场原点 + (x, 1 + y, z)，朝向 h
  function G.unitCF(origin, x, y, z, h)
    return CFrame.new(origin + V(x, 1 + y, z)) * CFrame.Angles(0, h, 0)
  end
end

return World
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX0000000000000000000000000000001C">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX0000000000000000000000000000001B">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="LocalScript" referent="RBX0000000000000000000000000000001A">
<Properties>
<string name="Name">Client</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：客户端（StarterPlayerScripts.Client）
-- 各模块共用一个上下文 G：Fx 特效与音效 · View 部队平滑显示 · UI 界面 · Guide 地图指引 · Anim 建筑动画 · Weather 战区天气 · Play 操作和镜头
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local G = { Config = require(RS:WaitForChild("Config")), R = {}, S = nil }
local Remotes = RS:WaitForChild("Remotes")
for _, name in ipairs({ "State", "Toast", "Action", "Fx", "Battle", "Shoot", "Drive", "Duel", "Board", "Err" }) do
  G.R[name] = Remotes:WaitForChild(name)
end

for _, name in ipairs({ "Fx", "View", "UI", "Guide", "Anim", "Weather", "Play" }) do
  require(script:WaitForChild(name)).init(G)
end

-- 一直收不到服务器的数据：多半是服务器脚本卡住或出错了，提示一下（不然只看到一片草地，不知道怎么回事）
task.delay(20, function()
  if not G.S then
    G.toast("等了 20 秒还没收到服务器的数据：服务器脚本可能卡住或出错了。请打开 Output（输出）窗口，把红色的字截图发给开发者", "bad")
  end
end)

-- 出错都写在屏幕上方的红条里：服务器接住的错、本地脚本的错
G.R.Err.OnClientEvent:Connect(function(msg) G.showError("服务器 " .. tostring(msg)) end)
pcall(function()
  game:GetService("ScriptContext").Error:Connect(function(msg, trace, scr)
    local where = scr and scr:GetFullName() or ""
    local line = trace and string.match(trace, "[^\n]+") or ""
    G.showError("本地 " .. tostring(msg) .. ((line ~= "") and ("  @ " .. line) or (where ~= "" and ("  @ " .. where) or "")))
  end)
end)

-- 远程事件的处理：一个出错不影响别的（错误照样会上红条）
local function safe(f)
  return function(...)
    local ok, err = pcall(f, ...)
    if not ok then G.showError("本地 " .. tostring(err)) end
  end
end
G.R.State.OnClientEvent:Connect(safe(function(s)
  if type(s) ~= "table" then return end
  G.S = s
  G.refresh()
end))
G.R.Toast.OnClientEvent:Connect(safe(function(msg, kind) G.toast(msg, kind) end))
G.R.Fx.OnClientEvent:Connect(safe(function(list) G.onFx(list) end))
G.R.Battle.OnClientEvent:Connect(safe(function(ev) G.onBattle(ev) end))
G.R.Duel.OnClientEvent:Connect(safe(function(ev) G.onDuelInvite(ev) end))
G.R.Board.OnClientEvent:Connect(safe(function(d) G.onBoard(d) end))

-- 每帧：各步分开接住错误（一步出错只报一次，别的照常跑，不会整个画面卡住）
local steps = { { "部队显示", function(dt) G.stepView(dt) end }, { "操作镜头", function(dt) G.stepPlay(dt) end }, { "特效", function() G.stepFx() end },
  { "界面", function(dt) G.stepUI(dt) end }, { "地图指引", function(dt) G.stepGuide(dt) end }, { "建筑动画", function(dt) G.stepAnim(dt) end },
  { "天气", function(dt) G.stepWeather(dt) end } }
RunService.RenderStepped:Connect(function(dt)
  for _, s in ipairs(steps) do
    local ok, err = pcall(s[2], dt)
    if not ok then G.showError("本地 " .. s[1] .. "：" .. tostring(err)) end
  end
end)
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000013">
<Properties>
<string name="Name">Anim</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨（客户端）：建筑动画（都在本地播，不占网络）——
--   新盖的楼（模型属性 BuiltAt 是刚才）：零件从地下按高度一层层升上来，四角搭着脚手架、落地扬尘；
--   零件属性 Anim = "spin" 的绕竖轴转（雷达；有 Ax 就绕这根轴转，比如抽油机的曲柄），"blink" 的一闪一闪（指示灯、跑道灯），
--   "nod" 的绕 Piv 点、Ax 轴来回摆 Amp 度（做俯卧撑的兵、抽油机的驴头）；spin 有 Piv 的绕那个点转（抽油机的配重）；
--   "belt" 的零件当传送带 / 铁轨：本地摆 N 个弹药箱 / 矿车，沿零件的 X 方向以 Spd 格每秒一直往前走（弹药厂、矿场）；
--   买得起的绿色购买按钮一呼一吸，隔一会儿冒一圈光；
--   机场跑道头停着的战斗机隔一会儿滑跑起飞、飞向战场，过一阵从南边进场降落、滑回停机位；直升机场的直升机起飞绕一圈落回来
--   （建筑里叫 Show 的模型，服务器上一直停着，只在本地动）
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Anim = {}

function Anim.init(G)
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local cam = workspace.CurrentCamera
  local spinning = {}   -- [part] = { cf0, spd, model }
  local blinking = {}   -- [part] = { spd, tr0 }
  local nodding = {}    -- [part] = { cf0, piv, ax, amp, spd, ph, model }
  local belts = {}      -- [part] = { cf0, len, h, spd, n, item, model, items }
  local pads = {}       -- [pad] = true
  local busy = {}       -- [model] = 升起动画放完的时刻（这之前不转）
  local GREEN = RGB(70, 220, 100)

  local function beltItem(kind)
    local parts = {}
    local function add(size, off, color, mat, shape)
      local p = G.fxPart(shape, size, CFrame.new(), color, mat, 0)
      p.CastShadow = true
      table.insert(parts, { p = p, off = off })
    end
    if kind == "cart" then
      add(V(2.8, 1.4, 2.0), CFrame.new(0, 1.0, 0), RGB(70, 72, 78), Enum.Material.Metal)
      add(V(2.4, 0.5, 1.6), CFrame.new(0, 1.9, 0), RGB(96, 80, 64), Enum.Material.Pebble)
      for _, sx in ipairs({ -0.9, 0.9 }) do add(V(2.2, 0.7, 0.7), CFrame.new(sx, 0.35, 0) * CFrame.Angles(0, math.pi / 2, 0), RGB(36, 36, 38), Enum.Material.Metal, Enum.PartType.Cylinder) end
    else
      add(V(1.6, 1.1, 1.5), CFrame.new(0, 0.55, 0), RGB(78, 92, 58), Enum.Material.Metal)
      add(V(1.62, 0.22, 1.52), CFrame.new(0, 0.75, 0), RGB(236, 196, 50), Enum.Material.SmoothPlastic)
    end
    return parts
  end

  ---------------------------------------------------------------- 起降表演
  local shows = {}   -- [Show 模型] = { kind, root, cf0 停放位置, bm 所在建筑, t, rot 旋翼转角, rotor, tail, axis, parts, hidden }
  local function addShow(sm, bm)
    if shows[sm] then return end
    local root = sm:FindFirstChild("Root")
    if not root then return end
    local parts = {}
    for _, d in ipairs(sm:GetDescendants()) do
      if d:IsA("BasePart") then table.insert(parts, d) end
    end
    local tail = sm:FindFirstChild("TailMotor", true)
    shows[sm] = { kind = sm:GetAttribute("Show"), root = root, cf0 = root.CFrame, bm = bm, t = math.random() * 15, rot = 0,
      rotor = sm:FindFirstChild("RotorMotor", true), tail = tail, axis = tail and tail:GetAttribute("Axis") or V(1, 0, 0), parts = parts, hidden = false }
  end

  local function register(m)
    for _, d in ipairs(m:GetDescendants()) do
      if d:IsA("BasePart") then
        local a = d:GetAttribute("Anim")
        if a == "spin" then
          spinning[d] = { cf0 = d.CFrame, spd = d:GetAttribute("Spd") or 0.3, model = m, ax = d:GetAttribute("Ax"), piv = d:GetAttribute("Piv") }
        elseif a == "blink" then
          blinking[d] = { spd = d:GetAttribute("Spd") or 1, tr0 = d.Transparency, ph = math.random() * 6 }
        elseif a == "belt" then
          belts[d] = { cf0 = d.CFrame, len = d.Size.X, h = d.Size.Y, spd = d:GetAttribute("Spd") or 3, n = d:GetAttribute("N") or 4, item = d:GetAttribute("Item") or "crate", model = m }
        elseif a == "nod" then
          local piv, ax = d:GetAttribute("Piv"), d:GetAttribute("Ax")
          if typeof(piv) == "Vector3" and typeof(ax) == "Vector3" then
            nodding[d] = { cf0 = d.CFrame, piv = piv, ax = ax.Unit, amp = math.rad(d:GetAttribute("Amp") or 8), spd = d:GetAttribute("Spd") or 0.5, ph = d:GetAttribute("Ph") or 0, model = m }
          end
        end
      end
    end
    local sm = m:FindFirstChild("Show")
    if sm then addShow(sm, m) end
  end

  -- 从地里升起来：每个零件先沉到地下，按离地高度依次升回原位
  local function rise(m)
    local parts = {}
    local y0, y1 = math.huge, -math.huge
    for _, d in ipairs(m:GetDescendants()) do
      -- 展示飞机是焊在一起的一整架：只挪它的 Root，别的零件跟着走
      if d:IsA("BasePart") and (not d:FindFirstAncestor("Show") or (d.Name == "Root" and d.Parent and d.Parent.Name == "Show")) then
        table.insert(parts, d)
        local p = d.CFrame.Position
        y0 = math.min(y0, p.Y - d.Size.Y / 2)
        y1 = math.max(y1, p.Y + d.Size.Y / 2)
      end
    end
    if #parts == 0 then return end
    local h = math.max(4, y1 - y0)
    local total = 1.6
    busy[m] = os.clock() + total + 0.3
    for _, p in ipairs(parts) do
      local cf = p.CFrame
      local k = math.clamp((cf.Position.Y - y0) / h, 0, 1)
      p.CFrame = cf - V(0, h + 2, 0)
      task.delay(k * total * 0.55, function()
        if p.Parent then TweenService:Create(p, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = cf }):Play() end
      end)
    end
    -- 脚手架：四角的黄色立杆 + 顶上一圈，盖完淡掉
    local body = m.PrimaryPart
    if body and G.fxPart then
      local c = body.CFrame.Position
      local sx, sz = body.Size.X / 2 + 1.5, body.Size.Z / 2 + 1.5
      local poles = {}
      for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
        local pole = G.fxPart(nil, V(0.5, h, 0.5), CFrame.new(c.X + o[1] * sx, y0 + h / 2, c.Z + o[2] * sz), RGB(240, 190, 40), Enum.Material.Metal, 0)
        table.insert(poles, pole)
      end
      for _, o in ipairs({ { 0, -1, 2 * sx, 0.4 }, { 0, 1, 2 * sx, 0.4 }, { -1, 0, 0.4, 2 * sz }, { 1, 0, 0.4, 2 * sz } }) do
        local bar = G.fxPart(nil, V(o[3], 0.4, o[4]), CFrame.new(c.X + o[1] * sx, y0 + h, c.Z + o[2] * sz), RGB(240, 190, 40), Enum.Material.Metal, 0)
        table.insert(poles, bar)
      end
      task.delay(total, function()
        for _, q in ipairs(poles) do
          if q.Parent then
            TweenService:Create(q, TweenInfo.new(0.5), { Transparency = 1 }):Play()
            Debris:AddItem(q, 0.55)
          end
        end
      end)
      -- 扬尘
      for i = 1, 10 do
        local a = i / 10 * math.pi * 2
        local q = V(c.X + math.cos(a) * sx, y0 + 1, c.Z + math.sin(a) * sz)
        local sm = G.fxPart(Enum.PartType.Ball, V(3, 3, 3), CFrame.new(q), RGB(196, 186, 160), Enum.Material.SmoothPlastic, 0.3)
        TweenService:Create(sm, TweenInfo.new(1.4), { Size = V(9, 9, 9), Transparency = 1, CFrame = CFrame.new(q + V(0, 4, 0)) }):Play()
        Debris:AddItem(sm, 1.5)
      end
      task.delay(total * 0.9, function()
        if G.playSound then G.playSound("build", c) end
      end)
    end
  end

  local function onBuilding(m)
    if not m:IsA("Model") then return end
    local at = m:GetAttribute("BuiltAt")
    local fresh = type(at) == "number" and (workspace:GetServerTimeNow() - at) < 4
    register(m)   -- 先记下原位（升起动画会先把零件沉到地下）
    if fresh then rise(m) end
  end
  local function onPad(m)
    local pad = m:FindFirstChild("Pad")
    if pad then pads[pad] = true end
  end

  local function watch(folder, fn)
    folder.ChildAdded:Connect(function(c)
      task.wait()
      if c.Parent then fn(c) end
    end)
    for _, c in ipairs(folder:GetChildren()) do fn(c) end
  end
  task.spawn(function()
    local plots = workspace:WaitForChild("Plots")
    local function onPlot(p)
      local b = p:WaitForChild("Buildings", 30)
      if b then watch(b, onBuilding) end
      local pd = p:WaitForChild("Pads", 30)
      if pd then watch(pd, onPad) end
    end
    plots.ChildAdded:Connect(onPlot)
    for _, p in ipairs(plots:GetChildren()) do task.spawn(onPlot, p) end
  end)

  ---------------------------------------------------------------- 自己基地里的「人气」：两个巡逻兵沿大道、横路来回走，一辆吉普在横路上来回开（只在本地画）
  local life = nil
  local ROUTE = { { -10, -104 }, { -10, 50 }, { 42, 60 }, { 42, 118 }, { -62, 118 }, { -62, 60 }, { -10, 50 } }
  local function soldierModel()
    local parts = {}
    local function add(size, off, color, shape)
      local p = G.fxPart(shape, size, CFrame.new(), color, Enum.Material.SmoothPlastic, 0)
      p.CastShadow = true
      table.insert(parts, { p = p, off = off })
      return p
    end
    add(V(1.0, 1.9, 0.6), CFrame.new(0, 0.95, 0), RGB(66, 74, 50))
    add(V(1.3, 1.7, 0.75), CFrame.new(0, 2.7, 0), RGB(86, 96, 64))
    add(V(0.8, 0.8, 0.8), CFrame.new(0, 3.95, 0), RGB(230, 188, 150))
    add(V(1.05, 0.45, 1.05), CFrame.new(0, 4.45, 0), RGB(70, 80, 52))
    add(V(0.18, 0.25, 2.0), CFrame.new(0.5, 2.8, -0.6), RGB(40, 40, 40))
    return parts
  end
  local function jeepModel()
    local parts = {}
    local function add(size, off, color, mat)
      local p = G.fxPart(nil, size, CFrame.new(), color, mat or Enum.Material.Metal, 0)
      p.CastShadow = true
      table.insert(parts, { p = p, off = off })
    end
    add(V(3.8, 1.6, 7.6), CFrame.new(0, 1.9, 0), RGB(86, 98, 66))
    add(V(3.4, 1.4, 3.4), CFrame.new(0, 3.3, 0.6), RGB(76, 88, 58))
    add(V(3.2, 0.8, 0.2), CFrame.new(0, 3.4, -1.2), RGB(80, 110, 130), Enum.Material.Glass)
    for _, sx in ipairs({ -1.9, 1.9 }) do
      for _, sz in ipairs({ -2.4, 2.4 }) do add(V(0.7, 1.8, 1.8), CFrame.new(sx, 0.9, sz), RGB(30, 30, 32), Enum.Material.SmoothPlastic) end
    end
    return parts
  end
  local function routeLen()
    local L = 0
    for i = 1, #ROUTE - 1 do
      local a, b = ROUTE[i], ROUTE[i + 1]
      L = L + math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
    end
    return L
  end
  local RL = routeLen()
  local function along(s)   -- 来回走：0..RL 再走回去
    s = s % (RL * 2)
    local back = s > RL
    if back then s = RL * 2 - s end
    for i = 1, #ROUTE - 1 do
      local a, b = ROUTE[i], ROUTE[i + 1]
      local l = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
      if s <= l then
        local k = s / l
        local dx, dz = b[1] - a[1], b[2] - a[2]
        if back then dx, dz = -dx, -dz end
        return a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k, dx, dz
      end
      s = s - l
    end
    local e = ROUTE[#ROUTE]
    return e[1], e[2], 0, 1
  end
  local function place(parts, cf)
    for _, q in ipairs(parts) do q.p.CFrame = cf * q.off end
  end
  -- 战斗机一圈（秒）：停 18 → 滑跑 7 → 爬升飞走 20 → 看不见 15 → 从战场那边反向进场 24 → 落地减速 6 → 滑到停机位 2 → 掉头 3 → 停
  --   （南边湖后面是雪山，不从那边进场）
  local UP = V(0, 1, 0)
  local ROLL_A = (62 - 4) / 6
  local ROLL_END = 205 - (62 * 6 - 0.5 * ROLL_A * 36)   -- 落地滑跑停在离停机位多远
  local JET_T = 18 + 7 + 20 + 15 + 24 + 6 + 2 + 3 + 6
  local function jetPose(s, t)
    local cf0 = s.cf0
    local P0, F = cf0.Position, cf0.LookVector
    local function at(d, h, pitch, back)
      local pos = P0 + F * d + UP * h
      return CFrame.lookAt(pos, pos + (back and -F or F)) * CFrame.Angles(pitch or 0, 0, 0)
    end
    if t < 18 then return at(0, 0) end
    t = t - 18
    if t < 7 then   -- 滑跑：加速，最后两秒抬头离地
      local lift = (t > 5.4) and (t - 5.4) ^ 2 * 2.6 or 0
      return at(0.5 * 8.6 * t * t, lift, math.rad(10) * math.clamp((t - 5) / 2, 0, 1))
    end
    t = t - 7
    if t < 20 then   -- 爬升，越飞越快，飞向战场那边
      return at(210 + 60 * t + 1.5 * t * t, 6.7 + 170 * (1 - math.exp(-t / 6)), math.rad(12) * math.exp(-t / 5))
    end
    t = t - 20
    if t < 15 then return nil end   -- 飞远了
    t = t - 15
    if t < 24 then   -- 从战场那边下滑进场，机头朝南对准跑道北头
      local k = t / 24
      return at(1800 - 1595 * k, 260 * (1 - k) ^ 1.3, math.rad(3), true)
    end
    t = t - 24
    if t < 6 then   -- 落地，减速
      return at(205 - (62 * t - 0.5 * ROLL_A * t * t), 0, math.rad(4) * math.max(0, 1 - t / 1.5), true)
    end
    t = t - 6
    if t < 2 then return at(ROLL_END * (1 - t / 2), 0, 0, true) end   -- 慢慢滑到停机位
    t = t - 2
    if t < 3 then return CFrame.lookAt(P0, P0 - F) * CFrame.Angles(0, math.pi * t / 3, 0) end   -- 原地掉头，机头朝跑道
    return at(0, 0)
  end

  -- 直升机一圈（秒）：停 24 → 旋翼转起来 4 → 升起 5 → 绕一圈 22 → 悬停转回原来的朝向 4 → 落下 5 → 旋翼停 5 → 停
  local HELI_T = 24 + 4 + 5 + 22 + 4 + 5 + 5 + 6
  local function heliPose(s, t)
    local cf0 = s.cf0
    local P0 = cf0.Position
    local rot0 = cf0 - P0
    if t < 24 then return cf0, 0 end
    t = t - 24
    if t < 4 then return cf0, 24 * t / 4 end
    t = t - 4
    if t < 5 then
      local k = t / 5
      return cf0 + UP * (35 * k * k * (3 - 2 * k)), 24
    end
    t = t - 5
    if t < 22 then   -- 绕停机坪北边一个半径 120 的圈，压坡度、低头
      local k = t / 22
      local C = P0 + V(0, 0, 120)
      local phi = math.pi + 2 * math.pi * k
      local pos = C + V(math.sin(phi), 0, math.cos(phi)) * 120 + UP * (35 + 20 * math.sin(math.pi * k))
      local look = CFrame.lookAt(pos, pos + V(math.cos(phi), 0, -math.sin(phi)))
      local side = (look.RightVector:Dot(C - pos) > 0) and -1 or 1
      local cf = look * CFrame.Angles(math.rad(-6), 0, side * math.rad(16) * math.min(1, k * 6, (1 - k) * 6))
      local blend = math.min(1, t / 2, (22 - t) / 2)   -- 头尾两秒从停放的朝向转过去、转回来
      if blend < 1 then cf = (CFrame.new(pos) * rot0):Lerp(cf, math.max(0, blend)) end
      return cf, 24
    end
    t = t - 22
    if t < 4 then return cf0 + UP * 35, 24 end
    t = t - 4
    if t < 5 then
      local k = t / 5
      return cf0 + UP * (35 * (1 - k * k * (3 - 2 * k))), 24
    end
    t = t - 5
    if t < 5 then return cf0, 24 * (1 - t / 5) end
    return cf0, 0
  end

  local function setHidden(s, hide)
    if s.hidden == hide then return end
    s.hidden = hide
    for _, p in ipairs(s.parts) do p.LocalTransparencyModifier = hide and 1 or 0 end
  end
  local function stepShows(dt)
    local now = os.clock()
    local cp = cam.CFrame.Position
    for sm, s in pairs(shows) do
      if not sm.Parent or not s.root.Parent then
        shows[sm] = nil
      elseif not (busy[s.bm] and now < busy[s.bm]) and (s.cf0.Position - cp).Magnitude < 3000 then
        s.t = s.t + dt
        if s.kind == "heli" then
          s.t = s.t % HELI_T
          local cf, spin = heliPose(s, s.t)
          s.root.CFrame = cf
          s.rot = s.rot + spin * dt
          if s.rotor then s.rotor.Transform = CFrame.Angles(0, s.rot, 0) end
          if s.tail then s.tail.Transform = CFrame.fromAxisAngle(s.axis, s.rot * 1.7) end
        else
          s.t = s.t % JET_T
          local cf = jetPose(s, s.t)
          setHidden(s, cf == nil)
          if cf then s.root.CFrame = cf end
        end
      end
    end
  end
  G.shows = shows

  local function stepLife(dt, now)
    local S = G.S
    if not (S and S.origin) then return end
    if not life then
      life = { soldiers = { soldierModel(), soldierModel() }, jeep = jeepModel(), t = 0 }
    end
    life.t = life.t + dt
    local o = S.origin
    for i, sm in ipairs(life.soldiers) do
      local x, z, dx, dz = along(life.t * 5 + i * RL * 0.6)
      local bob = math.abs(math.sin((life.t + i) * 9)) * 0.25
      local p = o + V(x + (i == 1 and -1.5 or 1.5), 1 + bob, z)
      place(sm, CFrame.lookAt(p, p + V(dx, 0, dz)))
    end
    -- 吉普：横路上从西到东再开回来
    local span = 230
    local s = (life.t * 14) % (span * 2)
    local jx = (s < span) and (-115 + s) or (-115 + span * 2 - s)
    local dir = (s < span) and 1 or -1
    local jp = o + V(jx, 1, 64 + dir * 4)   -- 两条车道 z = 60、68（兵营门口操场到 z = 55 为止）
    place(life.jeep, CFrame.lookAt(jp, jp + V(dir, 0, 0)))
  end

  local t, ringT = 0, 0
  function G.stepAnim(dt)
    stepLife(dt)
    stepShows(dt)
    t = t + dt
    ringT = ringT + dt
    local cp = cam.CFrame.Position
    local now = os.clock()
    for p, s in pairs(spinning) do
      if not p.Parent then
        spinning[p] = nil
      elseif not (busy[s.model] and now < busy[s.model]) and (s.cf0.Position - cp).Magnitude < 600 then
        local a = t * s.spd * math.pi * 2
        local r = s.ax and CFrame.fromAxisAngle(s.ax, a) or CFrame.Angles(0, a, 0)
        if s.piv then
          p.CFrame = CFrame.new(s.piv) * r * CFrame.new(-s.piv) * s.cf0
        else
          p.CFrame = CFrame.new(s.cf0.Position) * r * (s.cf0 - s.cf0.Position)
        end
      end
    end
    for p, s in pairs(belts) do
      if not p.Parent then
        for _, it in ipairs(s.items or {}) do
          for _, q in ipairs(it) do q.p:Destroy() end
        end
        belts[p] = nil
      elseif not (busy[s.model] and now < busy[s.model]) and (s.cf0.Position - cp).Magnitude < 450 then
        if not s.items then
          s.items = {}
          for i = 1, s.n do s.items[i] = beltItem(s.item) end
        end
        for i, it in ipairs(s.items) do
          local x = ((t * s.spd + (i - 1) * s.len / s.n) % s.len) - s.len / 2
          local cf = s.cf0 * CFrame.new(x, s.h / 2, 0)
          for _, q in ipairs(it) do q.p.CFrame = cf * q.off end
        end
      end
    end
    for p, s in pairs(nodding) do
      if not p.Parent then
        nodding[p] = nil
      elseif not (busy[s.model] and now < busy[s.model]) and (s.piv - cp).Magnitude < 450 then
        local a = math.sin(t * s.spd * math.pi * 2 + s.ph) * s.amp
        p.CFrame = CFrame.new(s.piv) * CFrame.fromAxisAngle(s.ax, a) * CFrame.new(-s.piv) * s.cf0
      end
    end
    for p, b in pairs(blinking) do
      if not p.Parent then
        blinking[p] = nil
      else
        local on = math.sin((t + b.ph) * b.spd * math.pi * 2) > -0.2
        p.Transparency = on and b.tr0 or 0.85
      end
    end
    local ring = ringT > 2.2
    if ring then ringT = 0 end
    for pad in pairs(pads) do
      if not pad.Parent then
        pads[pad] = nil
      elseif pad.Color == GREEN and (pad.CFrame.Position - cp).Magnitude < 400 then
        pad.Transparency = 0.25 * (0.5 + 0.5 * math.sin(t * 4))
        if ring and G.fxPart then   -- 买得起：冒一圈往外扩的光
          local c = pad.CFrame.Position
          local r = G.fxPart(Enum.PartType.Cylinder, V(0.2, 7, 7), CFrame.new(c.X, c.Y + 0.4, c.Z) * CFrame.Angles(0, 0, math.pi / 2), GREEN, Enum.Material.Neon, 0.35)
          TweenService:Create(r, TweenInfo.new(1), { Size = V(0.2, 16, 16), Transparency = 1 }):Play()
          Debris:AddItem(r, 1.05)
        end
      else
        pad.Transparency = 0
      end
    end
  end
end

return Anim
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000014">
<Properties>
<string name="Name">Fx</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨（客户端）：特效——开火曳光、炮口火光、炮弹 / 火箭弹弧线、导弹（跟着目标飞）、炸弹、拦截炮把炮弹打爆在半空、爆炸、建成、楼顶冒钱；
-- 支援技能（飞机掠过、治疗光圈、空投）、补给箱金币、震屏、音效（默认用 Roblox 自带的声音变调）；都在本地画，不占网络
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Fx = {}

function Fx.init(G)
  local Config = G.Config
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local cam = workspace.CurrentCamera
  local BALL = Enum.PartType.Ball
  local CYL = Enum.PartType.Cylinder
  local FLAT = CFrame.Angles(0, 0, math.pi / 2)   -- 圆柱立起来（贴地的圈）
  local me = Players.LocalPlayer

  local FXF = Instance.new("Folder")
  FXF.Name = "ClientFx"
  FXF.Parent = workspace
  G.fxFolder = FXF

  local function part(shape, size, cf, color, mat, tr)
    local p = Instance.new("Part")
    if shape then p.Shape = shape end
    p.Size = size
    p.CFrame = cf
    p.Color = color
    p.Material = mat or Enum.Material.Neon
    p.Transparency = tr or 0
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Parent = FXF
    return p
  end
  G.fxPart = part
  local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
  end
  G.tween = tween

  -- 音效：Config.Sounds 里填了 ID 就用自己的；没填用 Roblox 自带的（rbxasset://sounds/ 里现在只有爆炸、落地、滑块、哎哟这几个，
  -- 爆炸声调快了就是枪声、炮声）：{ 声音, 音量, 最慢, 最快 }；同一时间别放太多
  local EXP = "rbxasset://sounds/impact_explosion_03.mp3"
  local TICK = "rbxasset://sounds/volume_slider.ogg"
  local SND = {
    boom = { EXP, 0.8, 0.85, 1.05 }, cannon = { EXP, 0.5, 1.3, 1.5 }, rocket = { EXP, 0.36, 1.7, 2.0 },
    aa = { EXP, 0.16, 2.6, 3.0 }, rifle = { EXP, 0.12, 2.9, 3.3 }, gun = { EXP, 0.22, 2.6, 3.0 },
    build = { "rbxasset://sounds/action_jump_land.mp3", 1, 0.55, 0.65 }, click = { TICK, 0.5, 1.15, 1.15 },
    buy = { TICK, 0.7, 1.5, 1.5 }, coin = { TICK, 0.8, 2.0, 2.2 }, hit = { TICK, 0.55, 2.5, 2.7 }, kill = { EXP, 0.45, 2.1, 2.3 },
    hurt = { "rbxasset://sounds/ouch.ogg", 0.45, 1, 1.1 }, win = { TICK, 0.8, 1.6, 1.6 }, lose = { TICK, 0.8, 0.8, 0.8 }, alarm = { TICK, 0.9, 0.6, 0.6 },
  }
  local soundT, soundN = 0, 0
  function G.playSound(name, pos, speed)
    local custom = Config.Sounds and Config.Sounds[name]
    local def = SND[name]
    if (not custom or custom == "") and not def then return end
    local now = os.clock()
    if now - soundT > 0.1 then
      soundT = now
      soundN = 0
    end
    soundN = soundN + 1
    if soundN > 7 then return end
    local snd = Instance.new("Sound")
    if custom and custom ~= "" then
      snd.SoundId = custom
      snd.Volume = 0.6
    else
      snd.SoundId = def[1]
      snd.Volume = def[2]
      snd.PlaybackSpeed = speed or (def[3] + (def[4] - def[3]) * math.random())
    end
    snd.RollOffMinDistance = 30
    snd.RollOffMaxDistance = 1500
    if pos then
      if (pos - cam.CFrame.Position).Magnitude > 1500 then
        snd:Destroy()
        return
      end
      local p = part(nil, V(0.2, 0.2, 0.2), CFrame.new(pos), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
      snd.Parent = p
      snd:Play()
      Debris:AddItem(p, 5)
    else
      snd.Parent = SoundService   -- 界面音效：不分远近
      snd:Play()
      Debris:AddItem(snd, 5)
    end
  end
  -- 一串音：胜利升调、失败降调、警报
  function G.jingle(kind)
    local seq = (kind == "win") and { 1.2, 1.5, 1.9, 2.4 } or (kind == "lose") and { 1.0, 0.8, 0.62 } or { 0.6, 0.9, 0.6, 0.9 }
    task.spawn(function()
      for _, sp in ipairs(seq) do
        G.playSound((kind == "win" or kind == "lose") and kind or "alarm", nil, sp)
        task.wait(0.13)
      end
    end)
  end

  -- 震屏：附近的爆炸、开炮叠一点「震动量」，每帧按它晃视线（排在镜头脚本之后）
  local trauma = 0
  function G.shake(a)
    trauma = math.min(1, trauma + a)
  end
  pcall(function()
    RunService:BindToRenderStep("MTShake", Enum.RenderPriority.Last.Value, function(dt)
      if trauma <= 0.002 then return end
      local s = trauma * trauma
      local t = os.clock() * 26
      cam.CFrame = cam.CFrame * CFrame.Angles(math.noise(t, 1.7) * 0.06 * s, math.noise(t, 5.3) * 0.06 * s, math.noise(t, 9.1) * 0.035 * s)
      trauma = math.max(0, trauma - dt * 1.5)
    end)
  end)

  local function flash(p, s)
    local f = part(BALL, V(s, s, s), CFrame.new(p), RGB(255, 222, 140), Enum.Material.Neon, 0)
    tween(f, 0.09, { Transparency = 1, Size = V(s, s, s) * 1.6 })
    Debris:AddItem(f, 0.12)
  end
  G.flash = flash

  local function beam(a, b, w, color, life)
    local len = (b - a).Magnitude
    if len < 0.2 then return end
    local p = part(nil, V(w, w, len), CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2), color, Enum.Material.Neon, 0.1)
    tween(p, life, { Transparency = 1 })
    Debris:AddItem(p, life + 0.05)
  end
  G.beam = beam

  local function boom(p, s)
    local dist = (p - cam.CFrame.Position).Magnitude
    if dist < 160 then G.shake(math.clamp((160 - dist) / 160, 0, 1) * 0.45 * math.min(2, s)) end
    local fb = part(BALL, V(5, 5, 5) * s, CFrame.new(p), RGB(255, 175, 70), Enum.Material.Neon, 0.05)
    local light = Instance.new("PointLight")
    light.Color = RGB(255, 170, 90)
    light.Range = 30 * s
    light.Brightness = 3
    light.Parent = fb
    tween(fb, 0.38, { Size = V(16, 16, 16) * s, Transparency = 1 })
    tween(light, 0.38, { Brightness = 0 })
    Debris:AddItem(fb, 0.42)
    local n = (s >= 1) and 3 or 1
    for i = 1, n do   -- 翻滚上升的烟
      local o = V(math.random() - 0.5, 0, math.random() - 0.5) * 6 * s
      local sm = part(BALL, V(6, 6, 6) * s, CFrame.new(p + o), RGB(72, 68, 62), Enum.Material.SmoothPlastic, 0.2)
      tween(sm, 1.5 + i * 0.35, { Size = V(20, 20, 20) * s, Transparency = 1, CFrame = CFrame.new(p + o + V(0, (12 + i * 4) * s, 0)) })
      Debris:AddItem(sm, 1.7 + i * 0.35)
    end
    local ring = part(CYL, V(0.3, 4 * s, 4 * s), CFrame.new(p.X, p.Y - 1, p.Z) * FLAT, RGB(200, 185, 150), Enum.Material.SmoothPlastic, 0.35)
    tween(ring, 0.6, { Size = V(0.3, 28 * s, 28 * s), Transparency = 1 })
    Debris:AddItem(ring, 0.65)
    if s >= 1 then   -- 碎片
      for _ = 1, 6 do
        local d = V(math.random() - 0.5, math.random() * 0.8 + 0.4, math.random() - 0.5).Unit
        local c = part(nil, V(1, 1, 1), CFrame.new(p), RGB(50, 48, 45), Enum.Material.SmoothPlastic, 0)
        tween(c, 0.7, { CFrame = CFrame.new(p + d * 20 * s) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
        Debris:AddItem(c, 0.75)
      end
    end
  end
  G.boom = boom

  -- 飞行中的弹：抛物线（炮弹、火箭炮火箭弹）、直线（火箭筒、直升机火箭）、导弹（跟着目标的本地复制飞）、炸弹（先平飞再往下掉），每帧更新；
  -- 火箭、导弹到了自己炸（炮弹、炸弹落地的爆炸服务器发）；id 是服务器给的炮弹编号（拦截炮打掉时按它找）
  local flying = {}
  local byId = {}
  local function launch(a, b, dur, arc, kind, id, size)
    local p
    if kind == "shell" then
      local s = size or 1.4
      p = part(BALL, V(s, s, s), CFrame.new(a), RGB(255, 200, 120), Enum.Material.Neon, 0)
    elseif kind == "bomb" then
      p = part(nil, V(1.1, 1.1, 3.4), CFrame.new(a), RGB(62, 64, 60), Enum.Material.Metal, 0)
    elseif kind == "lava" then   -- 火山弹：发光的熔岩块
      p = part(BALL, V(3.4, 3.4, 3.4), CFrame.new(a), RGB(255, 110, 30), Enum.Material.Neon, 0)
      local glow = Instance.new("PointLight")
      glow.Color = RGB(255, 120, 40)
      glow.Range = 22
      glow.Brightness = 3
      glow.Parent = p
    elseif kind == "cruise" then   -- 巡航导弹：粗大的白弹体，尾焰发光
      p = part(nil, V(1.4, 1.4, 7.5), CFrame.new(a), RGB(238, 238, 232), Enum.Material.SmoothPlastic, 0)
      local glow = Instance.new("PointLight")
      glow.Color = RGB(255, 170, 80)
      glow.Range = 40
      glow.Brightness = 4
      glow.Parent = p
    elseif kind == "missile" then
      p = part(nil, V(0.5, 0.5, 3), CFrame.new(a), RGB(236, 236, 230), Enum.Material.SmoothPlastic, 0)
      local glow = Instance.new("PointLight")
      glow.Color = RGB(255, 190, 110)
      glow.Range = 10
      glow.Brightness = 2
      glow.Parent = p
    else
      p = part(nil, V(0.6, 0.6, 3.4), CFrame.new(a), RGB(255, 190, 90), Enum.Material.Neon, 0)
    end
    local f = { p = p, a = a, b = b, t0 = os.clock(), dur = math.max(0.05, dur), arc = arc, kind = kind, puff = 0, id = id }
    table.insert(flying, f)
    if id then byId[id] = f end
    return f
  end
  G.launch = launch
  local function arcPos(f, k)
    local b = f.b
    if f.track then   -- 导弹：盯着目标现在的位置（目标没了就飞到最后看到的地方）
      local r = f.track.root
      if r and r.Parent then
        b = r.CFrame.Position + V(0, f.th or 2, 0)
        f.b = b
      else
        f.track = nil
      end
    end
    if f.kind == "bomb" or f.kind == "lava" then
      local p = f.a:Lerp(b, k)
      return V(p.X, f.a.Y + (b.Y - f.a.Y) * k * k, p.Z)
    end
    return f.a:Lerp(b, k) + V(0, f.arc * 4 * k * (1 - k), 0)
  end
  local stepMinesF = nil
  function G.stepFx()
    local now = os.clock()
    if stepMinesF then stepMinesF() end
    for i = #flying, 1, -1 do
      local f = flying[i]
      local k = (now - f.t0) / f.dur
      if f.dead then
        table.remove(flying, i)
      elseif k >= 1 then
        f.p:Destroy()
        table.remove(flying, i)
        if f.id then byId[f.id] = nil end
        if f.kind == "rocket" then boom(f.b, 0.7) elseif f.kind == "missile" then boom(f.b, 0.9) end
      else
        local pos = arcPos(f, k)
        local ahead = arcPos(f, math.min(1, k + 0.02))
        if (ahead - pos).Magnitude > 0.001 then f.p.CFrame = CFrame.lookAt(pos, ahead) else f.p.CFrame = CFrame.new(pos) end
        f.puff = f.puff + 1
        if f.kind == "cruise" and f.puff % 2 == 0 then   -- 巡航导弹：一道粗白烟，留得久
          local s = part(BALL, V(2.8, 2.8, 2.8), CFrame.new(pos), RGB(220, 216, 210), Enum.Material.SmoothPlastic, 0.25)
          tween(s, 2.8, { Size = V(11, 11, 11), Transparency = 1 })
          Debris:AddItem(s, 2.85)
        elseif f.kind ~= "bomb" and f.kind ~= "cruise" and f.puff % 2 == 0 then   -- 尾烟（火山弹拖着黑烟）
          local s = part(BALL, V(1.6, 1.6, 1.6), CFrame.new(pos), RGB(160, 156, 150), Enum.Material.SmoothPlastic, 0.4)
          tween(s, 1, { Size = V(5, 5, 5), Transparency = 1 })
          Debris:AddItem(s, 1.05)
        end
      end
    end
  end

  -- 导弹发射井：两扇井盖往两边滑开、井口喷一大团白烟，几秒后合上（找离 p 最近的那口井）
  local function siloOpen(p)
    local plots = workspace:FindFirstChild("Plots")
    local silo = nil
    for _, pf in ipairs(plots and plots:GetChildren() or {}) do
      local bf = pf:FindFirstChild("Buildings")
      local s = bf and bf:FindFirstChild("silo")
      local body = s and s:FindFirstChild("Body")
      if body and (V(body.CFrame.Position.X, 0, body.CFrame.Position.Z) - V(p.X, 0, p.Z)).Magnitude < 8 then silo = s end
    end
    if silo then
      for _, d in ipairs(silo:GetChildren()) do
        if d:IsA("BasePart") and (d.Name == "DoorL" or d.Name == "DoorR") then
          local cf0 = d.CFrame
          local dx = (d.Name == "DoorL") and -5.6 or 5.6
          tween(d, 0.7, { CFrame = cf0 + V(dx, 0, 0) })
          task.delay(4.2, function()
            if d.Parent then tween(d, 1.0, { CFrame = cf0 }) end
          end)
        end
      end
    end
    local hole = p + V(-2, 1.4, -3)
    task.delay(0.6, function()
      flash(hole, 5)
      for i = 1, 8 do
        local o = V(math.random() - 0.5, 0, math.random() - 0.5) * 10
        local sm = part(BALL, V(7, 7, 7), CFrame.new(hole + o), RGB(226, 222, 216), Enum.Material.SmoothPlastic, 0.2)
        tween(sm, 2.2 + i * 0.15, { Size = V(24, 24, 24), Transparency = 1, CFrame = CFrame.new(hole + o * 2 + V(0, 10 + i * 3, 0)) })
        Debris:AddItem(sm, 2.5 + i * 0.15)
      end
    end)
    G.playSound("alarm", p, 0.6)
  end

  -- 巡航导弹炸了：大火球、贴地往外扩的冲击波、往上翻滚的火柱和黑烟顶，离得近的震得厉害
  local function bigBoom(p, s)
    boom(p, s)
    local dist = (p - cam.CFrame.Position).Magnitude
    if dist < 900 then G.shake(math.clamp((900 - dist) / 900, 0, 1) * 1.3) end
    local ring = part(CYL, V(0.4, 24, 24), CFrame.new(p.X, p.Y + 0.6, p.Z) * FLAT, RGB(255, 236, 200), Enum.Material.Neon, 0.3)
    tween(ring, 0.9, { Size = V(0.4, 280, 280), Transparency = 1 })
    Debris:AddItem(ring, 0.95)
    for i = 1, 4 do
      local q = p + V(0, i * 7, 0)
      local fb = part(BALL, V(16, 16, 16), CFrame.new(q), RGB(255, 160 - i * 18, 60), Enum.Material.Neon, 0.15)
      tween(fb, 1.6 + i * 0.25, { Size = V(38, 38, 38), Transparency = 1, CFrame = CFrame.new(q + V(0, 34 + i * 12, 0)) })
      Debris:AddItem(fb, 1.9 + i * 0.25)
    end
    local cap = part(BALL, V(30, 30, 30), CFrame.new(p + V(0, 30, 0)), RGB(60, 56, 52), Enum.Material.SmoothPlastic, 0.2)
    tween(cap, 4.5, { Size = V(110, 110, 110), Transparency = 1, CFrame = CFrame.new(p + V(0, 110, 0)) })
    Debris:AddItem(cap, 4.6)
  end
  G.bigBoom = bigBoom

  -- 拦截炮打掉一发炮弹：几道曳光打过去，炮弹在半空炸开
  local function intercept(e)
    local f = e.id and byId[e.id]
    if not f or f.dead then return end
    local k = math.clamp((os.clock() - f.t0) / f.dur, 0, 1)
    local pos = arcPos(f, k)
    f.dead = true
    f.p:Destroy()
    byId[e.id] = nil
    if e.laser then   -- 激光：一道红光，炮弹在半空烧爆
      beam(e.a, pos, 0.5, RGB(255, 70, 60), 0.18)
      beam(e.a, pos, 0.18, RGB(255, 230, 220), 0.12)
    else
      for _ = 1, 3 do
        local j = V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3
        beam(e.a, pos + j, 0.2, RGB(255, 226, 130), 0.14)
      end
    end
    flash(e.a, 1.6)
    boom(pos, 0.45)
    G.playSound("aa", e.a)
  end

  -- 爱国者拦截弹道导弹：一枚拦截弹拖着白烟飞上去，拦住了就在半空炸成一团（没拦住就擦过去）
  local function abm(e)
    local f = e.id and byId[e.id]
    if not f or f.dead then return end
    local k = math.clamp((os.clock() - f.t0) / f.dur, 0, 1)
    local pos = arcPos(f, k)
    local fl = launch(e.a, pos + (e.miss and V(30, 20, 0) or V(0, 0, 0)), 0.7, 40, "missile")
    flash(e.a, 2.4)
    G.playSound("rocket", e.a)
    if not e.miss then
      task.delay(0.7, function()
        local k2 = math.clamp((os.clock() - f.t0) / f.dur, 0, 1)
        local p2 = arcPos(f, k2)
        f.dead = true
        if f.p then f.p:Destroy() end
        byId[e.id] = nil
        boom(p2, 2.2)
        G.playSound("boom", p2, 0.7)
      end)
    end
    return fl
  end

  -- 地雷：布雷车撒下的（一块扁扁的雷，中间一颗红灯一闪一闪），踩上就炸
  local mines = {}
  local function mineFx(e)
    if not e.id or typeof(e.p) ~= "Vector3" then return end
    local m = part(CYL, V(0.5, 3.2, 3.2), CFrame.new(e.p.X, e.p.Y + 0.25, e.p.Z) * FLAT, RGB(74, 82, 58), Enum.Material.Metal, 0)
    local dot = part(BALL, V(0.7, 0.7, 0.7), CFrame.new(e.p + V(0, 0.6, 0)), RGB(255, 60, 40), Enum.Material.Neon, 0)
    mines[e.id] = { m, dot, t = os.clock() }
    Debris:AddItem(m, 400)
    Debris:AddItem(dot, 400)
  end
  -- 打完了：剩下的雷都收走
  function G.clearMines()
    for id, m in pairs(mines) do
      for _, p in ipairs(m) do p:Destroy() end
      mines[id] = nil
    end
  end
  local function mineBoom(e)
    local m = e.id and mines[e.id]
    if m then
      for _, p in ipairs(m) do p:Destroy() end
      mines[e.id] = nil
    end
    boom(e.p, 1.4)
    G.playSound("boom", e.p)
  end
  -- 地雷的红灯：一闪一闪（每帧 stepFx 里调）
  local function stepMines()
    local on = (os.clock() % 1) < 0.5
    for id, m in pairs(mines) do
      if not m[2].Parent then
        mines[id] = nil
      else
        m[2].Transparency = on and 0 or 0.85
      end
    end
  end

  stepMinesF = stepMines

  -- 电磁炮：一道粗的蓝白光贯穿过去，路上冒火花
  local function rail(e)
    beam(e.a, e.b, 1.6, RGB(110, 210, 255), 0.4)
    beam(e.a, e.b, 0.45, RGB(235, 250, 255), 0.25)
    flash(e.a, 5)
    local len = (e.b - e.a).Magnitude
    for i = 1, 6 do
      local p = e.a:Lerp(e.b, i / 7) + V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2
      local sp = part(BALL, V(1.4, 1.4, 1.4), CFrame.new(p), RGB(160, 230, 255), Enum.Material.Neon, 0.1)
      tween(sp, 0.35, { Size = V(4, 4, 4), Transparency = 1 })
      Debris:AddItem(sp, 0.4)
    end
    local dist = (e.a - cam.CFrame.Position).Magnitude
    if dist < 220 and len > 0 then G.shake(0.25) end
    G.playSound("cannon", e.a)
  end

  -- 单位技能：脚下一圈光（颜色按技能），烟幕再冒一圈烟
  local ABC = { charge = RGB(255, 214, 80), smoke = RGB(200, 200, 196), rapid = RGB(255, 150, 60), barrage = RGB(255, 90, 60), burner = RGB(110, 190, 255) }
  local function abilityFx(e)
    local p, s = e.p, (e.s or 10) + 8
    local ring = part(CYL, V(0.3, s, s), CFrame.new(p.X, p.Y + 0.6, p.Z) * FLAT, ABC[e.id] or RGB(255, 255, 255), Enum.Material.Neon, 0.2)
    tween(ring, 0.7, { Size = V(0.3, s * 3, s * 3), Transparency = 1 })
    Debris:AddItem(ring, 0.75)
    if e.id == "smoke" then
      for i = 1, 8 do
        local a = i / 8 * math.pi * 2
        local q = p + V(math.cos(a) * s * 0.6, 2, math.sin(a) * s * 0.6)
        local sm = part(BALL, V(8, 8, 8), CFrame.new(q), RGB(214, 214, 210), Enum.Material.SmoothPlastic, 0.3)
        tween(sm, (e.dur or 6), { Size = V(22, 22, 22), Transparency = 1, CFrame = CFrame.new(q + V(0, 6, 0)) })
        Debris:AddItem(sm, (e.dur or 6) + 0.1)
      end
    end
    G.playSound("buy", p)
  end

  local SHOT = {
    inf = { w = 0.15, c = RGB(255, 232, 130), life = 0.06, fl = 1.2, snd = "rifle" },
    ifv = { w = 0.3, c = RGB(255, 205, 110), life = 0.07, fl = 2.2, n = 2, hit = 0.35, snd = "aa" },
    tank = { w = 0.7, c = RGB(255, 185, 90), life = 0.12, fl = 5, hit = 0.9, snd = "cannon" },
    boss = { w = 1.1, c = RGB(255, 160, 70), life = 0.14, fl = 7, hit = 1.3, snd = "cannon" },
    aa = { w = 0.28, c = RGB(255, 214, 100), life = 0.07, fl = 1.8, n = 3, snd = "aa" },
    mg = { w = 0.14, c = RGB(255, 232, 130), life = 0.05, fl = 1, n = 2, snd = "rifle" },
    sniper = { w = 0.16, c = RGB(210, 235, 255), life = 0.16, fl = 1.2, snd = "rifle" },
    jeep = { w = 0.2, c = RGB(255, 220, 120), life = 0.06, fl = 1.4, n = 2, snd = "rifle" },
    td = { w = 0.6, c = RGB(255, 185, 90), life = 0.12, fl = 4.5, hit = 0.8, snd = "cannon" },
    breacher = { w = 0.2, c = RGB(255, 220, 120), life = 0.06, fl = 1.2, snd = "rifle" },
    spaag = { w = 0.3, c = RGB(255, 214, 100), life = 0.07, fl = 2, n = 4, snd = "aa" },
    cram = { w = 0.24, c = RGB(255, 236, 160), life = 0.06, fl = 1.6, n = 4, snd = "aa" },
    transport = { w = 0.16, c = RGB(255, 232, 130), life = 0.05, fl = 1, n = 2, snd = "rifle" },
    attacker = { w = 0.45, c = RGB(255, 200, 90), life = 0.1, fl = 3, n = 5, hit = 0.55, spread = 9, snd = "aa" },
    medic = { w = 0.12, c = RGB(255, 236, 150), life = 0.05, fl = 1, snd = "rifle" },
    commando = { w = 0.16, c = RGB(255, 236, 160), life = 0.06, fl = 1.2, n = 2, snd = "rifle" },
    repair = { w = 0.16, c = RGB(255, 232, 130), life = 0.05, fl = 1, n = 2, snd = "rifle" },
    ew = { w = 0.18, c = RGB(255, 226, 120), life = 0.05, fl = 1.2, n = 2, snd = "rifle" },
    heavytank = { w = 0.9, c = RGB(255, 170, 80), life = 0.14, fl = 6.5, hit = 1.1, snd = "cannon" },
    miner = { w = 0.2, c = RGB(255, 220, 120), life = 0.06, fl = 1.2, snd = "rifle" },
  }
  local GUN = {
    rifle = { w = 0.12, c = RGB(255, 236, 150), life = 0.05 },
    smg = { w = 0.1, c = RGB(255, 236, 150), life = 0.04 },
    sniper = { w = 0.22, c = RGB(200, 230, 255), life = 0.18 },
  }
  -- 喷火：一串由大变小的火团从喷口冲到目标，落点冒一团火
  local function flame(a, b)
    local n = 7
    for i = 1, n do
      local k = i / n
      local q = a:Lerp(b, k) + V((math.random() - 0.5) * 2 * k, (math.random() - 0.5) * 2 * k, (math.random() - 0.5) * 2 * k)
      local sz = 1 + 3 * k
      local f = part(BALL, V(sz, sz, sz), CFrame.new(a), (k < 0.4) and RGB(255, 230, 140) or RGB(255, 120 + math.random(0, 50), 30), Enum.Material.Neon, 0.15)
      tween(f, 0.12 + 0.18 * k, { CFrame = CFrame.new(q), Size = V(sz, sz, sz) * 1.5, Transparency = 0.9 })
      Debris:AddItem(f, 0.35)
    end
    local fb = part(BALL, V(4, 4, 4), CFrame.new(b), RGB(255, 140, 40), Enum.Material.Neon, 0.3)
    tween(fb, 0.4, { Size = V(7, 7, 7), Transparency = 1, CFrame = CFrame.new(b + V(0, 3, 0)) })
    Debris:AddItem(fb, 0.45)
  end

  local function shot(e)
    if e.u == "flamer" then
      flame(e.a, e.b)
      if math.random() < 0.3 then G.playSound("rocket", e.a, 0.7) end
      return
    end
    if e.u == "heli" then
      launch(e.a, e.b, 0.45, 0, "rocket")
      flash(e.a, 2)
      G.playSound("rocket", e.a)
      return
    end
    local s = SHOT[e.u] or SHOT.inf
    for i = 1, (s.n or 1) do
      local off = V(0, 0, 0)
      if i > 1 then off = V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 end
      beam(e.a + off, e.b + off, s.w, s.c, s.life)
    end
    flash(e.a, s.fl)
    if s.spread then   -- 攻击机机炮：一溜弹着点
      for _ = 1, 3 do boom(e.b + V((math.random() - 0.5) * s.spread * 2, 0, (math.random() - 0.5) * s.spread * 2), s.hit) end
    elseif s.hit then
      boom(e.b, s.hit)
    end
    G.playSound(s.snd, e.a)
  end

  -- 玩家开枪（别人的；自己的在开枪那一刻就画了）
  function G.gunFx(id, a, b, flight)
    if id == "rpg" then
      launch(a, b, flight or 0.5, 0, "rocket")
      flash(a, 1.4)
      G.playSound("rocket", a)
      return
    end
    local s = GUN[id] or GUN.rifle
    beam(a, b, s.w, s.c, s.life)
    flash(a, 0.7)
    G.playSound("gun", a)
  end

  local function buildFx(p, s)
    local ring = part(CYL, V(0.4, s * 0.5, s * 0.5), CFrame.new(p.X, 1.2, p.Z) * FLAT, RGB(220, 210, 180), Enum.Material.SmoothPlastic, 0.2)
    tween(ring, 0.9, { Size = V(0.4, s * 1.8, s * 1.8), Transparency = 1 })
    Debris:AddItem(ring, 1)
    for i = 1, 8 do
      local a = i / 8 * math.pi * 2
      local q = p + V(math.cos(a) * s * 0.5, 1, math.sin(a) * s * 0.5)
      local sm = part(BALL, V(4, 4, 4), CFrame.new(q), RGB(200, 192, 170), Enum.Material.SmoothPlastic, 0.3)
      tween(sm, 1.2, { Size = V(9, 9, 9), Transparency = 1, CFrame = CFrame.new(q + V(0, 5, 0)) })
      Debris:AddItem(sm, 1.3)
    end
    local sp = part(BALL, V(2, 2, 2), CFrame.new(p + V(0, 4, 0)), RGB(255, 225, 120), Enum.Material.Neon, 0.1)
    tween(sp, 0.6, { Size = V(s, s, s) * 0.8, Transparency = 1 })
    Debris:AddItem(sp, 0.65)
    G.playSound("build", p)
  end

  -- 楼顶冒出来的「+$5」
  function G.popText(p, str, color)
    local anchor = part(nil, V(0.2, 0.2, 0.2), CFrame.new(p), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(8, 0, 2, 0)
    bb.LightInfluence = 0
    bb.MaxDistance = 240
    bb.AlwaysOnTop = true
    bb.Parent = anchor
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Text = str
    t.TextColor3 = color
    t.TextStrokeTransparency = 0.3
    t.Font = Enum.Font.GothamBold
    t.TextScaled = true
    t.Parent = bb
    tween(bb, 1.6, { StudsOffsetWorldSpace = V(0, 6, 0) })
    tween(t, 1.6, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    Debris:AddItem(anchor, 1.7)
  end

  -- 支援：飞机从 a 直线飞到 b（t 秒），jet 是三角翼喷气机、heli 是直升机；身后一串烟
  local function flyover(e)
    local base0 = CFrame.lookAt(e.a, e.b)
    local base1 = CFrame.lookAt(e.b, e.b + (e.b - e.a).Unit)
    local parts = {}
    local function add(size, rel, color, mat, shape, tr)
      local p = part(shape, size, base0 * rel, color, mat or Enum.Material.Metal, tr or 0)
      table.insert(parts, { p = p, rel = rel })
      return p
    end
    if e.heli then
      add(V(3.4, 3.2, 11), CFrame.new(), RGB(66, 74, 56))
      add(V(1, 1, 9), CFrame.new(0, 0.6, 9), RGB(66, 74, 56))
      add(V(0.2, 26, 26), CFrame.new(0, 2.2, 0) * FLAT, RGB(30, 30, 30), Enum.Material.SmoothPlastic, CYL, 0.55)
    else
      add(V(3.2, 2.4, 30), CFrame.new(), RGB(72, 78, 88))
      add(V(34, 0.6, 10), CFrame.new(0, -0.2, 3), RGB(64, 70, 80))
      add(V(12, 0.5, 4), CFrame.new(0, 0.2, 13), RGB(64, 70, 80))
      add(V(0.5, 5, 5), CFrame.new(0, 2.6, 12), RGB(64, 70, 80))
      add(V(1.6, 1.6, 1.2), CFrame.new(0, 0, 15.4), RGB(255, 170, 80), Enum.Material.Neon, BALL)
    end
    local dur = e.t or 4
    for _, q in ipairs(parts) do
      tween(q.p, dur, { CFrame = base1 * q.rel }, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
      Debris:AddItem(q.p, dur + 0.1)
    end
    G.playSound(e.heli and "aa" or "rocket", e.a:Lerp(e.b, 0.5), e.heli and 0.5 or 0.6)
    task.spawn(function()
      local t0 = os.clock()
      while os.clock() - t0 < dur do
        local k = (os.clock() - t0) / dur
        local q = e.a:Lerp(e.b, k)
        local sm = part(BALL, V(3, 3, 3), CFrame.new(q), RGB(200, 200, 196), Enum.Material.SmoothPlastic, 0.45)
        tween(sm, 1.4, { Size = V(9, 9, 9), Transparency = 1 })
        Debris:AddItem(sm, 1.5)
        task.wait(0.12)
      end
    end)
  end
  -- 战地急救：绿色光圈扩开、几颗绿光往上飘
  local function healFx(p, r)
    local ring = part(CYL, V(0.4, 6, 6), CFrame.new(p.X, p.Y + 0.6, p.Z) * FLAT, RGB(90, 255, 140), Enum.Material.Neon, 0.25)
    tween(ring, 0.8, { Size = V(0.4, r * 2, r * 2), Transparency = 1 })
    Debris:AddItem(ring, 0.85)
    for _ = 1, 14 do
      local q = p + V((math.random() - 0.5) * r * 1.4, 1, (math.random() - 0.5) * r * 1.4)
      local g = part(BALL, V(1.4, 1.4, 1.4), CFrame.new(q), RGB(120, 255, 160), Enum.Material.Neon, 0.1)
      tween(g, 1.2, { CFrame = CFrame.new(q + V(0, 14, 0)), Transparency = 1 })
      Debris:AddItem(g, 1.25)
    end
    G.playSound("coin", p, 1.6)
  end
  -- 空投：尘土圈、白色降落伞缩小消失
  local function dropFx(p)
    local chute = part(BALL, V(10, 4, 10), CFrame.new(p + V(0, 16, 0)), RGB(236, 236, 230), Enum.Material.Fabric, 0.1)
    tween(chute, 1.2, { CFrame = CFrame.new(p + V(0, 3, 0)), Size = V(2, 1, 2), Transparency = 1 })
    Debris:AddItem(chute, 1.25)
    local ring = part(CYL, V(0.3, 4, 4), CFrame.new(p.X, p.Y + 0.4, p.Z) * FLAT, RGB(196, 180, 140), Enum.Material.SmoothPlastic, 0.3)
    tween(ring, 0.7, { Size = V(0.3, 22, 22), Transparency = 1 })
    Debris:AddItem(ring, 0.75)
  end
  -- 金币：一把金色硬币往上蹦、转着消失
  local function coinsFx(p)
    for _ = 1, 10 do
      local d = V(math.random() - 0.5, 0, math.random() - 0.5)
      local c = part(CYL, V(0.25, 1.3, 1.3), CFrame.new(p) * CFrame.Angles(0, math.random() * 6, math.pi / 2), RGB(255, 210, 60), Enum.Material.Neon, 0)
      tween(c, 0.9, { CFrame = CFrame.new(p + d * 10 + V(0, 8 + math.random() * 6, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
      Debris:AddItem(c, 0.95)
    end
    G.playSound("coin", p)
  end

  function G.onFx(list)
    if type(list) ~= "table" then return end
    local cp = cam.CFrame.Position
    for _, e in ipairs(list) do
      local at = e.a or e.p
      if typeof(at) == "Vector3" and (at - cp).Magnitude < 2200 then   -- 太远的（别人的战场）不画
        if e.k == "shot" then
          shot(e)
        elseif e.k == "gun" then
          if e.by ~= me.UserId then G.gunFx(e.w, e.a, e.b, e.t) end
        elseif e.k == "shell" then
          local small = e.u == "mortar"
          launch(e.a, e.b, e.t or 2, (e.b - e.a).Magnitude * 0.28, "shell", e.id, small and 0.9 or (e.u == "heavyarty" and 1.8 or 1.4))
          flash(e.a, small and 1.6 or 4)
          G.playSound("cannon", e.a)
        elseif e.k == "mrocket" then
          launch(e.a, e.b, e.t or 3, (e.b - e.a).Magnitude * 0.22, "mrocket", e.id)
          flash(e.a, 3)
          G.playSound("rocket", e.a)
        elseif e.k == "bomb" then
          launch(e.a, e.b, e.t or 2, 0, (e.u == "lava") and "lava" or "bomb", e.id)
        elseif e.k == "quake" then   -- 火山弹预警：地上一圈红光闪几下
          for i = 0, 2 do
            task.delay(i * 0.45, function()
              local r = part(CYL, V(0.3, (e.s or 30) * 2, (e.s or 30) * 2), CFrame.new(e.p.X, e.p.Y + 0.5, e.p.Z) * FLAT, RGB(255, 60, 30), Enum.Material.Neon, 0.35)
              tween(r, 0.4, { Transparency = 1 })
              Debris:AddItem(r, 0.45)
            end)
          end
          G.playSound("alarm", e.p, 0.5)
          G.shake(0.25)
        elseif e.k == "missile" then
          local f = launch(e.a, e.b, e.t or 1, (e.b - e.a).Magnitude * 0.06, "missile")
          local tr = e.bid and G.visByBid and G.visByBid(e.bid)
          if tr then
            f.track = tr
            f.th = tr.h3
          end
          flash(e.a, 1.6)
          G.playSound("rocket", e.a)
        elseif e.k == "intercept" then
          intercept(e)
        elseif e.k == "gshell" then   -- 空中炮艇：炮弹从天上直直地砸下来
          launch(e.a, e.b, e.t or 1.4, 0, "shell", e.id, 1.3)
          flash(e.a, 3)
          G.playSound("cannon", e.a, 0.8)
        elseif e.k == "ballistic" then   -- 弹道导弹：高高抛起来，拖一道粗白烟
          launch(e.a, e.b, e.t or 6.5, 320, "cruise", e.id)
          flash(e.a, 7)
          G.playSound("rocket", e.a, 0.6)
          G.playSound("alarm", e.b, 0.5)
        elseif e.k == "abm" then
          abm(e)
        elseif e.k == "rail" then
          rail(e)
        elseif e.k == "laser" then
          beam(e.a, e.b, 0.45, RGB(255, 70, 60), 0.12)
          beam(e.a, e.b, 0.15, RGB(255, 230, 220), 0.08)
          flash(e.b, 1.2)
          G.playSound("aa", e.a, 1.4)
        elseif e.k == "mine" then
          mineFx(e)
        elseif e.k == "mineboom" then
          mineBoom(e)
        elseif e.k == "swarm" then   -- 蜂群：发射箱一阵白烟
          for _ = 1, 3 do
            local o = V(math.random() - 0.5, 0, math.random() - 0.5) * 6
            local sm = part(BALL, V(4, 4, 4), CFrame.new(e.p + o), RGB(226, 222, 216), Enum.Material.SmoothPlastic, 0.3)
            tween(sm, 1.2, { Size = V(12, 12, 12), Transparency = 1, CFrame = CFrame.new(e.p + o + V(0, 8, 0)) })
            Debris:AddItem(sm, 1.25)
          end
          G.playSound("rocket", e.p)
        elseif e.k == "ability" then
          abilityFx(e)
        elseif e.k == "boom" then
          boom(e.p, e.s or 1)
          G.playSound("boom", e.p)
        elseif e.k == "bigboom" then
          bigBoom(e.p, e.s or 3.6)
          G.playSound("boom", e.p, 0.6)
        elseif e.k == "silo" then
          siloOpen(e.p)
        elseif e.k == "cruise" then
          launch(e.a, e.b, e.t or 5, (e.b - e.a).Magnitude * 0.45, "cruise", e.id)
          flash(e.a, 6)
          G.playSound("rocket", e.a, 0.7)
        elseif e.k == "build" then
          buildFx(e.p, e.s or 20)
        elseif e.k == "flyover" and typeof(e.b) == "Vector3" then
          flyover(e)
        elseif e.k == "heal" then
          healFx(e.p, e.s or 60)
        elseif e.k == "drop" then
          dropFx(e.p)
        elseif e.k == "coins" then
          coinsFx(e.p)
        elseif e.k == "jam" then   -- 电子干扰：导弹偏掉，冒一圈紫光
          local ring = part(CYL, V(0.2, 3, 3), CFrame.new(e.p) * FLAT, RGB(170, 110, 255), Enum.Material.Neon, 0.2)
          tween(ring, 0.5, { Size = V(0.2, 18, 18), Transparency = 1 })
          Debris:AddItem(ring, 0.55)
          G.popText(e.p, "干扰", RGB(190, 140, 255))
        end
      end
    end
  end
end

return Fx
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000015">
<Properties>
<string name="Name">Guide</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨（客户端）：地图指引——
--   ① 地上一串往前流动的绿色箭头 + 一条发光的线，从你脚下指到下一个要去的地方（补给箱优先，其次是左上角「当前目标」说的那个按钮）；
--      目标头顶一个上下跳、一直转的立体箭头（钱不够时变黄）；目标不在画面里时，屏幕边上一个箭头指方向；
--      目标是界面上的按钮（兵工厂里买兵、开战、建筑）时，那个按钮一闪一闪；左边菜单「指引」能关；
--   ② 左边的小地图（上面是战场）：自己的基地、盖好的楼、能买的按钮（绿点）、补给箱（金点）、你（白箭头）、你的部队（蓝点）；右上角「－」收起
local Players = game:GetService("Players")

local Guide = {}

function Guide.init(G)
  local Config = G.Config
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local V2 = Vector2.new
  local player = Players.LocalPlayer
  local ui = G.ui
  local mk, text, round = G.mk, G.text, G.round
  local cam = workspace.CurrentCamera
  local GREEN, AMBER = RGB(120, 255, 150), RGB(255, 205, 80)
  local on = true
  function G.guideOn() return on end
  function G.toggleGuide(v)
    if v == nil then on = not on else on = v end
    if ui.guideBtn then ui.guideBtn.Text = on and "指引：开" or "指引：关" end
    if not on then G.toast("指引关了：左边菜单「指引」可以再打开", "info") end
  end

  ---------------------------------------------------------------- ① 地上的箭头

  -- 一个箭头 = 两根斜着的发光细条拼成的「V」（尖朝前）；一池子反复用
  local N, GAP, SPEED = 24, 7, 11
  local pool = {}
  for i = 1, N do
    local a = G.fxPart(nil, V(0.55, 0.14, 3.2), CFrame.new(), RGB(120, 255, 150), Enum.Material.Neon, 1)
    local b = G.fxPart(nil, V(0.55, 0.14, 3.2), CFrame.new(), RGB(120, 255, 150), Enum.Material.Neon, 1)
    pool[i] = { a, b }
  end
  local LA = CFrame.new(-0.92, 0, 1.31) * CFrame.Angles(0, math.rad(-35), 0)
  local LB = CFrame.new(0.92, 0, 1.31) * CFrame.Angles(0, math.rad(35), 0)
  local phase = 0
  local function hideAll(from)
    for i = from, N do
      pool[i][1].Transparency = 1
      pool[i][2].Transparency = 1
    end
  end
  -- 现在要去哪：补给箱 > 目标按钮；打仗、布阵、开车时不指
  local function target()
    local S = G.S
    if not S or G.battle or G.mode ~= "free" then return nil, nil end
    if typeof(S.crate) == "Vector3" then return S.crate, RGB(255, 214, 80) end
    local pad = G.goalPadPart and G.goalPadPart()
    if pad and pad.Parent then return pad.CFrame.Position, (G.goalOk and not G.goalOk()) and AMBER or GREEN end
    return nil, nil
  end

  -- 目标头顶的立体箭头：竖杆 + 两片斜板拼成「V」（朝下），一直转
  local big = {
    G.fxPart(nil, V(0.9, 4.2, 0.9), CFrame.new(), GREEN, Enum.Material.Neon, 1),
    G.fxPart(nil, V(0.9, 3.2, 0.9), CFrame.new(), GREEN, Enum.Material.Neon, 1),
    G.fxPart(nil, V(0.9, 3.2, 0.9), CFrame.new(), GREEN, Enum.Material.Neon, 1),
  }
  -- 一条发光的线（Beam）：脚底 → 目标
  local anchor = G.fxPart(nil, V(0.2, 0.2, 0.2), CFrame.new(), GREEN, Enum.Material.Neon, 1)
  local a1 = Instance.new("Attachment")
  a1.Parent = anchor
  local beam = Instance.new("Beam")
  beam.Attachment1 = a1
  beam.LightEmission = 1
  beam.Transparency = NumberSequence.new(0.45)
  beam.Width0, beam.Width1 = 0.6, 0.6
  beam.FaceCamera = true
  beam.Segments = 2
  beam.Enabled = false
  beam.Parent = anchor
  local function attach(char)
    local hrp = char and char:WaitForChild("HumanoidRootPart", 10)
    if not hrp then return end
    local a0 = Instance.new("Attachment")
    a0.Name = "GuideA0"
    a0.Position = V(0, -2.4, 0)
    a0.Parent = hrp
    beam.Attachment0 = a0
  end
  player.CharacterAdded:Connect(attach)
  if player.Character then task.spawn(attach, player.Character) end
  -- 屏幕边上的箭头（另开一个铺满屏幕的界面，坐标和 WorldToViewportPoint 一样）：两根短棒拼成「>」，整个转向目标
  local edgeGui = mk("ScreenGui", { Name = "GuideEdge", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 2 }, player:WaitForChild("PlayerGui"))
  local edge = mk("Frame", { AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(46, 46), BackgroundTransparency = 1, Visible = false }, edgeGui)
  local edgeBars = {}
  for _, sgn in ipairs({ -1, 1 }) do
    local bar = mk("Frame", { AnchorPoint = V2(0.5, 0.5), Position = UDim2.new(0.5, -3, 0.5, sgn * 8), Size = UDim2.fromOffset(26, 7), BackgroundColor3 = GREEN,
      BorderSizePixel = 0, Rotation = sgn * 40 }, edge)
    round(bar, 3)
    table.insert(edgeBars, bar)
  end
  -- 界面上要点的按钮：一圈粗描边一闪一闪
  local pulse = mk("UIStroke", { Color = AMBER, Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

  ---------------------------------------------------------------- ② 小地图

  local MAP = { x0 = -150, x1 = 250, z0 = -145, z1 = 345 }   -- 相对基地原点的范围（含路和部署区）
  local MW, MH = 128, 156
  local mm = mk("Frame", { BackgroundColor3 = RGB(14, 18, 24), BackgroundTransparency = 0.2, BorderSizePixel = 0, Position = UDim2.fromOffset(158, 276), Size = UDim2.fromOffset(MW + 12, MH + 30) }, ui.root)
  round(mm, 10)
  text(mm, { Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 22), TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = RGB(255, 214, 90), Text = "地图（上面是战场）" })
  local area = mk("Frame", { BackgroundColor3 = RGB(70, 96, 58), BorderSizePixel = 0, Position = UDim2.fromOffset(6, 24), Size = UDim2.fromOffset(MW, MH), ClipsDescendants = true }, mm)
  round(area, 6)
  ui.minimap = mm
  ui.minimapC = G.collapsible and G.collapsible(mm, function() return 28 end)
  -- 世界（相对原点的 x、z）→ 小地图上的位置：北（+Z）朝上，从上往下看时 +X 在左边
  local function at(x, z)
    return UDim2.fromScale(1 - (x - MAP.x0) / (MAP.x1 - MAP.x0), 1 - (z - MAP.z0) / (MAP.z1 - MAP.z0))
  end
  local function sizeOf(w, d)
    return UDim2.fromScale(w / (MAP.x1 - MAP.x0), d / (MAP.z1 - MAP.z0))
  end
  local function rect(x, z, w, d, color, tr, z0)
    return mk("Frame", { AnchorPoint = V2(0.5, 0.5), Position = at(x, z), Size = sizeOf(w, d), BackgroundColor3 = color, BackgroundTransparency = tr or 0, BorderSizePixel = 0, ZIndex = z0 or 1 }, area)
  end
  local hs = Config.BaseSize / 2
  local F = Config.Field
  rect(0, 0, Config.BaseSize, Config.BaseSize, RGB(150, 152, 150), 0, 1)                            -- 基地地面
  rect(0, (hs + F.center - F.length / 2) / 2, Config.BaseSize, F.center - F.length / 2 - hs, RGB(52, 54, 58), 0, 1)   -- 路
  local dep = rect(0, (F.deploy[1] + F.deploy[2]) / 2, F.width, F.deploy[2] - F.deploy[1], RGB(60, 120, 220), 0.45, 1)   -- 部署区
  text(dep, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = Enum.Font.GothamBold, Text = "部署区", ZIndex = 2 })
  local dyn = mk("Frame", { Name = "Dynamic", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2 }, area)
  local me = text(area, { AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(16, 16), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, Font = Enum.Font.GothamBold,
    TextColor3 = RGB(255, 255, 255), TextStrokeTransparency = 0.2, Text = "▲", ZIndex = 6 })
  local ring = mk("Frame", { AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ZIndex = 5, Visible = false }, area)
  mk("UIStroke", { Color = RGB(120, 255, 150), Thickness = 2 }, ring)
  round(ring, 7)

  local function dot(x, z, size, color, zi)
    local f = mk("Frame", { AnchorPoint = V2(0.5, 0.5), Position = at(x, z), Size = UDim2.fromOffset(size, size), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = zi or 3 }, dyn)
    round(f, size)
    return f
  end
  -- 楼、按钮、补给箱、部队：状态变了或隔半秒重画
  local function redraw()
    local S = G.S
    if not S then return end
    for _, c in ipairs(dyn:GetChildren()) do c:Destroy() end
    local owned = S.owned or {}
    for _, b in ipairs(Config.Buildings) do
      if owned[b.id] then
        local r = rect(b.x, b.z, b.size[1], b.size[3], RGB(84, 92, 100), 0, 2)
        r.Parent = dyn
      elseif (not b.req or owned[b.req]) and Config.AreaOpen(b, S.rebirth) then
        local px, pz = b.x, b.z - b.size[3] / 2 - 6
        if b.pad then px, pz = b.x + b.pad[1], b.z + b.pad[2] end
        dot(px, pz, 7, (S.cash >= b.price) and RGB(90, 255, 120) or RGB(230, 90, 70), 3)
      end
    end
    local o = S.origin
    for m in pairs(G.vis or {}) do
      if m.Parent and m:GetAttribute("Owner") == player.UserId and not m:GetAttribute("Dead") then
        local r = m:FindFirstChild("Root")
        if r and o then
          local p = r.CFrame.Position - o
          dot(p.X, p.Z, 4, RGB(110, 170, 255), 3)
        end
      end
    end
    if typeof(S.crate) == "Vector3" and o then
      local p = S.crate - o
      dot(p.X, p.Z, 9, RGB(255, 214, 80), 4)
    end
  end

  ---------------------------------------------------------------- 每帧

  local t = 0
  function G.stepGuide(dt)
    phase = (phase + dt * SPEED) % GAP
    t = t + dt
    local S = G.S
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    -- 地上的箭头（指引关了就都不画）
    local goal, color = target()
    if not on then goal = nil end
    local used = 0
    if goal and root and S and S.origin then
      local from = root.CFrame.Position
      local y = S.origin.Y + 1.15
      local a = V(from.X, y, from.Z)
      local b = V(goal.X, y, goal.Z)
      -- 在围墙里、目标在墙外：先指到门口（南边的新区域走南门，西边工业区走西门），出了门再直接指过去
      local hs = Config.BaseSize / 2
      local pr, gr = from - S.origin, goal - S.origin
      if math.abs(pr.X) < hs and math.abs(pr.Z) < hs then
        if gr.Z < -hs - 2 then
          b = S.origin + V((Config.SouthGate[1] + Config.SouthGate[2]) / 2, 1.15, -hs - 8)
        elseif gr.X < -hs - 2 then
          b = S.origin + V(-hs - 8, 1.15, (Config.Industry.gate[1] + Config.Industry.gate[2]) / 2)
        end
      end
      local d = b - a
      local len = d.Magnitude
      if len > 12 then
        local dir = d / len
        local base0 = CFrame.lookAt(a, a + dir)
        for i = 1, N do
          local s = phase + (i - 1) * GAP + 4
          if s > len - 5 then break end
          local cf = base0 * CFrame.new(0, 0, -s)
          local p = pool[i]
          p[1].CFrame = cf * LA
          p[2].CFrame = cf * LB
          local fade = math.clamp(math.min(s - 4, len - 5 - s) / 6, 0, 1)
          local tr = 1 - 0.75 * fade
          p[1].Transparency, p[2].Transparency = tr, tr
          p[1].Color, p[2].Color = color, color
          used = i
        end
      end
    end
    hideAll(used + 1)
    -- 头顶的立体箭头、发光的线、屏幕边的箭头
    local hrp = beam.Attachment0 and beam.Attachment0.Parent
    if goal and root and hrp then
      local tgt = goal + V(0, 0.6, 0)
      anchor.CFrame = CFrame.new(tgt)
      beam.Color = ColorSequence.new(color)
      beam.Enabled = (tgt - root.CFrame.Position).Magnitude > 14
      local now = os.clock()
      local base = CFrame.new(tgt + V(0, 9 + math.sin(now * 3) * 1.2, 0)) * CFrame.Angles(0, now * 2, 0)
      big[1].CFrame = base * CFrame.new(0, 2.6, 0)
      big[2].CFrame = base * CFrame.new(-0.9, 0.2, 0) * CFrame.Angles(0, 0, math.rad(40))
      big[3].CFrame = base * CFrame.new(0.9, 0.2, 0) * CFrame.Angles(0, 0, math.rad(-40))
      for _, p in ipairs(big) do
        p.Color = color
        p.Transparency = 0.05
      end
      local sp, onScreen = cam:WorldToViewportPoint(tgt)
      if onScreen and sp.Z > 0 then
        edge.Visible = false
      else
        local vs = cam.ViewportSize
        local cx, cy = vs.X / 2, vs.Y / 2
        local dx, dy = sp.X - cx, sp.Y - cy
        if sp.Z < 0 then dx, dy = -dx, -dy end
        local l = math.sqrt(dx * dx + dy * dy)
        if l < 1e-3 then dx, dy, l = 0, 1, 1 end
        dx, dy = dx / l, dy / l
        local k = math.min((cx - 50) / math.max(math.abs(dx), 1e-3), (cy - 50) / math.max(math.abs(dy), 1e-3))
        edge.Position = UDim2.fromOffset(cx + dx * k, cy + dy * k)
        edge.Rotation = math.deg(math.atan2(dy, dx))
        for _, b in ipairs(edgeBars) do b.BackgroundColor3 = color end
        edge.Visible = true
      end
    else
      beam.Enabled = false
      edge.Visible = false
      for _, p in ipairs(big) do p.Transparency = 1 end
    end
    -- 界面上要点的按钮：闪
    local btn = on and G.goalUiTarget and G.goalUiTarget() or nil
    if btn and btn.Visible and not G.battle then
      pulse.Parent = btn
      pulse.Transparency = 0.15 + 0.6 * (0.5 + 0.5 * math.sin(os.clock() * 6))
    else
      pulse.Parent = nil
    end
    -- 小地图
    local show = S ~= nil and not G.battle and G.mode ~= "drive" and not G.compact   -- 手机屏幕小，不放小地图（地上的箭头照样指路）
    mm.Visible = show
    if not show then return end
    if t > 0.5 then
      t = 0
      redraw()
    end
    if root and S.origin then
      local p = root.CFrame.Position - S.origin
      me.Position = at(p.X, p.Z)
      local lv = root.CFrame.LookVector
      me.Rotation = math.deg(math.atan2(-lv.X, lv.Z))
    end
    if goal and S.origin then
      local p = goal - S.origin
      ring.Visible = true
      ring.Position = at(p.X, p.Z)
      local k = 1 + 0.35 * math.sin(os.clock() * 5)
      ring.Size = UDim2.fromOffset(14 * k, 14 * k)
    else
      ring.Visible = false
    end
  end
end

return Guide
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000016">
<Properties>
<string name="Name">Play</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨（客户端）：操作和镜头——
--   free 在基地里走 / 战场上自己当兵（Roblox 默认镜头）；deploy 布阵；battle 观战；drive 开车 / 开直升机 / 开喷气机（追尾镜头，本地算位置，20 次 / 秒发给服务器）
--   布阵：镜头按屏幕上没被面板挡住的那块自动拉近、框住部署区；点部队选中（Shift 加选、双击选同兵种、空地上拖框多选、下面一排兵种点一下选一类），
--     按住拖动摆放（几个一起拖保持队形）、点空地放下（几个一起：就地排成一块，步兵在前）；服务器直接摆到位；「看敌军」看这一关的敌军摆在哪
--   观战（开战默认）：自动导播——还没接火从我军背后看过去，接火后框住交火的单位、平滑推拉；点单位跟着它（追尾），Tab 换下一个；
--     拖动 / WASD 平移变自由镜头，空格或「自动镜头」回自动；鼠标指着单位显示名称、血量；拿枪或「操控小人」切回自己的小人
--   拿枪：按住左键连发（狙击枪、火箭筒一下一发），R 换弹；手机点屏幕开火
--   支援技能：点技能键（或按 Z X V B N），地上出现范围圈跟着鼠标，左键放下（手机点一下战场），右键 / Esc 取消
--   战斗事件：命中标记、飘伤害数字、连杀播报、战报滚动条、首领来袭、结算评星
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local PPS = game:GetService("ProximityPromptService")
local GuiService = game:GetService("GuiService")

local Play = {}

local function wrap(a)
  return (a + math.pi) % (2 * math.pi) - math.pi
end

---------------------------------------------------------------- 布阵、观战：镜头和点选
-- 单独一个函数（都写进 Play.init，局部变量会超过 Luau 一个函数 200 个的上限）。
-- 对外：G.setMode、G.toggleDeploy、G.toggleOverview、G.toggleDeployView、G.followNext、G.specAuto、G.ctlStep、G.ctlDown / Move / Up / Wheel / Pinch / Turn / Key / Rotate、G.ctlClear
local function ctlInit(G, getControls)
  local Config = G.Config
  local UNITS = Config.Units
  local F = Config.Field
  local V, V2 = Vector3.new, Vector2.new
  local RGB = Color3.fromRGB
  local player = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local ui = G.ui
  local RA = G.R.Action
  local PI = math.pi
  local ZMIN, ZMAX = F.center - F.length / 2, F.center + F.length / 2
  local ORD = {}
  for i, t in ipairs(Config.UnitOrder) do ORD[t] = i end

  local orbit = { yaw = 0, pitch = math.rad(58), dist = 420, focus = V(0, 0, 0), origin = V(0, 0, 0) }
  local camCF = nil
  local rotating = false
  local fit = true            -- 布阵：还没手动缩放 / 平移 / 转，镜头一直框住整个区（面板收起、屏幕变了跟着重新框）
  local view = "mine"         -- 布阵看哪边：mine 部署区 / enemy 敌军区
  G.deployView = view
  local spec = { mode = "auto", m = nil, lost = 0, zoomK = 1, yawOff = 0, t = 99, focus = nil, dist = 600, hot = false }
  G.spec = spec
  local ptr = nil             -- 按下去的这一下（鼠标左键 / 一根手指）
  local touchN = 0
  local pinch0, turn0 = nil, nil
  local lastClick = { m = nil, t = 0 }
  local hoverP = nil          -- 鼠标在视口里的位置（电脑）
  local hintT = -99

  local function inset()
    local ok, a = pcall(function() return GuiService:GetGuiInset() end)
    if ok and typeof(a) == "Vector2" then return a end
    return V2(0, 0)
  end
  -- 输入事件的位置不含顶栏；镜头的投影、射线都用视口坐标（含顶栏）
  local function vpOf(input)
    return V2(input.Position.X, input.Position.Y) + inset()
  end
  local function shiftDown()
    return UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
  end
  local function groundY()
    return orbit.origin.Y + 1
  end

  ---------------------------------------------------------------- 取景

  local function open(c)
    return c == nil or not c.collapsed
  end
  -- 屏幕上没被面板挡住的那块（视口像素）：镜头按它取景，焦点落在它中间
  local function freeRect()
    local vs = cam.ViewportSize
    local W, H = vs.X, vs.Y
    local s = (ui.scale and ui.scale.Scale) or 1
    local top = inset().Y
    local c = G.compact
    local x0, x1, y0, y1
    if G.mode == "battle" then
      if c then
        x0, x1, y0, y1 = 10 * s, W - 128 * s, top + 60 * s, H - 150 * s
      else
        x0, x1, y0, y1 = 20 * s, W - 20 * s, top + 140 * s, H - 250 * s
      end
    else
      local infoOn = ui.info and ui.info.Visible and open(ui.infoC)
      local shopOn = ui.shop and ui.shop.Visible and open(ui.shopC)
      if c then
        x0 = (infoOn and 250 or 60) * s
        x1 = W - (shopOn and 306 or 14) * s
        y0, y1 = top + 92 * s, H - 152 * s
      else
        x0 = (infoOn and 300 or 160) * s
        x1 = W - (shopOn and 350 or 20) * s
        y0, y1 = top + 118 * s, H - 182 * s
      end
    end
    if x1 - x0 < W * 0.35 then x0, x1 = W * 0.3, W * 0.7 end
    if y1 - y0 < H * 0.3 then y0, y1 = H * 0.32, H * 0.72 end
    return { x0 = x0, x1 = x1, y0 = y0, y1 = y1 }
  end
  local function shrink(r, k)
    local dx, dy = (r.x1 - r.x0) * k, (r.y1 - r.y0) * k
    return { x0 = r.x0 + dx, x1 = r.x1 - dx, y0 = r.y0 + dy, y1 = r.y1 - dy }
  end
  -- 镜头摆法：从 focus 往后退 dist、按 yaw / pitch 看过去；再横着挪一点，让 focus 正好落在空着的那块的中间
  local function rig(focus, dist, r)
    local vs = cam.ViewportSize
    local th = math.tan(math.rad(cam.FieldOfView) / 2)
    local asp = vs.X / math.max(1, vs.Y)
    local cp = math.cos(orbit.pitch)
    local look = V(math.sin(orbit.yaw) * cp, -math.sin(orbit.pitch), math.cos(orbit.yaw) * cp)
    local right = V(-math.cos(orbit.yaw), 0, math.sin(orbit.yaw))
    local up = right:Cross(look)
    local cx = (r.x0 + r.x1) / vs.X - 1
    local cy = 1 - (r.y0 + r.y1) / vs.Y
    local eye = focus - look * dist - right * (cx * dist * th * asp) - up * (cy * dist * th)
    return { eye = eye, look = look, right = right, up = up, th = th, asp = asp, W = vs.X, H = vs.Y }
  end
  -- 这些点都落进那块里时，镜头最近能离多近（离得越远点越往中间挤：二分）
  local function fitDist(pts, focus, r, dmin, dmax)
    local vs = cam.ViewportSize
    local nx0, nx1 = r.x0 / vs.X * 2 - 1, r.x1 / vs.X * 2 - 1
    local ny0, ny1 = 1 - r.y1 / vs.Y * 2, 1 - r.y0 / vs.Y * 2
    local function ok(d)
      local R = rig(focus, d, r)
      for _, p in ipairs(pts) do
        local rel = p - R.eye
        local z = rel:Dot(R.look)
        if z < 1 then return false end
        local sx = rel:Dot(R.right) / (z * R.th * R.asp)
        local sy = rel:Dot(R.up) / (z * R.th)
        if sx < nx0 or sx > nx1 or sy < ny0 or sy > ny1 then return false end
      end
      return true
    end
    if ok(dmin) then return dmin end
    if not ok(dmax) then return dmax end
    local lo, hi = dmin, dmax
    for _ = 1, 16 do
      local mid = (lo + hi) / 2
      if ok(mid) then hi = mid else lo = mid end
    end
    return hi
  end
  -- 视口上一点对应的地面：按镜头「要去」的位置算（不按正在缓动的那个），拖地图才跟手、不晃
  local function groundRig(sp, focus)
    local R = rig(focus or orbit.focus, orbit.dist, freeRect())
    local nx, ny = sp.X / R.W * 2 - 1, 1 - sp.Y / R.H * 2
    local dir = R.look + R.right * (nx * R.th * R.asp) + R.up * (ny * R.th)
    if dir.Y > -1e-3 then return nil end
    local t = (groundY() - R.eye.Y) / dir.Y
    if t <= 0 then return nil end
    return R.eye + dir * t
  end
  -- 按现在的镜头：这一点的视线和地面（战场顶面）的交点
  local function groundCam(sp)
    local ray = cam:ViewportPointToRay(sp.X, sp.Y)
    if ray.Direction.Y > -1e-4 then return nil end
    local t = (groundY() - ray.Origin.Y) / ray.Direction.Y
    if t <= 0 or t > 8000 then return nil end
    return ray.Origin + ray.Direction * t
  end

  ---------------------------------------------------------------- 单位

  local function myF(name)
    local S = G.S
    local pf = S and workspace:FindFirstChild("Plots")
    local p = pf and pf:FindFirstChild("Plot" .. tostring(S.plot))
    return p and p:FindFirstChild(name)
  end
  local function aliveIn(folder, needUid)
    local out = {}
    if not folder then return out end
    for m, e in pairs(G.vis or {}) do
      if m.Parent == folder and e.clone and e.clone.Parent and not m:GetAttribute("Dead") and (not needUid or m:GetAttribute("Uid") ~= nil) then
        out[#out + 1] = { m = m, e = e, p = e.root.Position, t = m:GetAttribute("Type") }
      end
    end
    return out
  end
  local function mineList()
    return aliveIn(myF("Units"), true)
  end
  local function enemyPreview()
    return aliveIn(myF("Enemies"), false)
  end
  -- 这一仗里还活着的单位（两边都有；其他基地里的不算）
  local function battleList()
    local B = G.battle
    local out = {}
    if not B or not B.origin then return out end
    local o = B.origin
    local f = myF("Units")
    for m, e in pairs(G.vis or {}) do
      if m.Parent and e.clone and e.clone.Parent and not m:GetAttribute("Dead") then
        local p = e.root.Position
        local rel = p - o
        if math.abs(rel.X) < F.width / 2 + 180 and rel.Z > ZMIN - 240 and rel.Z < ZMAX + 240 and rel.Y < 700 then
          local t = m:GetAttribute("Type")
          out[#out + 1] = { m = m, e = e, p = p, t = t, def = UNITS[t or ""], friend = (m.Parent == f) or (m:GetAttribute("Owner") == player.UserId) }
        end
      end
    end
    return out
  end
  local function hpOf(m)
    local r = m:FindFirstChild("Root")
    local bb = r and r:FindFirstChild("HP")
    if not (bb and bb.Enabled) then return nil end
    local bg = bb:FindFirstChildOfClass("Frame")
    local fill = bg and bg:FindFirstChild("Fill")
    return fill and fill.Size.X.Scale or nil
  end

  -- 屏幕上离这一点最近的单位（按它在屏幕上多大，至少 18 像素：小兵也好点）
  local function pickScreen(sp, list)
    local best, bk = nil, 1
    local rv = cam.CFrame.RightVector
    for _, it in ipairs(list) do
      local def = UNITS[it.t or ""]
      local size = def and def.size or 8
      local c0 = it.p + V(0, (it.m:GetAttribute("H") or 4) * 0.45, 0)
      local a = cam:WorldToViewportPoint(c0)
      if a.Z > 0 then
        local b = cam:WorldToViewportPoint(c0 + rv * size * 0.5)
        local rad = math.max(18, math.abs(b.X - a.X) + math.abs(b.Y - a.Y) + 6)
        local d = math.sqrt((a.X - sp.X) ^ 2 + (a.Y - sp.Y) ^ 2) / rad
        if d < bk then best, bk = it, d end
      end
    end
    return best
  end
  -- 点下去指着哪个单位：先看视线直接打中的，打不中找屏幕上离得近的；顺便给出地面上的点
  local castP = RaycastParams.new()
  castP.FilterType = Enum.RaycastFilterType.Include
  local function pickAt(sp, list)
    local inc = { G.unitFolder }
    local fld = (G.mode == "deploy") and myF("Field") or nil
    if fld then inc[2] = fld end
    castP.FilterDescendantsInstances = inc
    local ray = cam:ViewportPointToRay(sp.X, sp.Y)
    local res = workspace:Raycast(ray.Origin, ray.Direction * 6000, castP)
    local ground = nil
    if res then
      local c = res.Instance
      while c and c.Parent ~= G.unitFolder do c = c.Parent end
      local m = c and G.serverModelOf(c)
      if m then   -- 打中的是单位：地面的点按视线和地面的交点（拖动时按它算挪了多远）
        for _, it in ipairs(list) do
          if it.m == m then return it, groundCam(sp) end
        end
      end
      if fld and res.Instance == fld then ground = res.Position end
    end
    ground = ground or groundCam(sp)
    return pickScreen(sp, list), ground
  end

  ---------------------------------------------------------------- 选中

  local sel, selN = {}, 0
  local hls = {}
  local function selChanged()
    selN = 0
    local one = nil
    for m in pairs(sel) do
      if m.Parent then
        selN = selN + 1
        one = m
      else
        sel[m] = nil
      end
    end
    -- 高亮：选得不多时每个都加（Roblox 同时最多显示 31 个高亮）；多了只靠脚下的圈
    for m, h in pairs(hls) do
      if not sel[m] or selN > 12 then
        h:Destroy()
        hls[m] = nil
      end
    end
    if selN <= 12 then
      for m in pairs(sel) do
        local c = G.cloneOf(m)
        if c and not hls[m] then
          hls[m] = G.mk("Highlight", { FillColor = RGB(255, 220, 80), FillTransparency = 0.6, OutlineColor = RGB(255, 240, 160), OutlineTransparency = 0,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, c)
        end
      end
    end
    if selN == 1 then
      G.sel = { m = one, clone = G.cloneOf(one), uid = one:GetAttribute("Uid"), t = one:GetAttribute("Type") }
      local def = UNITS[G.sel.t or ""]
      if def then ui.sellBtn.Text = "解散 +$" .. Config.Fmt(math.floor(def.price * 0.5)) end
    else
      G.sel = nil
    end
    G.selN = selN
    G.updateButtons()
  end
  local function selClear()
    for m in pairs(sel) do sel[m] = nil end
    selChanged()
  end
  G.ctlClear = selClear
  local function selectType(t, add)
    if not add then
      for m in pairs(sel) do sel[m] = nil end
    end
    for _, it in ipairs(mineList()) do
      if t == nil or it.t == t then sel[it.m] = true end
    end
    selChanged()
  end
  local function boxSelect(a, b, add)
    local x0, x1 = math.min(a.X, b.X), math.max(a.X, b.X)
    local y0, y1 = math.min(a.Y, b.Y), math.max(a.Y, b.Y)
    if not add then
      for m in pairs(sel) do sel[m] = nil end
    end
    for _, it in ipairs(mineList()) do
      local v = cam:WorldToViewportPoint(it.p + V(0, 2, 0))
      if v.Z > 0 and v.X >= x0 and v.X <= x1 and v.Y >= y0 and v.Y <= y1 then sel[it.m] = true end
    end
    selChanged()
  end

  ---------------------------------------------------------------- 摆放

  local function inZone(x, z)
    return z >= F.deploy[1] and z <= F.deploy[2] and math.abs(x) <= F.width / 2 - 4
  end
  -- 几个一起放到一点：就地排成一块（每排不超过 √(2.4n) 个；row 小的兵种在前＝朝敌人那边），整块尽量留在部署区里
  local function blockAt(items, x, z)
    table.sort(items, function(a, b)
      if a.row ~= b.row then return a.row < b.row end
      if a.t ~= b.t then return (ORD[a.t or ""] or 99) < (ORD[b.t or ""] or 99) end
      return (a.uid or 0) < (b.uid or 0)
    end)
    local cols = math.max(1, math.ceil(math.sqrt(#items * 2.4)))
    local lines = {}
    for i, it in ipairs(items) do
      local li = math.floor((i - 1) / cols) + 1
      local L = lines[li]
      if not L then
        L = { w = 0, d = 0, items = {} }
        lines[li] = L
      end
      local s = it.size + 5
      L.items[#L.items + 1] = it
      L.w = L.w + s
      L.d = math.max(L.d, s)
    end
    local depth, wmax = 0, 0
    for _, L in ipairs(lines) do
      depth = depth + L.d
      wmax = math.max(wmax, L.w)
    end
    local hw = F.width / 2 - 10
    if wmax / 2 < hw then x = math.clamp(x, -hw + wmax / 2, hw - wmax / 2) end
    local D1, D2 = F.deploy[1] + 2, F.deploy[2] - 2
    if depth < D2 - D1 then z = math.clamp(z, D1 + depth / 2, D2 - depth / 2) end
    local out = {}
    local zz = z + depth / 2
    for _, L in ipairs(lines) do
      local zc = zz - L.d / 2
      local xx = x + L.w / 2   -- 从北往南看，+X 在左：从左往右排
      for _, it in ipairs(L.items) do
        local s = it.size + 5
        out[#out + 1] = { it.uid, xx - s / 2, zc }
        xx = xx - s
      end
      zz = zz - L.d
    end
    return out
  end
  local function selItems()
    local items = {}
    for m in pairs(sel) do
      if m.Parent then
        local t = m:GetAttribute("Type")
        local def = UNITS[t or ""]
        items[#items + 1] = { uid = m:GetAttribute("Uid"), size = def and def.size or 8, row = def and def.row or 5, t = t, m = m }
      end
    end
    return items
  end
  -- 点空地：选中一个就放到这一点，几个就地排成一块
  local function groundPlan(g)
    if not (g and G.S) then return nil end
    local items = selItems()
    if #items == 0 then return nil end
    local rel = g - G.S.origin
    if #items == 1 then return { { items[1].uid, rel.X, rel.Z } }, rel end
    return blockAt(items, rel.X, rel.Z), rel
  end
  local function groundClick(g)
    if view ~= "mine" or not g then return end
    if selN == 0 then
      if os.clock() - hintT > 6 then
        hintT = os.clock()
        G.toast(G.mobile and "先点一下自己的部队（或下面一排的兵种），再点要放的位置" or "先点自己的部队选中（也能拖框、双击、点下面一排的兵种），再点要放的位置", "info")
      end
      return
    end
    local list, rel = groundPlan(g)
    if not list then return end
    if not inZone(rel.X, rel.Z) then
      G.toast("只能摆在蓝色的部署区里", "bad")
      return
    end
    RA:FireServer("place", list)
    G.playSound("click")
    selClear()
  end
  -- 拖动放手：选中的这些都挪同样一段（保持队形）
  local function dragPlan(off)
    local S = G.S
    local list, okN = {}, 0
    for m in pairs(sel) do
      local e = G.vis and G.vis[m]
      if e and m.Parent then
        local p = e.root.Position + off - S.origin
        list[#list + 1] = { m:GetAttribute("Uid"), p.X, p.Z, m }
        if inZone(p.X, p.Z) then okN = okN + 1 end
      end
    end
    return list, okN
  end
  local function dropSel(off)
    local list, okN = dragPlan(off)
    if #list == 0 then return false end
    if okN == 0 then
      G.toast("只能摆在蓝色的部署区里", "bad")
      return false
    end
    for _, e in ipairs(list) do e[4] = nil end
    RA:FireServer("place", list)
    G.playSound("click")
    return true
  end

  ---------------------------------------------------------------- 地上的圈、头顶的名字、屏幕上的框和提示

  local rings, ringN = {}, 0
  local function ring(x, z, d, color, tr)
    ringN = ringN + 1
    local r = rings[ringN]
    if not r then
      r = G.fxPart(Enum.PartType.Cylinder, V(0.25, 10, 10), CFrame.new(), color, Enum.Material.Neon, 1)
      rings[ringN] = r
    end
    r.Size = V(0.25, d, d)
    r.CFrame = CFrame.new(x, groundY() + 0.3, z) * CFrame.Angles(0, 0, PI / 2)
    r.Color = color
    r.Transparency = tr
  end
  local function ringsDone()
    for i = ringN + 1, #rings do
      if rings[i].Transparency < 1 then rings[i].Transparency = 1 end
    end
    ringN = 0
  end

  local tags = {}   -- [服务器的模型] = 头顶名字（布阵时）
  local function tagStep(on)
    for m, bb in pairs(tags) do
      if not m.Parent or not bb.Parent then
        if bb.Parent then bb:Destroy() end
        tags[m] = nil
      elseif not on then
        bb.Enabled = false
      end
    end
    if not on then return end
    for _, it in ipairs(mineList()) do
      local bb = tags[it.m]
      if not bb then
        local def = UNITS[it.t or ""]
        local name = def and (def.short or def.name) or "?"
        bb = G.mk("BillboardGui", { Name = "DeployTag", Adornee = it.e.root, Size = UDim2.fromOffset(16 + 13 * (utf8.len(name) or 2), 18),
          StudsOffsetWorldSpace = V(0, (it.m:GetAttribute("H") or 5) + 2.2, 0), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 1100 }, it.e.clone)
        local l = G.text(bb, { Name = "L", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.35, BackgroundColor3 = RGB(16, 20, 28), TextSize = 13,
          Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, Text = name })
        G.round(l, 5)
        tags[it.m] = bb
      end
      bb.Enabled = true
      local l = bb:FindFirstChild("L")
      if l then l.TextColor3 = sel[it.m] and RGB(255, 220, 90) or RGB(235, 240, 245) end
    end
  end

  local over = G.mk("ScreenGui", { Name = "CamOverlay", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 3 }, player:WaitForChild("PlayerGui"))
  local box = G.mk("Frame", { BackgroundColor3 = RGB(120, 200, 255), BackgroundTransparency = 0.85, BorderSizePixel = 0, Visible = false }, over)
  G.mk("UIStroke", { Color = RGB(160, 220, 255), Thickness = 1.5 }, box)
  local tip = G.text(over, { AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 0.2, BackgroundColor3 = RGB(14, 18, 24),
    TextSize = 14, RichText = true, Visible = false, ZIndex = 5 })
  G.round(tip, 6)
  G.mk("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, tip)

  -- 布阵时下面一排：每个兵种一个（点一下选上这一类，Shift 加选），最前面「全部」
  local chips = G.mk("ScrollingFrame", { Name = "Roster", BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AnchorPoint = V2(0.5, 1),
    Position = UDim2.new(0.5, 0, 1, -136), Size = UDim2.fromOffset(880, 36), CanvasSize = UDim2.fromOffset(0, 36), Visible = false }, ui.root)
  G.mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center,
    Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, chips)
  ui.roster = chips
  local chipSig, chipBtns, chipAll = "", {}, 0
  local function chipsStep(on)
    chips.Visible = on
    if not on then return end
    local c = G.compact
    if c then
      chips.Position, chips.Size = UDim2.new(0.5, 0, 1, -116), UDim2.fromOffset(680, 32)
    else
      chips.Position, chips.Size = UDim2.new(0.5, 0, 1, -136), UDim2.fromOffset(880, 36)
    end
    local all = mineList()
    local counts, order = {}, {}
    for _, it in ipairs(all) do
      local t = it.t
      if t and UNITS[t] then
        if not counts[t] then
          counts[t] = 0
          order[#order + 1] = t
        end
        counts[t] = counts[t] + 1
      end
    end
    table.sort(order, function(a, b) return (ORD[a] or 99) < (ORD[b] or 99) end)
    local sig = tostring(#all) .. (c and "c" or "")
    for _, t in ipairs(order) do sig = sig .. "," .. t .. counts[t] end
    if sig ~= chipSig then
      chipSig = sig
      chipAll = #all
      for _, b in ipairs(chipBtns) do b:Destroy() end
      chipBtns = {}
      local h = c and 28 or 32
      local total = 0
      local function add(label, n, t, i)
        local w = (c and 20 or 24) + (c and 13 or 15) * (utf8.len(label) or 2) + (c and 8 or 9) * #tostring(n)
        local b = G.button(chips, label .. " " .. n, RGB(40, 54, 72), { Size = UDim2.fromOffset(w, h), TextSize = c and 13 or 15, LayoutOrder = i }, function()
          selectType(t, shiftDown())
        end)
        b:SetAttribute("T", t or "*")
        chipBtns[#chipBtns + 1] = b
        total = total + w + 6
      end
      if #all > 0 then
        add("全部", #all, nil, 0)
        for i, t in ipairs(order) do add(UNITS[t].short or UNITS[t].name, counts[t], t, i) end
      end
      chips.CanvasSize = UDim2.fromOffset(math.max(total, 10), h + 4)
    end
    local selT = {}
    for m in pairs(sel) do selT[m:GetAttribute("Type") or ""] = true end
    for _, b in ipairs(chipBtns) do
      local t = b:GetAttribute("T")
      local lit = (t == "*" and selN > 0 and selN == chipAll) or (t ~= "*" and selT[t] == true)
      b.BackgroundColor3 = lit and RGB(176, 140, 40) or RGB(40, 54, 72)
    end
  end

  -- 鼠标指着的单位：旁边一个小框写名称、敌我、血量（电脑）
  local hoverT = 0
  local hoverIt = nil
  local function hoverStep(dt, active)
    hoverT = hoverT + dt
    if not active or G.mobile or not hoverP or (ptr and ptr.moved) or rotating then
      tip.Visible = false
      hoverIt = nil
      return
    end
    if hoverT < 0.06 then return end
    hoverT = 0
    local list
    if G.mode == "deploy" then
      list = (view == "mine") and mineList() or enemyPreview()
    else
      list = battleList()
    end
    local it = pickScreen(hoverP, list)
    hoverIt = it
    if not it then
      tip.Visible = false
      return
    end
    local def = UNITS[it.t or ""]
    local friend = (G.mode == "deploy" and view == "mine") or it.friend == true
    local s = def and def.name or "单位"
    local stars = it.m:GetAttribute("Stars") or 0
    if stars > 0 then s = s .. " <font color=\"#FFD24A\">" .. string.rep("★", stars) .. "</font>" end
    local side = friend and "<font color=\"#7CFC8A\">我方</font>" or "<font color=\"#FF8A80\">敌方</font>"
    local hp = (G.mode == "battle") and hpOf(it.m) or nil
    local extra = hp and string.format("  · 血量 %d%%", math.floor(hp * 100 + 0.5)) or ""
    if G.mode == "deploy" and view == "mine" and def then extra = "  · 射程 " .. def.range end
    if G.mode == "battle" and spec.m ~= it.m then extra = extra .. "  <font color=\"#B8C2CC\">（点一下跟随）</font>" end
    local sc = (ui.scale and ui.scale.Scale) or 1
    tip.TextSize = math.floor(14 * math.max(1, sc) + 0.5)
    tip.Text = side .. " " .. s .. extra
    tip.Position = UDim2.fromOffset(hoverP.X + 16, hoverP.Y + 14)
    tip.Visible = true
  end

  -- 选中了还没放：鼠标指着空地时画出会放到哪（绿色可以、红色不行）；拖动时画出每个的新位置
  local function ghostStep()
    if view ~= "mine" or selN == 0 or not G.S then return end
    local o = G.S.origin
    if ptr and ptr.drag and ptr.off then
      for _, e in ipairs((dragPlan(ptr.off))) do
        local def = UNITS[e[4]:GetAttribute("Type") or ""]
        ring(o.X + e[2], o.Z + e[3], ((def and def.size) or 8) + 2, inZone(e[2], e[3]) and RGB(90, 220, 120) or RGB(230, 80, 70), 0.45)
      end
      return
    end
    if G.mobile or not hoverP or hoverIt or ptr then return end
    local g = groundCam(hoverP)
    if not g then return end
    local list, rel = groundPlan(g)
    if not list then return end
    local okZ = inZone(rel.X, rel.Z)
    local sizes = {}
    for m in pairs(sel) do
      local def = UNITS[m:GetAttribute("Type") or ""]
      sizes[m:GetAttribute("Uid") or 0] = (def and def.size) or 8
    end
    for _, e in ipairs(list) do
      ring(o.X + e[2], o.Z + e[3], (sizes[e[1]] or 8) + 2, okZ and RGB(90, 220, 120) or RGB(230, 80, 70), 0.55)
    end
  end

  ---------------------------------------------------------------- 观战：自动导播、跟随

  local function baseYaw()
    local b = G.battle
    return (b and b.team == 2) and PI or 0
  end
  -- 交火的单位（离最近的敌人不到 260）：框住它们；还没接火框住我军（我军没了框敌军）。喷气机满场飞，不算
  local function directorUpdate(snap)
    local fr, en = {}, {}
    for _, it in ipairs(battleList()) do
      if not (it.def and it.def.jet) then
        if it.friend then fr[#fr + 1] = it else en[#en + 1] = it end
      end
    end
    local ENG2 = 260 * 260
    for _, a in ipairs(fr) do
      for _, b in ipairs(en) do
        local dx, dz = a.p.X - b.p.X, a.p.Z - b.p.Z
        local d2 = dx * dx + dz * dz
        if d2 < (a.near or 1e18) then a.near = d2 end
        if d2 < (b.near or 1e18) then b.near = d2 end
      end
    end
    local pts = {}
    for _, it in ipairs(fr) do
      if (it.near or 1e18) < ENG2 then pts[#pts + 1] = it.p end
    end
    for _, it in ipairs(en) do
      if (it.near or 1e18) < ENG2 then pts[#pts + 1] = it.p end
    end
    spec.hot = #pts >= 2
    if not spec.hot then
      pts = {}
      for _, it in ipairs((#fr > 0) and fr or en) do pts[#pts + 1] = it.p end
    end
    local y = groundY()
    local foc, dist
    if #pts == 0 then
      foc, dist = orbit.origin + V(0, 1, F.center), 700
    else
      local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
      for _, p in ipairs(pts) do
        x0, x1 = math.min(x0, p.X), math.max(x1, p.X)
        z0, z1 = math.min(z0, p.Z), math.max(z1, p.Z)
      end
      foc = V((x0 + x1) / 2, y, (z0 + z1) / 2)
      local fp = { foc + V(45, 0, 30), foc + V(-45, 0, -30), foc + V(45, 0, -30), foc + V(-45, 0, 30) }
      for _, p in ipairs(pts) do
        fp[#fp + 1] = V(p.X, y, p.Z)
        fp[#fp + 1] = V(p.X, math.max(p.Y, y) + 8, p.Z)
      end
      dist = fitDist(fp, foc, shrink(freeRect(), 0.06), 90, 1500)
    end
    spec.focus, spec.dist = foc, dist
    if snap then
      orbit.focus, orbit.dist = foc, math.clamp(dist * spec.zoomK, 60, 1600)
    end
  end
  local function specAuto(keepYaw)
    spec.mode, spec.m, spec.lost, spec.zoomK, spec.yawOff, spec.t = "auto", nil, 0, 1, 0, 99
    if not keepYaw then orbit.yaw = baseYaw() end
    orbit.pitch = math.rad(42)
    G.updateButtons()
  end
  function G.specAuto()
    if G.mode ~= "battle" then return end
    specAuto(false)
  end
  local function specFree()
    if spec.mode ~= "free" then
      spec.mode, spec.m = "free", nil
      orbit.focus = V(orbit.focus.X, groundY(), orbit.focus.Z)
      G.updateButtons()
    end
  end
  local function follow(m)
    if spec.mode ~= "follow" then spec.zoomK = 1 end
    spec.mode, spec.m, spec.lost, spec.yawOff = "follow", m, 0, 0
    orbit.pitch = math.rad(24)
    G.updateButtons()
  end
  G.followUnit = follow
  -- 换下一个跟随：我方的按兵种顺序轮着来（我方没了轮敌方）
  function G.followNext(dir)
    if G.mode ~= "battle" then return end
    local fr, en = {}, {}
    for _, it in ipairs(battleList()) do
      if it.friend then fr[#fr + 1] = it else en[#en + 1] = it end
    end
    local L = (#fr > 0) and fr or en
    if #L == 0 then
      specAuto(false)
      return
    end
    table.sort(L, function(a, b)
      local oa, ob = ORD[a.t or ""] or 99, ORD[b.t or ""] or 99
      if oa ~= ob then return oa < ob end
      return a.m.Name < b.m.Name
    end)
    local idx = 0
    for i, it in ipairs(L) do
      if it.m == spec.m then idx = i end
    end
    idx = ((idx - 1 + (dir or 1)) % #L) + 1
    follow(L[idx].m)
  end
  local function followStep(dt)
    local m = spec.m
    local e = m and G.vis and G.vis[m]
    if not e or not m.Parent or m:GetAttribute("Dead") or not e.clone.Parent then
      spec.lost = spec.lost + dt
      if spec.lost > 1.6 then G.followNext(1) end   -- 跟的那个没了：停一下再换下一个
      return
    end
    spec.lost = 0
    local def = UNITS[m:GetAttribute("Type") or ""]
    orbit.focus = e.root.Position + V(0, (m:GetAttribute("H") or 4) * 0.6, 0)
    local want = ((def and def.jet) and 190 or math.clamp(((def and def.size) or 8) * 3 + 34, 50, 150)) * spec.zoomK
    orbit.dist = orbit.dist + (want - orbit.dist) * (1 - math.exp(-dt * 2.5))
    if not rotating then   -- 追尾：慢慢转到它背后
      local lv = e.root.CFrame.LookVector
      if lv.X * lv.X + lv.Z * lv.Z > 0.05 then
        local chase = math.atan2(lv.X, lv.Z) + spec.yawOff
        orbit.yaw = orbit.yaw + wrap(chase - orbit.yaw) * (1 - math.exp(-dt * 1.4))
      end
    end
  end
  local function specStep(dt)
    if spec.mode == "follow" then
      followStep(dt)
    elseif spec.mode == "auto" then
      spec.t = spec.t + dt
      if spec.t > 0.35 or not spec.focus then
        spec.t = 0
        directorUpdate(false)
      end
      orbit.focus = orbit.focus:Lerp(spec.focus, 1 - math.exp(-dt * 1.6))
      local want = math.clamp(spec.dist * spec.zoomK, 60, 1600)
      orbit.dist = orbit.dist + (want - orbit.dist) * (1 - math.exp(-dt * 1.3))
    end
  end
  -- 跟随着的是不是自己能放技能的单位：返回 技能、战斗编号、还要冷却几秒
  local function followAbility()
    local m = spec.m
    if G.mode ~= "battle" or spec.mode ~= "follow" or not m or not m.Parent or m:GetAttribute("Dead") then return nil end
    if m.Parent ~= myF("Units") and m:GetAttribute("Owner") ~= player.UserId then return nil end
    local def = UNITS[m:GetAttribute("Type") or ""]
    local ab = def and not def.hidden and Config.Abilities[def.cat or ""]
    local bid = m:GetAttribute("BU")
    if not ab or not bid then return nil end
    return ab, bid, math.max(0, ((G.abCD and G.abCD[bid]) or 0) - os.clock())
  end
  function G.useAbility()
    local ab, bid, left = followAbility()
    if not ab then return false end
    if left > 0 then
      G.toast("「" .. ab.name .. "」还要冷却 " .. math.ceil(left) .. " 秒", "info")
      return true
    end
    RA:FireServer("ability", bid)
    return true
  end
  local function abilityButton()
    local b = ui.abilBtn
    if not b then return end
    local ab, _, left = followAbility()
    b.Visible = ab ~= nil and G.drive == nil
    if ab then
      b.Text = (left > 0) and (ab.name .. " " .. math.ceil(left) .. " 秒") or (ab.name .. (G.mobile and "" or "（F）"))
      b.BackgroundColor3 = (left > 0) and RGB(80, 74, 60) or RGB(176, 128, 34)
    end
  end
  local function camLabel()
    local L = ui.camL
    if not L then return end
    local line
    if spec.mode == "follow" and spec.m then
      local m = spec.m
      local def = UNITS[m:GetAttribute("Type") or ""]
      local friend = (m.Parent == myF("Units")) or m:GetAttribute("Owner") == player.UserId
      local hp = hpOf(m)
      local ab = followAbility()
      line = "跟随：" .. (friend and "<font color=\"#7CFC8A\">我方</font> " or "<font color=\"#FF8A80\">敌方</font> ") .. (def and def.name or "单位") ..
        (hp and string.format("  · 血量 %d%%", math.floor(hp * 100 + 0.5)) or "") ..
        (ab and ("  · <font color=\"#FFD24A\">技能「" .. ab.name .. "」</font>" .. (G.mobile and "" or " 按 F") .. "：" .. ab.desc) or "")
    elseif spec.mode == "auto" then
      line = spec.hot and "自动镜头 · 跟着交火的地方" or "自动镜头 · 看我军推进"
    else
      line = "自由镜头"
    end
    local tipLine = G.mobile and "点单位跟随 · 单指拖动平移 · 双指缩放、旋转" or "点单位跟随 · Tab 下一个 · 空格 自动镜头 · 拖动平移 · 右键转 · 滚轮缩放"
    L.Text = line .. "\n<font size=\"" .. (G.compact and 12 or 13) .. "\" color=\"#B8C2CC\">" .. tipLine .. "</font>"
  end

  ---------------------------------------------------------------- 布阵镜头

  local function deployFit()
    local Z = (view == "enemy") and F.enemy or F.deploy
    local o = orbit.origin
    orbit.focus = o + V(0, 1, (Z[1] + Z[2]) / 2)
    local hw, y = F.width / 2 + 4, groundY()
    local z0, z1 = o.Z + Z[1] - 6, o.Z + Z[2] + 6
    local pts = { V(o.X - hw, y, z0), V(o.X + hw, y, z0), V(o.X - hw, y, z1), V(o.X + hw, y, z1), V(o.X - hw, y + 10, z1), V(o.X + hw, y + 10, z1) }
    orbit.dist = fitDist(pts, orbit.focus, shrink(freeRect(), 0.02), 120, 2200)
  end
  local function enterDeploy()
    local S = G.S
    orbit.origin = S and S.origin or V(0, 0, 0)
    orbit.yaw, orbit.pitch = 0, math.rad(58)
    view = "mine"
    G.deployView = view
    fit = true
    deployFit()
    if G.compact and not G.deployTipShown then
      G.deployTipShown = true
      G.toast("点部队选中、点空地放下 · 按住部队拖动 · 单指拖地图、双指缩放 · 下面一排点一下选一类", "info")
    end
  end
  function G.toggleDeployView()
    if G.mode ~= "deploy" then return end
    view = (view == "mine") and "enemy" or "mine"
    G.deployView = view
    fit = true
    orbit.yaw, orbit.pitch = 0, math.rad(58)
    selClear()
    deployFit()
  end
  local function enterBattle()
    local b = G.battle
    orbit.origin = (b and b.origin) or (G.S and G.S.origin) or V(0, 0, 0)
    specAuto(false)
    spec.focus = nil
    directorUpdate(true)   -- 第一帧就摆好，接着自动导播接手
  end

  local function clampFocus()
    local o = orbit.origin
    local f = orbit.focus
    if G.mode == "deploy" then
      orbit.focus = V(math.clamp(f.X, o.X - 420, o.X + 420), f.Y, math.clamp(f.Z, o.Z - 160, o.Z + ZMAX + 120))
    else
      orbit.focus = V(math.clamp(f.X, o.X - F.width / 2 - 200, o.X + F.width / 2 + 200), f.Y, math.clamp(f.Z, o.Z + ZMIN - 200, o.Z + ZMAX + 200))
    end
  end
  local function camStep(dt)
    if not UIS:GetFocusedTextBox() then   -- 键盘：WASD 平移、Q / E 转
      local fwd = V(math.sin(orbit.yaw), 0, math.cos(orbit.yaw))
      local right = V(-math.cos(orbit.yaw), 0, math.sin(orbit.yaw))
      local mv = V(0, 0, 0)
      if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then mv = mv + fwd end
      if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then mv = mv - fwd end
      if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then mv = mv + right end
      if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then mv = mv - right end
      local turn = 0
      if UIS:IsKeyDown(Enum.KeyCode.Q) then turn = turn + 1 end
      if UIS:IsKeyDown(Enum.KeyCode.E) then turn = turn - 1 end
      if turn ~= 0 then
        if G.mode == "battle" and spec.mode == "follow" then spec.yawOff = spec.yawOff + turn * dt * 1.5 else orbit.yaw = orbit.yaw + turn * dt * 1.5 end
        fit = false
      end
      if mv.Magnitude > 0 then
        if G.mode == "battle" then specFree() end
        fit = false
        orbit.focus = orbit.focus + mv.Unit * dt * 300 * (orbit.dist / 600)
      end
    end
    if G.mode == "deploy" then
      if fit then deployFit() end
    else
      specStep(dt)
    end
    clampFocus()
    local R = rig(orbit.focus, orbit.dist, freeRect())
    local want = CFrame.lookAt(R.eye, R.eye + R.look)
    local k = 8
    if ptr and ptr.pan then
      k = 24
    elseif G.mode == "battle" and spec.mode == "follow" then
      k = 12
    end
    camCF = camCF and camCF:Lerp(want, 1 - math.exp(-dt * k)) or want
    cam.CFrame = camCF
  end

  ---------------------------------------------------------------- 模式

  function G.setMode(m)
    G.mode = m
    local controls = getControls()
    if m == "free" then
      cam.CameraType = Enum.CameraType.Custom
      local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
      if hum then cam.CameraSubject = hum end
      if controls then controls:Enable() end
      UIS.MouseBehavior = Enum.MouseBehavior.Default
      rotating = false
    else
      camCF = cam.CFrame
      cam.CameraType = Enum.CameraType.Scriptable
      if controls then
        if m == "drive" then controls:Enable() else controls:Disable() end
      end
      if m == "deploy" then
        enterDeploy()
      elseif m == "battle" then
        enterBattle()
      end
    end
    PPS.Enabled = (m == "free")   -- 布阵、观战、开车时别误触建筑旁的 E 提示
    ptr = nil
    box.Visible = false
    tip.Visible = false
    tagStep(m == "deploy")
    chipsStep(m == "deploy")
    selClear()
  end

  function G.toggleDeploy()
    if G.mode == "deploy" then
      G.setMode("free")
    elseif G.S then
      if G.S.n == 0 then G.toast("还没有部队：先盖兵营，再在右边「兵工厂」生产", "info") end
      G.setMode("deploy")
    end
  end
  function G.toggleOverview()
    if not G.battle then return end
    if G.mode == "battle" then G.setMode("free") else G.setMode("battle") end
  end

  ---------------------------------------------------------------- 输入（Play 的输入处理在合适的地方调进来）

  function G.ctlRotate(on)
    rotating = on and true or false
  end
  function G.ctlDown(input)
    local touch = input.UserInputType == Enum.UserInputType.Touch
    if touch then
      touchN = touchN + 1
      if touchN >= 2 then   -- 第二根手指：双指缩放 / 旋转，别再拖了
        ptr = nil
        box.Visible = false
        return
      end
    end
    local sp = vpOf(input)
    local now = os.clock()
    if G.mode == "deploy" then
      if not G.S or G.S.battle then return end
      local it, g = pickAt(sp, (view == "mine") and mineList() or {})
      if it then
        local m = it.m
        local shift = shiftDown()
        if lastClick.m == m and now - lastClick.t < 0.4 then   -- 双击：选上同兵种的全部
          lastClick.m = nil
          selectType(it.t, shift)
          ptr = { input = input, sp = sp, kind = "unit", m = m, g0 = g, keep = true, touch = touch }
          return
        end
        lastClick.m, lastClick.t = m, now
        local was = sel[m] == true
        if shift then
          if was then sel[m] = nil else sel[m] = true end
          selChanged()
        elseif not was then
          for k in pairs(sel) do sel[k] = nil end
          sel[m] = true
          selChanged()
        end
        ptr = { input = input, sp = sp, kind = "unit", m = m, g0 = g, was = was, shift = shift, touch = touch }
      else
        lastClick.m = nil
        ptr = { input = input, sp = sp, kind = touch and "pan" or "box", g0 = g, f0 = orbit.focus, touch = touch, shift = shiftDown() }
      end
    elseif G.mode == "battle" then
      if G.aim then
        ptr = { input = input, sp = sp, kind = "aim", touch = touch }
        return
      end
      local it = pickAt(sp, battleList())
      if it then
        follow(it.m)
        ptr = nil
        return
      end
      ptr = { input = input, sp = sp, kind = "pan", f0 = orbit.focus, touch = touch }
    end
  end
  local function pointerMove(sp)
    local p = ptr
    if not p.moved then
      if (sp - p.sp).Magnitude < (p.touch and 12 or 6) then return end
      p.moved = true
      if p.kind == "pan" then
        if G.mode == "battle" then specFree() end
        fit = false
        p.f0 = orbit.focus
        p.g0 = groundRig(p.sp, p.f0)
      end
    end
    p.cur = sp
    if p.kind == "unit" then
      local g = groundCam(sp)
      if g and p.g0 then p.off = V(g.X - p.g0.X, 0, g.Z - p.g0.Z) end
      p.drag = true
    elseif p.kind == "box" then
      p.box = true
      local x0, x1 = math.min(p.sp.X, sp.X), math.max(p.sp.X, sp.X)
      local y0, y1 = math.min(p.sp.Y, sp.Y), math.max(p.sp.Y, sp.Y)
      box.Position = UDim2.fromOffset(x0, y0)
      box.Size = UDim2.fromOffset(x1 - x0, y1 - y0)
      box.Visible = true
    elseif p.kind == "pan" then
      p.pan = true
      local g = groundRig(sp, p.f0)
      if g and p.g0 then orbit.focus = p.f0 + V(p.g0.X - g.X, 0, p.g0.Z - g.Z) end
    end
  end
  function G.ctlMove(input)
    local ut = input.UserInputType
    local mouse = ut == Enum.UserInputType.MouseMovement
    if mouse then
      if input.Position then hoverP = vpOf(input) end
      if rotating then
        local d = input.Delta
        if d then
          if G.mode == "battle" and spec.mode == "follow" then spec.yawOff = spec.yawOff - d.X * 0.008 else orbit.yaw = orbit.yaw - d.X * 0.008 end
          orbit.pitch = math.clamp(orbit.pitch + d.Y * 0.006, 0.2, 1.45)
          fit = false
        end
        return
      end
    elseif ut ~= Enum.UserInputType.Touch then
      return
    end
    if not ptr then return end
    if ptr.touch ~= (not mouse) then return end
    if ptr.touch and ptr.input ~= input then return end
    pointerMove(mouse and (hoverP or ptr.sp) or vpOf(input))
  end
  function G.ctlUp(input)
    local touch = input.UserInputType == Enum.UserInputType.Touch
    if touch then touchN = math.max(0, touchN - 1) end
    local p = ptr
    if not p or p.touch ~= touch or (touch and p.input ~= input) then return end
    ptr = nil
    box.Visible = false
    local sp = input.Position and vpOf(input) or p.cur or p.sp
    if G.mode == "deploy" then
      if not G.S or G.S.battle then return end
      if p.kind == "unit" then
        if p.drag and p.off then
          if dropSel(p.off) then selClear() end
        elseif not p.shift and not p.keep and p.was then
          if selN > 1 then   -- 点一下一群里的一个：只留它
            for k in pairs(sel) do sel[k] = nil end
            sel[p.m] = true
            selChanged()
          else               -- 再点一下自己：取消
            selClear()
          end
        end
      elseif p.box then
        boxSelect(p.sp, sp, p.shift)
      elseif not p.moved then
        groundClick(p.g0)
      end
    elseif G.mode == "battle" then
      if p.kind == "aim" and not p.moved and G.aim and G.castAt then G.castAt(sp.X, sp.Y, true) end
    end
  end
  function G.ctlWheel(input)
    local z = input.Position.Z
    if z == 0 then return end
    local f = math.clamp(1 - 0.12 * z, 0.5, 1.6)
    if G.mode == "battle" and spec.mode ~= "free" then
      spec.zoomK = math.clamp(spec.zoomK * f, 0.3, 3)
      return
    end
    fit = false
    local nd = math.clamp(orbit.dist * f, 50, 1800)
    local k = nd / orbit.dist
    local g = hoverP and groundRig(hoverP)
    if g then   -- 朝鼠标指着的地方缩放
      local fo = orbit.focus
      orbit.focus = V(g.X + (fo.X - g.X) * k, fo.Y, g.Z + (fo.Z - g.Z) * k)
    end
    orbit.dist = nd
  end
  function G.ctlPinch(scale, state)
    if state == Enum.UserInputState.Begin then
      pinch0 = { d = orbit.dist, k = spec.zoomK }
      ptr = nil
      box.Visible = false
    elseif pinch0 and scale > 0 then
      if G.mode == "battle" and spec.mode ~= "free" then
        spec.zoomK = math.clamp(pinch0.k / scale, 0.3, 3)
      else
        fit = false
        orbit.dist = math.clamp(pinch0.d / scale, 50, 1800)
      end
      if state == Enum.UserInputState.End then pinch0 = nil end
    end
  end
  function G.ctlTurn(rot, state)   -- 双指旋转（rot 是度数）
    local followTurn = G.mode == "battle" and spec.mode == "follow"
    if state == Enum.UserInputState.Begin then
      turn0 = followTurn and spec.yawOff or orbit.yaw
    elseif turn0 then
      local y = turn0 - math.rad(rot)
      if followTurn then spec.yawOff = y else orbit.yaw = y end
      fit = false
      if state == Enum.UserInputState.End then turn0 = nil end
    end
  end
  function G.ctlKey(kc)
    if G.mode == "battle" then
      if kc == Enum.KeyCode.F then
        return G.useAbility()
      elseif kc == Enum.KeyCode.Tab then
        G.followNext(shiftDown() and -1 or 1)
        return true
      elseif kc == Enum.KeyCode.Space then
        specAuto(false)
        return true
      end
    elseif G.mode == "deploy" and kc == Enum.KeyCode.Space then   -- 镜头复位（重新框住整个区）
      fit = true
      orbit.yaw, orbit.pitch = 0, math.rad(58)
      return true
    end
    return false
  end

  ---------------------------------------------------------------- 每帧

  local slowT = 0
  function G.ctlStep(dt)
    local active = (G.mode == "deploy" or G.mode == "battle") and not G.drive
    if active then camStep(dt) end
    if active and G.mode == "deploy" then
      for m in pairs(sel) do
        local e = G.vis and G.vis[m]
        if e and m.Parent then
          local def = UNITS[m:GetAttribute("Type") or ""]
          local p = e.root.Position
          ring(p.X, p.Z, ((def and def.size) or 8) + 3, RGB(255, 214, 80), 0.5)
        end
      end
      ghostStep()
    end
    ringsDone()
    hoverStep(dt, active)
    slowT = slowT + dt
    if slowT > 0.25 then
      slowT = 0
      local dep = active and G.mode == "deploy" and view == "mine"
      tagStep(dep)
      chipsStep(dep)
      if active and G.mode == "battle" then camLabel() end
      abilityButton()
    end
  end
end

function Play.init(G)
  local Config = G.Config
  local UNITS = Config.Units
  local F = Config.Field
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local player = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local ui = G.ui
  local RA, RShoot, RDrive = G.R.Action, G.R.Shoot, G.R.Drive
  local mouse = player:GetMouse()
  local XMAX = F.width / 2 - 6
  local ZMIN, ZMAX = F.center - F.length / 2 + 5, F.center + F.length / 2 - 5
  local JX, JZ0, JZ1 = F.width / 2 + 160, ZMIN - 200, ZMAX + 200   -- 喷气机能飞的范围（和服务器 Battle 一样）
  G.mode = "free"

  local controls = nil
  task.spawn(function()
    local ok, res = pcall(function()
      local pm = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 15))
      return pm:GetControls()
    end)
    if ok then controls = res end
  end)

  ctlInit(G, function() return controls end)

  function G.sellSelected()
    if G.sel then
      RA:FireServer("sell", G.sel.uid)
      G.ctlClear()
    end
  end

  ---------------------------------------------------------------- 瞄准点

  local aimParams = RaycastParams.new()
  aimParams.FilterType = Enum.RaycastFilterType.Exclude
  -- 电脑：鼠标指着的地方；手机（或开车时的手机）：屏幕中间的准星
  local function aimPoint(skip)
    local ex = { G.fxFolder }
    if player.Character then table.insert(ex, player.Character) end
    if skip then table.insert(ex, skip) end
    aimParams.FilterDescendantsInstances = ex
    local ray
    if G.mobile then
      local vs = cam.ViewportSize
      ray = cam:ViewportPointToRay(vs.X / 2, vs.Y / 2)
    else
      local mp = UIS:GetMouseLocation()
      ray = cam:ViewportPointToRay(mp.X, mp.Y)
    end
    local res = workspace:Raycast(ray.Origin, ray.Direction * 3000, aimParams)
    if res then return res.Position end
    return ray.Origin + ray.Direction * 3000
  end

  ---------------------------------------------------------------- 开车

  local driveCF = nil
  local driveRot = false   -- 开车时按住右键转镜头
  local function moveVector()
    if controls then
      local ok, mv = pcall(function() return controls:GetMoveVector() end)
      if ok and typeof(mv) == "Vector3" then return mv end
    end
    local x, z = 0, 0
    if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then z = z - 1 end
    if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then z = z + 1 end
    if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then x = x + 1 end
    if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then x = x - 1 end
    return V(x, 0, z)
  end

  local preDrive = "free"
  local function startDrive(ev)
    local m = nil
    for sm in pairs(G.vis or {}) do
      if sm.Parent and sm:GetAttribute("BU") == ev.bid then m = sm end
    end
    if not m then   -- 本地还没这辆车的模型：别让服务器以为在开（角色会一直藏着），直接下车
      RA:FireServer("exit")
      G.toast("这辆车还没加载出来，过一秒再试", "info")
      return
    end
    local root = m:FindFirstChild("Root")
    local o = ev.origin or (G.battle and G.battle.origin) or V(0, 0, 0)
    local p = root.CFrame.Position - o
    local lv = root.CFrame.LookVector
    local h = math.atan2(-lv.X, -lv.Z)
    local def = UNITS[ev.t]
    G.drive = { bid = ev.bid, t = ev.t, origin = o, x = p.X, z = p.Z, y = def.air and math.max(def.alt, p.Y - 1) or 0, h = h, ty = 0, spd = def.speed, roll = 0,
      camYaw = h, camPitch = math.rad(def.air and 20 or 16), sendT = 0, nextFire = os.clock() + (ev.cd or 0), firing = false, model = m, clone = G.cloneOf(m) }
    G.drive.cf = root.CFrame
    if G.mode ~= "drive" then preDrive = G.mode end
    driveCF = cam.CFrame
    G.setMode("drive")
    ui.cross.Visible = true
    ui.fireBtn.Visible = G.mobile
    ui.upBtn.Visible = G.mobile and def.air == true
    ui.downBtn.Visible = G.mobile and def.air == true
    local tip
    if def.jet then
      tip = G.mobile and "摇杆左右转弯、上下加减速，按住「升高」「降低」调高度，转镜头瞄准，按「开火」" or "W / S 加减速，A / D 转弯，空格升高、C 降低，鼠标瞄准、按住左键开火"
      if def.bombs then tip = tip .. "；轰炸机按一下扔一串炸弹（落在飞机前方）" end
    else
      tip = (G.mobile and "摇杆开车，转镜头瞄准，按「开火」" or "WASD 开车，鼠标瞄准，按住左键开火，右键拖动转镜头") ..
        (def.air and (G.mobile and "，按住「升高」「降低」调高度" or "，空格升高、C 降低") or "")
      if def.cargo then tip = tip .. (G.mobile and "；降到最低（按住「降低」）自动放下步兵" or "；降到最低（按住 C）自动放下步兵") end
    end
    G.toast(tip .. (G.mobile and "；下车点「下车」" or "；下车按 F"), "info")
  end

  local function stopDrive()
    G.drive = nil
    ui.cross.Visible = false
    ui.fireBtn.Visible = false
    ui.upBtn.Visible = false
    ui.downBtn.Visible = false
    driveRot = false
    if G.mode == "drive" then G.setMode((preDrive == "battle" and G.battle) and "battle" or "free") end   -- 原来在观战的，下车回观战
  end

  local function driveStep(dt)
    local dr = G.drive
    if not dr then return end
    local def = UNITS[dr.t]
    local mv = moveVector()
    if not driveRot then dr.camYaw = dr.camYaw + wrap(dr.h - dr.camYaw) * math.min(1, dt * ((def.air and not def.jet) and 0 or 1.5)) end
    if def.jet then   -- 喷气机：一直往前飞，W / S 加减速，A / D 转弯（压坡度），空格 / C 升降
      dr.spd = math.clamp(dr.spd + (-mv.Z) * def.speed * 0.8 * dt, def.speed * 0.6, def.speed * 1.15)
      dr.h = dr.h - mv.X * def.turn * 1.2 * dt
      dr.roll = dr.roll + (-mv.X * 0.8 - dr.roll) * math.min(1, dt * 4)
      dr.x = dr.x - math.sin(dr.h) * dr.spd * dt
      dr.z = dr.z - math.cos(dr.h) * dr.spd * dt
      if UIS:IsKeyDown(Enum.KeyCode.Space) or dr.climb == 1 then dr.y = math.min(220, dr.y + 40 * dt) end
      if UIS:IsKeyDown(Enum.KeyCode.C) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) or dr.climb == -1 then dr.y = math.max(40, dr.y - 40 * dt) end
    elseif def.air then
      local yaw = dr.camYaw
      local fwd, right = V(-math.sin(yaw), 0, -math.cos(yaw)), V(math.cos(yaw), 0, -math.sin(yaw))
      local move = right * mv.X + fwd * (-mv.Z)
      if move.Magnitude > 1 then move = move.Unit end
      dr.x = dr.x + move.X * def.speed * dt
      dr.z = dr.z + move.Z * def.speed * dt
      if UIS:IsKeyDown(Enum.KeyCode.Space) or dr.climb == 1 then dr.y = math.min(150, dr.y + 30 * dt) end
      if UIS:IsKeyDown(Enum.KeyCode.C) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) or dr.climb == -1 then dr.y = math.max(def.cargo and 6 or 15, dr.y - 30 * dt) end
      dr.h = dr.h + wrap(yaw - dr.h) * math.min(1, dt * 3)
    else
      local throttle = -mv.Z
      dr.h = dr.h - mv.X * 1.4 * dt
      local sp = def.speed * 1.1 * throttle
      dr.x = dr.x - math.sin(dr.h) * sp * dt
      dr.z = dr.z - math.cos(dr.h) * sp * dt
    end
    if def.jet then
      dr.x = math.clamp(dr.x, -JX, JX)
      dr.z = math.clamp(dr.z, JZ0, JZ1)
    else
      dr.x = math.clamp(dr.x, -XMAX, XMAX)
      dr.z = math.clamp(dr.z, ZMIN, ZMAX)
    end
    local aim = aimPoint(dr.clone)
    dr.aim = aim
    local rel = aim - dr.origin
    if def.turret then dr.ty = wrap(math.atan2(-(rel.X - dr.x), -(rel.Z - dr.z)) - dr.h) end
    dr.cf = CFrame.new(dr.origin + V(dr.x, 1 + dr.y, dr.z)) * CFrame.Angles(0, dr.h, 0) * CFrame.Angles(0, 0, dr.roll)
    dr.sendT = dr.sendT + dt
    local fire = nil
    local now = os.clock()
    if dr.firing and now >= dr.nextFire then
      fire = aim
      dr.nextFire = now + (def.bombs and def.rate * 0.5 or def.rate)
    end
    if dr.sendT >= 0.05 or fire then
      dr.sendT = 0
      RDrive:FireServer({ x = dr.x, z = dr.z, h = dr.h, y = dr.y, ty = dr.ty, fire = fire })
    end
    -- 追尾镜头
    local pos = dr.cf.Position
    local back, up = def.size * 1.5 + 22, def.size * 0.6 + 9
    local yaw, pitch = dr.camYaw, dr.camPitch
    local look = V(-math.sin(yaw) * math.cos(pitch), -math.sin(pitch), -math.cos(yaw) * math.cos(pitch))
    local want = CFrame.lookAt(pos - look * back + V(0, up, 0), pos + look * 30 + V(0, up * 0.4, 0))
    driveCF = driveCF and driveCF:Lerp(want, 1 - math.exp(-dt * 10)) or want
    cam.CFrame = driveCF
  end

  ---------------------------------------------------------------- 拿枪

  local gun = { id = nil, tool = nil, nextShot = 0, firing = false }
  local ammo = {}
  local function ammoOf(id)
    local w = Config.Weapons[id]
    local a = ammo[id]
    if not a then
      a = { n = w.mag, r = 0 }
      ammo[id] = a
    end
    if a.r > 0 and os.clock() >= a.r then
      a.n = w.mag
      a.r = 0
    end
    return a
  end
  local shotParams = RaycastParams.new()
  shotParams.FilterType = Enum.RaycastFilterType.Exclude
  local function tryFire()
    local id, tool = gun.id, gun.tool
    local char = player.Character
    if not id or not tool or not char or G.drive then return end
    local w = Config.Weapons[id]
    local a = ammoOf(id)
    local now = os.clock()
    if a.r > 0 or now < gun.nextShot then return end
    if a.n <= 0 then
      a.r = now + w.reload
      return
    end
    local head = char:FindFirstChild("Head")
    local handle = tool:FindFirstChild("Handle")
    if not head or not handle then return end
    gun.nextShot = now + w.rate
    a.n = a.n - 1
    if a.n <= 0 then a.r = now + w.reload end
    local aim = aimPoint()
    if G.mobile and mouse.Hit then aim = mouse.Hit.Position end
    local dir = aim - head.Position
    if dir.Magnitude < 0.5 then return end
    shotParams.FilterDescendantsInstances = { char, G.fxFolder }
    local res = workspace:Raycast(head.Position, dir.Unit * w.range, shotParams)
    local endP = res and res.Position or (head.Position + dir.Unit * w.range)
    local mz = handle:FindFirstChild("Muzzle")
    local muzzle = mz and mz.WorldPosition or head.Position
    G.gunFx(id, muzzle, endP, w.proj and ((endP - muzzle).Magnitude / w.speed) or nil)
    RShoot:FireServer(id, aim)
  end
  local function reload()
    local id = gun.id
    if not id then return end
    local w = Config.Weapons[id]
    local a = ammoOf(id)
    if a.r > 0 or a.n >= w.mag then return end
    a.r = os.clock() + w.reload
    RA:FireServer("reload", id)
  end
  local function onChar(char)
    task.spawn(function()
      local hum = char:WaitForChild("Humanoid", 10)
      if not hum then return end
      local last, lastT = hum.Health, 0
      hum.HealthChanged:Connect(function(h)
        if h < last - 4 and G.battle and os.clock() - lastT > 0.35 then
          lastT = os.clock()
          G.playSound("hurt")
        end
        last = h
      end)
    end)
    char.ChildAdded:Connect(function(c)
      if c:IsA("Tool") and c:GetAttribute("Weapon") then
        gun.id, gun.tool = c:GetAttribute("Weapon"), c
        c.Activated:Connect(function()
          if G.mobile then tryFire() end
        end)
        if G.mode == "battle" then G.setMode("free") end   -- 观战时拿起枪：切回自己的小人
      end
    end)
    char.ChildRemoved:Connect(function(c)
      if c == gun.tool then
        gun.id, gun.tool, gun.firing = nil, nil, false
      end
    end)
  end
  player.CharacterAdded:Connect(onChar)
  if player.Character then onChar(player.Character) end

  local function ammoHud()
    local dr = G.drive
    if dr then   -- 开车：显示还要装填几秒
      local def = UNITS[dr.t]
      local left = dr.nextFire - os.clock()
      ui.ammo.Visible = true
      ui.reloadBar.Visible = false
      ui.ammo.Text = def.name .. ((left > 0.05) and string.format("  装填 %.1f 秒", left) or "  可以开火")
      return
    end
    if not gun.id then
      ui.ammo.Visible = false
      ui.reloadBar.Visible = false
      return
    end
    local w = Config.Weapons[gun.id]
    local a = ammoOf(gun.id)
    ui.ammo.Visible = true
    if a.r > 0 then
      ui.ammo.Text = w.name .. "  换弹中…"
      ui.reloadBar.Visible = true
      ui.reloadBar.Size = UDim2.fromOffset(260 * math.clamp(1 - (a.r - os.clock()) / w.reload, 0, 1), 4)
    else
      ui.ammo.Text = w.name .. "  " .. a.n .. " / " .. w.mag .. (G.mobile and "" or "   R 换弹")
      ui.reloadBar.Visible = false
    end
  end

  ---------------------------------------------------------------- 支援技能

  G.aim = nil
  local aimRing, aimStrip = nil, nil
  local aimTipShown = false
  -- 屏幕上一点对应的战场地面（战场顶面 y = 原点 + 1 的平面）
  local function groundPoint(x, y, viewport)
    local B = G.battle
    if not B or not B.origin then return nil end
    local ray = viewport and cam:ViewportPointToRay(x, y) or cam:ScreenPointToRay(x, y)
    if math.abs(ray.Direction.Y) < 1e-4 then return nil end
    local t = (B.origin.Y + 1 - ray.Origin.Y) / ray.Direction.Y
    if t <= 0 or t > 6000 then return nil end
    return ray.Origin + ray.Direction * t
  end
  function G.toggleAim(id)
    if G.aim == id then
      G.aim = nil
      return
    end
    local sk = Config.SkillById[id]
    if not sk or not G.battle or not (G.skillHave and G.skillHave[id]) then return end
    local left = (G.skillReady[id] or 0) - os.clock()
    if left > 0 then
      G.toast("「" .. sk.name .. "」还要冷却 " .. math.ceil(left) .. " 秒", "info")
      return
    end
    G.aim = id
    if not aimTipShown then
      aimTipShown = true
      G.toast(G.mobile and "点战场上的位置放下「" .. sk.name .. "」（再点一次技能键取消）" or "左键点战场放下「" .. sk.name .. "」，右键或 Esc 取消（观战镜头更好瞄）", "info")
    end
  end
  local function castAt(x, y, viewport)
    local id = G.aim
    if not id then return false end
    local p = groundPoint(x, y, viewport)
    if not p then return true end
    local rel = p - G.battle.origin
    RA:FireServer("skill", id, rel.X, rel.Z)
    G.skillReady[id] = os.clock() + Config.SkillById[id].cd   -- 先在本地进入冷却，服务器放了会再确认
    G.aim = nil
    return true
  end
  G.castAt = castAt
  local function aimUpdate()
    local sk = G.aim and Config.SkillById[G.aim]
    if sk and not G.battle then G.aim, sk = nil, nil end
    if not aimRing then
      aimRing = G.fxPart(Enum.PartType.Cylinder, V(0.3, 10, 10), CFrame.new(), RGB(255, 200, 70), Enum.Material.Neon, 1)
      aimStrip = G.fxPart(nil, V(20, 0.3, 100), CFrame.new(), RGB(255, 120, 60), Enum.Material.Neon, 1)
    end
    aimRing.Transparency, aimStrip.Transparency = 1, 1
    if not sk then return end
    local mp = G.mobile and (cam.ViewportSize / 2) or UIS:GetMouseLocation()
    local p = groundPoint(mp.X, mp.Y, true)
    if not p then return end
    if sk.kind == "strike" then
      local dir = (G.battle.team == 2) and -1 or 1
      aimStrip.Size = V(22, 0.3, sk.len)
      aimStrip.CFrame = CFrame.new(p.X, p.Y + 0.4, p.Z) * CFrame.Angles(0, (dir < 0) and math.pi or 0, 0)
      aimStrip.Transparency = 0.5
    else
      local r = sk.r or 14
      aimRing.Size = V(0.3, r * 2, r * 2)
      aimRing.Color = (sk.kind == "heal") and RGB(90, 255, 140) or ((sk.kind == "drop") and RGB(120, 190, 255) or RGB(255, 200, 70))
      aimRing.CFrame = CFrame.new(p.X, p.Y + 0.4, p.Z) * CFrame.Angles(0, 0, math.pi / 2)
      aimRing.Transparency = 0.5
    end
  end
  local KEYSK = {}
  for _, sk in ipairs(Config.Skills) do KEYSK[Enum.KeyCode[sk.key]] = sk.id end

  ---------------------------------------------------------------- 战斗事件

  -- 连杀：4 秒内接着亲手击毁算连杀
  local streak, lastKill = 0, 0
  local STREAK = { [2] = "双杀！", [3] = "三杀！", [4] = "四杀！", [5] = "五杀！" }
  local function onKill(ev)
    local now = os.clock()
    streak = (now - lastKill < 4) and (streak + 1) or 1
    lastKill = now
    if streak >= 2 then G.announce(STREAK[streak] or "超神！", RGB(255, 120, 70), nil, 1.2) end
    local def = UNITS[ev.t]
    G.feedLine("你击毁了 <font color=\"#FF8A80\">敌方" .. (def and def.name or (ev.hero and "玩家" or "单位")) .. "</font>", RGB(255, 226, 120))
  end

  G.battle = nil
  local function counterTip(enemy)
    if not enemy then return "多造一些兵再来" end
    local function n(...)
      local s = 0
      for _, t in ipairs({ ... }) do s = s + (enemy[t] or 0) end
      return s
    end
    if n("stealth") > 0 then return "敌方有隐身轰炸机：只有爱国者和战斗机打得到它" end
    if n("ballistic") > 0 then return "敌方有弹道导弹车：专打你扎堆的地方，别挤成一团；带上爱国者能把导弹拦下来" end
    if n("gunship") > 0 then return "敌方有空中炮艇：在高空绕圈往下砸炮弹，带防空车、弹炮、激光防空、爱国者或者战斗机" end
    if n("swarm") > 0 then return "敌方有蜂群无人机车：一窝蜂的小无人机专撞车，多带防空车、激光防空、步兵把它们打下来" end
    if n("miner") > 0 then return "敌方会布雷：让皮厚的破障车开在最前面趟雷，或者用火炮、飞机远远地打" end
    if n("railgun") > 0 then return "敌方有电磁炮：一发打穿一整排，别排成一条长龙；直升机、攻击机绕过去打它"  end
    if n("drone", "fighter", "bomber") > 0 then return "敌方有高空的飞机（无人机 / 战斗机 / 轰炸机）：带弹炮防空车、爱国者、单兵防空组，或者自己的战斗机" end
    if n("loiter") > 0 then return "敌方有巡飞弹：一头撞上来专炸坦克，带防空车、步战车早点把它打下来" end
    if n("ew") > 0 then return "敌方有电子战车：导弹容易被干扰偏掉，多用坦克炮、火炮，或者先端掉它" end
    if n("heavytank") > 0 then return "敌方有重型坦克：反坦克导弹组、武装直升机、攻击机、巡飞弹专克它" end
    if n("heli", "transport", "attacker") > 0 then return "敌方有直升机 / 攻击机：带上防空车、步战车、单兵防空组，或者多带步兵" end
    if n("tank", "boss", "td", "breacher") >= 2 then return "敌方装甲多：武装直升机、反坦克导弹组、突击炮、攻击机专克装甲，火箭筒也行" end
    if n("cram") > 0 then return "敌方有拦截炮：炮弹、火箭弹会被打下来，用坦克、攻击机去端掉它" end
    if n("arty", "mlrs", "howitzer", "heavyarty", "mortar") > 0 then return "敌方有炮兵：别把步兵挤成一团；拦截炮能挡炮弹，开快车冲上去端掉它" end
    if n("sniper") > 0 then return "敌方有狙击手：用迫击炮、火炮、机枪车压制，你本人也小心" end
    return "多造一些兵再来，或者升级军工科技"
  end

  function G.onBattle(ev)
    if type(ev) ~= "table" then return end
    if ev.phase == "start" then
      ui.result.Visible = false
      ui.closeModals()
      G.battle = { origin = ev.origin, team = ev.team or 1, mode = ev.mode, title = ev.title or "", t0 = os.clock(), len = ev.time or Config.BattleTime,
        enemy = G.S and G.S.enemy }
      ui.bInfo.Text = ""
      G.skillReady = {}
      G.aim = nil
      streak = 0
      G.setMode("battle")   -- 开战默认观战镜头（自动跟着交火的地方）
      if ev.boss then
        G.announce("首领来袭！", RGB(255, 90, 70), "第 " .. tostring(ev.level) .. " 关 · 猛犸重坦——血极厚，集中火力、用支援技能", 2.6)
        G.jingle("alarm")
        G.shake(0.5)
      else
        G.announce("开战！", RGB(255, 214, 90), ev.title, 1.4)
      end
      G.toast(G.mobile and "观战镜头自动跟着交火的地方，点自己的单位跟随它、还能放技能；想亲自上阵点「操控小人」或拿起枪"
        or "观战镜头自动跟着交火的地方：点自己的单位跟随，按 F 放它的技能（冲锋、烟幕……），Tab 换下一个，空格回自动；想亲自上阵点「操控小人」或按 1 拿枪", "info")
      G.abCD = {}
      G.skyEvent = ev.event and ev.event.id or nil   -- 大雾、夜战：天色跟着变（Weather）
      if ev.event then
        task.delay(1.7, function()
          if G.battle then G.announce("战况：" .. tostring(ev.event.name), RGB(255, 170, 90), ev.event.desc, 2.6) end
        end)
      end
    elseif ev.phase == "tick" then
      if G.battle then G.battle.t0 = os.clock() - (ev.t or 0) end
      ui.bInfo.Text = "<font color=\"#7CFC8A\">我方 " .. tostring(ev.a) .. "</font>      <font color=\"#FF8A80\">敌方 " .. tostring(ev.e) .. "</font>"
      for _, f in ipairs(ev.feed or {}) do
        local def = UNITS[f.t]
        local nm = def and def.name or "单位"
        if f.en and not f.me then
          G.feedLine("击毁 <font color=\"#FF8A80\">敌方" .. nm .. "</font>", RGB(220, 230, 240))
          if f.t == "boss" then G.announce("首领被击毁！", RGB(255, 214, 90), nil, 1.8) end
        elseif not f.en and f.mine then
          G.feedLine("<font color=\"#FF8A80\">我方" .. nm .. " 被击毁</font>", RGB(255, 140, 130))
        end
      end
    elseif ev.phase == "hit" then
      if typeof(ev.p) == "Vector3" then
        G.popText(ev.p, (ev.k and "击毁 " or "") .. "-" .. tostring(ev.d), ev.k and RGB(255, 200, 60) or RGB(255, 255, 255))
      end
      G.hitMarker(ev.k)
      G.playSound(ev.k and "kill" or "hit")
      if ev.k then onKill(ev) end
    elseif ev.phase == "theater" then
      G.announce("进入新战区：" .. tostring(ev.name), RGB(120, 220, 255), ev.desc, 3.2)
      G.jingle("win")
    elseif ev.phase == "skill" then
      G.skillReady[ev.id] = os.clock() + (ev.cd or 0)
      G.playSound("buy")
    elseif ev.phase == "ability" then   -- 单位技能放出去了：这个单位冷却
      G.abCD = G.abCD or {}
      if ev.bid then G.abCD[ev.bid] = os.clock() + (ev.cd or 0) end
      G.feedLine("<font color=\"#FFD24A\">" .. tostring(ev.name) .. "！</font>", RGB(255, 226, 120))
    elseif ev.phase == "event" then   -- 战况：敌机突袭、空降增援
      G.announce(tostring(ev.text), RGB(255, 120, 80), ev.sub, 1.8)
      G.jingle("alarm")
    elseif ev.phase == "hero" then
      ui.rejoinBtn.Visible = (not ev.alive) and G.battle ~= nil and G.drive == nil
    elseif ev.phase == "drive" then
      startDrive(ev)
    elseif ev.phase == "exit" then
      stopDrive()
    elseif ev.phase == "end" then
      local enemy = G.battle and G.battle.enemy
      G.battle = nil
      G.aim = nil
      G.skyEvent = nil
      if G.clearMines then G.clearMines() end
      preDrive = "free"
      stopDrive()
      ui.rejoinBtn.Visible = false
      if G.mode == "battle" then G.setMode("free") end
      local win = ev.result == "win"
      ui.resTitle.Text = win and "胜利！" or ((ev.result == "timeout") and "时间到" or "失败")
      ui.resTitle.TextColor3 = win and RGB(255, 214, 90) or RGB(240, 110, 100)
      ui.resStars.Text = ev.stars and (string.rep("★", ev.stars) .. string.rep("☆", 3 - ev.stars)) or ""
      local lines = {}
      if ev.record then table.insert(lines, "新纪录！最高打到第 " .. tostring(ev.level) .. " 关") end
      if ev.text then table.insert(lines, ev.text) end
      local rewardLine = nil
      if win and (ev.reward or 0) > 0 then
        table.insert(lines, "")
        rewardLine = #lines
      elseif not win and ev.mode == "pve" then
        table.insert(lines, counterTip(enemy))
      end
      if (ev.pk or 0) > 0 then table.insert(lines, "你亲手击毁 " .. tostring(ev.pk) .. " 个敌方单位") end
      if (ev.lostN or 0) > 0 then
        local parts = {}
        for _, t in ipairs(Config.UnitOrder) do
          local n = ev.lost and ev.lost[t]
          if n then table.insert(parts, UNITS[t].name .. "×" .. n) end
        end
        table.insert(lines, "损失：" .. table.concat(parts, "  "))
      elseif ev.mode ~= "duel" then
        table.insert(lines, "一个都没损失！")
      end
      local function rewardText(v)
        return "奖励 $" .. Config.Fmt(v) .. ((ev.mode == "pve") and ("，下一关：第 " .. tostring(ev.level) .. " 关") or "")
      end
      if rewardLine then lines[rewardLine] = rewardText(0) end
      ui.resBody.Text = table.concat(lines, "\n")
      ui.result.Visible = true
      G.jingle(win and "win" or "lose")
      if win then G.announce("胜利！", RGB(255, 214, 90), ev.stars and (string.rep("★", ev.stars) .. string.rep("☆", 3 - ev.stars)) or nil, 1.6) end
      -- 奖励数字滚上去
      if rewardLine then
        task.spawn(function()
          local t0 = os.clock()
          while ui.result.Visible do
            local k = math.min(1, (os.clock() - t0) / 0.9)
            lines[rewardLine] = rewardText(math.floor(ev.reward * k * (2 - k)))
            ui.resBody.Text = table.concat(lines, "\n")
            if k >= 1 then break end
            task.wait(0.03)
          end
        end)
      end
    end
    G.updateButtons()
  end

  ---------------------------------------------------------------- 输入

  local function orbitMode()
    return not G.drive and (G.mode == "deploy" or G.mode == "battle")
  end
  UIS.InputBegan:Connect(function(input, gp)
    local ut = input.UserInputType
    if ut == Enum.UserInputType.MouseButton2 and G.aim then
      G.aim = nil   -- 右键取消技能瞄准
      return
    end
    if ut == Enum.UserInputType.MouseButton2 and G.mode ~= "free" then   -- 右键拖动转镜头
      if G.drive then driveRot = true else G.ctlRotate(true) end
      UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Escape and G.aim then
      G.aim = nil
      return
    end
    local skk = KEYSK[input.KeyCode]
    if skk and G.battle then
      G.toggleAim(skk)
      return
    end
    if ut == Enum.UserInputType.MouseButton1 then
      if G.aim and G.battle then
        castAt(input.Position.X, input.Position.Y, false)
      elseif G.drive then
        G.drive.firing = true
      elseif orbitMode() then
        G.ctlDown(input)
      elseif gun.id then
        gun.firing = true
        tryFire()
      end
    elseif ut == Enum.UserInputType.Touch then
      if orbitMode() then G.ctlDown(input) end
    elseif input.KeyCode == Enum.KeyCode.F and G.drive then
      RA:FireServer("exit")
    elseif input.KeyCode == Enum.KeyCode.R and gun.id then
      reload()
    elseif orbitMode() then
      G.ctlKey(input.KeyCode)
    end
  end)
  UIS.InputEnded:Connect(function(input)
    local ut = input.UserInputType
    if ut == Enum.UserInputType.MouseButton2 then
      driveRot = false
      G.ctlRotate(false)
      if G.mode ~= "free" then UIS.MouseBehavior = Enum.MouseBehavior.Default end
    elseif ut == Enum.UserInputType.MouseButton1 then
      gun.firing = false
      if G.drive then G.drive.firing = false end
      if orbitMode() then G.ctlUp(input) end
    elseif ut == Enum.UserInputType.Touch then
      if orbitMode() then G.ctlUp(input) end
    end
  end)
  UIS.InputChanged:Connect(function(input, gp)
    if G.mode == "free" then return end
    local ut = input.UserInputType
    if G.drive then
      if ut == Enum.UserInputType.MouseMovement and driveRot then
        G.drive.camYaw = G.drive.camYaw - input.Delta.X * 0.008
        G.drive.camPitch = math.clamp(G.drive.camPitch + input.Delta.Y * 0.005, -0.1, 1.2)
      end
      return
    end
    if not orbitMode() then return end
    if ut == Enum.UserInputType.MouseWheel then
      if not gp then G.ctlWheel(input) end
    elseif ut == Enum.UserInputType.MouseMovement or ut == Enum.UserInputType.Touch then
      G.ctlMove(input)
    end
  end)
  UIS.TouchTap:Connect(function(positions, gp)   -- 自己的小人上阵时（手机）：点一下放技能；布阵、观战走 ctlDown / ctlUp
    if gp or G.mode ~= "free" then return end
    local p = positions[1]
    if p and G.aim and G.battle then castAt(p.X, p.Y, false) end
  end)
  local pan0 = nil
  UIS.TouchPan:Connect(function(positions, total, velocity, state, gp)   -- 开车时单指拖动转镜头
    if not G.drive or gp or #positions ~= 1 then return end
    if state == Enum.UserInputState.Begin then
      pan0 = { yaw = G.drive.camYaw, pitch = G.drive.camPitch }
    elseif pan0 then
      G.drive.camYaw = pan0.yaw - total.X * 0.006
      G.drive.camPitch = math.clamp(pan0.pitch + total.Y * 0.004, -0.1, 1.2)
      if state == Enum.UserInputState.End then pan0 = nil end
    end
  end)
  UIS.TouchPinch:Connect(function(positions, scale, velocity, state, gp)
    if orbitMode() then G.ctlPinch(scale, state) end
  end)
  UIS.TouchRotate:Connect(function(positions, rotation, velocity, state, gp)
    if orbitMode() then G.ctlTurn(rotation, state) end
  end)
  -- 走到军工建筑旁按 E：兵工厂翻到这个建筑的页签
  PPS.PromptTriggered:Connect(function(prompt)
    local tab = prompt:GetAttribute("Tab")
    if tab and G.shopTab then G.shopTab(tab) end
  end)
  ui.fireBtn.MouseButton1Down:Connect(function()
    if G.drive then G.drive.firing = true end
  end)
  ui.fireBtn.MouseButton1Up:Connect(function()
    if G.drive then G.drive.firing = false end
  end)
  -- 手机：按住「升高」「降低」（松手或手指滑出按钮都停）
  for _, e in ipairs({ { ui.upBtn, 1 }, { ui.downBtn, -1 } }) do
    e[1].MouseButton1Down:Connect(function()
      if G.drive then G.drive.climb = e[2] end
    end)
    local function stop()
      if G.drive and G.drive.climb == e[2] then G.drive.climb = 0 end
    end
    e[1].MouseButton1Up:Connect(stop)
    e[1].MouseLeave:Connect(stop)
  end

  ---------------------------------------------------------------- 每帧

  local popT = 0
  function G.stepPlay(dt)
    if G.drive then driveStep(dt) end
    G.ctlStep(dt)   -- 布阵 / 观战的镜头、选中圈、名字、提示（别的模式下把它们藏起来）
    if gun.firing and gun.id and Config.Weapons[gun.id].auto and not G.aim then tryFire() end
    ammoHud()
    aimUpdate()
    if G.battle then
      local left = math.max(0, G.battle.len - (os.clock() - G.battle.t0))
      ui.bTitle.Text = string.format("%s   %d:%02d", G.battle.title, math.floor(left / 60), math.floor(left % 60))
    end
    -- 自己基地的楼顶隔几秒冒「+$」
    popT = popT + dt
    local S = G.S
    if popT >= 3 and S and G.mode == "free" and S.owned and not G.battle then
      popT = 0
      local mul = 1 + Config.Rebirth.income * (S.rebirth or 0)
      for id in pairs(S.owned) do
        local b = Config.BuildingById[id]
        if b and b.income then
          local v = Config.BuildingIncome(b, S.owned, S.lv and S.lv[id]) * mul
          local p = S.origin + V(b.x, 1 + b.size[2] + 2, b.z)
          if (p - cam.CFrame.Position).Magnitude < 260 then G.popText(p, "+$" .. Config.Fmt(v * 3), RGB(130, 235, 140)) end
        end
      end
    end
  end
end

return Play
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000017">
<Properties>
<string name="Name">UI</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨（客户端）：界面——钱、关卡、兵工厂、按钮、提示；任务、武器、排行榜、真人对战（排位匹配、同服约战）、重生、致谢；
-- 每日奖励、约战邀请、匹配中的状态条；战斗中的面板、支援技能栏、战报滚动条、命中标记、大字播报、结果（评星）；
-- 新手目标（左上角 + 指着下一个按钮的箭头）、低血量红边、出错红条；
-- 面板右上角「－ / ＋」收起展开（当前目标、信息栏、兵工厂、小地图），左边菜单整列能收起；菜单里「指引」开关、「回出生点」
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local UI = {}

-- 模型署名（CC-BY 要求在游戏里写明；和 roblox/models/credits.txt 一致）
local CREDITS = {
  "步兵：Army Character 2 —— MirzaArrafiERV_45",
  "步兵战车：M2 Bradley IFV —— 42manako",
  "主战坦克：M1A1 Abrams Main Battle Tank —— MirzaArrafiERV_45",
  "防空车：M163 VADS —— 42manako",
  "自行火炮：M109 PALADIN ARTILLERY —— Muhamad Mirza Arrafi",
  "火箭炮：Free M270 —— Mr. Penguin",
  "武装直升机：Boeing AH-64D Apache Combat Helicopter —— Muhamad Mirza Arrafi",
  "运兵直升机：Sikorsky UH-60M Blackhawk —— Muhamad Mirza Arrafi",
  "察打无人机：MQ-9 —— IProZenoN",
  "攻击机：A-10 Thunderbolt II —— AIRMAN Magazine",
  "战斗机：Chengdu J-20 Fighter —— andertan",
  "轰炸机：Chinese Xi'an H-6 —— 42manako",
  "机枪车：Oshkosh M-ATV —— 42manako",
  "突击炮：Chinese PTL-02 —— 42manako",
  "破障车：M1150 ABV —— Kalibrovshik",
  "弹炮防空车：Type-625 Anti Aircraft Gun Missile System —— Muhamad Mirza Arrafi",
  "拦截炮：Centurion C-RAM —— Muhamad Mirza Arrafi",
  "防空导弹：MIM-104 Patriot Air Defense System —— Muhamad Mirza Arrafi",
  "牵引榴弹炮：M777 howitzer —— miloschnack",
  "重型自行火炮：PANZERHAUBITZE 2000 ARTILLERY (PzH-2000) —— Muhamad Mirza Arrafi",
  "标枪：FGM-148 Javelin (Low-Poly) —— GoldbergR",
  "毒刺：FIM-92 Stinger (Low-Poly) —— GoldbergR",
  "迫击炮：Mortar - M224 —— jcherry3d",
  "机枪：Low-Poly M240B —— TastyTony",
  "以上模型都来自 Sketchfab，CC-BY-4.0 授权；只缩小了贴图、用了简化网格（PzH 2000 的贴图调亮了）",
}

function UI.init(G)
  local Config = G.Config
  local UNITS = Config.Units
  local RGB = Color3.fromRGB
  local V2 = Vector2.new
  local player = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local FONT, FONT2 = Enum.Font.GothamBold, Enum.Font.GothamMedium
  local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
  G.mobile = mobile
  -- 手机（触屏、屏幕窄边不到 600）：界面放大一些，换一套紧凑排版（ui.layout）；平板照电脑的排
  local function isCompact()
    local vs = cam.ViewportSize
    return mobile and math.min(vs.X, vs.Y) < 600
  end
  G.compact = isCompact()
  -- Roblox 自带的玩家列表在右上角，会盖住兵工厂和战报；同服务器的玩家在「真人对战」里能看到
  pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end)
  local RA = G.R.Action
  local ui = {}
  G.ui = ui

  local function mk(cls, props, parent)
    local o = Instance.new(cls)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
  end
  local function round(o, r)
    mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
    return o
  end
  local function outline(o, tr)
    mk("UIStroke", { Color = RGB(255, 255, 255), Transparency = tr or 0.86, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
    return o
  end
  local function text(parent, props)
    local t = mk("TextLabel", { BackgroundTransparency = 1, Font = FONT2, TextSize = 16, TextColor3 = RGB(236, 240, 244), TextXAlignment = Enum.TextXAlignment.Left, Text = "" })
    for k, v in pairs(props) do t[k] = v end
    t.Parent = parent
    return t
  end
  local function button(parent, txt, color, props, onClick)
    local b = mk("TextButton", { Text = txt, Font = FONT, TextSize = 18, TextColor3 = RGB(255, 255, 255), BackgroundColor3 = color, AutoButtonColor = true, BorderSizePixel = 0 })
    round(b, 8)
    for k, v in pairs(props or {}) do b[k] = v end
    b.Parent = parent
    if onClick then
      b.Activated:Connect(function(...)
        if G.playSound then G.playSound("click") end
        onClick(...)
      end)
    end
    return b
  end
  local function panel(parent, props)
    local f = mk("Frame", { BackgroundColor3 = RGB(14, 18, 24), BackgroundTransparency = 0.2, BorderSizePixel = 0 })
    round(f, 10)
    outline(f, 0.88)
    for k, v in pairs(props) do f[k] = v end
    f.Parent = parent
    return f
  end
  G.mk, G.round, G.text, G.button = mk, round, text, button

  -- 面板右上角的「－ / ＋」：收起时只留最上面一条（面板剪裁掉下面的内容，子元素的显示隐藏照旧归别处管），再点展开。
  -- 排版（ui.layout）会重设面板大小：排完调 c.apply() 再收一次。shortH 是函数：收起后留多高
  local collapsers = {}
  local function collapsible(f, shortH)
    local c = { collapsed = false, f = f, clip = f.ClipsDescendants }
    c.btn = button(f, "－", RGB(50, 56, 66), { AnchorPoint = V2(1, 0), Position = UDim2.new(1, -5, 0, 5), Size = UDim2.fromOffset(26, 24), TextSize = 15, ZIndex = f.ZIndex + 2 })
    -- 面板现在的大小不是自己收起时设的那个：是排版（或别处）刚设的完整大小，记下来
    function c.apply()
      if c.shrunk == nil or f.Size ~= c.shrunk then c.full = f.Size end
      if c.collapsed then
        f.ClipsDescendants = true
        c.shrunk = UDim2.new(c.full.X.Scale, c.full.X.Offset, 0, shortH())
        f.Size = c.shrunk
      else
        f.ClipsDescendants = c.clip
        c.shrunk = nil
        f.Size = c.full
      end
      c.btn.Text = c.collapsed and "＋" or "－"
    end
    c.btn.Activated:Connect(function()
      c.collapsed = not c.collapsed
      c.apply()
    end)
    table.insert(collapsers, c)
    return c
  end
  G.collapsible = collapsible

  local gui = mk("ScreenGui", { Name = "TycoonUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
  -- 按屏幕大小整体缩放：根框架先放大 1/s 倍再用 UIScale 缩 s 倍，正好铺满屏幕
  local root = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
  local uiScale = mk("UIScale", {}, root)
  ui.scale = uiScale   -- 镜头取景按它算面板在屏幕上占多大
  local function rescale()
    local vs = cam.ViewportSize
    G.compact = isCompact()
    local s
    if G.compact then
      s = math.clamp(vs.Y / 470, 0.62, 0.92)   -- 手机横屏 390 高：约 0.83，画布约 900 × 390
    else
      s = math.clamp(math.min(vs.X / 1280, vs.Y / 720) * 1.08, 0.5, 1.3)
    end
    uiScale.Scale = s
    root.Size = UDim2.fromScale(1 / s, 1 / s)
    if ui.layout then ui.layout() end
  end
  rescale()
  cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
  ui.root = root

  ---------------------------------------------------------------- 常驻面板

  local top = panel(root, { AnchorPoint = V2(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(420, 56) })
  local cashL = text(top, { Position = UDim2.fromOffset(18, 0), Size = UDim2.new(0.6, -18, 1, 0), Font = FONT, TextSize = 30, TextColor3 = RGB(255, 214, 90), Text = "$0" })
  local incL = text(top, { Position = UDim2.new(0.6, 0, 0, 0), Size = UDim2.new(0.4, -16, 1, 0), TextSize = 18, TextColor3 = RGB(130, 235, 140), TextXAlignment = Enum.TextXAlignment.Right, Text = "+0 / 秒" })

  -- 匹配中 / 传送中 / 对战服务器 的状态条（钱的下面）
  local mbar = panel(root, { AnchorPoint = V2(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), Size = UDim2.fromOffset(460, 40), Visible = false, ZIndex = 3 })
  local mbarL = text(mbar, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -120, 1, 0), TextSize = 15, Font = FONT, TextColor3 = RGB(255, 220, 140), ZIndex = 3 })
  local mbarBtn = button(mbar, "取消", RGB(120, 60, 52), { AnchorPoint = V2(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(90, 30), TextSize = 14, ZIndex = 3 },
    function() RA:FireServer("matchCancel") end)

  local info = panel(root, { Position = UDim2.fromOffset(10, 72), Size = UDim2.fromOffset(280, 196) })
  ui.info = info
  local lvL = text(info, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 28), Font = FONT, TextSize = 22, Text = "第 1 关" })
  local armyL = text(info, { Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -28, 0, 20), Text = "部队 0 / 4" })
  local enemyL = text(info, { Position = UDim2.fromOffset(14, 60), Size = UDim2.new(1, -28, 0, 52), TextSize = 14, TextWrapped = true, TextScaled = true, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = RGB(255, 165, 150) })
  mk("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 9 }, enemyL)
  local rewardL = text(info, { Position = UDim2.fromOffset(14, 112), Size = UDim2.new(1, -28, 0, 20), TextSize = 14, TextColor3 = RGB(255, 214, 90), RichText = true })
  local rankL = text(info, { Position = UDim2.fromOffset(14, 134), Size = UDim2.new(1, -28, 0, 20), TextSize = 15, Font = FONT, TextColor3 = RGB(255, 216, 106) })
  local xpBg = mk("Frame", { BackgroundColor3 = RGB(40, 44, 50), BorderSizePixel = 0, Position = UDim2.fromOffset(14, 157), Size = UDim2.new(1, -28, 0, 6) }, info)
  round(xpBg, 3)
  local xpFill = mk("Frame", { BackgroundColor3 = RGB(255, 200, 80), BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, xpBg)
  round(xpFill, 3)
  local ratingL = text(info, { Position = UDim2.fromOffset(14, 168), Size = UDim2.new(1, -28, 0, 20), TextSize = 13, TextColor3 = RGB(170, 190, 210) })

  ui.infoC = collapsible(info, function() return lvL.Position.Y.Offset + lvL.Size.Y.Offset + 6 end)

  -- 左边一列菜单按钮
  local menu = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 276), Size = UDim2.fromOffset(140, 300) }, root)
  local menuList = mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, menu)
  local menuGrid = mk("UIGridLayout", { CellSize = UDim2.fromOffset(76, 34), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = Enum.FillDirection.Horizontal })
  local modals = {}
  local modalSize = {}
  local function closeModals()
    for _, m in pairs(modals) do m.Visible = false end
  end
  local function open(name)
    local m = modals[name]
    local was = m.Visible
    closeModals()
    m.Visible = not was
    if m.Visible and ui.fill[name] then ui.fill[name]() end
  end
  ui.fill = {}
  local btnMission = button(menu, "任务", RGB(52, 84, 120), { Size = UDim2.fromOffset(140, 40), LayoutOrder = 1, TextSize = 16 }, function() open("missions") end)
  local btnBuild = button(menu, "建筑", RGB(64, 112, 70), { Size = UDim2.fromOffset(140, 40), LayoutOrder = 2, TextSize = 16 }, function() open("build") end)
  local btnWeapon = button(menu, "武器", RGB(60, 74, 60), { Size = UDim2.fromOffset(140, 40), LayoutOrder = 3, TextSize = 16 }, function() open("weapons") end)
  local btnBoard = button(menu, "排行榜", RGB(84, 70, 40), { Size = UDim2.fromOffset(140, 40), LayoutOrder = 4, TextSize = 16 }, function() open("board") end)
  local btnDuel = button(menu, "真人对战", RGB(150, 50, 46), { Size = UDim2.fromOffset(140, 40), LayoutOrder = 5, TextSize = 16 }, function() open("duel") end)
  local btnRebirth = button(menu, "重生", RGB(150, 110, 30), { Size = UDim2.fromOffset(140, 40), LayoutOrder = 6, TextSize = 16, Visible = false }, function() open("rebirth") end)
  local btnHome = button(menu, "回出生点", RGB(54, 70, 84), { Size = UDim2.fromOffset(140, 34), LayoutOrder = 7, TextSize = 14 }, function() RA:FireServer("home") end)
  local btnGuide = button(menu, "指引：开", RGB(40, 96, 60), { Size = UDim2.fromOffset(140, 34), LayoutOrder = 8, TextSize = 14 }, function()
    if G.toggleGuide then G.toggleGuide() end
  end)
  ui.guideBtn = btnGuide
  local btnCredits = button(menu, "致谢", RGB(54, 58, 66), { Size = UDim2.fromOffset(140, 34), LayoutOrder = 9, TextSize = 14 }, function() open("credits") end)
  -- 菜单最上面：收起 / 展开整列
  local menuCollapsed = false
  local btnMenu = button(menu, "菜单 －", RGB(40, 46, 56), { Size = UDim2.fromOffset(140, 30), LayoutOrder = 0, TextSize = 14 })
  local menuBtns = { btnMenu, btnMission, btnBuild, btnWeapon, btnBoard, btnDuel, btnRebirth, btnHome, btnGuide, btnCredits }
  btnMenu.Activated:Connect(function()
    menuCollapsed = not menuCollapsed
    btnMenu.Text = menuCollapsed and "菜单 ＋" or "菜单 －"
    for _, b in ipairs(menuBtns) do
      if b ~= btnMenu then b.Visible = not menuCollapsed end
    end
    btnRebirth.Visible = not menuCollapsed and G.S ~= nil and (G.S.rebirth or 0) < Config.Rebirth.max
  end)

  -- 右边：兵工厂（按页签分类：步兵 / 装甲 / 防空 / 炮兵 / 空中，可以滚动；最下面一行是军工科技）
  local ROWH = 62
  local shop = panel(root, { AnchorPoint = V2(1, 0), Position = UDim2.new(1, -10, 0, 72), Size = UDim2.new(0, 330, 1, -212) })
  local shopTitle = text(shop, { Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 28), Font = FONT, TextSize = 20, Text = "兵工厂" })
  -- 手机上兵工厂占的地方大：能收起，收起后右上角一个按钮再打开；布阵时自动收起
  local shopOpen = true
  local shopClose = button(shop, "收起", RGB(60, 66, 76), { AnchorPoint = V2(1, 0), Position = UDim2.new(1, -8, 0, 5), Size = UDim2.fromOffset(60, 24), TextSize = 13, Visible = false }, function()
    shopOpen = false
    G.updateButtons()
  end)
  local shopToggle = button(root, "打开兵工厂", RGB(45, 95, 165), { AnchorPoint = V2(1, 0), Position = UDim2.new(1, -6, 0, 4), Size = UDim2.fromOffset(124, 40), TextSize = 15, Visible = false }, function()
    shopOpen = true
    G.updateButtons()
  end)
  local tabBar = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -20, 0, 30) }, shop)
  mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, tabBar)
  local list = mk("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(6, 74), Size = UDim2.new(1, -12, 1, -80),
    CanvasSize = UDim2.fromOffset(0, 0), ScrollBarThickness = 5 }, shop)
  local rows = {}
  local rowParts = {}   -- 每一行（含科技行）的框、名字、说明、按钮：排版时一起改大小
  local function row(color)
    local r = mk("Frame", { BackgroundColor3 = color or RGB(255, 255, 255), BackgroundTransparency = color and 0.9 or 0.94, BorderSizePixel = 0, Size = UDim2.new(1, -10, 0, ROWH - 6) }, list)
    round(r, 8)
    local n = text(r, { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -112, 0, 22), Font = FONT, TextSize = 16 })
    local d = text(r, { Position = UDim2.fromOffset(10, 26), Size = UDim2.new(1, -112, 0, 28), TextSize = 11, TextWrapped = true, TextScaled = true, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = RGB(170, 180, 192) })
    local dc = mk("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 8 }, d)   -- 说明长的自动缩小，两行放得下
    table.insert(rowParts, { r = r, n = n, d = d, dc = dc })
    return r, n, d
  end
  for _, t in ipairs(Config.UnitOrder) do
    local def = UNITS[t]
    local r, n, d = row()
    n.Text = def.name
    d.Text = def.desc
    local b = button(r, "$" .. Config.Fmt(def.price), RGB(60, 150, 80), { AnchorPoint = V2(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(94, 40), TextSize = 15 },
      function() RA:FireServer("buy", t) end)
    rows[t] = { frame = r, name = n, btn = b }
    rowParts[#rowParts].b = b
  end
  local techRow, techName, techDesc = row(RGB(255, 214, 90))
  local techBtn = button(techRow, "", RGB(150, 120, 40), { AnchorPoint = V2(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(94, 40), TextSize = 15 },
    function() RA:FireServer("tech") end)
  rowParts[#rowParts].b = techBtn
  techName.TextColor3 = RGB(255, 222, 130)
  local tabBtns = {}
  local function showTab(id)
    ui.tab = id
    local i = 0
    for _, t in ipairs(Config.UnitOrder) do
      local r = rows[t]
      local on = UNITS[t].cat == id
      r.frame.Visible = on
      if on then
        r.frame.Position = UDim2.fromOffset(2, i * ROWH)
        i = i + 1
      end
    end
    techRow.Position = UDim2.fromOffset(2, i * ROWH)
    list.CanvasSize = UDim2.fromOffset(0, (i + 1) * ROWH)
    list.CanvasPosition = V2(0, 0)
    for tid, b in pairs(tabBtns) do b.BackgroundColor3 = (tid == id) and RGB(60, 110, 170) or RGB(44, 50, 60) end
  end
  for i, tab in ipairs(Config.Tabs) do
    tabBtns[tab.id] = button(tabBar, tab.name, RGB(44, 50, 60), { Size = UDim2.fromOffset(58, 28), LayoutOrder = i, TextSize = 14 }, function() showTab(tab.id) end)
  end
  showTab("foot")
  -- 走到军工建筑旁按 E：打开兵工厂、翻到这个建筑的页签
  G.shopTab = function(id)
    showTab(id)
    if not shopOpen then
      shopOpen = true
      G.updateButtons()
    end
  end
  ui.shop = shop
  ui.shopC = collapsible(shop, function() return shopTitle.Position.Y.Offset + shopTitle.Size.Y.Offset + 4 end)
  -- 指引要闪的「买」按钮
  function G.shopBtn(t)
    return rows[t] and rows[t].btn
  end

  -- 下面一排按钮（抬高一点，让开 Roblox 的物品栏）
  local bar = mk("Frame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 1), Position = UDim2.new(0.5, 0, 1, -78), Size = UDim2.fromOffset(900, 52) }, root)
  mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, bar)
  ui.deployBtn = button(bar, "布阵", RGB(45, 95, 165), { Size = UDim2.fromOffset(120, 48), LayoutOrder = 1 }, function() G.toggleDeploy() end)
  ui.arrangeBtn = button(bar, "一键排阵", RGB(70, 115, 75), { Size = UDim2.fromOffset(120, 48), LayoutOrder = 2, Visible = false }, function() RA:FireServer("arrange") end)
  -- 布阵时看一眼这一关的敌军摆在哪（再点回来）
  ui.eviewBtn = button(bar, "看敌军", RGB(128, 62, 56), { Size = UDim2.fromOffset(110, 48), LayoutOrder = 3, Visible = false }, function()
    if G.toggleDeployView then G.toggleDeployView() end
  end)
  ui.sellBtn = button(bar, "解散", RGB(120, 62, 52), { Size = UDim2.fromOffset(150, 48), LayoutOrder = 4, Visible = false }, function() G.sellSelected() end)
  ui.fightBtn = button(bar, "开战！", RGB(195, 52, 45), { Size = UDim2.fromOffset(140, 48), LayoutOrder = 5, TextSize = 22 }, function()
    if G.S and not G.S.battle then RA:FireServer("battle") end
  end)
  ui.raidBtn = button(bar, "突袭", RGB(150, 70, 30), { Size = UDim2.fromOffset(120, 48), LayoutOrder = 6 }, function()
    if G.S and not G.S.battle then RA:FireServer("raid") end
  end)
  ui.hqBtn = button(bar, "升级指挥部", RGB(125, 102, 40), { Size = UDim2.fromOffset(200, 48), LayoutOrder = 7, TextSize = 15, Visible = false }, function() RA:FireServer("hq") end)

  ui.hint = text(root, {
    AnchorPoint = V2(0.5, 1), Position = UDim2.new(0.5, 0, 1, -136), Size = UDim2.fromOffset(820, 24),
    TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, TextStrokeTransparency = 0.4, Visible = false,
    Text = mobile and "点部队选中、点空地放下 · 按住部队拖动 · 单指拖地图 · 双指缩放 · 下面一排点一下选一类"
      or "点部队选中（Shift 加选 · 双击选同兵种 · 空地上拖框）· 按住拖动摆放 · 点空地放下 · 滚轮缩放 · 右键转 · 空格复位",
  })

  ---------------------------------------------------------------- 战斗中


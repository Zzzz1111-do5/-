  -- 发射箱朝右（+X）起竖：侧面朝敌开火
  K.add(V(3.6, 2.4, 4.6), CF(1.6, 4.0, 1.4) * CFrame.Angles(0, 0, math.rad(-35)), col:Lerp(C.olive, 0.3), MAT.Metal)

<Item class="ModuleScript" referent="RBX00000000000000000000000000000002">
<Properties>
<string name="Name">Config</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：共享配置（ReplicatedStorage.Config，服务器和客户端都 require）
-- 数值都在这里调：建筑、兵种、关卡敌军、武器、军衔、重生、每日奖励与任务、突袭与约战
local Config = {}

Config.Version = "0.2"
Config.SaveKey = "MilitaryTycoon_v1"   -- DataStore 名字（改了就是新存档）
Config.StartCash = 300
Config.BaseCap = 4                     -- 没有指挥部时最多几个单位
Config.OfflineHours = 2                -- 离线收益最多算几小时
Config.OfflineRate = 0.2               -- 离线时按在线收入的几成算
Config.PlotCount = 6                   -- 一个服务器几块基地（游戏设置里「最多玩家数」也设成 6）
Config.PlotSpacing = 900               -- 基地之间的间距（X 方向）
Config.BaseSize = 260                  -- 基地边长
-- 战场在基地 +Z 方向；deploy / enemy 是我方部署区、敌军区的 Z 范围（相对基地中心）。单位按真实比例（约 2.2 格 = 1 米），战场跟着放大
Config.Field = { center = 570, width = 520, length = 820, deploy = { 170, 330 }, enemy = { 810, 970 } }
-- 约战竞技场：和战场一样大小，摆在所有基地的战场后面（原点 z = Arena.z），挑战方在南边（部署区），应战方在北边（敌军区）
Config.Arena = { z = 1300, xs = { -450, 450 } }
Config.Spawn = { x = 0, z = -120 }     -- 出生点（基地里，相对基地中心）
Config.BattleTime = 240                -- 一场最多几秒，到时算没打赢（活着的照样回来）
Config.Tick = 0.05                     -- 战斗推演步长（秒）
Config.MaxEnemy = 40                   -- 敌军最多几个单位；预算再多就加强属性

-- 每块基地的颜色（队伍色圈、旗子、部署区）；敌军统一暗红
Config.PlotColors = {
  Color3.fromRGB(52, 120, 220), Color3.fromRGB(70, 170, 80), Color3.fromRGB(230, 140, 40),
  Color3.fromRGB(150, 90, 210), Color3.fromRGB(40, 180, 180), Color3.fromRGB(215, 190, 50),
}
Config.EnemyColor = Color3.fromRGB(200, 50, 45)

-- 建筑：req 是前置（盖好它才出现这个的购买按钮）；x, z 是在基地里的位置；size 是外形 { 宽, 高, 深 }
--   kind：house 居民楼 / factory 工厂 / power 发电厂 / bank 银行 / mil 军工（units：能生产的兵种）/ hq 指挥部（cap：各级部队上限，up：升级价）
--   四排：z = -95 居民楼和银行、-45 工厂、30 军工、100 指挥部和直升机场；z = 60 那条横通道和中间 x ∈ [-70, 50] 的竖通道是部队开出去的路
Config.Buildings = {
  { id = "house1", name = "居民楼 A", kind = "house", price = 60, income = 5, x = -95, z = -95, size = { 18, 16, 18 } },
  { id = "barracks", name = "兵营", kind = "mil", units = { "inf" }, price = 300, req = "house1", x = -95, z = 30, size = { 26, 10, 18 } },
  { id = "house2", name = "居民楼 B", kind = "house", price = 300, income = 10, req = "house1", x = -40, z = -95, size = { 18, 22, 18 } },
  { id = "hq", name = "指挥部", kind = "hq", price = 800, req = "barracks", x = -95, z = 100, size = { 30, 14, 24 }, cap = { 10, 18, 30, 40 }, up = { 3000, 15000, 60000 } },
  { id = "factory1", name = "轻工厂", kind = "factory", price = 900, income = 20, req = "house2", x = -95, z = -45, size = { 26, 13, 22 } },
  { id = "tankfac", name = "装甲车厂", kind = "mil", units = { "ifv", "tank" }, price = 2500, req = "factory1", x = -40, z = 30, size = { 36, 18, 30 } },
  { id = "house3", name = "居民楼 C", kind = "house", price = 2000, income = 30, req = "factory1", x = 15, z = -95, size = { 18, 30, 18 } },
  { id = "power", name = "发电厂", kind = "power", price = 4000, req = "factory1", x = 15, z = -45, size = { 22, 20, 22 } },
  { id = "aafac", name = "防空车间", kind = "mil", units = { "aa" }, price = 6000, req = "tankfac", x = 15, z = 30, size = { 30, 14, 24 } },
  { id = "artyfac", name = "炮兵阵地", kind = "mil", units = { "arty", "mlrs" }, price = 9000, req = "tankfac", x = 80, z = 30, size = { 32, 9, 32 } },
  { id = "factory2", name = "重工厂", kind = "factory", price = 12000, income = 60, req = "power", x = -40, z = -45, size = { 28, 16, 24 } },
  { id = "helipad", name = "直升机场", kind = "mil", units = { "heli" }, price = 20000, req = "factory2", x = 85, z = 100, size = { 48, 3, 48 } },
  { id = "factory3", name = "军工联合体", kind = "factory", price = 45000, income = 150, req = "factory2", x = 80, z = -45, size = { 30, 20, 26 } },
  { id = "bank", name = "银行", kind = "bank", price = 120000, income = 350, req = "factory3", x = 80, z = -95, size = { 22, 28, 22 } },
}
Config.PowerBoost = 1.5   -- 有发电厂时工厂收入乘几

-- 军工科技：花钱升级，每级全军（我方）血量、伤害各 +bonus；后期的钱主要花在这里，高关卡靠它
Config.Tech = { base = 2500, growth = 1.5, bonus = 0.1, max = 40 }
function Config.TechCost(level)
  return math.floor(Config.Tech.base * Config.Tech.growth ^ level)
end

-- 兵种：dmg 每发伤害、rate 几秒一发（火箭炮是一轮齐射的间隔）、range 射程、speed 速度（格 / 秒）、size 占地（排阵、推开用）、len 模型长度（格）；
--   air 会飞（alt 飞行高度）；hitsAir 能打飞机；armor 装甲；vsArmor / vsAir / vsInf 打装甲 / 飞机 / 步兵的伤害倍数；
--   splash 溅射半径；minRange 最近射程；salvo 一轮几发；side 侧面朝敌开火（M270 的发射箱朝右）；prefer 优先打的目标（inf / armor / air）；
--   model 用哪个导入模型（没导入就用零件拼的）；needHQ 指挥部几级才能造
-- 克制：坦克克步兵，直升机克坦克，防空车克直升机，步兵人多能打直升机，火炮、火箭炮打扎堆的步兵，步战车什么都能打一点
Config.Units = {
  inf = { name = "步兵班", price = 60, hp = 110, dmg = 10, rate = 0.6, range = 120, speed = 14, size = 8, hitsAir = true,
    vsArmor = 0.2, vsAir = 0.3, vsInf = 1, prefer = "inf", model = "soldier", desc = "便宜，人多能打下直升机；打坦克几乎没用" },
  ifv = { name = "步兵战车", price = 350, hp = 460, dmg = 30, rate = 0.7, range = 170, speed = 26, size = 16, len = 15, armor = true, hitsAir = true,
    vsArmor = 0.45, vsAir = 0.7, vsInf = 1.3, prefer = "inf", model = "ifv", desc = "25 毫米机关炮，打步兵、直升机都行，挡不住坦克" },
  tank = { name = "主战坦克", price = 450, hp = 700, dmg = 90, rate = 2.4, range = 210, speed = 24, size = 22, len = 22, armor = true,
    vsArmor = 1, vsInf = 1.25, splash = 14, prefer = "armor", model = "tank", desc = "又硬又狠，克步兵、克装甲；怕直升机" },
  aa = { name = "防空车", price = 500, hp = 340, dmg = 28, rate = 0.5, range = 280, speed = 26, size = 14, len = 12, armor = true, hitsAir = true,
    vsAir = 3.2, vsArmor = 0.35, vsInf = 0.5, prefer = "air", model = "aa", desc = "加特林高炮，专打直升机；打地面很弱" },
  arty = { name = "自行火炮", price = 650, hp = 280, dmg = 75, rate = 4.5, range = 560, minRange = 100, speed = 18, size = 18, len = 16, armor = true,
    vsArmor = 0.8, vsInf = 1.4, splash = 32, prefer = "inf", model = "arty", desc = "射程很远，炮弹溅射，专打扎堆的步兵；被贴近就危险" },
  mlrs = { name = "火箭炮", price = 1400, hp = 300, dmg = 60, rate = 10, salvo = 6, range = 700, minRange = 150, speed = 18, size = 22, len = 16, armor = true,
    vsArmor = 0.7, vsInf = 1.3, splash = 26, side = true, prefer = "inf", model = "mlrs", needHQ = 2, desc = "一轮六发覆盖一片，射程最远；装填慢、怕近身" },
  heli = { name = "武装直升机", price = 900, hp = 420, dmg = 115, rate = 2.8, range = 300, speed = 50, size = 30, len = 30, air = true, alt = 70,
    vsArmor = 1.45, vsInf = 0.6, prefer = "armor", model = "heli", desc = "又快又狠，专克坦克；只有防空车、步兵、步战车打得到" },
  boss = { name = "猛犸重坦", price = 0, hp = 9000, dmg = 220, rate = 3, range = 260, speed = 14, size = 32, len = 30, armor = true,
    vsArmor = 1.2, vsInf = 1.2, splash = 22, prefer = "armor", model = "tank", boss = true, desc = "每十关的首领：血极厚" },
}
Config.UnitOrder = { "inf", "ifv", "tank", "aa", "arty", "mlrs", "heli" }
-- 玩家本人上阵（小人）：在推演里算一个步兵大小的目标，血量用角色的 Humanoid
Config.Hero = { hp = 200, size = 3, regen = 6, regenDelay = 5, respawn = 3 }

-- 玩家的武器（背包里的工具）：dmg 每发、rate 几秒一发、mag 弹匣、reload 换弹秒数、range 射程、spread 散布（度）；
--   proj 有弹道（火箭弹：speed 弹速，splash 溅射）；vsArmor / vsAir / vsInf 同兵种；pvp 打真人时的伤害倍数
Config.Weapons = {
  rifle = { name = "步枪", price = 0, dmg = 22, rate = 0.12, mag = 30, reload = 1.8, range = 450, spread = 0.8, vsArmor = 0.12, vsAir = 0.5, vsInf = 1, pvp = 1, auto = true },
  smg = { name = "冲锋枪", price = 3000, dmg = 14, rate = 0.065, mag = 40, reload = 1.6, range = 260, spread = 2.2, vsArmor = 0.08, vsAir = 0.4, vsInf = 1, pvp = 1, auto = true },
  sniper = { name = "狙击枪", price = 12000, dmg = 160, rate = 1.3, mag = 5, reload = 2.6, range = 1200, spread = 0, vsArmor = 0.3, vsAir = 0.7, vsInf = 1.2, pvp = 0.8 },
  rpg = { name = "火箭筒", price = 8000, dmg = 380, rate = 0.6, mag = 1, reload = 2.8, range = 700, spread = 0.6, proj = true, speed = 260, splash = 14,
    vsArmor = 1.6, vsAir = 1.1, vsInf = 0.8, pvp = 0.5 },
}
Config.WeaponOrder = { "rifle", "smg", "sniper", "rpg" }

-- 军衔：累计经验（打赢关卡、亲手击毁、突袭、约战）
Config.Ranks = {
  { 0, "列兵" }, { 50, "上等兵" }, { 150, "下士" }, { 350, "中士" }, { 700, "上士" }, { 1200, "少尉" }, { 2000, "中尉" }, { 3200, "上尉" },
  { 5000, "少校" }, { 7500, "中校" }, { 11000, "上校" }, { 16000, "大校" }, { 23000, "少将" }, { 33000, "中将" }, { 50000, "上将" },
}
function Config.RankOf(xp)
  local name, i = Config.Ranks[1][2], 1
  for k, r in ipairs(Config.Ranks) do
    if xp >= r[1] then name, i = r[2], k end
  end
  return name, i
end

-- 重生：打到 level 关、盖了银行就能重生——建筑、现金、关卡、部队、科技清零，换永久加成（每次收入 +income、部队血量伤害 +power）
Config.Rebirth = { level = 20, income = 0.5, power = 0.1 }

-- 每日奖励（连续登录，最多叠到 7 天）和每日任务（每天三个，按日期换）
Config.Daily = { base = 500, incomeSec = 90, step = 0.25, max = 7 }
Config.Missions = {
  { id = "win3", text = "打赢 3 场关卡", kind = "win", goal = 3 },
  { id = "kill10", text = "亲手（拿枪或开载具）击毁 10 个敌方单位", kind = "kill", goal = 10 },
  { id = "make8", text = "生产 8 个单位", kind = "make", goal = 8 },
  { id = "raid1", text = "突袭赢 1 次", kind = "raidwin", goal = 1 },
  { id = "drive3", text = "开载具击毁 3 个敌方单位", kind = "drivekill", goal = 3 },
  { id = "duel1", text = "和别的玩家约战 1 次", kind = "duel", goal = 1 },
  { id = "tech1", text = "升级 1 次军工科技", kind = "tech", goal = 1 },
  { id = "boss1", text = "打赢一场首领关", kind = "boss", goal = 1 },
  { id = "build2", text = "盖 2 栋建筑", kind = "build", goal = 2 },
}
Config.MissionRewardSec = 120   -- 任务奖励 = 这么多秒的收入（至少 400）

-- 突袭（打别的玩家存下来的防线，对方不在线也能打）和约战（同一个服务器里实时对战）
Config.Raid = { cooldown = 25, range = 250, start = 1000, k = 32, loot = 0.6, minUnits = 1 }
Config.Duel = { invite = 20, reward = 300, share = 0.2 }

-- 音效：填 "rbxassetid://数字"（Studio 工具箱 → 音频里搜，复制 ID）；留空就不放
Config.Sounds = { rifle = "", cannon = "", aa = "", rocket = "", boom = "", build = "", buy = "", win = "", lose = "", gun = "" }

-- 关卡敌军：预算按关卡往上涨，兵种逐渐解锁；每十关多一辆首领（同一关的敌军每次都一样，开打前就能看到）
function Config.EnemyBudget(level)
  return math.floor(150 * (1.28 ^ (level - 1)))
end
function Config.EnemyTypes(level)
  local t = { "inf" }
  if level >= 5 then table.insert(t, "ifv") end
  if level >= 6 then table.insert(t, "tank") end
  if level >= 7 then table.insert(t, "arty") end
  if level >= 8 then table.insert(t, "aa") end
  if level >= 9 then table.insert(t, "heli") end
  if level >= 12 then table.insert(t, "mlrs") end
  return t
end
function Config.IsBoss(level)
  return level % 10 == 0
end
function Config.Reward(level)
  local r = math.floor(Config.EnemyBudget(level) * 0.9 + 100 * level)
  if Config.IsBoss(level) then r = r * 2 end
  return r
end

-- 查表：建筑 id → 建筑；兵种 → 生产它的建筑 id
Config.BuildingById = {}
Config.UnitSource = {}
for _, b in ipairs(Config.Buildings) do
  Config.BuildingById[b.id] = b
  for _, u in ipairs(b.units or {}) do Config.UnitSource[u] = b.id end
end

-- 数字加千位分隔：12345 → 12,345
function Config.Fmt(n)
  local s = string.format("%.0f", math.floor(math.abs(n)))
  local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
  if out:sub(1, 1) == "," then out = out:sub(2) end
  if n < 0 then out = "-" .. out end
  return out
end

-- 天数（UTC），每日奖励、每日任务用
function Config.Day(t)
  return math.floor(t / 86400)
end

-- 某一天的三个任务（按日期定，同一天大家一样）
function Config.MissionsOf(day)
  local rng = Random.new(day * 131 + 7)
  local pool = {}
  for i = 1, #Config.Missions do pool[i] = i end
  local out = {}
  for _ = 1, 3 do
    local k = rng:NextInteger(1, #pool)
    table.insert(out, Config.Missions[pool[k]])
    table.remove(pool, k)
  end
  return out
end

return Config
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX00000000000000000000000000000003">
<Properties>
<string name="Name">UnitModels</string>
</Properties>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000000000000000000000000000000E">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX0000000000000000000000000000000D">
<Properties>
<string name="Name">Main</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：服务器主脚本（ServerScriptService.Main）
-- 各模块共用一个上下文 G：每个模块的 init(G) 把自己的函数挂到 G 上，模块之间通过 G 互相调用（不互相 require，免得循环引用）
--   World 地图 · Store 存档 / 排行榜 / 突袭匹配 · Economy 经济与成长 · Army 平时的部队 · Combat 战斗 · Weapons 玩家的枪
--   Models 模型 · Battle 推演
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS:WaitForChild("Config"))
local G = {
  Config = Config,
  Models = require(script:WaitForChild("Models")),
  Battle = require(script:WaitForChild("Battle")),
  states = {},   -- [player] = st
}
local V = Vector3.new

Players.CharacterAutoLoads = false   -- 分到基地以后再生成角色，出生在自己基地里

---------------------------------------------------------------- 远程事件

local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
G.R = {}
for _, name in ipairs({ "State", "Toast", "Action", "Fx", "Battle", "Shoot", "Drive", "Duel", "Board" }) do
  local r = Instance.new("RemoteEvent")
  r.Name = name
  r.Parent = Remotes
  G.R[name] = r
end
Remotes.Parent = RS

local fxq = {}
function G.fx(e)
  fxq[#fxq + 1] = e
end
function G.toast(st, msg, kind)
  G.R.Toast:FireClient(st.pl, msg, kind or "info")
end

-- 先收导入的原模型（在铺地形、建地图之前：没锚定的模型别掉下去砸在地上散开）
local imported = G.Models.loadImported()
if #imported > 0 then print("[军事大亨] 用上了导入的原模型：" .. table.concat(imported, "、")) end
for _, name in ipairs({ "World", "Store", "Economy", "Army", "Combat", "Weapons" }) do
  require(script:WaitForChild(name)).init(G)
end

local BDEF = Config.BuildingById

---------------------------------------------------------------- 发给客户端的状态

function G.push(st)
  local d = st.data
  if not d then return end
  local counts = {}
  for _, u in pairs(st.units) do counts[u.t] = (counts[u.t] or 0) + 1 end
  local enemy = {}
  for _, e in ipairs(st.enemy) do enemy[e.t] = (enemy[e.t] or 0) + 1 end
  local hqNext = nil
  if d.owned.hq and d.hq < #BDEF.hq.cap then hqNext = BDEF.hq.up[d.hq] end
  local techNext = nil
  if d.tech < Config.Tech.max then techNext = Config.TechCost(d.tech) end
  local rank, ri = Config.RankOf(d.xp)
  local nextXp = Config.Ranks[ri + 1] and Config.Ranks[ri + 1][1] or nil
  G.missionsFresh(st)
  local ms = {}
  for i, m in ipairs(d.missions.list) do
    local def = G.missionDef[m.id]
    if def then ms[i] = { text = def.text, goal = def.goal, prog = m.prog, claimed = m.claimed } end
  end
  local dOK, dAmt, dStreak = G.dailyInfo(st)
  local weapons = {}
  for id in pairs(d.weapons) do weapons[id] = true end
  local B = st.battle
  G.R.State:FireClient(st.pl, {
    cash = d.cash, income = st.income, level = d.level, best = d.best, cap = G.capOf(d), n = G.count(st), counts = counts,
    owned = d.owned, hq = d.hq, hqNext = hqNext, tech = d.tech, techNext = techNext, plot = st.plot.index, origin = st.plot.origin,
    battle = B ~= nil, mode = B and B.mode or nil, enemy = enemy, reward = Config.Reward(d.level), save = st.canSave,
    rebirth = d.rebirth, canRebirth = G.canRebirth(d), xp = d.xp, rank = rank, nextXp = nextXp, rating = d.rating, kills = d.kills,
    weapons = weapons, daily = { ok = dOK, amount = dAmt, streak = dStreak }, missions = ms, missionReward = G.missionReward(st),
    raidCD = math.max(0, math.ceil((st.raidCD or 0) - os.clock())), power = G.powerOf(d),
  })
  if st.ls then
    st.ls.cash.Value = math.floor(d.cash)
    st.ls.level.Value = d.level
    st.ls.rank.Value = rank
  end
  st.dirty = false
end

---------------------------------------------------------------- 进出服务器

local function spawnChar(st)
  if G.states[st.pl] ~= st or not st.pl.Parent then return end
  local ok, err = pcall(function() st.pl:LoadCharacter() end)
  if not ok then warn("[军事大亨] 生成角色失败：" .. tostring(err)) end
end

local function onCharacter(st, char)
  local hrp = char:WaitForChild("HumanoidRootPart", 10)
  if hrp and G.states[st.pl] == st then
    task.wait()
    local S, o = Config.Spawn, st.plot.origin
    char:PivotTo(CFrame.lookAt(o + V(S.x, 5, S.z), o + V(S.x, 5, S.z + 10)))
  end
  local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
  if hum then
    hum.Died:Connect(function()
      if st.driving then G.driveStop(st) end
      task.wait(Config.Hero.respawn)
      if G.states[st.pl] == st and st.pl.Character == char then spawnChar(st) end
    end)
  end
  if G.states[st.pl] == st and st.data then
    G.giveTools(st)
    G.rankTag(st)
  end
end

local function onPlayer(pl)
  if G.states[pl] then return end
  local plot = nil
  for _, p in ipairs(G.plots) do
    if not p.owner then
      plot = p
      break
    end
  end
  if not plot then
    pl:Kick("这个服务器的基地都有人了，换一个服务器吧")
    return
  end
  plot.owner = pl
  plot.sign.Text = pl.DisplayName .. " 的基地"
  local st = { pl = pl, plot = plot, units = {}, enemy = {}, pads = {}, padT = {}, nextUid = 0, income = 0, ready = false, canSave = false }
  G.states[pl] = st
  -- 排行榜（右上角玩家列表里显示）
  local ls = Instance.new("Folder")
  ls.Name = "leaderstats"
  local lv = Instance.new("IntValue")
  lv.Name = "关卡"
  lv.Value = 1
  lv.Parent = ls
  local cash = Instance.new("IntValue")
  cash.Name = "现金"
  cash.Parent = ls
  local rk = Instance.new("StringValue")
  rk.Name = "军衔"
  rk.Value = Config.Ranks[1][2]
  rk.Parent = ls
  ls.Parent = pl
  st.ls = { level = lv, cash = cash, rank = rk }
  pl.CharacterAdded:Connect(function(char) onCharacter(st, char) end)

  local raw, ok = G.loadData(pl)
  if G.states[pl] ~= st then return end   -- 读档的时候人走了
  st.data = G.cleanData(raw)
  st.canSave = ok
  local d = st.data
  G.econSetup(st)
  G.armySetup(st)
  G.makeEnemy(st)
  -- 离线收益：按在线的 OfflineRate 成，最多算 OfflineHours 小时
  local away = 0
  if type(raw) == "table" and type(raw.t) == "number" then away = os.time() - raw.t end
  if away > 60 and st.income > 0 then
    local earn = math.floor(st.income * math.min(away, Config.OfflineHours * 3600) * Config.OfflineRate)
    d.cash = d.cash + earn
    task.delay(4, function()
      if G.states[pl] == st then
        local h = (away >= 3600) and (math.floor(away / 3600) .. " 小时 " .. math.floor(away % 3600 / 60) .. " 分") or (math.floor(away / 60) .. " 分钟")
        G.toast(st, "离线收益 +$" .. Config.Fmt(earn) .. "（离开了 " .. h .. "）", "good")
      end
    end)
  end
  st.ready = true
  G.push(st)
  if pl.Character then task.spawn(onCharacter, st, pl.Character) else spawnChar(st) end
  task.delay(2, function()
    if G.states[pl] ~= st then return end
    if not ok then
      G.toast(st, "存档没读到，这次的进度不会保存（在 Studio 里测试：先发布，再在游戏设置 → 安全里打开 API 访问）", "bad")
    end
    if type(raw) ~= "table" then
      G.toast(st, "欢迎来到军事大亨！踩绿色按钮盖楼，楼会一直给你赚钱", "info")
      task.wait(6)
      if G.states[pl] == st then G.toast(st, "盖好兵营就能生产部队：右边「兵工厂」，或者走到兵营旁按 E", "info") end
      task.wait(6)
      if G.states[pl] == st then G.toast(st, "点「开战」打这一关；你本人也会上战场——拿着枪（物理栏 1）一起打，还能开自己的坦克", "info") end
    else
      local log = G.readRaidLog(pl)
      if log and G.states[pl] == st then
        local held = 0
        for _, e in ipairs(log) do
          if type(e) == "table" and e.w then held = held + 1 end
        end
        G.toast(st, "你不在的时候防线被突袭了 " .. #log .. " 次，守住 " .. held .. " 次", (held * 2 >= #log) and "good" or "bad")
      end
    end
  end)
end

Players.PlayerAdded:Connect(onPlayer)
for _, pl in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, pl) end

Players.PlayerRemoving:Connect(function(pl)
  local st = G.states[pl]
  if not st then return end
  if st.battle then G.abandon(st) end
  st.battle = nil
  if st.ready then G.save(st) end
  G.states[pl] = nil
  local plot = st.plot
  for _, name in ipairs({ "Buildings", "Pads", "Units", "Enemies" }) do plot[name]:ClearAllChildren() end
  plot.owner = nil
  plot.sign.Text = "空基地"
end)

game:BindToClose(function()
  local list = {}
  for _, st in pairs(G.states) do table.insert(list, st) end
  for _, st in ipairs(list) do
    if st.ready then G.save(st) end
  end
end)

---------------------------------------------------------------- 客户端发来的操作

local ACT = {
  buy = function(st, a) G.buyUnit(st, a) end,
  move = function(st, a, b, c) G.moveUnit(st, a, b, c) end,
  sell = function(st, a) G.sellUnit(st, a) end,
  arrange = function(st) G.arrange(st) end,
  battle = function(st) G.startBattle(st) end,
  raid = function(st) G.startRaid(st) end,
  duel = function(st, a) G.duelInvite(st, a) end,
  duelYes = function(st, a) G.duelAnswer(st, a, true) end,
  duelNo = function(st, a) G.duelAnswer(st, a, false) end,
  hq = function(st) G.upgradeHQ(st) end,
  tech = function(st) G.upgradeTech(st) end,
  rebirth = function(st) G.rebirth(st) end,
  daily = function(st) G.claimDaily(st) end,
  mission = function(st, a) G.claimMission(st, a) end,
  weapon = function(st, a) G.buyWeapon(st, a) end,
  reload = function(st, a) G.reload(st, a) end,
  drive = function(st, a) G.driveStart(st, a) end,
  exit = function(st) G.driveStop(st) end,
  rejoin = function(st) G.heroJoin(st) end,
  home = function(st) G.sendHome(st) end,
}
G.R.Action.OnServerEvent:Connect(function(pl, op, a, b, c)
  local st = G.states[pl]
  if not st or not st.ready or type(op) ~= "string" then return end
  -- 限流：每秒十来次
  local now = os.clock()
  st.tokens = math.min(15, (st.tokens or 15) + (now - (st.tokT or now)) * 10)
  st.tokT = now
  if st.tokens < 1 then return end
  st.tokens = st.tokens - 1
  local f = ACT[op]
  if f then f(st, a, b, c) end
end)

G.R.Shoot.OnServerEvent:Connect(function(pl, id, aim)
  local st = G.states[pl]
  if st and type(id) == "string" then G.shoot(st, id, aim) end
end)

G.R.Drive.OnServerEvent:Connect(function(pl, d)
  local st = G.states[pl]
  if not st or type(d) ~= "table" then return end
  G.driveInput(st, d)
  if d.fire ~= nil then G.driveFire(st, d.fire) end
end)

---------------------------------------------------------------- 循环

-- 每秒：收入、按钮颜色、状态
task.spawn(function()
  while true do
    task.wait(1)
    for _, st in pairs(G.states) do
      if st.ready and st.data then
        G.econTick(st)
        G.push(st)
      end
    end
  end
end)

-- 自动存档
task.spawn(function()
  while true do
    task.wait(90)
    local list = {}
    for _, st in pairs(G.states) do table.insert(list, st) end
    for _, st in ipairs(list) do
      if G.states[st.pl] == st and st.ready then G.save(st) end
    end
  end
end)

-- 排行榜：每分钟刷新一次牌子和界面
task.spawn(function()
  task.wait(8)
  while true do
    local lv, rt = G.readBoards()
    local function lines(title, list)
      local out = { title }
      for i, e in ipairs(list) do table.insert(out, i .. ". " .. e.name .. "  " .. Config.Fmt(e.value)) end
      if #list == 0 then table.insert(out, "（暂无）") end
      return table.concat(out, "\n")
    end
    local t1, t2 = lines("最高关卡", lv), lines("突袭积分", rt)
    for _, p in ipairs(G.plots) do
      p.board[1].Text = t1
      p.board[2].Text = t2
    end
    G.R.Board:FireAllClients({ level = lv, rating = rt })
    task.wait(60)
  end
end)

-- 每帧：平时的部队开来开去；特效攒一帧发一次
RunService.Heartbeat:Connect(function(dt)
  G.armyStep(dt)
  if #fxq > 0 then
    G.R.Fx:FireAllClients(fxq)
    fxq = {}
  end
end)
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000005">
<Properties>
<string name="Name">Army</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：部队（平时）：生产（从工厂开出来停到部署区）、阵位、挪位置、排阵、解散、关卡敌军预览
local Army = {}

function Army.init(G)
  local Config, Models, Battle = G.Config, G.Models, G.Battle
  local F = Config.Field
  local UNITS, BDEF = Config.Units, Config.BuildingById
  local hs = Config.BaseSize / 2
  local ROADZ = (hs + F.center - F.length / 2) / 2

  function G.count(st)
    local n = 0
    for _ in pairs(st.units) do n = n + 1 end
    return n
  end

  local function setFly(u, on)
    if u.model and u.model.Parent then u.model:SetAttribute("Fly", on) end
  end
  G.setFly = setFly

  local function newModel(st, u)
    local model, root = Models.unit(u.t, st.plot.color)
    model.Name = "U" .. u.uid
    model:SetAttribute("Uid", u.uid)
    model:SetAttribute("Type", u.t)
    model:SetAttribute("Owner", st.pl.UserId)
    model:SetAttribute("Fly", false)
    model.Parent = st.plot.Units
    u.model, u.root, u.bar, u.fill = model, root, nil, nil
    root.CFrame = G.unitCF(st.plot.origin, u.x, u.y, u.z, u.h)
  end

  function G.spawnUnit(st, t, x, z, y, h)
    st.nextUid = st.nextUid + 1
    local u = { uid = st.nextUid, t = t, x = x, y = y or 0, z = z, h = h or math.pi, sx = x, sz = z }
    newModel(st, u)
    st.units[u.uid] = u
    return u
  end

  -- 约战里打没了的单位：战后在阵位上换一个新模型（约战不损失部队）
  function G.respawnModel(st, u)
    if u.model then u.model:Destroy() end
    u.x, u.y, u.z, u.h, u.path = u.sx, 0, u.sz, math.pi, nil
    newModel(st, u)
  end

  -- 全部开回（直接放回）阵位
  function G.homeSnap(st)
    for _, u in pairs(st.units) do
      u.path = nil
      u.x, u.y, u.z, u.h = u.sx, 0, u.sz, math.pi
      setFly(u, false)
      if u.root and u.root.Parent then u.root.CFrame = G.unitCF(st.plot.origin, u.x, 0, u.z, u.h) end
    end
  end

  -- (x, z) 这个阵位空不空（跟别的部队的阵位比）
  local function spotFree(st, x, z, size, skip)
    for _, o in pairs(st.units) do
      if o ~= skip then
        local need = (size + UNITS[o.t].size) / 2 + 2
        local dx, dz = o.sx - x, o.sz - z
        if dx * dx + dz * dz < need * need then return false end
      end
    end
    return true
  end

  -- 找个空阵位：默认按兵种排在部署区里（步兵最前，火炮、火箭炮最后），从中间往两边一圈圈找
  local ROWOFF = { inf = 8, ifv = 26, tank = 44, aa = 64, heli = 86, arty = 112, mlrs = 136 }
  local function zoneOf(size)
    local D = F.deploy
    return F.width / 2 - 10 - size / 2, D[1] + size / 2 + 2, D[2] - size / 2 - 2
  end
  local function freeSpot(st, t, nearX, nearZ, skip)
    local size = UNITS[t].size
    local xmax, z1, z2 = zoneOf(size)
    local x0 = math.clamp(nearX or 0, -xmax, xmax)
    local z0 = math.clamp(nearZ or (F.deploy[2] - (ROWOFF[t] or 40)), z1, z2)
    local step = size + 3
    for ring = 0, 16 do
      local n = math.max(1, ring * 8)
      for k = 0, n - 1 do
        local a = k / n * math.pi * 2
        local x = x0 + math.cos(a) * ring * step
        local z = z0 + math.sin(a) * ring * step * 0.6
        if math.abs(x) <= xmax and z >= z1 and z <= z2 and spotFree(st, x, z, size, skip) then
          return x, z
        end
      end
    end
    return x0, z0
  end

  -- 新兵从工厂开出来：出门 → 横通道（z = 60）→ 中间通道 → 路上 → 阵位（直升机直接飞过去）
  local function exitPath(u, b)
    if UNITS[u.t].air then
      u.path = { { x = b.x, z = b.z, y = 40 }, { x = u.sx, z = u.sz, y = 40 }, { x = u.sx, z = u.sz, y = 0 } }
      setFly(u, true)
    else
      local gx = math.clamp(b.x, -60, 45)
      u.path = {
        { x = b.x, z = b.z + b.size[3] / 2 + 6, y = 0 },
        { x = b.x, z = 60, y = 0 },
        { x = gx, z = 60, y = 0 },
        { x = gx, z = ROADZ, y = 0 },
        { x = u.sx, z = u.sz, y = 0 },
      }
    end
  end

  -- 开到新位置（直升机先升空再落）
  function G.goTo(u, x, z)
    if UNITS[u.t].air then
      local cruise = math.max(u.y, 24)
      u.path = { { x = u.x, z = u.z, y = cruise }, { x = x, z = z, y = cruise }, { x = x, z = z, y = 0 } }
      setFly(u, true)
    else
      u.path = { { x = x, z = z, y = 0 } }
    end
  end

  local function stepPath(st, u, dt)
    local wp = u.path[1]
    local def = UNITS[u.t]
    local sp = (def.air and 50 or def.speed * 1.6) * dt
    local dx, dy, dz = wp.x - u.x, wp.y - u.y, wp.z - u.z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist <= sp then
      u.x, u.y, u.z = wp.x, wp.y, wp.z
      table.remove(u.path, 1)
      if #u.path == 0 then
        u.path = nil
        u.h = math.pi
        setFly(u, false)
      end
    else
      u.x = u.x + dx / dist * sp
      u.y = u.y + dy / dist * sp
      u.z = u.z + dz / dist * sp
      if dx * dx + dz * dz > 0.04 then Battle.turn(u, dx, dz, dt, 4) end
    end
    if u.root and u.root.Parent then u.root.CFrame = G.unitCF(st.plot.origin, u.x, u.y, u.z, u.h) end
  end

  -- 每帧：平时（不在打仗）的部队开来开去
  function G.armyStep(dt)
    for _, st in pairs(G.states) do
      if st.ready and not st.battle then
        for _, u in pairs(st.units) do
          if u.path then stepPath(st, u, dt) end
        end
      end
    end
  end

  function G.buyUnit(st, t)
    if not st.ready then return end
    local def = UNITS[t]
    if not def or def.boss then return end
    local d = st.data
    local src = BDEF[Config.UnitSource[t]]
    if not src or not d.owned[src.id] then
      G.toast(st, "先盖" .. (src and src.name or "工厂") .. "才能生产" .. def.name, "bad")
      return
    end
    if def.needHQ and d.hq < def.needHQ then
      G.toast(st, def.name .. "要指挥部 " .. def.needHQ .. " 级", "bad")
      return
    end
    if st.battle then
      G.toast(st, "打仗的时候不能生产", "bad")
      return
    end
    local cap = G.capOf(d)
    if G.count(st) >= cap then
      G.toast(st, "部队满了（" .. cap .. "）：" .. (d.owned.hq and "升级指挥部能带更多" or "盖指挥部能带更多"), "bad")
      return
    end
    if d.cash < def.price then
      G.toast(st, "钱不够：" .. def.name .. " 还差 $" .. Config.Fmt(def.price - d.cash), "bad")
      return
    end
    d.cash = d.cash - def.price
    local x, z = freeSpot(st, t)
    local u = G.spawnUnit(st, t, src.x, src.z, def.air and 0.8 or 0, math.pi)
    u.sx, u.sz = x, z
    exitPath(u, src)
    G.progress(st, "make", 1)
    G.push(st)
  end

  function G.moveUnit(st, uid, x, z)
    if st.battle then return end
    if type(uid) ~= "number" or type(x) ~= "number" or type(z) ~= "number" then return end
    if x ~= x or z ~= z then return end
    local u = st.units[uid]
    if not u then return end
    local size = UNITS[u.t].size
    local xmax, z1, z2 = zoneOf(size)
    x = math.clamp(x, -xmax, xmax)
    z = math.clamp(z, z1, z2)
    if not spotFree(st, x, z, size, u) then x, z = freeSpot(st, u.t, x, z, u) end
    u.sx, u.sz = x, z
    G.goTo(u, x, z)
  end

  function G.sellUnit(st, uid)
    if st.battle then return end
    local u = st.units[uid]
    if not u then return end
    local refund = math.floor(UNITS[u.t].price * 0.5)
    st.data.cash = st.data.cash + refund
    if u.model then u.model:Destroy() end
    st.units[uid] = nil
    G.toast(st, "解散" .. UNITS[u.t].name .. "，退回 $" .. Config.Fmt(refund), "info")
    G.push(st)
  end

  function G.arrange(st)
    if st.battle then return end
    local list = {}
    for _, u in pairs(st.units) do table.insert(list, u) end
    if #list == 0 then return end
    local ROW = Battle.ROW
    table.sort(list, function(a, b)
      if ROW[a.t] ~= ROW[b.t] then return ROW[a.t] < ROW[b.t] end
      return a.uid < b.uid
    end)
    local types = {}
    for i, u in ipairs(list) do types[i] = u.t end
    local slots = Battle.formation(types, F.deploy[2] - 4, -1, F.deploy[2] - F.deploy[1] - 8)
    for i, u in ipairs(list) do
      local s = slots[i]
      if s then
        u.sx, u.sz = s.x, s.z
        G.goTo(u, s.x, s.z)
      end
    end
    G.toast(st, "排好了：步兵在前，装甲、防空、直升机，火炮、火箭炮在最后", "info")
  end

  -- 这一关的敌军先摆在敌军区（开打前就能看到对面有什么）
  function G.makeEnemy(st)
    st.plot.Enemies:ClearAllChildren()
    st.enemy = {}
    local list, hm, dm = Battle.genEnemy(st.data.level)
    local slots = Battle.formation(list, F.enemy[1] + 4, 1, F.enemy[2] - F.enemy[1] - 8)
    for i, s in ipairs(slots) do
      local model, root = Models.unit(s.t, Config.EnemyColor)
      model.Name = "E" .. i
      model:SetAttribute("Type", s.t)
      model:SetAttribute("Fly", false)
      model.Parent = st.plot.Enemies
      root.CFrame = G.unitCF(st.plot.origin, s.x, 0, s.z, 0)
      table.insert(st.enemy, { t = s.t, x = s.x, z = s.z, model = model, root = root, hm = hm, dm = dm })
    end
  end

  -- 进服：按存档摆部队（阵位不在部署区里的重新找）
  function G.armySetup(st)
    local cap = G.capOf(st.data)
    for _, a in ipairs(st.data.army) do
      if G.count(st) < cap then
        local size = UNITS[a.t].size
        local xmax, z1, z2 = zoneOf(size)
        local x, z = a.x, a.z
        if math.abs(x) > xmax or z < z1 or z > z2 or not spotFree(st, x, z, size) then
          x, z = freeSpot(st, a.t)
        end
        G.spawnUnit(st, a.t, x, z, 0, math.pi)
      end
    end
    st.data.army = {}
  end
end

return Army
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000006">
<Properties>
<string name="Name">Battle</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：战斗推演（服务器）。只管数字：位置、血量、选目标、开火、溅射、炮弹 / 火箭弹落地；
-- 模型、特效、玩家角色的血交给调用方传进来的回调 B.cb（world / muzzle / aim / fx / hurt / die / heroHurt / kill）。
-- 坐标都是相对战场原点的 (x, z)；y 是离地高度（直升机）；h 是车身朝向（CFrame.Angles(0, h, 0)，模型正前方 −Z），ty 是炮塔相对车身的转角。
-- 单位：u = { t, def, team, x, y, z, h, ty, hp, max, dm（伤害倍数）, cd, rt, alive, tgt, hero（玩家本人）, driver（玩家在开）, hold（守着不出击）}
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))

local Battle = {}

local F = Config.Field
local XMAX = F.width / 2 - 6
local ZMIN = F.center - F.length / 2 + 5
local ZMAX = F.center + F.length / 2 - 5
local TURRET = { ifv = true, tank = true, aa = true, arty = true, boss = true }

Battle.HERO = { name = "玩家", hp = Config.Hero.hp, size = Config.Hero.size, speed = 0, range = 0, hero = true }

local function canHit(ad, td)
  if td.air then return ad.hitsAir == true end
  return true
end
Battle.canHit = canHit

-- 伤害倍数：按目标是飞机 / 装甲 / 步兵（玩家本人算步兵）
local function mult(ad, td)
  if td.air then return ad.vsAir or 0 end
  if td.armor then return ad.vsArmor or 1 end
  return ad.vsInf or 1
end
Battle.mult = mult

local function prefers(ad, td)
  local p = ad.prefer
  if p == "air" then return td.air == true end
  if p == "armor" then return td.armor == true end
  if p == "inf" then return not td.armor and not td.air end
  return false
end

local function wrap(a)
  return (a + math.pi) % (2 * math.pi) - math.pi
end

-- 选目标：最近的、能打的；喜欢的兵种算近四成；够不着的近距离目标（火炮）往后排；原来的目标稍微优先；玩家本人略微优先（敌人认得出指挥官）
local function pick(U, u)
  local d = u.def
  local best, bs = nil, math.huge
  for _, e in ipairs(U) do
    if e.alive and e.team ~= u.team and canHit(d, e.def) then
      local dx, dz = e.x - u.x, e.z - u.z
      local s = math.sqrt(dx * dx + dz * dz)
      if d.minRange and s < d.minRange then s = s + 400 end
      if prefers(d, e.def) then s = s * 0.6 end
      if e.hero then s = s * 0.8 end
      if e == u.tgt then s = s * 0.85 end
      if s < bs then
        bs, best = s, e
      end
    end
  end
  return best
end

local function hurt(B, u, dmg, src)
  if not u.alive or dmg <= 0 then return false end
  if u.hero then
    B.cb.heroHurt(u, dmg)
    return false
  end
  u.hp = u.hp - dmg
  if u.hp <= 0 then
    u.hp = 0
    u.alive = false
    B.cb.die(u)
    if src and B.cb.kill then B.cb.kill(u, src) end
    return true
  end
  B.cb.hurt(u)
  return false
end

-- 外部伤害（玩家开枪、开的车开火）：src = { team, player, drive }；返回打没打死
function Battle.damage(B, u, dmg, src)
  return hurt(B, u, dmg, src)
end

-- 溅射：地面单位按离爆点的距离衰减（中心满伤，边上四成）；ad 是攻击方的兵种（算伤害倍数）
local function splash(B, team, ad, x, z, r, dmg, skip, src)
  for _, e in ipairs(B.units) do
    if e.alive and e.team ~= team and e ~= skip and not e.def.air then
      local dx, dz = e.x - x, e.z - z
      local dd = math.sqrt(dx * dx + dz * dz)
      local reach = r + e.def.size * 0.3
      if dd < reach then
        local k = 1 - 0.6 * math.min(1, dd / reach)
        hurt(B, e, dmg * k * mult(ad, e.def), src)
      end
    end
  end
end
Battle.splash = splash

-- 抛射弹（火炮炮弹、火箭炮火箭弹）：飞一会儿才落地
local function lob(B, u, x, z, scatter, flight, kind, src)
  local a = math.random() * math.pi * 2
  local r = math.random() * scatter
  local sx, sz = x + math.cos(a) * r, z + math.sin(a) * r
  table.insert(B.shells, { at = B.t + flight, x = sx, z = sz, team = u.team, def = u.def, dm = u.dm, src = src })
  B.cb.fx({ k = kind, a = B.cb.muzzle(u), b = B.cb.world(sx, 0, sz), t = flight })
end

local function fire(B, u, t, dist)
  local d = u.def
  if d.salvo then   -- 火箭炮：一轮几发，陆续发射
    u.salvoLeft = d.salvo
    u.salvoAt = B.t
    u.salvoX, u.salvoZ = t.x + (t.vx or 0) * 2, t.z + (t.vz or 0) * 2
    return
  end
  if d.minRange and d.splash then   -- 火炮：抛物线炮弹，落点有散布，打移动目标往前估一点
    local fl = 1.2 + dist / 170
    lob(B, u, t.x + (t.vx or 0) * fl * 0.5, t.z + (t.vz or 0) * fl * 0.5, 14, fl, "shell")
    return
  end
  local hitP = 0.92
  if t.def.air then
    hitP = 0.75
    if u.t == "inf" then hitP = 0.5 end
  end
  if t.hero then hitP = hitP * 0.7 end
  local hit = math.random() < hitP
  local dmg = d.dmg * u.dm
  if hit then hurt(B, t, dmg * mult(d, t.def)) end
  if d.splash and not t.def.air then splash(B, u.team, d, t.x, t.z, d.splash, dmg * 0.5, t) end
  B.cb.fx({ k = "shot", u = u.t, a = B.cb.muzzle(u), b = B.cb.aim(t, hit) })
end

local function salvoStep(B, u)
  if not u.salvoLeft or u.salvoLeft <= 0 then return end
  if B.t < u.salvoAt then return end
  u.salvoLeft = u.salvoLeft - 1
  u.salvoAt = B.t + 0.25
  local dx, dz = u.salvoX - u.x, u.salvoZ - u.z
  local fl = 2 + math.sqrt(dx * dx + dz * dz) / 220
  lob(B, u, u.salvoX, u.salvoZ, 30, fl, "mrocket", u.driver and { team = u.team, player = u.driver, drive = true } or nil)
end

local function shells(B)
  local i = 1
  while i <= #B.shells do
    local s = B.shells[i]
    if B.t >= s.at then
      table.remove(B.shells, i)
      splash(B, s.team, s.def, s.x, s.z, s.def.splash or 10, s.def.dmg * s.dm, nil, s.src)
      B.cb.fx({ k = "boom", p = B.cb.world(s.x, 0, s.z), s = (s.def.salvo and 1.5) or 1.3 })
    else
      i = i + 1
    end
  end
end

-- 转向：最多每秒 rate 弧度，朝 (dx, dz)
local function turn(u, dx, dz, dt, rate)
  if dx == 0 and dz == 0 then return end
  local want = math.atan2(-dx, -dz)
  local diff = wrap(want - u.h)
  local m = rate * dt
  if diff > m then diff = m elseif diff < -m then diff = -m end
  u.h = u.h + diff
end
Battle.turn = turn

-- 炮塔对准世界方向 (dx, dz)：转角相对车身
local function aimTurret(u, dx, dz, dt)
  local want = wrap(math.atan2(-dx, -dz) - u.h)
  local diff = wrap(want - (u.ty or 0))
  local m = 2.6 * dt
  if diff > m then diff = m elseif diff < -m then diff = -m end
  u.ty = wrap((u.ty or 0) + diff)
  return math.abs(wrap(want - u.ty))
end
Battle.aimTurret = aimTurret

local function act(B, u, dt)
  local d = u.def
  u.cd = u.cd - dt
  salvoStep(B, u)
  if d.air and u.y < d.alt then u.y = math.min(d.alt, u.y + 16 * dt) end
  local t = u.tgt
  local mx, mz = 0, 0
  local inRange = false
  if t then
    local dx, dz = t.x - u.x, t.z - u.z
    local dist = math.sqrt(dx * dx + dz * dz)
    local tooClose = d.minRange ~= nil and dist < d.minRange
    if tooClose then
      mx, mz = -dx, -dz            -- 火炮被贴近：往后退
    elseif dist > d.range * 0.92 and not (u.hold and dist > d.range * 1.6) then
      mx, mz = dx, dz              -- 够不着：往前走（守方等敌人走近了才出击）
    end
    if dist <= d.range and not tooClose then
      inRange = true
      local err = 0
      if TURRET[u.t] then
        err = aimTurret(u, dx, dz, dt)
        if mx == 0 and mz == 0 then turn(u, dx, dz, dt, 0.8) end   -- 停下打的时候车身慢慢转正
      elseif d.side then
        turn(u, dz, -dx, dt, 1.6)  -- 火箭炮发射箱朝右：右侧对准目标
        local want = math.atan2(-dz, dx)
        err = math.abs(wrap(want - u.h))
      else
        turn(u, dx, dz, dt, d.air and 3 or 2.4)
      end
      local ready = ((not d.air) or u.y >= d.alt * 0.5) and err < 0.35
      if u.cd <= 0 and ready then
        fire(B, u, t, dist)
        u.cd = d.rate * (0.85 + math.random() * 0.3)
      end
    elseif TURRET[u.t] then
      aimTurret(u, dx, dz, dt)
    end
  end
  u.moving = false
  u.vx, u.vz = 0, 0
  if mx ~= 0 or mz ~= 0 then
    local l = math.sqrt(mx * mx + mz * mz)
    local sp = d.speed * dt
    local nx, nz = mx / l * sp, mz / l * sp
    u.x = u.x + nx
    u.z = u.z + nz
    u.vx, u.vz = nx / dt, nz / dt
    u.moving = true
    if TURRET[u.t] or not inRange then turn(u, mx, mz, dt, 3) end
  end
  if u.x > XMAX then u.x = XMAX elseif u.x < -XMAX then u.x = -XMAX end
  if u.z > ZMAX then u.z = ZMAX elseif u.z < ZMIN then u.z = ZMIN end
end

-- 挤在一起的推开一点（地面和地面、飞机和飞机；玩家本人和玩家在开的车不推——位置归玩家）
local function separate(U)
  local n = #U
  for i = 1, n do
    local a = U[i]
    if a.alive and not a.hero then
      for j = i + 1, n do
        local b = U[j]
        if b.alive and not b.hero and (a.def.air == true) == (b.def.air == true) then
          local dx, dz = b.x - a.x, b.z - a.z
          local need = (a.def.size + b.def.size) * 0.5
          local d2 = dx * dx + dz * dz
          if d2 < need * need then
            local dd = math.sqrt(d2)
            if dd < 0.01 then
              local r = math.random() * math.pi * 2
              dx, dz, dd = math.cos(r), math.sin(r), 1
            end
            local push = math.min(1.2, (need - dd) * 0.5)
            local ux, uz = dx / dd, dz / dd
            if not a.driver then a.x, a.z = a.x - ux * push, a.z - uz * push end
            if not b.driver then b.x, b.z = b.x + ux * push, b.z + uz * push end
          end
        end
      end
    end
  end
end

-- 玩家开的车开火：打瞄准点附近的敌人（直瞄），没打着也在瞄准点炸（有溅射的）；返回开没开火
function Battle.driveFire(B, u, ax, az, ay)
  local d = u.def
  if not u.alive or u.cd > 0 then return false end
  local dx, dz = ax - u.x, az - u.z
  local dist = math.sqrt(dx * dx + dz * dz)
  if dist > d.range * 1.15 then return false end
  if d.minRange and dist < d.minRange * 0.6 then return false end
  u.cd = d.rate
  local src = { team = u.team, player = u.driver, drive = true }
  if d.salvo then
    u.salvoLeft = d.salvo
    u.salvoAt = B.t
    u.salvoX, u.salvoZ = ax, az
    return true
  end
  if d.minRange and d.splash then
    lob(B, u, ax, az, 6, 1.2 + dist / 170, "shell", src)
    return true
  end
  -- 直瞄：瞄准点附近（目标大小以内）最近的敌人
  local best, bd = nil, math.huge
  for _, e in ipairs(B.units) do
    if e.alive and e.team ~= u.team and canHit(d, e.def) then
      local ex, ez = e.x - ax, e.z - az
      local ey = (e.y or 0) - (ay or 0)
      local dd = math.sqrt(ex * ex + ez * ez + ey * ey * 0.3)
      if dd < e.def.size * 0.6 + 6 and dd < bd then best, bd = e, dd end
    end
  end
  local dmg = d.dmg * u.dm
  if best then hurt(B, best, dmg * mult(d, best.def), src) end
  if d.splash then splash(B, u.team, d, ax, az, d.splash, dmg * 0.5, best, src) end
  B.cb.fx({ k = "shot", u = u.t, a = B.cb.muzzle(u), b = best and B.cb.aim(best, true) or B.cb.world(ax, ay or 0, az) })
  return true
end

-- 推演一步；返回 nil（继续）或 "win" / "lose" / "timeout"（按第 1 队算；玩家本人不算兵力）
function Battle.step(B, dt)
  B.t = B.t + dt
  local U = B.units
  for _, u in ipairs(U) do
    if u.alive and not u.hero and not u.driver then
      u.rt = u.rt - dt
      if u.rt <= 0 or not (u.tgt and u.tgt.alive) then
        u.tgt = pick(U, u)
        u.rt = 0.4 + math.random() * 0.4
      end
    end
  end
  for _, u in ipairs(U) do
    if u.alive and not u.hero then
      if u.driver then
        u.cd = u.cd - dt
        salvoStep(B, u)
      else
        act(B, u, dt)
      end
    end
  end
  separate(U)
  shells(B)
  local a, e = 0, 0
  for _, u in ipairs(U) do
    if u.alive and not u.hero then
      if u.team == 1 then a = a + 1 else e = e + 1 end
    end
  end
  B.alive1, B.alive2 = a, e
  if e == 0 then return "win" end
  if a == 0 then return "lose" end
  if B.t >= Config.BattleTime then return "timeout" end
  return nil
end

-- 关卡敌军：按预算随机买兵（同一关每次都一样）；超过人数上限的预算换成属性加成；首领关多一辆猛犸重坦
local W = { inf = 3, ifv = 1.6, tank = 2.2, aa = 1, arty = 1.2, mlrs = 0.7, heli = 1.4 }
function Battle.genEnemy(level)
  local budget = Config.EnemyBudget(level)
  local types = Config.EnemyTypes(level)
  local rng = Random.new(level * 7919 + 101)
  local list, spent = {}, 0
  while #list < Config.MaxEnemy do
    local cand, tw = {}, 0
    for _, t in ipairs(types) do
      if spent + Config.Units[t].price <= budget then
        table.insert(cand, t)
        tw = tw + (W[t] or 1)
      end
    end
    if #cand == 0 then break end
    local r = rng:NextNumber() * tw
    local pickT = cand[#cand]
    for _, t in ipairs(cand) do
      r = r - (W[t] or 1)
      if r <= 0 then
        pickT = t
        break
      end
    end
    table.insert(list, pickT)
    spent = spent + Config.Units[pickT].price
  end
  if #list == 0 then
    list = { "inf" }
    spent = Config.Units.inf.price
  end
  local k = 1
  if budget > spent * 1.05 then k = budget / spent end
  local m = math.sqrt(k)
  if Config.IsBoss(level) then table.insert(list, "boss") end
  return list, m, m   -- 兵种列表、血量倍数、伤害倍数
end

-- 排阵：前排步兵，然后步战车、坦克、首领、防空、直升机，最后火炮、火箭炮；同兵种一排排开（太宽就分两排）
-- zFront 是第一排前沿的 Z，dir 是往后排的方向（我方 −1，敌方 +1），depth 是可用纵深（排不下就压紧）
Battle.ROW = { inf = 1, ifv = 2, tank = 3, boss = 4, aa = 5, heli = 6, arty = 7, mlrs = 8 }
function Battle.formation(types, zFront, dir, depth)
  local ROW = Battle.ROW
  local list = {}
  for i, t in ipairs(types) do list[i] = t end
  table.sort(list, function(a, b) return ROW[a] < ROW[b] end)
  local rows = {}
  local i = 1
  while i <= #list do
    local t = list[i]
    local s = Config.Units[t].size + 6
    local maxN = math.max(1, math.floor((F.width - 40) / s))
    local j = i
    while j <= #list and list[j] == t and j - i < maxN do j = j + 1 end
    table.insert(rows, { t = t, n = j - i, s = s })
    i = j
  end
  local total = 0
  for _, r in ipairs(rows) do total = total + r.s end
  local k = 1
  if depth and total > depth then k = depth / total end
  local out = {}
  local z = zFront
  for _, r in ipairs(rows) do
    local zc = z + dir * r.s * k / 2
    for c = 0, r.n - 1 do
      table.insert(out, { t = r.t, x = (c - (r.n - 1) / 2) * r.s, z = zc })
    end
    z = z + dir * r.s * k
  end
  return out
end

return Battle
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000007">
<Properties>
<string name="Name">Combat</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：战斗编排——打 AI 关卡（pve）、突袭别人的防线（raid）、和同服玩家约战（duel）；
-- 玩家本人上阵（小人：开战时传送到己方后方，敌人会打你，死了在基地复活、可以重返战场）、亲自驾驶自己的车 / 直升机
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local Combat = {}

function Combat.init(G)
  local Config, Models, Battle = G.Config, G.Models, G.Battle
  local V = Vector3.new
  local F = Config.Field
  local UNITS = Config.Units
  local RB = G.R.Battle
  local XMAX = F.width / 2 - 6
  local ZMIN, ZMAX = F.center - F.length / 2 + 5, F.center + F.length / 2 - 5
  local nextBid = 0

  local function addUnit(B, bu)
    nextBid = nextBid + 1
    bu.bid = nextBid
    B.byId[nextBid] = bu
    if bu.model and bu.model.Parent then bu.model:SetAttribute("BU", nextBid) end
    table.insert(B.units, bu)
  end

  -- 两队玩家本人上阵的位置：第 1 队在部署区后面朝北，第 2 队在敌军区后面朝南
  local function heroSpot(B, team)
    if team == 1 then return B.origin + V(0, 4, F.deploy[1] + 14), 1 end
    return B.origin + V(0, 4, F.enemy[2] - 14), -1
  end

  local function callbacks(B)
    local cb = {}
    cb.fx = G.fx
    function cb.world(x, y, z)
      return B.origin + V(x, 1 + y, z)
    end
    function cb.muzzle(u)
      if not (u.root and u.root.Parent) then return B.origin + V(u.x, 4, u.z) end
      local cf = u.root.CFrame
      if u.ty and u.ty ~= 0 then cf = cf * CFrame.Angles(0, u.ty, 0) end
      return cf:PointToWorldSpace(Models.muzzle(u.t))
    end
    function cb.aim(t, hit)
      local p = B.origin + V(t.x, 1 + (t.y or 0) + (t.h3 or 2.5), t.z)
      if not hit then p = p + V(math.random() * 12 - 6, math.random() * 3, math.random() * 12 - 6) end
      return p
    end
    function cb.hurt(u)
      if u.fill then u.fill.Size = UDim2.fromScale(math.clamp(u.hp / u.max, 0, 1), 1) end
    end
    function cb.heroHurt(u, dmg)
      local hum = u.model and u.model:FindFirstChildOfClass("Humanoid")
      if hum and hum.Health > 0 then hum:TakeDamage(dmg * 0.5) end
    end
    function cb.kill(u, src)
      local st = src.player and G.states[src.player]
      if not st or not st.data then return end
      st.data.kills = st.data.kills + 1
      G.addXP(st, u.def.boss and 25 or 2)
      G.progress(st, "kill", 1)
      if src.drive then G.progress(st, "drivekill", 1) end
    end
    function cb.die(u)
      if u.bar then u.bar.Enabled = false end
      if u.driver then
        local st = G.states[u.driver]
        if st then G.driveStop(st) end
      end
      local m = u.model
      if not m or not m.Parent then return end
      m:SetAttribute("Dead", true)   -- 残骸：客户端布阵时不能选、画成烧黑的
      m:SetAttribute("Fly", false)
      local p = B.origin + V(u.x, 1 + u.y, u.z)
      if u.t == "inf" then
        G.fx({ k = "boom", p = p + V(0, 2, 0), s = 0.7 })
        m:Destroy()
        return
      end
      G.fx({ k = "boom", p = p + V(0, 3, 0), s = u.def.boss and 3 or 2 })
      if u.def.air then   -- 直升机摔到地上
        u.root.CFrame = G.unitCF(B.origin, u.x, 0, u.z, u.h) * CFrame.Angles(0.25, 0, 0.6)
        G.fx({ k = "boom", p = B.origin + V(u.x, 3, u.z), s = 1.6 })
      end
      for _, part in ipairs(m:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 1 and part.Name ~= "TeamRing" then
          part.Color = Color3.fromRGB(38, 35, 32)
          part.Material = Enum.Material.CorrodedMetal
        end
      end
      local fire = Instance.new("Fire")
      fire.Size = 8
      fire.Heat = 12
      fire.Parent = u.root
      local smoke = Instance.new("Smoke")
      smoke.Color = Color3.fromRGB(40, 40, 40)
      smoke.Opacity = 0.35
      smoke.RiseVelocity = 9
      smoke.Size = 6
      smoke.Parent = u.root
      Debris:AddItem(m, 6)
    end
    return cb
  end

  local function newBattle(mode, origin)
    local B = { mode = mode, origin = origin, units = {}, shells = {}, t = 0, alive1 = 0, alive2 = 0, byId = {}, teamOf = {}, sts = {}, over = false }
    B.cb = callbacks(B)
    return B
  end

  -- 把玩家的部队加进战斗；mirror：放到对面（约战的应战方）
  local function enlist(B, st, team, mirror)
    local tm = G.powerOf(st.data)
    for _, u in pairs(st.units) do
      local def = UNITS[u.t]
      u.path = nil
      local x, z, h = u.sx, u.sz, math.pi
      if mirror then x, z, h = -u.sx, F.enemy[1] + (F.deploy[2] - u.sz), 0 end
      u.x, u.y, u.z, u.h = x, 0, z, h
      if not u.bar then u.bar, u.fill = Models.hpBar(u.root, Models.heightOf(u.t) + 3, st.plot.color) end
      u.bar.Enabled = true
      u.fill.Size = UDim2.fromScale(1, 1)
      if def.air then G.setFly(u, true) end
      addUnit(B, {
        uid = u.uid, owner = st, t = u.t, def = def, team = team, x = x, y = 0, z = z, h = h, ty = 0,
        hp = def.hp * tm, max = def.hp * tm, dm = tm, cd = math.random() * def.rate, rt = 0, alive = true,
        model = u.model, root = u.root, bar = u.bar, fill = u.fill, h3 = Models.heightOf(u.t) * 0.45,
      })
    end
  end

  -- AI（或者防线快照）的部队：list = { { t, x, z, model?, root? } }，坐标是战场坐标
  local function enlistAI(B, list, hm, dm, hold, folder)
    for i, a in ipairs(list) do
      local def = UNITS[a.t]
      local model, root = a.model, a.root
      if not model then
        model, root = Models.unit(a.t, Config.EnemyColor)
        model.Name = "E" .. i
        model:SetAttribute("Type", a.t)
        model:SetAttribute("Fly", false)
        model.Parent = folder
      end
      root.CFrame = G.unitCF(B.origin, a.x, 0, a.z, 0)
      local bar, fill = Models.hpBar(root, Models.heightOf(a.t) + 3, Config.EnemyColor)
      bar.Enabled = true
      if def.air then model:SetAttribute("Fly", true) end
      addUnit(B, {
        t = a.t, def = def, team = 2, x = a.x, y = 0, z = a.z, h = 0, ty = 0, hp = def.hp * hm, max = def.hp * hm, dm = dm,
        cd = math.random() * def.rate, rt = 0, alive = true, hold = hold, model = model, root = root, bar = bar, fill = fill,
        h3 = Models.heightOf(a.t) * 0.45,
      })
    end
  end

  -- 把推演里的位置摆到模型上（没动的不改，省同步）；炮塔转角写在模型属性 TY 上（客户端转炮塔）
  local function placeAll(B)
    for _, u in ipairs(B.units) do
      if u.alive and not u.hero and u.root and u.root.Parent then
        if u.px == nil or math.abs(u.x - u.px) > 0.02 or math.abs(u.z - u.pz) > 0.02 or math.abs(u.y - u.py) > 0.02 or math.abs(u.h - u.ph) > 0.004 then
          u.px, u.pz, u.py, u.ph = u.x, u.z, u.y, u.h
          local cf = G.unitCF(B.origin, u.x, u.y, u.z, u.h)
          if u.def.air and u.moving then cf = cf * CFrame.Angles(-0.14, 0, 0) end
          u.root.CFrame = cf
        end
        local ty = math.floor((u.ty or 0) * 50 + 0.5) / 50
        if ty ~= u.pty then
          u.pty = ty
          u.model:SetAttribute("TY", ty)
        end
      end
    end
  end

  local function syncHeroes(B)
    for _, u in ipairs(B.units) do
      if u.hero and u.alive then
        local char = u.model
        local hum = char and char.Parent and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 or not (u.root and u.root.Parent) then
          u.alive = false
          local st = G.states[u.hero]
          if st and st.hero == u then
            st.hero = nil
            RB:FireClient(u.hero, { phase = "hero", alive = false })
          end
        else
          local p = u.root.Position - B.origin
          u.x, u.z = p.X, p.Z
        end
      end
    end
  end

  -- 玩家本人上阵：传送到己方后方，血量加到上阵的量；at 给了就在那里下车
  function G.heroJoin(st, at)
    local B = st.battle
    if not B or B.over or st.driving then return end
    local team = B.teamOf[st.pl]
    local char = st.pl.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) or hum.Health <= 0 then return end
    local pos, dir = heroSpot(B, team)
    if at then pos = at end
    char:PivotTo(CFrame.lookAt(pos, pos + V(0, 0, dir * 10)))
    hum.MaxHealth = Config.Hero.hp
    if not at then hum.Health = Config.Hero.hp end
    if st.hero then st.hero.alive = false end
    local bu = { hero = st.pl, owner = st, t = "hero", def = Battle.HERO, team = team, x = pos.X - B.origin.X, z = pos.Z - B.origin.Z, y = 0, h = 0,
      hp = 1, max = 1, dm = 1, cd = 0, rt = 0, alive = true, model = char, root = hrp, h3 = 2.5 }
    addUnit(B, bu)
    char:SetAttribute("BU", bu.bid)
    st.hero = bu
    RB:FireClient(st.pl, { phase = "hero", alive = true })
  end

  -- 开车时把角色藏起来（锚定、透明），下车放回车旁
  local function hideChar(st, hide, at)
    local char = st.pl.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hide then
      st.hidden = {}
      for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
          st.hidden[d] = d.Transparency
          d.Transparency = 1
        end
      end
      if hrp then hrp.Anchored = true end
    else
      for d, tr in pairs(st.hidden or {}) do
        if d.Parent then d.Transparency = tr end
      end
      st.hidden = nil
      if hrp then
        hrp.Anchored = false
        if at then char:PivotTo(CFrame.new(at)) end
      end
    end
  end

  function G.driveStart(st, uid)
    local B = st.battle
    if not B or B.over or st.driving or type(uid) ~= "number" then return end
    local bu
    for _, u in ipairs(B.units) do
      if u.owner == st and u.uid == uid and u.alive and not u.hero then bu = u end
    end
    if not bu then return end
    if bu.t == "inf" then
      G.toast(st, "步兵班不能开——你本人就是步兵", "info")
      return
    end
    bu.driver = st.pl
    bu.tgt = nil
    bu.salvoLeft = 0
    st.driving = bu
    st.driveT = os.clock()
    if st.hero then
      st.hero.alive = false
      st.hero = nil
    end
    hideChar(st, true)
    RB:FireClient(st.pl, { phase = "drive", uid = uid, t = bu.t, bid = bu.bid, origin = B.origin })
  end

  function G.driveStop(st)
    local bu = st.driving
    if not bu then return end
    st.driving = nil
    bu.driver = nil
    local B = st.battle
    local at = nil
    if B then at = B.origin + V(bu.x + bu.def.size * 0.6 + 3, 4, bu.z) end
    hideChar(st, false, at)
    RB:FireClient(st.pl, { phase = "exit" })
    if B and not B.over then G.heroJoin(st, at) end
  end

  -- 玩家开的车：客户端算位置（不卡），服务器只检查速度、边界
  function G.driveInput(st, d)
    local bu = st.driving
    if not bu or not bu.alive or type(d) ~= "table" then return end
    local x, z, h, y, ty = d.x, d.z, d.h, d.y, d.ty
    if type(x) ~= "number" or type(z) ~= "number" or type(h) ~= "number" or x ~= x or z ~= z or h ~= h then return end
    local now = os.clock()
    local dt = math.min(0.5, now - (st.driveT or now))
    st.driveT = now
    local maxStep = bu.def.speed * 1.5 * math.max(dt, 0.05) + 3
    local dx, dz = x - bu.x, z - bu.z
    local dist = math.sqrt(dx * dx + dz * dz)
    if dist > maxStep then x, z = bu.x + dx / dist * maxStep, bu.z + dz / dist * maxStep end
    bu.x = math.clamp(x, -XMAX, XMAX)
    bu.z = math.clamp(z, ZMIN, ZMAX)
    bu.h = h
    bu.moving = dist > 0.05
    if bu.def.air then
      bu.y = (type(y) == "number" and y == y) and math.clamp(y, 12, 160) or bu.def.alt
    end
    if type(ty) == "number" and ty == ty then bu.ty = ty end
  end

  function G.driveFire(st, aim)
    local bu = st.driving
    local B = st.battle
    if not bu or not bu.alive or not B or typeof(aim) ~= "Vector3" then return end
    local a = aim - B.origin
    Battle.driveFire(B, bu, a.X, a.Z, a.Y - 1)
  end

  local function tick(B)
    for st, team in pairs(B.sts) do
      if G.states[st.pl] == st then
        local a, e = B.alive1, B.alive2
        if team == 2 then a, e = e, a end
        RB:FireClient(st.pl, { phase = "tick", t = B.t, a = a, e = e })
      end
    end
  end

  local finish
  local function begin(B, sides, title)
    for team, st in pairs(sides) do
      st.battle = B
      B.teamOf[st.pl] = team
      B.sts[st] = team
    end
    placeAll(B)
    for st, team in pairs(B.sts) do
      RB:FireClient(st.pl, { phase = "start", mode = B.mode, title = title, level = st.data.level, team = team, time = Config.BattleTime, origin = B.origin })
      G.push(st)
      G.heroJoin(st)
    end
    task.spawn(function()
      local tickT = 0
      while not B.over do
        local dt = task.wait(Config.Tick)
        if B.over then break end
        syncHeroes(B)
        local ok, res = pcall(Battle.step, B, math.min(dt, 0.2))
        if not ok then
          warn("[军事大亨] 战斗推演出错：" .. tostring(res))
          res = "timeout"
        end
        placeAll(B)
        tickT = tickT + dt
        if tickT >= 0.5 then
          tickT = 0
          tick(B)
        end
        if res then
          finish(B, res)
          break
        end
      end
    end)
  end

  -- 剩下的兵力（按价格算）：约战打到时间按这个判输赢
  local function valueLeft(B, team)
    local v = 0
    for _, u in ipairs(B.units) do
      if u.alive and not u.hero and u.team == team then v = v + (u.def.price or 0) * (u.hp / math.max(1, u.max)) end
    end
    return v
  end
  local function armyValue(st)
    local v = 0
    for _, u in pairs(st.units) do v = v + UNITS[u.t].price end
    return v
  end

  -- 打完：清理、按模式算奖励；res 是第 1 队的结果
  function finish(B, res)
    if B.over then return end
    B.over = true
    for st in pairs(B.sts) do
      if st.driving then G.driveStop(st) end
      st.hero = nil
      local char = st.pl.Character
      local hum = char and char:FindFirstChildOfClass("Humanoid")
      if hum then
        hum.MaxHealth = 100
        if hum.Health > 100 then hum.Health = 100 end
      end
      if char then char:SetAttribute("BU", nil) end
    end
    for _, bu in ipairs(B.units) do
      if bu.bar then bu.bar.Enabled = false end
      if bu.model and bu.model.Parent and not bu.hero then
        bu.model:SetAttribute("BU", nil)
        bu.model:SetAttribute("TY", 0)
      end
    end
    if B.mode == "duel" then
      local t1, t2 = nil, nil
      for st, team in pairs(B.sts) do
        if team == 1 then t1 = st else t2 = st end
      end
      local winner = 0
      if res == "win" then winner = 1 elseif res == "lose" then winner = 2
      else
        local v1, v2 = valueLeft(B, 1), valueLeft(B, 2)
        winner = (v1 >= v2) and 1 or 2
      end
      if B.arena then B.arena.busy = false end
      for st, team in pairs(B.sts) do
        if G.states[st.pl] == st then
          local other = (team == 1) and t2 or t1
          local won = team == winner
          local reward = 0
          if won then
            reward = math.floor(Config.Duel.reward + Config.Duel.share * (other and armyValue(other) or 0))
            st.data.cash = st.data.cash + reward
            st.data.duelWins = st.data.duelWins + 1
            G.addXP(st, 30)
          else
            G.addXP(st, 10)
          end
          G.progress(st, "duel", 1)
          -- 约战不损失部队：打没了的换新模型，全部放回阵位
          for _, bu in ipairs(B.units) do
            if bu.owner == st and not bu.hero then
              local u = st.units[bu.uid]
              if u and not bu.alive then G.respawnModel(st, u) end
            end
          end
          G.homeSnap(st)
          st.battle = nil
          RB:FireClient(st.pl, { phase = "end", mode = "duel", result = won and "win" or "lose", reward = reward, lost = {}, lostN = 0, level = st.data.level,
            text = won and ("你赢了 " .. (other and other.pl.DisplayName or "对手") .. "！") or ("输给了 " .. (other and other.pl.DisplayName or "对手") .. "，部队没有损失") })
          G.push(st)
          task.spawn(G.save, st)
        end
      end
      return
    end
    -- 关卡、突袭：第 1 队是玩家
    local st = nil
    for s in pairs(B.sts) do st = s end
    if not st or G.states[st.pl] ~= st then return end
    local d = st.data
    local lost, lostN = {}, 0
    for _, bu in ipairs(B.units) do
      if bu.owner == st and not bu.hero then
        local u = st.units[bu.uid]
        if u then
          if bu.alive then   -- 活着的开回战前的阵位，下一仗满血
            u.x, u.y, u.z, u.h = bu.x, bu.y, bu.z, bu.h
            G.goTo(u, u.sx, u.sz)
          else
            st.units[bu.uid] = nil
            lost[u.t] = (lost[u.t] or 0) + 1
            lostN = lostN + 1
          end
        end
      elseif bu.team == 2 and bu.alive and bu.model and bu.model.Parent then
        bu.model:SetAttribute("Fly", false)
      end
    end
    local reward, text = 0, nil
    if B.mode == "pve" then
      if res == "win" then
        reward = Config.Reward(d.level)
        d.cash = d.cash + reward
        if Config.IsBoss(d.level) then
          G.progress(st, "boss", 1)
          text = "打掉了首领！奖励翻倍"
        end
        G.addXP(st, 10 + d.level * 2)
        G.progress(st, "win", 1)
        d.level = d.level + 1
        d.best = math.max(d.best, d.level)
        d.wins = (d.wins or 0) + 1
      end
    else   -- 突袭
      local opp = B.raid
      local E = 1 / (1 + 10 ^ ((opp.rating - d.rating) / 400))
      local won = res == "win"
      local delta = math.floor(Config.Raid.k * ((won and 1 or 0) - E) + (won and 0.5 or -0.5))
      d.rating = math.max(0, d.rating + delta)
      if won then
        reward = math.floor(Config.Reward(opp.level) * Config.Raid.loot)
        d.cash = d.cash + reward
        d.raidWins = d.raidWins + 1
        G.addXP(st, 25)
        G.progress(st, "raidwin", 1)
      end
      text = "突袭" .. (won and "成功" or "失败") .. "：积分 " .. ((delta >= 0) and "+" or "") .. delta .. "（现在 " .. d.rating .. "）"
      if opp.key then G.logRaid(opp.key, { n = st.pl.DisplayName, w = not won, t = os.time() }) end
    end
    st.enemy = {}
    st.battle = nil
    RB:FireClient(st.pl, { phase = "end", mode = B.mode, result = res, reward = reward, lost = lost, lostN = lostN, level = d.level, text = text })
    G.push(st)
    task.spawn(G.save, st)
    task.delay((res == "win") and 3 or 2, function()
      if G.states[st.pl] == st and not st.battle then
        G.makeEnemy(st)
        G.push(st)
      end
    end)
  end

  -- 人走了：约战算他输；关卡、突袭直接结束（不算输赢、不扣兵）
  function G.abandon(st)
    local B = st.battle
    if not B or B.over then return end
    if B.mode == "duel" then
      B.sts[st] = nil
      finish(B, (B.teamOf[st.pl] == 1) and "lose" or "win")
    else
      B.over = true
    end
  end

  local function canFight(st)
    if not st.ready or st.battle or st.busy then return false end
    if G.count(st) == 0 then
      G.toast(st, "还没有部队：先盖兵营，再在右边「兵工厂」生产", "bad")
      return false
    end
    return true
  end

  function G.startBattle(st)
    if not canFight(st) then return end
    if #st.enemy == 0 then G.makeEnemy(st) end
    local B = newBattle("pve", st.plot.origin)
    B.level = st.data.level
    enlist(B, st, 1, false)
    local list = {}
    for _, e in ipairs(st.enemy) do table.insert(list, { t = e.t, x = e.x, z = e.z, model = e.model, root = e.root }) end
    local hm, dm = 1, 1
    if st.enemy[1] then hm, dm = st.enemy[1].hm, st.enemy[1].dm end
    enlistAI(B, list, hm, dm, false, st.plot.Enemies)
    local title = "第 " .. st.data.level .. " 关" .. (Config.IsBoss(st.data.level) and "（首领）" or "")
    begin(B, { [1] = st }, title)
  end

  -- 找不到真人对手（或者存档服务不可用）：AI 指挥官，兵力和你差不多
  local BOTNAMES = { "雷霆", "钢铁", "猎鹰", "磐石", "暴风", "长弓", "铁壁", "毒蛇" }
  local function botOpponent(st)
    local value = armyValue(st) * G.powerOf(st.data)
    local budget = math.max(300, value * 0.85)
    local types = Config.EnemyTypes(math.max(5, st.data.level))
    local list, spent = {}, 0
    while #list < Config.MaxEnemy do
      local t = types[math.random(1, #types)]
      if spent + UNITS[t].price > budget then break end
      table.insert(list, t)
      spent = spent + UNITS[t].price
    end
    if #list == 0 then list = { "inf", "inf" } end
    local slots = Battle.formation(list, F.deploy[2] - 4, -1, F.deploy[2] - F.deploy[1] - 8)
    local army = {}
    for _, s in ipairs(slots) do table.insert(army, { t = s.t, x = s.x, z = s.z }) end
    return { key = nil, name = "AI 指挥官·" .. BOTNAMES[math.random(1, #BOTNAMES)], level = st.data.level, tech = st.data.tech, rebirth = 0, rating = st.data.rating, army = army }
  end

  function G.startRaid(st)
    if not canFight(st) then return end
    local now = os.clock()
    if now < (st.raidCD or 0) then
      G.toast(st, "部队还在休整：" .. math.ceil(st.raidCD - now) .. " 秒后才能再突袭", "info")
      return
    end
    st.raidCD = now + Config.Raid.cooldown
    st.busy = true
    G.toast(st, "侦察中：找一条差不多强的防线……", "info")
    local opp = G.findOpponent(st)
    st.busy = false
    if G.states[st.pl] ~= st or st.battle or not st.ready then return end
    if not opp then opp = botOpponent(st) end
    st.plot.Enemies:ClearAllChildren()
    st.enemy = {}
    local B = newBattle("raid", st.plot.origin)
    B.raid = opp
    enlist(B, st, 1, false)
    local tm = (1 + Config.Tech.bonus * opp.tech) * (1 + Config.Rebirth.power * opp.rebirth)
    local list = {}
    for _, a in ipairs(opp.army) do
      local z = math.clamp(F.enemy[1] + (F.deploy[2] - a.z), F.enemy[1] + 4, F.enemy[2] - 4)
      table.insert(list, { t = a.t, x = math.clamp(-a.x, -XMAX, XMAX), z = z })
    end
    enlistAI(B, list, tm, tm, true, st.plot.Enemies)
    begin(B, { [1] = st }, "突袭：" .. opp.name .. " 的防线（第 " .. opp.level .. " 关水平）")
  end

  -- 约战：挑战同服的玩家，对方接受后两边的部队、本人都传到竞技场
  function G.duelInvite(st, targetUid)
    if type(targetUid) ~= "number" or not canFight(st) then return end
    local target = Players:GetPlayerByUserId(targetUid)
    local ts = target and G.states[target]
    if not ts or ts == st or not ts.ready then return end
    if ts.battle then
      G.toast(st, target.DisplayName .. " 正在打仗，等一会儿", "info")
      return
    end
    if G.count(ts) == 0 then
      G.toast(st, target.DisplayName .. " 还没有部队", "info")
      return
    end
    ts.invite = { from = st.pl, untilT = os.clock() + Config.Duel.invite }
    G.R.Duel:FireClient(target, { from = st.pl.UserId, name = st.pl.DisplayName, level = st.data.level, n = G.count(st), rank = (Config.RankOf(st.data.xp)), time = Config.Duel.invite })
    G.toast(st, "已经向 " .. target.DisplayName .. " 发起约战，等对方接受", "info")
  end

  function G.duelAnswer(ts, fromUid, yes)
    local inv = ts.invite
    ts.invite = nil
    if not inv or inv.from.UserId ~= fromUid or os.clock() > inv.untilT then return end
    local st = G.states[inv.from]
    if not st then return end
    if not yes then
      G.toast(st, ts.pl.DisplayName .. " 拒绝了约战", "info")
      return
    end
    if not canFight(st) or not canFight(ts) then
      G.toast(ts, "约战没开成（对方在忙或者没有部队）", "info")
      return
    end
    local arena = nil
    for _, a in ipairs(G.arenas) do
      if not a.busy then
        arena = a
        break
      end
    end
    if not arena then
      G.toast(st, "竞技场都在用，过一会儿再约", "info")
      G.toast(ts, "竞技场都在用，过一会儿再约", "info")
      return
    end
    arena.busy = true
    local B = newBattle("duel", arena.origin)
    B.arena = arena
    enlist(B, st, 1, false)
    enlist(B, ts, 2, true)
    begin(B, { [1] = st, [2] = ts }, "约战：" .. st.pl.DisplayName .. " vs " .. ts.pl.DisplayName)
  end

  -- 战后或者想回去了：传送回自己的基地出生点
  function G.sendHome(st)
    if st.battle and not st.battle.over then return end
    local char = st.pl.Character
    if char then
      local S = Config.Spawn
      local o = st.plot.origin
      char:PivotTo(CFrame.lookAt(o + V(S.x, 5, S.z), o + V(S.x, 5, S.z + 10)))
    end
  end
end

return Combat
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000008">
<Properties>
<string name="Name">Economy</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：经济与成长（建筑、购买按钮、收入、指挥部、军工科技、重生、经验与军衔、每日奖励、每日任务、武器商店）
local Players = game:GetService("Players")

local Economy = {}

function Economy.init(G)
  local Config, Models = G.Config, G.Models
  local V = Vector3.new
  local BDEF, UNITS = Config.BuildingById, Config.Units
  local GREEN, RED = Color3.fromRGB(70, 220, 100), Color3.fromRGB(225, 70, 60)

  function G.incomeOf(d)
    local inc = 0
    for id in pairs(d.owned) do
      local b = BDEF[id]
      if b and b.income then
        local v = b.income
        if b.kind == "factory" and d.owned.power then v = v * Config.PowerBoost end
        inc = inc + v
      end
    end
    return inc * (1 + Config.Rebirth.income * (d.rebirth or 0))
  end

  function G.capOf(d)
    if d.owned.hq and d.hq >= 1 then return BDEF.hq.cap[d.hq] or BDEF.hq.cap[1] end
    return Config.BaseCap
  end

  -- 我方部队的血量、伤害倍数（军工科技 × 重生）
  function G.powerOf(d)
    return (1 + Config.Tech.bonus * d.tech) * (1 + Config.Rebirth.power * (d.rebirth or 0))
  end

  function G.recalc(st)
    local d = st.data
    st.income = G.incomeOf(d)
    if st.hqLabel then st.hqLabel.Text = "指挥部 " .. string.rep("★", d.hq) .. "  部队上限 " .. G.capOf(d) end
    if st.hqPrompt then
      if d.hq < #BDEF.hq.cap then
        st.hqPrompt.ObjectText = "$" .. Config.Fmt(BDEF.hq.up[d.hq]) .. " → 上限 " .. BDEF.hq.cap[d.hq + 1]
      else
        st.hqPrompt.Enabled = false
      end
    end
  end

  local function buildingPos(plot, b)
    return plot.origin + V(b.x, 1, b.z)
  end
  G.buildingPos = buildingPos

  function G.placeBuilding(st, b, fresh)
    local m, body = Models.building(st.plot.Buildings, b, buildingPos(st.plot, b), st.plot.color)
    local top = b.size[2] / 2 + 5   -- 牌子的偏移是从主体零件中心算的：大约在楼顶上方
    if b.income then
      Models.sign(body, b.name .. "  <font color=\"#7CFC8A\">+" .. Config.Fmt(b.income) .. "/秒</font>", top, 20, 2.8, nil, 200)
    elseif b.kind == "mil" then
      local names = {}
      for _, u in ipairs(b.units) do table.insert(names, UNITS[u].name) end
      Models.sign(body, b.name .. " · 生产" .. table.concat(names, "、"), top, 22, 2.8, nil, 200)
      for i, t in ipairs(b.units) do
        local pp = Instance.new("ProximityPrompt")
        pp.ActionText = "生产" .. UNITS[t].name
        pp.ObjectText = "$" .. Config.Fmt(UNITS[t].price)
        pp.KeyboardKeyCode = (i == 1) and Enum.KeyCode.E or Enum.KeyCode.Q
        pp.HoldDuration = 0
        pp.MaxActivationDistance = 28
        pp.RequiresLineOfSight = false
        pp.UIOffset = Vector2.new(0, (i - 1) * 70)
        pp.Parent = body
        pp.Triggered:Connect(function(who)
          if who == st.pl then G.buyUnit(st, t) end
        end)
      end
    elseif b.kind == "hq" then
      local _, label = Models.sign(body, "", top + 5, 24, 2.8, Color3.fromRGB(255, 220, 120), 240)
      st.hqLabel = label
      local pp = Instance.new("ProximityPrompt")
      pp.ActionText = "升级指挥部"
      pp.ObjectText = ""
      pp.HoldDuration = 0.4
      pp.MaxActivationDistance = 28
      pp.RequiresLineOfSight = false
      pp.Parent = body
      st.hqPrompt = pp
      pp.Triggered:Connect(function(who)
        if who == st.pl then G.upgradeHQ(st) end
      end)
    elseif b.kind == "power" then
      Models.sign(body, "发电厂 · 工厂收入 ×" .. Config.PowerBoost, top + 2, 20, 2.8, nil, 200)
    end
    if fresh then G.fx({ k = "build", p = buildingPos(st.plot, b), s = math.max(b.size[1], b.size[3]) }) end
    return m
  end

  -- 按钮颜色：买得起绿、买不起红（只在变的时候改，省得每秒同步）
  local function padColors(st)
    for _, p in pairs(st.pads) do
      local ok = st.data.cash >= p.b.price
      if p.ok ~= ok then
        p.ok = ok
        p.pad.Color = ok and GREEN or RED
      end
    end
  end

  -- 重新摆购买按钮：没盖、前置已经盖好的建筑才有
  function G.refreshPads(st)
    st.plot.Pads:ClearAllChildren()
    st.pads = {}
    local d = st.data
    for _, b in ipairs(Config.Buildings) do
      if not d.owned[b.id] and (not b.req or d.owned[b.req]) then
        local _, pad, pp = Models.pad(st.plot.Pads, b, buildingPos(st.plot, b), st.plot.color)
        local id = b.id
        pad.Touched:Connect(function(hit)
          local who = Players:GetPlayerFromCharacter(hit.Parent)
          if who == st.pl then G.tryBuild(st, id, true) end
        end)
        pp.Triggered:Connect(function(who)
          if who == st.pl then G.tryBuild(st, id, false) end
        end)
        st.pads[id] = { pad = pad, b = b }
      end
    end
    padColors(st)
  end

  function G.tryBuild(st, id, touch)
    if not st.ready then return end
    local b = BDEF[id]
    local d = st.data
    if not b or d.owned[id] or (b.req and not d.owned[b.req]) then return end
    if touch then   -- 踩着按钮不停触发：隔一会儿才算一次
      local now = os.clock()
      if now - (st.padT[id] or 0) < 1.2 then return end
      st.padT[id] = now
    end
    if d.cash < b.price then
      G.toast(st, "钱不够：" .. b.name .. " 还差 $" .. Config.Fmt(b.price - d.cash), "bad")
      return
    end
    d.cash = d.cash - b.price
    d.owned[id] = true
    if b.kind == "hq" then d.hq = 1 end
    G.placeBuilding(st, b, true)
    G.recalc(st)
    G.refreshPads(st)
    G.progress(st, "build", 1)
    local extra = ""
    if b.income then extra = "，收入 +" .. Config.Fmt(b.income) .. "/秒" end
    G.toast(st, "建成：" .. b.name .. extra, "good")
    if b.kind == "mil" then
      G.toast(st, "可以生产了：右边「兵工厂」，或者走到建筑旁按 E", "info")
    elseif b.kind == "hq" then
      G.toast(st, "部队上限 " .. G.capOf(d) .. "；以后可以升级指挥部带更多兵", "info")
    end
    G.push(st)
  end

  function G.upgradeHQ(st)
    if not st.ready then return end
    local d = st.data
    if not d.owned.hq then
      G.toast(st, "先盖指挥部", "bad")
      return
    end
    if d.hq >= #BDEF.hq.cap then
      G.toast(st, "指挥部已经满级", "info")
      return
    end
    local price = BDEF.hq.up[d.hq]
    if d.cash < price then
      G.toast(st, "升级指挥部还差 $" .. Config.Fmt(price - d.cash), "bad")
      return
    end
    d.cash = d.cash - price
    d.hq = d.hq + 1
    G.recalc(st)
    G.fx({ k = "build", p = buildingPos(st.plot, BDEF.hq), s = 30 })
    G.toast(st, "指挥部升到 " .. d.hq .. " 级：部队上限 " .. G.capOf(d), "good")
    G.push(st)
  end

  function G.upgradeTech(st)
    if not st.ready then return end
    local d = st.data
    if d.tech >= Config.Tech.max then
      G.toast(st, "军工科技已经满级", "info")
      return
    end
    local price = Config.TechCost(d.tech)
    if d.cash < price then
      G.toast(st, "升级军工科技还差 $" .. Config.Fmt(price - d.cash), "bad")
      return
    end
    d.cash = d.cash - price
    d.tech = d.tech + 1
    G.progress(st, "tech", 1)
    G.toast(st, "军工科技升到 " .. d.tech .. " 级：全军血量、伤害 +" .. math.floor(d.tech * Config.Tech.bonus * 100 + 0.5) .. "%", "good")
    G.push(st)
  end

  function G.canRebirth(d)
    return d.level >= Config.Rebirth.level and d.owned.bank == true
  end

  -- 重生：建筑、现金、关卡、部队、科技清零；武器、经验、军衔、积分留着；换永久加成
  function G.rebirth(st)
    if not st.ready or st.battle then return end
    local d = st.data
    if not G.canRebirth(d) then
      G.toast(st, "打到第 " .. Config.Rebirth.level .. " 关、盖了银行才能重生", "bad")
      return
    end
    d.rebirth = d.rebirth + 1
    d.cash = Config.StartCash
    d.owned = {}
    d.hq = 0
    d.tech = 0
    d.level = 1
    for _, u in pairs(st.units) do
      if u.model then u.model:Destroy() end
    end
    st.units = {}
    st.hqLabel, st.hqPrompt = nil, nil
    st.plot.Buildings:ClearAllChildren()
    G.recalc(st)
    G.refreshPads(st)
    G.makeEnemy(st)
    G.addXP(st, 200)
    G.fx({ k = "build", p = st.plot.origin + V(0, 1, 0), s = 120 })
    G.toast(st, "重生第 " .. d.rebirth .. " 次！收入永久 +" .. math.floor(Config.Rebirth.income * 100 * d.rebirth) .. "%，部队永久 +" .. math.floor(Config.Rebirth.power * 100 * d.rebirth) .. "%", "good")
    G.rankTag(st)
    G.push(st)
    task.spawn(G.save, st)
  end

  -- 经验、军衔；头顶的名牌（[军衔] 名字 ★重生次数）
  function G.rankTag(st)
    local char = st.pl.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end
    local tag = head:FindFirstChild("RankTag")
    if not tag then
      tag = Instance.new("BillboardGui")
      tag.Name = "RankTag"
      tag.Size = UDim2.new(10, 0, 1.4, 0)
      tag.StudsOffsetWorldSpace = V(0, 2.6, 0)
      tag.MaxDistance = 160
      tag.LightInfluence = 0
      tag.AlwaysOnTop = false
      local t = Instance.new("TextLabel")
      t.Name = "T"
      t.Size = UDim2.fromScale(1, 1)
      t.BackgroundTransparency = 1
      t.Font = Enum.Font.GothamBold
      t.TextScaled = true
      t.RichText = true
      t.TextColor3 = Color3.new(1, 1, 1)
      t.TextStrokeTransparency = 0.3
      t.Parent = tag
      tag.Parent = head
    end
    local rank = Config.RankOf(st.data.xp)
    local stars = (st.data.rebirth > 0) and ("  <font color=\"#FFD24A\">★" .. st.data.rebirth .. "</font>") or ""
    tag.T.Text = "<font color=\"#FFD86A\">[" .. rank .. "]</font> " .. st.pl.DisplayName .. stars
  end

  function G.addXP(st, n)
    local d = st.data
    local old = Config.RankOf(d.xp)
    d.xp = d.xp + math.floor(n)
    local new = Config.RankOf(d.xp)
    if new ~= old then
      G.toast(st, "晋升：" .. new .. "！", "good")
      G.rankTag(st)
      if st.ls and st.ls.rank then st.ls.rank.Value = new end
    end
  end

  -- 每日任务：今天的三个（按日期定）；kind 对上的加进度
  local function missionsFresh(st)
    local d = st.data
    local day = Config.Day(os.time())
    if d.missions.day ~= day or #d.missions.list ~= 3 then
      d.missions = { day = day, list = {} }
      for _, m in ipairs(Config.MissionsOf(day)) do table.insert(d.missions.list, { id = m.id, prog = 0, claimed = false }) end
    end
  end
  G.missionsFresh = missionsFresh
  local MBYID = {}
  for _, m in ipairs(Config.Missions) do MBYID[m.id] = m end
  G.missionDef = MBYID
  function G.progress(st, kind, n)
    if not st.data then return end
    missionsFresh(st)
    local changed = false
    for _, m in ipairs(st.data.missions.list) do
      local def = MBYID[m.id]
      if def and def.kind == kind and not m.claimed and m.prog < def.goal then
        m.prog = math.min(def.goal, m.prog + (n or 1))
        changed = true
        if m.prog >= def.goal then G.toast(st, "任务完成：" .. def.text .. "（到「任务」里领奖励）", "good") end
      end
    end
    if changed then st.dirty = true end
  end
  function G.missionReward(st)
    return math.max(400, math.floor(st.income * Config.MissionRewardSec))
  end
  function G.claimMission(st, i)
    if type(i) ~= "number" then return end
    missionsFresh(st)
    local m = st.data.missions.list[i]
    local def = m and MBYID[m.id]
    if not def or m.claimed or m.prog < def.goal then return end
    m.claimed = true
    local r = G.missionReward(st)
    st.data.cash = st.data.cash + r
    G.addXP(st, 40)
    G.toast(st, "领到任务奖励 $" .. Config.Fmt(r), "good")
    G.push(st)
  end

  -- 每日奖励：连续登录天数越多越多（最多叠到 7 天）
  function G.dailyInfo(st)
    local d = st.data
    local day = Config.Day(os.time())
    if d.daily.day == day then return false, 0, d.daily.streak end
    local streak = (d.daily.day == day - 1) and math.min(Config.Daily.max, d.daily.streak + 1) or 1
    local amount = math.floor(math.max(Config.Daily.base, st.income * Config.Daily.incomeSec) * (1 + Config.Daily.step * (streak - 1)))
    return true, amount, streak
  end
  function G.claimDaily(st)
    local ok, amount, streak = G.dailyInfo(st)
    if not ok then return end
    local d = st.data
    d.daily.day = Config.Day(os.time())
    d.daily.streak = streak
    d.cash = d.cash + amount
    G.toast(st, "每日奖励（连续第 " .. streak .. " 天）：$" .. Config.Fmt(amount), "good")
    G.push(st)
  end

  function G.buyWeapon(st, id)
    local w = Config.Weapons[id]
    if not w or not st.ready then return end
    local d = st.data
    if d.weapons[id] then return end
    if d.cash < w.price then
      G.toast(st, "买" .. w.name .. "还差 $" .. Config.Fmt(w.price - d.cash), "bad")
      return
    end
    d.cash = d.cash - w.price
    d.weapons[id] = true
    G.giveTools(st)
    G.toast(st, "买到" .. w.name .. "：在下面的物品栏里（按数字键切换）", "good")
    G.push(st)
  end

  -- 每秒：收入、按钮颜色
  function G.econTick(st)
    st.data.cash = st.data.cash + st.income
    padColors(st)
  end

  -- 进服：盖好已有的建筑、摆按钮、今天的任务
  function G.econSetup(st)
    for _, b in ipairs(Config.Buildings) do
      if st.data.owned[b.id] then G.placeBuilding(st, b, false) end
    end
    G.recalc(st)
    G.refreshPads(st)
    missionsFresh(st)
  end
end

return Economy
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000009">
<Properties>
<string name="Name">Models</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：模型（地图、竞技场、建筑、购买按钮、兵种、武器、排行榜牌子、血条）
-- 兵种：优先用玩家在 Studio 里「导入 3D」进来的原模型（roblox/models/*.glb，名字 = 槽位：soldier / ifv / tank / aa / arty / mlrs / heli），
--   没导入就用零件拼的。模型结构都一样：锚定的隐形 Root（原点在车底中心、正前方 −Z），其余零件焊在 Root 上；
--   炮塔、旋翼、尾桨各挂在一个用 Motor6D 接到 Root 的「毂」上（TurretMotor / RotorMotor / TailMotor），客户端转它们的 Transform。
-- 建筑、地面是锚定的静态零件。
local RS = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(RS:WaitForChild("Config"))

local Models = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local MAT = Enum.Material
local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local UP = CFrame.Angles(0, 0, math.pi / 2)   -- Roblox 圆柱的轴在 X 方向，转 90° 立起来

local C = {
  concrete = RGB(168, 168, 162), asphalt = RGB(52, 54, 58), dark = RGB(38, 40, 44), glass = RGB(66, 104, 134),
  olive = RGB(92, 104, 70), oliveDark = RGB(62, 72, 48), sand = RGB(196, 176, 128), metal = RGB(122, 126, 130),
  track = RGB(36, 36, 38), gun = RGB(46, 48, 50), skin = RGB(230, 188, 150), uniform = RGB(86, 96, 64),
  white = RGB(236, 236, 230), red = RGB(200, 50, 45), yellow = RGB(236, 190, 40), brick = RGB(150, 82, 62),
  roof = RGB(70, 72, 76), green = RGB(70, 220, 100), ground = RGB(124, 108, 78),
}
Models.C = C

local function darker(c, k)
  return c:Lerp(Color3.new(0, 0, 0), k or 0.35)
end

-- 静态零件：base 是整体的位置，off 是相对它的偏移（Shape 要在 Size 之前设，球会被改成等边）
local function block(parent, base, size, off, color, mat, shape)
  local p = Instance.new("Part")
  if shape then p.Shape = shape end
  p.Anchored = true
  p.Size = size
  p.CFrame = base * off
  p.Color = color
  p.Material = mat or MAT.SmoothPlastic
  p.TopSurface = Enum.SurfaceType.Smooth
  p.BottomSurface = Enum.SurfaceType.Smooth
  p.Parent = parent
  return p
end
Models.block = block

-- 竖直圆柱：height 高，dia 直径，off 是圆柱中心
local function cyl(parent, base, height, dia, off, color, mat)
  return block(parent, base, V(height, dia, dia), off * UP, color, mat, CYL)
end

-- 不挡人、不挡射线的装饰零件
local function ghostly(p)
  p.CanCollide = false
  p.CanQuery = false
  p.CanTouch = false
  return p
end

-- 头顶的字（大小按格算，离远了跟着变小）
function Models.sign(part, text, height, w, h, color, maxDist)
  local bb = Instance.new("BillboardGui")
  bb.Size = UDim2.new(w or 16, 0, h or 3, 0)
  bb.StudsOffsetWorldSpace = V(0, height, 0)
  bb.LightInfluence = 0
  bb.MaxDistance = maxDist or 220
  bb.Parent = part
  local t = Instance.new("TextLabel")
  t.Size = UDim2.fromScale(1, 1)
  t.BackgroundTransparency = 1
  t.Font = Enum.Font.GothamBold
  t.TextScaled = true
  t.RichText = true
  t.TextColor3 = color or Color3.new(1, 1, 1)
  t.TextStrokeTransparency = 0.35
  t.Text = text
  t.Parent = bb
  return bb, t
end

---------------------------------------------------------------- 地图

local function tree(f, pos, rng)
  local base = CF(pos)
  local h = rng:NextNumber(7, 12)
  cyl(f, base, h, 1.8, CF(0, h / 2, 0), RGB(108, 80, 56), MAT.Wood)
  local d = rng:NextNumber(10, 16)
  local g = RGB(56 + rng:NextInteger(0, 30), 116 + rng:NextInteger(0, 40), 48)
  block(f, base, V(d, d, d), CF(0, h + d * 0.3, 0), g, MAT.Grass, BALL)
  if rng:NextNumber() < 0.5 then
    local d2 = d * 0.7
    block(f, base, V(d2, d2, d2), CF(d * 0.3, h + d * 0.62, d * 0.15), g:Lerp(RGB(255, 255, 255), 0.06), MAT.Grass, BALL)
  end
end

-- 战场（基地前面的，或者竞技场）：地面、部署区、敌军区、沙袋、弹坑；colorA / colorB 是两边区域的颜色
local function battlefield(f, origin, colorA, colorB, rng)
  local base = CF(origin)
  local Fd = Config.Field
  local D, E = Fd.deploy, Fd.enemy
  local field = block(f, base, V(Fd.width, 1, Fd.length), CF(0, 0.5, Fd.center), C.ground, MAT.Ground)
  field.Name = "Field"
  local dz = ghostly(block(f, base, V(Fd.width - 6, 0.1, D[2] - D[1]), CF(0, 1.06, (D[1] + D[2]) / 2), colorA, MAT.SmoothPlastic))
  dz.Name = "DeployZone"
  dz.Transparency = 0.72
  local ez = ghostly(block(f, base, V(Fd.width - 6, 0.1, E[2] - E[1]), CF(0, 1.06, (E[1] + E[2]) / 2), colorB, MAT.SmoothPlastic))
  ez.Name = "EnemyZone"
  ez.Transparency = 0.75
  ghostly(block(f, base, V(Fd.width - 6, 0.12, 0.8), CF(0, 1.08, D[2]), colorA, MAT.Neon))
  ghostly(block(f, base, V(Fd.width - 6, 0.12, 0.8), CF(0, 1.08, E[1]), colorB, MAT.Neon))
  local z0, z1 = Fd.center - Fd.length / 2, Fd.center + Fd.length / 2
  block(f, base, V(3, 3, Fd.length), CF(-Fd.width / 2 - 1.5, 2.5, Fd.center), C.sand, MAT.Fabric)
  block(f, base, V(3, 3, Fd.length), CF(Fd.width / 2 + 1.5, 2.5, Fd.center), C.sand, MAT.Fabric)
  block(f, base, V(Fd.width + 6, 3, 3), CF(0, 2.5, z1 + 1.5), C.sand, MAT.Fabric)
  for _ = 1, 14 do   -- 弹坑、石头（只是装饰，不挡部队）
    local d = rng:NextNumber(10, 26)
    ghostly(cyl(f, base, 0.1, d, CF(rng:NextNumber(-200, 200), 1.04, rng:NextNumber(D[2] + 30, E[1] - 30)), RGB(92, 80, 60), MAT.Ground))
  end
  for _ = 1, 10 do
    local d = rng:NextNumber(4, 9)
    local side = (rng:NextNumber() < 0.5) and -1 or 1
    ghostly(block(f, base, V(d, d, d), CF(side * rng:NextNumber(190, 245), 1, rng:NextNumber(z0 + 40, z1 - 40)), RGB(120, 118, 112), MAT.Slate, BALL))
  end
  return field
end

-- 一块基地：地面、围墙、出生点、路、战场、树、头顶的名字、排行榜牌子。返回 { field, sign, board }
function Models.plot(f, origin, color, index)
  local base = CF(origin)
  local B = Config.BaseSize
  local hs = B / 2
  local Fd = Config.Field
  local rng = Random.new(index * 97 + 13)

  local slab = block(f, base, V(B, 1, B), CF(0, 0.5, 0), RGB(146, 148, 146), MAT.Concrete)
  slab.Name = "Base"
  -- 部队开出去的通道（深色）：横穿 z = 60，再从中间往前到路上
  ghostly(block(f, base, V(B - 12, 0.08, 28), CF(0, 1.04, 60), RGB(92, 94, 96), MAT.Asphalt))
  ghostly(block(f, base, V(120, 0.08, hs - 60), CF(-10, 1.04, (hs + 60) / 2), RGB(92, 94, 96), MAT.Asphalt))
  -- 围墙：后面和两边，前面敞开对着战场
  block(f, base, V(B, 4, 1.5), CF(0, 3, -hs + 0.75), RGB(120, 122, 118), MAT.Concrete)
  block(f, base, V(1.5, 4, B), CF(-hs + 0.75, 3, 0), RGB(120, 122, 118), MAT.Concrete)
  block(f, base, V(1.5, 4, B), CF(hs - 0.75, 3, 0), RGB(120, 122, 118), MAT.Concrete)
  -- 出生点
  local S = Config.Spawn
  cyl(f, base, 0.3, 12, CF(S.x, 1.15, S.z), color, MAT.SmoothPlastic)
  cyl(f, base, 0.32, 8, CF(S.x, 1.16, S.z), C.white, MAT.SmoothPlastic)
  -- 路（基地和战场之间）
  local fz0 = Fd.center - Fd.length / 2
  local roadZ, roadL = (hs + fz0) / 2, fz0 - hs
  block(f, base, V(B, 1, roadL), CF(0, 0.5, roadZ), C.asphalt, MAT.Asphalt)
  for k = -8, 8 do
    ghostly(block(f, base, V(8, 0.06, 0.8), CF(k * 15, 1.03, roadZ), C.white, MAT.SmoothPlastic))
  end
  local field = battlefield(f, origin, color, RGB(190, 50, 40), rng)
  -- 树：基地右边的空地（第一块基地左边也种）
  local sides = { 1 }
  if index == 1 then sides = { 1, -1 } end
  for _, sd in ipairs(sides) do
    for _ = 1, 34 do
      local x = sd * rng:NextNumber(hs + 40, Config.PlotSpacing - Fd.width / 2 - 20)
      local z = rng:NextNumber(-hs + 5, Fd.center + Fd.length / 2)
      tree(f, origin + V(x, 0, z), rng)
    end
  end
  -- 头顶的名字
  local anchor = ghostly(block(f, base, V(1, 1, 1), CF(0, 2, -20), C.white))
  anchor.Transparency = 1
  local _, label = Models.sign(anchor, "空基地", 70, 100, 13, color, 1600)
  -- 排行榜牌子（出生点后面的墙上，朝出生点）
  local board = block(f, base, V(40, 22, 1), CF(0, 14, -hs + 2), RGB(24, 28, 34), MAT.SmoothPlastic)
  board.Name = "Board"
  local sg = Instance.new("SurfaceGui")
  sg.Face = Enum.NormalId.Back
  sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
  sg.PixelsPerStud = 20
  sg.LightInfluence = 0
  sg.Parent = board
  local cols = {}
  for i, title in ipairs({ "最高关卡", "突袭积分" }) do
    local col = Instance.new("TextLabel")
    col.Name = "Col" .. i
    col.BackgroundTransparency = 1
    col.Position = UDim2.fromScale((i - 1) * 0.5, 0)
    col.Size = UDim2.fromScale(0.5, 1)
    col.Font = Enum.Font.GothamBold
    col.TextScaled = true
    col.TextColor3 = C.white
    col.TextYAlignment = Enum.TextYAlignment.Top
    col.Text = title .. "\n（读取中）"
    col.Parent = sg
    cols[i] = col
  end
  return { field = field, sign = label, board = cols }
end

-- 约战竞技场：只有战场，南北两边的出发区，看台边上一圈旗子
function Models.arena(f, origin, index)
  local rng = Random.new(index * 53 + 991)
  local field = battlefield(f, origin, RGB(60, 140, 230), RGB(230, 70, 60), rng)
  local Fd = Config.Field
  local base = CF(origin)
  local anchor = ghostly(block(f, base, V(1, 1, 1), CF(0, 2, Fd.center), C.white))
  anchor.Transparency = 1
  Models.sign(anchor, "约战竞技场 " .. index, 90, 120, 15, RGB(255, 220, 120), 2400)
  for k = -4, 4 do
    local z = Fd.center + k * Fd.length / 9
    for _, sx in ipairs({ -1, 1 }) do
      cyl(f, base, 18, 0.5, CF(sx * (Fd.width / 2 + 8), 9, z), C.metal, MAT.Metal)
      block(f, base, V(0.2, 3.5, 6), CF(sx * (Fd.width / 2 + 8), 16, z + 3), (k % 2 == 0) and RGB(60, 140, 230) or RGB(230, 70, 60), MAT.Fabric)
    end
  end
  return { field = field }
end

---------------------------------------------------------------- 建筑

local HOUSE = { house1 = RGB(226, 212, 186), house2 = RGB(186, 206, 222), house3 = RGB(222, 192, 180) }

local function slabUnder(m, base, w, d, color, mat)
  block(m, base, V(w + 3, 0.6, d + 3), CF(0, 0.3, 0), color or C.concrete, mat or MAT.Concrete)
end

local function flag(m, base, at, color)
  cyl(m, base, 18, 0.4, at * CF(0, 0.6 + 9, 0), C.metal, MAT.Metal)
  block(m, base, V(0.15, 3, 5), at * CF(0, 0.6 + 16.4, 2.6), color, MAT.Fabric)
end

local function house(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, h, d), CF(0, 0.6 + h / 2, 0), HOUSE[b.id] or C.white, MAT.SmoothPlastic)
  for k = 1, math.floor(h / 4) do   -- 每层一圈窗户带
    local y = 0.6 + (k - 1) * 4 + 2.4
    if y + 1 < 0.6 + h then block(m, base, V(w + 0.3, 1.4, d + 0.3), CF(0, y, 0), C.glass, MAT.Glass) end
  end
  block(m, base, V(w + 0.8, 0.7, d + 0.8), CF(0, 0.6 + h + 0.35, 0), C.roof, MAT.Concrete)
  block(m, base, V(w * 0.3, 1.8, d * 0.3), CF(w * 0.2, 0.6 + h + 1.6, d * 0.15), C.metal, MAT.Metal)
  block(m, base, V(3.2, 4.4, 0.6), CF(0, 0.6 + 2.2, -d / 2 - 0.2), C.dark)
  block(m, base, V(w * 0.5, 0.4, 2.4), CF(0, 0.6 + 4.7, -d / 2 - 1.2), C.roof)
  return body
end

local function factory(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local hh = h * 0.62
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, hh, d), CF(0, 0.6 + hh / 2, 0), C.brick, MAT.Brick)
  block(m, base, V(w + 0.6, 0.6, d + 0.6), CF(0, 0.6 + hh + 0.3, 0), C.roof, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    block(m, base, V(w * 0.8, 1.6, 2.4), CF(0, 0.6 + hh + 1.4, s * d * 0.22), C.glass, MAT.Glass)
  end
  block(m, base, V(w * 0.38, hh * 0.62, 0.6), CF(-w * 0.15, 0.6 + hh * 0.31, -d / 2 - 0.15), C.dark, MAT.DiamondPlate)
  local n = (b.id == "factory3") and 2 or 1
  for k = 1, n do   -- 烟囱冒烟
    local cx = w / 2 - 3 - (k - 1) * 5
    local top = h + 4
    cyl(m, base, top, 2.6, CF(cx, 0.6 + top / 2, d / 2 - 3), C.brick, MAT.Brick)
    local tip = ghostly(block(m, base, V(1.5, 1, 1.5), CF(cx, 0.6 + top + 0.6, d / 2 - 3), C.dark))
    tip.Transparency = 1
    local s = Instance.new("Smoke")
    s.Color = RGB(96, 96, 98)
    s.Opacity = 0.22
    s.RiseVelocity = 6
    s.Size = 3
    s.Parent = tip
  end
  block(m, base, V(3, 3, 3), CF(-w / 2 + 2, 0.6 + 1.5, -d / 2 - 3), C.olive, MAT.WoodPlanks)
  return body
end

local function power(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  slabUnder(m, base, w, d)
  local tx = -w / 2 + 6.5
  local body = cyl(m, base, h, 12, CF(tx, 0.6 + h / 2, 0), RGB(205, 205, 200), MAT.Concrete)   -- 冷却塔
  cyl(m, base, 1, 12.6, CF(tx, 0.6 + h - 0.5, 0), RGB(176, 176, 172), MAT.Concrete)
  local tip = ghostly(block(m, base, V(6, 1, 6), CF(tx, 0.6 + h + 1, 0), C.white))
  tip.Transparency = 1
  local s = Instance.new("Smoke")
  s.Color = RGB(240, 240, 240)
  s.Opacity = 0.3
  s.RiseVelocity = 8
  s.Size = 6
  s.Parent = tip
  block(m, base, V(8, 8, d - 2), CF(w / 2 - 4.5, 0.6 + 4, 0), RGB(110, 120, 130), MAT.Metal)
  for k = -1, 1 do block(m, base, V(2, 2.4, 2), CF(w / 2 - 4.5, 0.6 + 9.2, k * 4), C.yellow, MAT.Metal) end
  return body
end

local function bank(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  block(m, base, V(w + 3, 1.2, d + 3), CF(0, 0.6, 0), RGB(220, 218, 210), MAT.Marble)
  local hb = h * 0.72
  local body = block(m, base, V(w - 2, hb, d - 5), CF(0, 1.2 + hb / 2, 2), RGB(236, 233, 224), MAT.Marble)
  for k = 0, 3 do
    cyl(m, base, hb, 1.6, CF(-w / 2 + 2.5 + k * (w - 5) / 3, 1.2 + hb / 2, -d / 2 + 2), RGB(242, 240, 232), MAT.Marble)
  end
  block(m, base, V(w, 2.4, d), CF(0, 1.2 + hb + 1.2, 0), RGB(225, 222, 212), MAT.Marble)
  block(m, base, V(w * 0.6, 3, d * 0.6), CF(0, 1.2 + hb + 3.9, 0), RGB(212, 175, 55), MAT.Metal)
  block(m, base, V(4, 6, 0.5), CF(0, 1.2 + 3, -d / 2 + 4.6), C.dark)
  return body
end

local function barracks(m, base, b, team)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, h, d), CF(0, 0.6 + h / 2, 0), C.olive, MAT.Concrete)
  block(m, base, V(w + 1.2, 0.8, d + 1.2), CF(0, 0.6 + h + 0.4, 0), C.oliveDark, MAT.Concrete)
  block(m, base, V(w + 0.2, 1.2, d + 0.2), CF(0, 0.6 + h * 0.6, 0), C.glass, MAT.Glass)
  block(m, base, V(5, 6, 0.6), CF(0, 0.6 + 3, d / 2 + 0.15), C.dark)
  flag(m, base, CF(w / 2 + 2, 0, d / 2 + 2), team)
  block(m, base, V(7, 1.8, 1.4), CF(-6, 0.6 + 0.9, d / 2 + 4), C.sand, MAT.Fabric)
  block(m, base, V(7, 1.8, 1.4), CF(6, 0.6 + 0.9, d / 2 + 4), C.sand, MAT.Fabric)
  return body
end

local function hangar(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local wall = h * 0.5
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, wall, d), CF(0, 0.6 + wall / 2, 0), RGB(112, 120, 100), MAT.Metal)
  local r = w * 0.47
  block(m, base, V(d, r * 2, r * 2), CF(0, 0.6 + wall - r * 0.42, 0) * CFrame.Angles(0, math.pi / 2, 0), RGB(100, 108, 90), MAT.CorrodedMetal, CYL)
  block(m, base, V(w * 0.62, wall * 0.92, 0.6), CF(0, 0.6 + wall * 0.46, d / 2 + 0.15), C.dark, MAT.DiamondPlate)
  local seg = w * 0.62 / 6
  for k = 0, 5 do
    block(m, base, V(seg, 0.8, 0.7), CF(-w * 0.31 + (k + 0.5) * seg, 0.6 + wall * 0.92 + 0.4, d / 2 + 0.2), (k % 2 == 0) and C.yellow or C.dark)
  end
  return body
end

local function aaShop(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local hh = h * 0.6
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, hh, d), CF(0, 0.6 + hh / 2, 0), RGB(118, 126, 112), MAT.Concrete)
  block(m, base, V(w * 0.55, hh * 0.8, 0.6), CF(0, 0.6 + hh * 0.4, d / 2 + 0.15), C.dark, MAT.DiamondPlate)
  cyl(m, base, 7, 0.6, CF(-w / 2 + 3, 0.6 + hh + 3.5, -d / 2 + 3), C.metal, MAT.Metal)
  block(m, base, V(6, 3, 0.4), CF(-w / 2 + 3, 0.6 + hh + 7.5, -d / 2 + 3) * CFrame.Angles(math.rad(-20), math.rad(30), 0), C.white, MAT.Metal)
  block(m, base, V(3, 1.6, 3), CF(w / 4, 0.6 + hh + 0.8, 0), C.olive, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    block(m, base, V(0.3, 0.3, 4), CF(w / 4 + s * 0.7, 0.6 + hh + 2.4, 1.4) * CFrame.Angles(math.rad(-35), 0, 0), C.gun, MAT.Metal)
  end
  return body
end

local function artyPos(m, base, b)
  local w, d = b.size[1], b.size[3]
  block(m, base, V(w + 3, 0.6, d + 3), CF(0, 0.3, 0), C.sand, MAT.Sand)
  block(m, base, V(w, 3, 2), CF(0, 0.6 + 1.5, -d / 2 + 1), C.sand, MAT.Fabric)
  block(m, base, V(2, 3, d - 2), CF(-w / 2 + 1, 0.6 + 1.5, 0), C.sand, MAT.Fabric)
  block(m, base, V(2, 3, d - 2), CF(w / 2 - 1, 0.6 + 1.5, 0), C.sand, MAT.Fabric)
  local body = block(m, base, V(3.6, 1.2, 5), CF(0, 0.6 + 1.6, -1), C.olive, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    block(m, base, V(0.8, 2.6, 2.6), CF(s * 2.2, 0.6 + 1.3, -0.5), C.track, MAT.Metal, CYL)
    block(m, base, V(0.4, 0.4, 6), CF(s * 1.2, 0.6 + 0.6, -5) * CFrame.Angles(0, s * 0.25, 0), C.olive, MAT.Metal)
  end
  block(m, base, V(0.5, 0.5, 8), CF(0, 0.6 + 3.2, 2.5) * CFrame.Angles(math.rad(-28), 0, 0), C.gun, MAT.Metal)
  for k = 0, 2 do block(m, base, V(2.2, 1.2, 1.4), CF(-w / 2 + 4, 0.6 + 0.6 + k * 1.2, -d / 2 + 4), C.oliveDark, MAT.WoodPlanks) end
  local net = block(m, base, V(w * 0.85, 0.2, d * 0.75), CF(0, 0.6 + 7, 0), RGB(70, 88, 52), MAT.Fabric)
  net.Transparency = 0.15
  for _, sx in ipairs({ -1, 1 }) do
    for _, sz in ipairs({ -1, 1 }) do cyl(m, base, 7, 0.3, CF(sx * w * 0.4, 0.6 + 3.5, sz * d * 0.35), C.oliveDark, MAT.Wood) end
  end
  return body
end

local function helipad(m, base, b)
  local w, d = b.size[1], b.size[3]
  local body = block(m, base, V(w, 0.8, d), CF(0, 0.4, 0), C.asphalt, MAT.Asphalt)
  ghostly(cyl(m, base, 0.1, w * 0.78, CF(0, 0.85, 0), C.yellow))
  ghostly(cyl(m, base, 0.12, w * 0.7, CF(0, 0.86, 0), C.asphalt, MAT.Asphalt))
  ghostly(block(m, base, V(2, 0.1, 14), CF(-4.5, 0.95, 0), C.white))
  ghostly(block(m, base, V(2, 0.1, 14), CF(4.5, 0.95, 0), C.white))
  ghostly(block(m, base, V(9, 0.1, 2), CF(0, 0.95, 0), C.white))
  for _, sx in ipairs({ -1, 1 }) do
    for _, sz in ipairs({ -1, 1 }) do block(m, base, V(1, 1, 1), CF(sx * (w / 2 - 1), 1.2, sz * (d / 2 - 1)), RGB(80, 255, 120), MAT.Neon) end
  end
  cyl(m, base, 9, 0.3, CF(w / 2 + 2, 4.5, -d / 2 + 2), C.metal, MAT.Metal)
  block(m, base, V(0.9, 0.9, 3), CF(w / 2 + 2, 8.5, -d / 2 + 3.5), RGB(240, 120, 30), MAT.Fabric)
  return body
end

local function hq(m, base, b, team)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  slabUnder(m, base, w, d)
  local h1 = h * 0.6
  local body = block(m, base, V(w, h1, d), CF(0, 0.6 + h1 / 2, 0), RGB(96, 104, 86), MAT.Concrete)
  block(m, base, V(w + 0.3, 1.2, d + 0.3), CF(0, 0.6 + h1 * 0.6, 0), C.glass, MAT.Glass)
  local h2 = h * 0.4
  block(m, base, V(w * 0.55, h2, d * 0.55), CF(-w * 0.12, 0.6 + h1 + h2 / 2, 0), RGB(84, 92, 76), MAT.Concrete)
  block(m, base, V(w * 0.55 + 0.3, 1, d * 0.55 + 0.3), CF(-w * 0.12, 0.6 + h1 + h2 * 0.55, 0), C.glass, MAT.Glass)
  cyl(m, base, 14, 0.4, CF(w * 0.3, 0.6 + h1 + 7, -d * 0.25), C.metal, MAT.Metal)
  block(m, base, V(0.7, 0.7, 0.7), CF(w * 0.3, 0.6 + h1 + 14.2, -d * 0.25), C.red, MAT.Neon)
  block(m, base, V(5, 2.4, 0.4), CF(w * 0.25, 0.6 + h1 + 2, d * 0.2) * CFrame.Angles(math.rad(-15), math.rad(-25), 0), C.white, MAT.Metal)
  flag(m, base, CF(-w / 2 - 2, 0, d / 2 + 2), team)
  block(m, base, V(5, 5, 0.6), CF(0, 0.6 + 2.5, d / 2 + 0.15), C.dark)
  return body
end

local KIND = { house = house, factory = factory, power = power, bank = bank, hq = hq }
local MIL = { barracks = barracks, tankfac = hangar, aafac = aaShop, artyfac = artyPos, helipad = helipad }

-- 建筑：pos 是地面中心（基地地面顶上）；返回 model、主体零件（挂牌子、提示用）
function Models.building(parent, b, pos, team)
  local m = Instance.new("Model")
  m.Name = b.id
  local f = KIND[b.kind]
  if b.kind == "mil" then f = MIL[b.id] or barracks end
  local body = f(m, CF(pos), b, team)
  body.Name = "Body"
  m.PrimaryPart = body
  m.Parent = parent
  return m, body
end

-- 购买按钮：建筑位置上一个全息虚影，前面（−Z 那边）一个发光的圆按钮，踩上去或按 E 就买
function Models.pad(parent, b, pos, team)
  local m = Instance.new("Model")
  m.Name = "Pad_" .. b.id
  local base = CF(pos)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local ghost = ghostly(block(m, base, V(w, h, d), CF(0, h / 2, 0), team, MAT.ForceField))
  ghost.CastShadow = false
  local pad = block(m, base, V(0.7, 7, 7), CF(0, 0.35, -d / 2 - 6) * UP, C.green, MAT.Neon, CYL)
  pad.Name = "Pad"
  local desc = ""
  if b.income then desc = "收入 +" .. Config.Fmt(b.income) .. "/秒"
  elseif b.kind == "mil" then
    local names = {}
    for _, u in ipairs(b.units) do table.insert(names, Config.Units[u].name) end
    desc = "生产" .. table.concat(names, "、")
  elseif b.kind == "hq" then desc = "部队上限 " .. b.cap[1]
  elseif b.kind == "power" then desc = "工厂收入 ×" .. Config.PowerBoost
  end
  local _, label = Models.sign(pad, "<b>" .. b.name .. "</b>\n$" .. Config.Fmt(b.price) .. "  " .. desc, 5.5, 17, 4.2, nil, 220)
  local pp = Instance.new("ProximityPrompt")
  pp.ActionText = "建造"
  pp.ObjectText = b.name .. "  $" .. Config.Fmt(b.price)
  pp.HoldDuration = 0
  pp.MaxActivationDistance = 14
  pp.RequiresLineOfSight = false
  pp.Parent = pad
  m.Parent = parent
  return m, pad, pp, label
end

---------------------------------------------------------------- 兵种：零件

local function newPart(m, size, cf, color, mat, shape)
  local p = Instance.new("Part")
  if shape then p.Shape = shape end
  p.Size = size
  p.CFrame = cf
  p.Color = color
  p.Material = mat or MAT.SmoothPlastic
  p.TopSurface = Enum.SurfaceType.Smooth
  p.BottomSurface = Enum.SurfaceType.Smooth
  p.Anchored = false
  p.CanCollide = false
  p.CanTouch = false
  p.Massless = true
  p.Parent = m
  return p
end

local function weld(p0, p1, c0)
  local w = Instance.new("Weld")
  w.Part0 = p0
  w.Part1 = p1
  w.C0 = c0
  w.Parent = p1
  return w
end

-- 毂：一个隐形小零件，用 Motor6D 接在 root 上（转轴点 pivot），挂在它上面的零件跟着转
local function hub(m, root, name, pivot, tag)
  local h = newPart(m, V(0.2, 0.2, 0.2), CF(pivot), C.gun)
  h.Name = name .. "Hub"
  h.Transparency = 1
  local mot = Instance.new("Motor6D")
  mot.Name = name .. "Motor"
  mot.Part0 = root
  mot.Part1 = h
  mot.C0 = CF(pivot)
  mot.Parent = h
  if tag then CollectionService:AddTag(mot, tag) end
  return h
end

-- 零件模型的骨架：k 是按设计尺寸放大的倍数；add(尺寸, 相对位置, …) 焊在 root 上，turret(转轴点) 开一个炮塔毂，之后 addT 焊在炮塔毂上
local function kit(k)
  local m = Instance.new("Model")
  local root = Instance.new("Part")
  root.Name = "Root"
  root.Anchored = true
  root.CanCollide = false
  root.CanTouch = false
  root.Transparency = 1
  root.Size = V(1, 1, 1)
  root.CFrame = CF()
  root.Parent = m
  m.PrimaryPart = root
  local K = {}
  local function sc(off) return off - off.Position + off.Position * k end
  function K.add(size, off, color, mat, shape)
    local o = sc(off)
    local p = newPart(m, size * k, o, color, mat, shape)
    weld(root, p, o)
    return p
  end
  local th, tp = nil, nil
  function K.turret(pivot)
    tp = pivot * k
    th = hub(m, root, "Turret", tp)
  end
  function K.addT(size, off, color, mat, shape)
    local o = sc(off)
    local p = newPart(m, size * k, o, color, mat, shape)
    weld(th, p, CF(tp):Inverse() * o)
    return p
  end
  function K.rotor(y, span, color)
    local h = hub(m, root, "Rotor", V(0, y * k, 0), "Rotor")
    for _, sz in ipairs({ V(0.7, 0.12, span), V(span, 0.12, 0.7) }) do
      local blade = newPart(m, sz * k, CF(0, (y + 0.22) * k, 0), color, MAT.Metal)
      weld(h, blade, CF(0, 0.22 * k, 0))
    end
  end
  return m, root, K
end

local function soldier(K, ox, oz, col)
  K.add(V(0.9, 1.6, 0.55), CF(ox, 0.8, oz), C.uniform:Lerp(C.dark, 0.3))
  K.add(V(1.15, 1.5, 0.65), CF(ox, 2.35, oz), C.uniform)
  K.add(V(0.9, 1.0, 0.4), CF(ox, 2.4, oz + 0.5), C.oliveDark)
  K.add(V(0.7, 0.7, 0.7), CF(ox, 3.45, oz), C.skin)
  K.add(V(0.92, 0.38, 0.92), CF(ox, 3.86, oz), col)
  K.add(V(0.16, 0.22, 1.7), CF(ox + 0.42, 2.45, oz - 0.75), C.gun, MAT.Metal)
end

-- 设计尺寸（老版本的零件模型）× k = 配置里的长度
local PART = {}
PART.inf = { len = 4.1, h = 4.1, build = function(K, col)
  for _, o in ipairs({ { -1.8, 1 }, { 1.8, 1 }, { 0, -1.3 } }) do soldier(K, o[1], o[2], col) end
end }
PART.ifv = { len = 7.4, build = function(K, col)
  local dk = darker(col, 0.3)
  K.add(V(1.3, 1.5, 7.2), CF(-2.4, 0.75, 0), C.track, MAT.Metal)
  K.add(V(1.3, 1.5, 7.2), CF(2.4, 0.75, 0), C.track, MAT.Metal)

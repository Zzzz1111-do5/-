-- 玩家本人上阵（小人）：在推演里算一个步兵大小的目标，血量用角色的 Humanoid
Config.Hero = { hp = 200, size = 3, regen = 6, regenDelay = 5, respawn = 3 }

-- 玩家的武器（背包里的工具）：dmg 每发、rate 几秒一发、mag 弹匣、reload 换弹秒数、range 射程、spread 散布（度）；
--   proj 有弹道（火箭弹：speed 弹速，splash 溅射）；vsArmor / vsAir / vsInf 同兵种；pvp 打真人时的伤害倍数
Config.Weapons = {
  rifle = { name = "步枪", price = 0, dmg = 22, rate = 0.12, mag = 30, reload = 1.8, range = 450, spread = 0.8, vsArmor = 0.12, vsAir = 0.5, vsInf = 1, pvp = 1, auto = true },
  smg = { name = "冲锋枪", price = 3000, dmg = 14, rate = 0.065, mag = 40, reload = 1.6, range = 260, spread = 2.2, vsArmor = 0.08, vsAir = 0.4, vsInf = 1, pvp = 1, auto = true },
  sniper = { name = "狙击枪", price = 12000, dmg = 160, rate = 1.3, mag = 5, reload = 2.6, range = 1200, spread = 0, vsArmor = 0.3, vsAir = 0.7, vsInf = 1.2, pvp = 0.8 },
  rpg = { name = "火箭筒", price = 8000, dmg = 380, rate = 0.6, mag = 1, reload = 2.8, range = 700, spread = 0.6, proj = true, speed = 260, splash = 14,
    vsArmor = 1.6, vsAir = 1.1, vsInf = 0.8, pvp = 0.5 },
}
Config.WeaponOrder = { "rifle", "smg", "sniper", "rpg" }

-- 军衔：累计经验（打赢关卡、亲手击毁、突袭、约战）
Config.Ranks = {
  { 0, "列兵" }, { 50, "上等兵" }, { 150, "下士" }, { 350, "中士" }, { 700, "上士" }, { 1200, "少尉" }, { 2000, "中尉" }, { 3200, "上尉" },
  { 5000, "少校" }, { 7500, "中校" }, { 11000, "上校" }, { 16000, "大校" }, { 23000, "少将" }, { 33000, "中将" }, { 50000, "上将" },
}
function Config.RankOf(xp)
  local name, i = Config.Ranks[1][2], 1
  for k, r in ipairs(Config.Ranks) do
    if xp >= r[1] then name, i = r[2], k end
  end
  return name, i
end

-- 重生：基地里（含已经开放的新区域）的建筑全部盖好就能重生，最多 max 次——建筑、现金、关卡、部队、科技清零，
--   换永久加成（每次收入 +income、部队血量伤害 +power），再开放一块新区域（Config.Areas）；武器、经验、军衔、积分留着
Config.Rebirth = { max = 3, income = 0.5, power = 0.1 }

-- 战场支援（打仗时屏幕下方的技能键：点一下技能，再点战场上的位置；电脑上也能按 Z X V B N）：
--   need 盖了哪栋楼才有；cd 冷却秒数（每一仗开打时全部就绪）；伤害、援军强度跟着全军战力（军工科技 × 重生）走
--   kind：barrage 炮弹覆盖（n 发落在半径 r 里，每发 dmg、溅射 splash，flight 秒后陆续落地；拦截炮挡得住）/ heal 治疗（半径 r 内我方回 pct 成血）/
--         drop 空投援军（squads 个步兵班，这一仗打完就撤）/ strike 空袭（沿进攻方向 len 格长扔 n 颗炸弹；拦截炮挡不住）
Config.Skills = {
  { id = "mortar", name = "迫击炮急袭", key = "Z", need = "barracks", cd = 25, kind = "barrage", n = 6, r = 20, dmg = 55, splash = 16, flight = 2.2,
    vsArmor = 0.35, vsInf = 1.5, desc = "6 发迫击炮弹砸向一片，专炸扎堆的步兵" },
  { id = "heal", name = "战地急救", key = "X", need = "hq", cd = 40, kind = "heal", r = 70, pct = 0.4, desc = "范围里的我方部队和你本人回四成血" },
  { id = "barrage", name = "炮火覆盖", key = "V", need = "artyfac", cd = 40, kind = "barrage", n = 12, r = 36, dmg = 95, splash = 26, flight = 3,
    vsArmor = 0.9, vsInf = 1.4, desc = "12 发 155 毫米炮弹覆盖一大片（敌方拦截炮挡得住）" },
  { id = "drop", name = "空投援军", key = "B", need = "helipad", cd = 60, kind = "drop", squads = 3, desc = "把 3 个步兵班空投到指定位置，这一仗打完就撤" },
  { id = "strike", name = "空袭", key = "N", need = "airbase", cd = 55, kind = "strike", n = 12, len = 150, dmg = 140, splash = 24,
    vsArmor = 1.1, vsInf = 1.4, desc = "轰炸机沿进攻方向扔下一串 12 颗炸弹（拦截炮挡不住）" },
  { id = "cruise", name = "巡航导弹", key = "M", need = "silo", cd = 90, kind = "missile", dmg = 1100, splash = 46, flight = 5,
    vsArmor = 1.5, vsInf = 1.3, desc = "从工业区的导弹发射井打出一枚巡航导弹，炸平一大片（拦截炮挡不住）" },
}
-- 这个玩家的技能冷却（有雷达站快两成）
function Config.SkillCD(sk, owned)
  return sk.cd * ((owned and owned.radar) and Config.RadarCD or 1)
end
Config.SkillById = {}
for _, sk in ipairs(Config.Skills) do Config.SkillById[sk.id] = sk end

-- 老兵：打完一仗活下来的部队攒经验（活下来 +1，每亲手击毁一个敌人再 +1），够 need 里的数就升一星（最多 3 星），每星血量、伤害 +bonus；星级跟着存档
Config.Vet = { need = { 3, 8, 16 }, bonus = 0.15 }
function Config.StarsOf(v)
  local s = 0
  for i, n in ipairs(Config.Vet.need) do
    if (v or 0) >= n then s = i end
  end
  return s
end

-- 补给空投：不打仗的时候每隔 every 秒（± jitter）往基地里空投一个补给箱，走过去碰一下就拿钱（= sec 秒的收入，至少 min），life 秒没捡就收走
Config.Crate = { every = 80, jitter = 25, sec = 45, min = 150, life = 120 }
-- 里程碑：打赢第 5、10、15……关时额外奖励（= 这一关的奖励 × k）
Config.Milestone = { every = 5, k = 1.5 }

-- 每日奖励（连续登录，最多叠到 7 天）和每日任务（每天三个，按日期换）
Config.Daily = { base = 500, incomeSec = 90, step = 0.25, max = 7 }
Config.Missions = {
  { id = "win3", text = "打赢 3 场关卡", kind = "win", goal = 3 },
  { id = "kill10", text = "亲手（拿枪或开载具）击毁 10 个敌方单位", kind = "kill", goal = 10 },
  { id = "make8", text = "生产 8 个单位", kind = "make", goal = 8 },
  { id = "raid1", text = "突袭赢 1 次", kind = "raidwin", goal = 1 },
  { id = "drive3", text = "开载具击毁 3 个敌方单位", kind = "drivekill", goal = 3 },
  { id = "duel1", text = "和别的玩家约战 1 次", kind = "duel", goal = 1 },
  { id = "tech1", text = "升级 1 次军工科技", kind = "tech", goal = 1 },
  { id = "boss1", text = "打赢一场首领关", kind = "boss", goal = 1 },
  { id = "build2", text = "盖 2 栋建筑", kind = "build", goal = 2 },
  { id = "skill5", text = "打仗时放 5 次战场支援", kind = "skill", goal = 5 },
  { id = "crate3", text = "捡 3 个补给空投箱", kind = "crate", goal = 3 },
  { id = "up3", text = "升级 3 次建筑", kind = "upgrade", goal = 3 },
}
Config.MissionRewardSec = 120   -- 任务奖励 = 这么多秒的收入（至少 400）

-- 突袭（打别的玩家存下来的防线，对方不在线也能打）和约战（同一个服务器里点名挑战，友谊赛不算积分）
Config.Raid = { cooldown = 25, range = 250, start = 1000, k = 32, loot = 0.6, minUnits = 1 }
Config.Duel = { invite = 20, reward = 300, share = 0.2 }
-- 真人对战（排位，服内或跨服匹配）：start 起始积分、k 每场最多涨跌；window / widen / maxWindow 能配的积分差（等得越久放得越宽，每秒 +widen）；
--   tick 每几秒配一次、expire 排队记录几秒过期、refresh 几秒刷新一次；waitMax 对战服务器里等对手最多几秒、countdown 到齐后几秒开打、back 打完几秒送回去；
--   reward 赢了的奖金（再加对方部队价值的 share）、lose 输了的安慰奖
Config.Match = { start = 1000, k = 32, window = 120, widen = 12, maxWindow = 900, tick = 3, expire = 60, refresh = 10, waitMax = 75, countdown = 5, back = 8,
  reward = 600, share = 0.25, lose = 150 }

-- 音效：留空就用 Roblox 自带的声音（爆炸声变调当枪炮声）；想换成自己的就填 "rbxassetid://数字"（Studio 工具箱 → 音频里搜，复制 ID）
Config.Sounds = { rifle = "", cannon = "", aa = "", rocket = "", boom = "", build = "", buy = "", win = "", lose = "", gun = "", hit = "", kill = "", coin = "", click = "", hurt = "", alarm = "" }

-- 关卡敌军：预算按关卡往上涨，兵种逐渐解锁；每十关多一辆首领（同一关的敌军每次都一样，开打前就能看到）
function Config.EnemyBudget(level)
  return math.floor(150 * (1.28 ^ (level - 1)))
end
function Config.EnemyTypes(level)
  local t = {}
  for _, id in ipairs(Config.UnitOrder) do
    if (Config.Units[id].lv or 99) <= level then table.insert(t, id) end
  end
  return t
end
function Config.IsBoss(level)
  return level % 10 == 0
end
-- 战区：每 10 关换一个（打掉首领就进下一个），地面、两边的地形、道具都换；奖励加成 reward，speed 地面部队速度倍数，range 射程倍数，quake 每几秒一次火山弹
Config.Theaters = {
  { id = "grass", lv = 1, name = "绿野战区", reward = 0, desc = "开阔的田野和农舍废墟" },
  { id = "desert", lv = 11, name = "沙漠战区", reward = 0.2, speed = 0.9, desc = "沙地难走：地面部队慢一成；奖励 +20%" },
  { id = "snow", lv = 21, name = "雪原战区", reward = 0.4, speed = 0.85, desc = "积雪很深：地面部队慢一成半；奖励 +40%" },
  { id = "urban", lv = 31, name = "城市废墟", reward = 0.6, range = 0.88, desc = "巷战：大家射程短一成；奖励 +60%" },
  { id = "volcano", lv = 41, name = "火山战区", reward = 0.8, quake = 14, desc = "每隔十几秒有火山弹砸下来，敌我都伤；奖励 +80%" },
}
function Config.TheaterOf(level)
  local t = Config.Theaters[1]
  for _, th in ipairs(Config.Theaters) do
    if level >= th.lv then t = th end
  end
  return t
end
function Config.Reward(level)
  local r = math.floor(Config.EnemyBudget(level) * 0.9 + 100 * level)
  if Config.IsBoss(level) then r = r * 2 end
  return math.floor(r * (1 + (Config.TheaterOf(level).reward or 0)))
end

-- 查表：建筑 id → 建筑；兵种 → 生产它的建筑 id
Config.BuildingById = {}
Config.UnitSource = {}
for _, b in ipairs(Config.Buildings) do
  Config.BuildingById[b.id] = b
  for _, u in ipairs(b.units or {}) do Config.UnitSource[u] = b.id end
end

-- 数字加千位分隔：12345 → 12,345
function Config.Fmt(n)
  local s = string.format("%.0f", math.floor(math.abs(n)))
  local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
  if out:sub(1, 1) == "," then out = out:sub(2) end
  if n < 0 then out = "-" .. out end
  return out
end

-- 天数（UTC），每日奖励、每日任务用
function Config.Day(t)
  return math.floor(t / 86400)
end

-- 某一天的三个任务（按日期定，同一天大家一样）
function Config.MissionsOf(day)
  local rng = Random.new(day * 131 + 7)
  local pool = {}
  for i = 1, #Config.Missions do pool[i] = i end
  local out = {}
  for _ = 1, 3 do
    local k = rng:NextInteger(1, #pool)
    table.insert(out, Config.Missions[pool[k]])
    table.remove(pool, k)
  end
  return out
end

return Config
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX00000000000000000000000000000003">
<Properties>
<string name="Name">UnitModels</string>
</Properties>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000000000000000000000000000012">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX00000000000000000000000000000011">
<Properties>
<string name="Name">Main</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：服务器主脚本（ServerScriptService.Main）
-- 各模块共用一个上下文 G：每个模块的 init(G) 把自己的函数挂到 G 上，模块之间通过 G 互相调用（不互相 require，免得循环引用）
--   World 地图 · Store 存档 / 排行榜 / 突袭匹配 · Economy 经济与成长 · Army 平时的部队 · Combat 战斗 · Weapons 玩家的枪 · Match 真人对战匹配
--   Skills 战场支援技能 · Crates 补给空投 · Models 模型 · Battle 推演
-- 循环里每个玩家、每一步都包在 pcall 里：一个人、一步出错只跳过那一下，不会把整个服务器的收入、战斗卡死（出错原文发到所有人屏幕上的红条）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS:WaitForChild("Config"))
local G = {
  Config = Config,
  Models = require(script:WaitForChild("Models")),
  Battle = require(script:WaitForChild("Battle")),
  states = {},   -- [player] = st
}
local V = Vector3.new

Players.CharacterAutoLoads = false   -- 分到基地以后再生成角色，出生在自己基地里

---------------------------------------------------------------- 远程事件

local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
G.R = {}
for _, name in ipairs({ "State", "Toast", "Action", "Fx", "Battle", "Shoot", "Drive", "Duel", "Board", "Err" }) do
  local r = Instance.new("RemoteEvent")
  r.Name = name
  r.Parent = Remotes
  G.R[name] = r
end
Remotes.Parent = RS

local fxq = {}
function G.fx(e)
  fxq[#fxq + 1] = e
end
function G.toast(st, msg, kind)
  G.R.Toast:FireClient(st.pl, msg, kind or "info")
end

-- 开服时出的错记下来：进服的玩家屏幕上也提示一下（不打开 Output 窗口也看得到）
G.bootErrors = {}
local function bootError(what, err)
  local msg = "[军事大亨] " .. what .. "出错：" .. tostring(err)
  warn(msg)
  table.insert(G.bootErrors, msg)
end
-- 运行中接住的错：Output 里留一条，所有玩家屏幕上方红条显示（同一个错只发一次，免得刷屏）
local errSeen, errN = {}, 0
function G.reportError(where, err)
  local full = tostring(err)
  local first = string.match(full, "^[^\n]*") or full
  local key = tostring(where) .. first
  if errSeen[key] then return end
  errSeen[key] = true
  errN = errN + 1
  warn("[军事大亨] " .. tostring(where) .. " 出错：" .. full)
  if errN <= 8 then pcall(function() G.R.Err:FireAllClients(string.sub(tostring(where) .. "：" .. first, 1, 300)) end) end
end
-- 安全地调：出错就上报（带出错位置的调用栈）、返回 false
local function tb(e) return debug.traceback(tostring(e), 2) end
function G.try(where, f, ...)
  local ok, err = xpcall(f, tb, ...)
  if not ok then G.reportError(where, err) end
  return ok, err
end

-- 先收导入的原模型（在铺地形、建地图之前：没锚定的模型别掉下去砸在地上散开）
local okImp, imported = pcall(G.Models.loadImported)
if not okImp then
  bootError("整理导入的模型", imported)
elseif #imported > 0 then
  print("[军事大亨] 用上了导入的原模型：" .. table.concat(imported, "、"))
end
-- 各模块挂到 G 上；一个出错不影响后面的（init 里不能等网络，要等的放 task.spawn）
for _, name in ipairs({ "World", "Store", "Economy", "Army", "Combat", "Weapons", "Match", "Skills", "Crates" }) do
  local ok, err = pcall(function() require(script:WaitForChild(name)).init(G) end)
  if not ok then bootError("模块 " .. name .. " ", err) end
end

local BDEF = Config.BuildingById

---------------------------------------------------------------- 发给客户端的状态

function G.push(st)
  local d = st.data
  if not d then return end
  local counts = {}
  for _, u in pairs(st.units) do counts[u.t] = (counts[u.t] or 0) + 1 end
  local enemy = {}
  for _, e in ipairs(st.enemy) do enemy[e.t] = (enemy[e.t] or 0) + 1 end
  local hqNext = nil
  if d.owned.hq and d.hq < #BDEF.hq.cap then hqNext = BDEF.hq.up[d.hq] end
  local techNext = nil
  if d.tech < Config.Tech.max then techNext = Config.TechCost(d.tech) end
  local rank, ri = Config.RankOf(d.xp)
  local nextXp = Config.Ranks[ri + 1] and Config.Ranks[ri + 1][1] or nil
  G.missionsFresh(st)
  local ms = {}
  for i, m in ipairs(d.missions.list) do
    local def = G.missionDef[m.id]
    if def then ms[i] = { text = def.text, goal = def.goal, prog = m.prog, claimed = m.claimed } end
  end
  local dOK, dAmt, dStreak = G.dailyInfo(st)
  local weapons = {}
  for id in pairs(d.weapons) do weapons[id] = true end
  local B = st.battle
  local rbBuilt, rbTotal = Config.RebirthProgress(d.owned, d.rebirth)
  G.R.State:FireClient(st.pl, {
    cash = d.cash, income = st.income, level = d.level, best = d.best, cap = G.capOf(d), n = G.count(st), counts = counts,
    owned = d.owned, lv = d.lv, hq = d.hq, hqNext = hqNext, tech = d.tech, techNext = techNext, plot = st.plot.index, origin = st.plot.origin,
    battle = B ~= nil, mode = B and B.mode or nil, enemy = enemy, reward = Config.Reward(d.level), save = st.canSave,
    rebirth = d.rebirth, canRebirth = G.canRebirth(d), rbBuilt = rbBuilt, rbTotal = rbTotal, savedAt = st.savedAt, xp = d.xp, rank = rank, nextXp = nextXp, rating = d.rating, kills = d.kills,
    weapons = weapons, daily = { ok = dOK, amount = dAmt, streak = dStreak }, missions = ms, missionReward = G.missionReward(st),
    raidCD = math.max(0, math.ceil((st.raidCD or 0) - os.clock())), power = G.powerOf(d),
    pvp = d.pvp, pvpWins = d.pvpWins, pvpGames = d.pvpGames, match = G.matchInfo and G.matchInfo(st) or nil, matchServer = G.matchServer, teleporting = st.teleporting == true,
    skills = G.skillInfo and G.skillInfo(st) or nil, vets = G.vetCount and G.vetCount(st) or 0, wins = d.wins or 0,
    crate = st.crate and st.crate.landed and st.crate.pos or nil, event = Config.EventOf(d.level),
  })
  if st.ls then
    st.ls.cash.Value = math.floor(d.cash)
    st.ls.level.Value = d.level
    st.ls.rank.Value = rank
  end
  st.dirty = false
end

---------------------------------------------------------------- 进出服务器

local function spawnChar(st)
  if G.states[st.pl] ~= st or not st.pl.Parent then return end
  local ok, err = pcall(function() st.pl:LoadCharacter() end)
  if not ok then warn("[军事大亨] 生成角色失败：" .. tostring(err)) end
end

local function onCharacter(st, char)
  local hrp = char:WaitForChild("HumanoidRootPart", 10)
  if hrp and G.states[st.pl] == st then
    task.wait()
    local S, o = Config.Spawn, st.plot.origin
    char:PivotTo(CFrame.lookAt(o + V(S.x, 5, S.z), o + V(S.x, 5, S.z + 10)))
  end
  local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
  if hum then
    hum.Died:Connect(function()
      if st.driving then G.driveStop(st) end
      task.wait(Config.Hero.respawn)
      if G.states[st.pl] == st and st.pl.Character == char then spawnChar(st) end
    end)
  end
  if G.states[st.pl] == st and st.data then
    G.giveTools(st)
    G.rankTag(st)
  end
end

local function onPlayer(pl)
  if G.states[pl] then return end
  local plot = nil
  for _, p in ipairs(G.plots) do
    if not p.owner then
      plot = p
      break
    end
  end
  if not plot then
    pl:Kick("这个服务器的基地都有人了，换一个服务器吧")
    return
  end
  plot.owner = pl
  plot.sign.Text = pl.DisplayName .. " 的基地"
  local st = { pl = pl, plot = plot, units = {}, enemy = {}, pads = {}, padT = {}, nextUid = 0, income = 0, ready = false, canSave = false }
  G.states[pl] = st
  -- 排行榜（右上角玩家列表里显示）
  local ls = Instance.new("Folder")
  ls.Name = "leaderstats"
  local lv = Instance.new("IntValue")
  lv.Name = "关卡"
  lv.Value = 1
  lv.Parent = ls
  local cash = Instance.new("IntValue")
  cash.Name = "现金"
  cash.Parent = ls
  local rk = Instance.new("StringValue")
  rk.Name = "军衔"
  rk.Value = Config.Ranks[1][2]
  rk.Parent = ls
  ls.Parent = pl
  st.ls = { level = lv, cash = cash, rank = rk }
  pl.CharacterAdded:Connect(function(char) onCharacter(st, char) end)

  local raw, ok = G.loadData(pl)
  if G.states[pl] ~= st then return end   -- 读档的时候人走了
  st.data = G.cleanData(raw)
  st.canSave = ok
  local d = st.data
  -- 盖楼、摆部队、摆敌军：出错也要接着往下走（至少把人生成出来，屏幕上提示出错）
  local okSetup, errSetup = pcall(function()
    G.econSetup(st)
    G.armySetup(st)
    G.makeEnemy(st)
    if G.setTheater then G.setTheater(st, Config.TheaterOf(d.level)) end   -- 战场换成这个关卡所在的战区
  end)
  if not okSetup then bootError("给 " .. pl.Name .. " 准备基地", errSetup) end
  -- 离线收益：按在线的 OfflineRate 成，最多算 OfflineHours 小时
  local away = 0
  if type(raw) == "table" and type(raw.t) == "number" then away = os.time() - raw.t end
  if away > 60 and st.income > 0 then
    local earn = math.floor(st.income * math.min(away, Config.OfflineHours * 3600) * Config.OfflineRate)
    d.cash = d.cash + earn
    task.delay(4, function()
      if G.states[pl] == st then
        local h = (away >= 3600) and (math.floor(away / 3600) .. " 小时 " .. math.floor(away % 3600 / 60) .. " 分") or (math.floor(away / 60) .. " 分钟")
        G.toast(st, "离线收益 +$" .. Config.Fmt(earn) .. "（离开了 " .. h .. "）", "good")
      end
    end)
  end
  st.ready = true
  local okPush, errPush = pcall(G.push, st)
  if not okPush then bootError("发状态给 " .. pl.Name, errPush) end
  if pl.Character then task.spawn(onCharacter, st, pl.Character) else spawnChar(st) end
  if G.matchArrive then task.spawn(G.matchArrive, st) end   -- 对战服务器：认人、到齐开打
  for _, msg in ipairs(G.bootErrors) do G.toast(st, msg .. "（请把这句截图发给开发者）", "bad") end
  task.delay(2, function()
    if G.states[pl] ~= st then return end
    if not ok then
      G.toast(st, "存档没读到，这次的进度不会保存（在 Studio 里测试：先发布，再在游戏设置 → 安全里打开 API 访问）", "bad")
    end
    if G.matchServer then return end
    if type(raw) ~= "table" then
      G.toast(st, "欢迎来到军事大亨！踩绿色按钮盖楼，楼会一直给你赚钱", "info")
      task.wait(6)
      if G.states[pl] == st then G.toast(st, "盖好兵营就能生产部队：右边「兵工厂」，或者走到兵营旁按 E", "info") end
      task.wait(6)
      if G.states[pl] == st then G.toast(st, "点「开战」打这一关；你本人也会上战场——拿着枪（物理栏 1）一起打，还能开自己的坦克", "info") end
    else
      local log = G.readRaidLog(pl)
      if log and G.states[pl] == st then
        local held = 0
        for _, e in ipairs(log) do
          if type(e) == "table" and e.w then held = held + 1 end
        end
        G.toast(st, "你不在的时候防线被突袭了 " .. #log .. " 次，守住 " .. held .. " 次", (held * 2 >= #log) and "good" or "bad")
      end
    end
  end)
end

Players.PlayerAdded:Connect(onPlayer)
for _, pl in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, pl) end

Players.PlayerRemoving:Connect(function(pl)
  local st = G.states[pl]
  if not st then return end
  if G.matchCancel then G.matchCancel(st, true) end
  if st.battle then G.abandon(st) end
  st.battle = nil
  if st.ready and not st.teleporting then G.save(st) end   -- 传送走的人传送前已经存过（别拿这里的旧数据盖掉对战服务器存的）
  G.states[pl] = nil
  local plot = st.plot
  for _, name in ipairs({ "Buildings", "Pads", "Units", "Enemies", "Drops", "Areas" }) do plot[name]:ClearAllChildren() end
  st.crate = nil
  plot.owner = nil
  plot.sign.Text = "空基地"
end)

game:BindToClose(function()
  local list = {}
  for _, st in pairs(G.states) do table.insert(list, st) end
  for _, st in ipairs(list) do
    if st.ready then G.save(st) end
  end
end)

---------------------------------------------------------------- 客户端发来的操作

local ACT = {
  buy = function(st, a) G.buyUnit(st, a) end,
  move = function(st, a, b, c) G.moveUnit(st, a, b, c) end,
  place = function(st, a) G.placeUnits(st, a) end,
  sell = function(st, a) G.sellUnit(st, a) end,
  arrange = function(st) G.arrange(st) end,
  battle = function(st) G.startBattle(st) end,
  raid = function(st) G.startRaid(st) end,
  duel = function(st, a) G.duelInvite(st, a) end,
  duelYes = function(st, a) G.duelAnswer(st, a, true) end,
  duelNo = function(st, a) G.duelAnswer(st, a, false) end,
  hq = function(st) G.upgradeHQ(st) end,
  tech = function(st) G.upgradeTech(st) end,
  upgrade = function(st, a) G.upgradeBuilding(st, a) end,
  rebirth = function(st) G.rebirth(st) end,
  daily = function(st) G.claimDaily(st) end,
  mission = function(st, a) G.claimMission(st, a) end,
  weapon = function(st, a) G.buyWeapon(st, a) end,
  reload = function(st, a) G.reload(st, a) end,
  drive = function(st, a) G.driveStart(st, a) end,
  exit = function(st) G.driveStop(st) end,
  rejoin = function(st) G.heroJoin(st) end,
  home = function(st) G.sendHome(st) end,
  match = function(st) if G.matchJoin then G.matchJoin(st) end end,
  matchCancel = function(st) if G.matchCancel then G.matchCancel(st) end end,
  skill = function(st, a, b, c) if G.useSkill then G.useSkill(st, a, b, c) end end,
  ability = function(st, a) if G.useAbility then G.useAbility(st, a) end end,
}
-- 对战服务器里只打那一场排位赛
local MATCHBLOCK = { battle = true, raid = true, duel = true, duelYes = true, match = true, rebirth = true }
G.R.Action.OnServerEvent:Connect(function(pl, op, a, b, c)
  local st = G.states[pl]
  if not st or not st.ready or type(op) ~= "string" then return end
  -- 限流：每秒十来次
  local now = os.clock()
  st.tokens = math.min(15, (st.tokens or 15) + (now - (st.tokT or now)) * 10)
  st.tokT = now
  if st.tokens < 1 then return end
  st.tokens = st.tokens - 1
  if G.matchServer and MATCHBLOCK[op] then
    G.toast(st, "对战服务器里只打这一场排位赛，打完自动送你回去", "info")
    return
  end
  local f = ACT[op]
  if f then
    G.try("操作 " .. op, f, st, a, b, c)
    st.needSave = true   -- 下一轮自动存档存上
  end
end)

G.R.Shoot.OnServerEvent:Connect(function(pl, id, aim)
  local st = G.states[pl]
  if st and st.ready and type(id) == "string" then G.try("开枪", G.shoot, st, id, aim) end
end)

G.R.Drive.OnServerEvent:Connect(function(pl, d)
  local st = G.states[pl]
  if not st or not st.ready or type(d) ~= "table" then return end
  G.try("开车", function()
    G.driveInput(st, d)
    if d.fire ~= nil then G.driveFire(st, d.fire) end
  end)
end)

---------------------------------------------------------------- 循环

-- 每秒：收入、按钮颜色、状态
task.spawn(function()
  while true do
    task.wait(1)
    for _, st in pairs(G.states) do
      if st.ready and st.data then
        G.try("收入", G.econTick, st)
        G.try("发状态", G.push, st)
      end
    end
  end
end)

-- 自动存档：每 30 秒看一圈，这段时间里操作过的（买、盖、升级、打完仗……）就存；没操作的也至少两分钟存一次（钱一直在涨）
task.spawn(function()
  while true do
    task.wait(30)
    local list = {}
    for _, st in pairs(G.states) do table.insert(list, st) end
    local now = os.clock()
    for _, st in ipairs(list) do
      if G.states[st.pl] == st and st.ready and not st.teleporting and (st.needSave or now - (st.saveT or 0) > 120) then
        st.needSave = false
        st.saveT = now
        G.try("自动存档", G.save, st)
      end
    end
  end
end)

-- 排行榜：每分钟刷新一次牌子和界面
task.spawn(function()
  task.wait(8)
  while true do
    local okB, lv, rt, pv = pcall(G.readBoards)
    if not okB then lv, rt, pv = {}, {}, {} end
    local function lines(title, list)
      local out = { title }
      for i, e in ipairs(list) do table.insert(out, i .. ". " .. e.name .. "  " .. Config.Fmt(e.value)) end
      if #list == 0 then table.insert(out, "（暂无）") end
      return table.concat(out, "\n")
    end
    local t1, t2, t3 = lines("最高关卡", lv), lines("突袭积分", rt), lines("对战积分", pv)
    for _, p in ipairs(G.plots) do
      p.board[1].Text = t1
      p.board[2].Text = t2
      p.board[3].Text = t3
    end
    G.R.Board:FireAllClients({ level = lv, rating = rt, pvp = pv })
    task.wait(60)
  end
end)

-- 每帧：平时的部队开来开去；特效攒一帧发一次
RunService.Heartbeat:Connect(function(dt)
  if G.armyStep then G.try("部队移动", G.armyStep, dt) end
  if #fxq > 0 then
    local list = fxq
    fxq = {}
    G.R.Fx:FireAllClients(list)
  end
end)

print("[军事大亨] " .. Config.Version .. " 服务器启动好了" .. ((#G.bootErrors > 0) and ("（有 " .. #G.bootErrors .. " 处出错，见上面的警告）") or ""))
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000005">
<Properties>
<string name="Name">Army</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：部队（平时）：生产（从工厂开出来停到部署区）、阵位、挪位置、排阵、解散、关卡敌军预览；老兵星级（头顶的星）
local Army = {}

function Army.init(G)
  local Config, Models, Battle = G.Config, G.Models, G.Battle
  local F = Config.Field
  local UNITS, BDEF = Config.Units, Config.BuildingById
  local hs = Config.BaseSize / 2
  local ROADZ = (hs + F.center - F.length / 2) / 2

  function G.count(st)
    local n = 0
    for _ in pairs(st.units) do n = n + 1 end
    return n
  end

  local function setFly(u, on)
    if u.model and u.model.Parent then u.model:SetAttribute("Fly", on) end
  end
  G.setFly = setFly

  -- 老兵：头顶的金星（模型属性 Stars 也记一份，客户端布阵时能看）
  function G.vetTag(st, u)
    local n = Config.StarsOf(u.v)
    if not (u.root and u.root.Parent) then return end
    u.model:SetAttribute("Stars", n)
    local tag = u.root:FindFirstChild("Vet")
    if n <= 0 then
      if tag then tag:Destroy() end
      return
    end
    if not tag then
      tag = Models.sign(u.root, "", Models.heightOf(u.t) + 6, 6, 1.6, Color3.fromRGB(255, 214, 80), 260)
      tag.Name = "Vet"
    end
    tag:FindFirstChildOfClass("TextLabel").Text = string.rep("★", n)
  end
  function G.vetCount(st)
    local n = 0
    for _, u in pairs(st.units) do
      if Config.StarsOf(u.v) > 0 then n = n + 1 end
    end
    return n
  end

  local function newModel(st, u)
    local model, root = Models.unit(u.t, st.plot.color)
    model.Name = "U" .. u.uid
    model:SetAttribute("Uid", u.uid)
    model:SetAttribute("Type", u.t)
    model:SetAttribute("Owner", st.pl.UserId)
    model:SetAttribute("Fly", false)
    model.Parent = st.plot.Units
    u.model, u.root, u.bar, u.fill = model, root, nil, nil
    root.CFrame = G.unitCF(st.plot.origin, u.x, u.y, u.z, u.h)
    if (u.v or 0) > 0 then G.vetTag(st, u) end
  end

  function G.spawnUnit(st, t, x, z, y, h, v)
    st.nextUid = st.nextUid + 1
    local u = { uid = st.nextUid, t = t, x = x, y = y or 0, z = z, h = h or math.pi, sx = x, sz = z, v = v or 0 }
    newModel(st, u)
    st.units[u.uid] = u
    return u
  end

  -- 约战里打没了的单位：战后在阵位上换一个新模型（约战不损失部队）
  function G.respawnModel(st, u)
    if u.model then u.model:Destroy() end
    u.x, u.y, u.z, u.h, u.path = u.sx, 0, u.sz, math.pi, nil
    newModel(st, u)
  end

  -- 全部开回（直接放回）阵位
  function G.homeSnap(st)
    for _, u in pairs(st.units) do
      u.path = nil
      u.x, u.y, u.z, u.h = u.sx, 0, u.sz, math.pi
      setFly(u, false)
      if u.root and u.root.Parent then u.root.CFrame = G.unitCF(st.plot.origin, u.x, 0, u.z, u.h) end
    end
  end

  -- (x, z) 这个阵位空不空（跟别的部队的阵位比）
  local function spotFree(st, x, z, size, skip)
    for _, o in pairs(st.units) do
      if o ~= skip then
        local need = (size + UNITS[o.t].size) / 2 + 2
        local dx, dz = o.sx - x, o.sz - z
        if dx * dx + dz * dz < need * need then return false end
      end
    end
    return true
  end

  -- 找个空阵位：默认按兵种的 row 排在部署区里（步兵最前，火炮、火箭炮、飞机最后），从中间往两边一圈圈找
  local function rowOff(t)
    return 8 + ((UNITS[t].row or 5) - 1) * 15
  end
  local function zoneOf(size)
    local D = F.deploy
    return F.width / 2 - 10 - size / 2, D[1] + size / 2 + 2, D[2] - size / 2 - 2
  end
  local function freeSpot(st, t, nearX, nearZ, skip)
    local size = UNITS[t].size
    local xmax, z1, z2 = zoneOf(size)
    local x0 = math.clamp(nearX or 0, -xmax, xmax)
    local z0 = math.clamp(nearZ or (F.deploy[2] - rowOff(t)), z1, z2)
    local step = size + 3
    for ring = 0, 16 do
      local n = math.max(1, ring * 8)
      for k = 0, n - 1 do
        local a = k / n * math.pi * 2
        local x = x0 + math.cos(a) * ring * step
        local z = z0 + math.sin(a) * ring * step * 0.6
        if math.abs(x) <= xmax and z >= z1 and z <= z2 and spotFree(st, x, z, size, skip) then
          return x, z
        end
      end
    end
    return x0, z0
  end

  -- 新兵从工厂开出来：出门 → 横通道（z = 60）→ 中间通道 → 路上 → 阵位（直升机直接飞过去；喷气机在空军基地的跑道上滑跑起飞）
  local function exitPath(u, b)
    local def = UNITS[u.t]
    if def.jet and b.id == "airbase" then
      local rz0, rz1 = b.z - b.size[3] / 2 + 14, b.z + b.size[3] / 2 - 10
      u.x, u.z, u.h = b.x, rz0, math.pi
      u.path = { { x = b.x, z = rz1, y = 0 }, { x = b.x, z = rz1 + 90, y = 30 }, { x = u.sx, z = u.sz, y = 50 }, { x = u.sx, z = u.sz, y = 0 } }
      setFly(u, true)
    elseif def.air then
      u.path = { { x = b.x, z = b.z, y = 40 }, { x = u.sx, z = u.sz, y = 40 }, { x = u.sx, z = u.sz, y = 0 } }
      setFly(u, true)
    else
      local gx = math.clamp(b.x, -60, 45)
      u.path = {
        { x = b.x, z = b.z + b.size[3] / 2 + 6, y = 0 },
        { x = b.x, z = 60, y = 0 },
        { x = gx, z = 60, y = 0 },
        { x = gx, z = ROADZ, y = 0 },
        { x = u.sx, z = u.sz, y = 0 },
      }
    end
  end

  -- 开到新位置（直升机先升空再落）
  function G.goTo(u, x, z)
    if UNITS[u.t].air then
      local cruise = math.max(u.y, 24)
      u.path = { { x = u.x, z = u.z, y = cruise }, { x = x, z = z, y = cruise }, { x = x, z = z, y = 0 } }
      setFly(u, true)
    else
      u.path = { { x = x, z = z, y = 0 } }
    end
  end

  local function stepPath(st, u, dt)
    local wp = u.path[1]
    local def = UNITS[u.t]
    local sp = (def.jet and 90 or def.air and 50 or def.speed * 1.6) * dt
    local dx, dy, dz = wp.x - u.x, wp.y - u.y, wp.z - u.z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist <= sp then
      u.x, u.y, u.z = wp.x, wp.y, wp.z
      table.remove(u.path, 1)
      if #u.path == 0 then
        u.path = nil
        u.h = math.pi
        setFly(u, false)
      end
    else
      u.x = u.x + dx / dist * sp
      u.y = u.y + dy / dist * sp
      u.z = u.z + dz / dist * sp
      if dx * dx + dz * dz > 0.04 then Battle.turn(u, dx, dz, dt, 4) end
    end
    if u.root and u.root.Parent then u.root.CFrame = G.unitCF(st.plot.origin, u.x, u.y, u.z, u.h) end
  end

  -- 每帧：平时（不在打仗）的部队开来开去
  function G.armyStep(dt)
    for _, st in pairs(G.states) do
      if st.ready and not st.battle then
        for _, u in pairs(st.units) do
          if u.path then stepPath(st, u, dt) end
        end
      end
    end
  end

  function G.buyUnit(st, t)
    if not st.ready then return end
    local def = UNITS[t]
    if not def or def.boss then return end
    local d = st.data
    local src = BDEF[Config.UnitSource[t]]
    if not src or not d.owned[src.id] then
      G.toast(st, "先盖" .. (src and src.name or "工厂") .. "才能生产" .. def.name, "bad")
      return
    end
    if def.needHQ and d.hq < def.needHQ then
      G.toast(st, def.name .. "要指挥部 " .. def.needHQ .. " 级", "bad")
      return
    end
    if st.battle then
      G.toast(st, "打仗的时候不能生产", "bad")
      return
    end
    local cap = G.capOf(d)
    if G.count(st) >= cap then
      G.toast(st, "部队满了（" .. cap .. "）：" .. (d.owned.hq and "升级指挥部能带更多" or "盖指挥部能带更多"), "bad")
      return
    end
    if d.cash < def.price then
      G.toast(st, "钱不够：" .. def.name .. " 还差 $" .. Config.Fmt(def.price - d.cash), "bad")
      return
    end
    d.cash = d.cash - def.price
    local x, z = freeSpot(st, t)
    local u = G.spawnUnit(st, t, src.x, src.z, def.air and 0.8 or 0, math.pi)
    u.sx, u.sz = x, z
    exitPath(u, src)
    G.progress(st, "make", 1)
    G.push(st)
  end

  -- 直接摆到阵位上（布阵时挪位置不再慢慢开过去：客户端那份显示会很快地滑过去）
  local function snapTo(st, u, x, z)
    u.sx, u.sz = x, z
    u.path = nil
    u.x, u.y, u.z, u.h = x, 0, z, math.pi
    setFly(u, false)
    if u.root and u.root.Parent then u.root.CFrame = G.unitCF(st.plot.origin, x, 0, z, u.h) end
  end

  -- 布阵：挪一个或一批（list = { { uid, x, z }, ... }，最多 200 个）。挪的这批原来的阵位先不算占着，再按顺序一个个找空位
  function G.placeUnits(st, list)
    if st.battle or type(list) ~= "table" then return end
    local items, seen = {}, {}
    for i = 1, math.min(#list, 200) do
      local e = list[i]
      if type(e) == "table" then
        local uid, x, z = e[1], e[2], e[3]
        local u = (type(uid) == "number") and st.units[uid] or nil
        if u and not seen[u] and type(x) == "number" and type(z) == "number" and x == x and z == z then
          seen[u] = true
          table.insert(items, { u = u, x = x, z = z })
        end
      end
    end
    if #items == 0 then return end
    for _, it in ipairs(items) do it.u.sx, it.u.sz = 1e6, 1e6 end
    for _, it in ipairs(items) do
      local u = it.u
      local size = UNITS[u.t].size
      local xmax, z1, z2 = zoneOf(size)
      local x, z = math.clamp(it.x, -xmax, xmax), math.clamp(it.z, z1, z2)
      if not spotFree(st, x, z, size, u) then x, z = freeSpot(st, u.t, x, z, u) end
      snapTo(st, u, x, z)
    end
  end

  function G.moveUnit(st, uid, x, z)
    G.placeUnits(st, { { uid, x, z } })
  end

  function G.sellUnit(st, uid)
    if st.battle then return end
    local u = st.units[uid]
    if not u then return end
    local refund = math.floor(UNITS[u.t].price * 0.5)
    st.data.cash = st.data.cash + refund
    if u.model then u.model:Destroy() end
    st.units[uid] = nil
    local stars = Config.StarsOf(u.v)
    G.toast(st, "解散" .. UNITS[u.t].name .. ((stars > 0) and ("（" .. string.rep("★", stars) .. " 老兵）") or "") .. "，退回 $" .. Config.Fmt(refund), "info")
    G.push(st)
  end

  function G.arrange(st)
    if st.battle then return end
    local list = {}
    for _, u in pairs(st.units) do table.insert(list, u) end
    if #list == 0 then return end
    -- 和 Battle.formation 一样的顺序（row，再按兵种名），同兵种按编号
    table.sort(list, function(a, b)
      if a.t ~= b.t then return Battle.order(a.t, b.t) end
      return a.uid < b.uid
    end)
    local types = {}
    for i, u in ipairs(list) do types[i] = u.t end
    local slots = Battle.formation(types, F.deploy[2] - 4, -1, F.deploy[2] - F.deploy[1] - 8)
    for i, u in ipairs(list) do
      local s = slots[i]
      if s then snapTo(st, u, s.x, s.z) end
    end
    G.toast(st, "排好了：步兵在前，装甲、防空、直升机，火炮、火箭炮、飞机在最后", "info")
  end

  -- 这一关的敌军先摆在敌军区（开打前就能看到对面有什么）
  function G.makeEnemy(st)
    st.plot.Enemies:ClearAllChildren()
    st.enemy = {}
    local list, hm, dm = Battle.genEnemy(st.data.level)
    local slots = Battle.formation(list, F.enemy[1] + 4, 1, F.enemy[2] - F.enemy[1] - 8)
    for i, s in ipairs(slots) do
      local model, root = Models.unit(s.t, Config.EnemyColor)
      model.Name = "E" .. i
      model:SetAttribute("Type", s.t)
      model:SetAttribute("Fly", false)
      model.Parent = st.plot.Enemies
      root.CFrame = G.unitCF(st.plot.origin, s.x, 0, s.z, 0)
      table.insert(st.enemy, { t = s.t, x = s.x, z = s.z, model = model, root = root, hm = hm, dm = dm })
    end
  end

  -- 进服：按存档摆部队（阵位不在部署区里的重新找）
  function G.armySetup(st)
    local cap = G.capOf(st.data)
    for _, a in ipairs(st.data.army) do
      if G.count(st) < cap then
        local size = UNITS[a.t].size
        local xmax, z1, z2 = zoneOf(size)
        local x, z = a.x, a.z
        if math.abs(x) > xmax or z < z1 or z > z2 or not spotFree(st, x, z, size) then
          x, z = freeSpot(st, a.t)
        end
        G.spawnUnit(st, a.t, x, z, 0, math.pi, a.v)
      end
    end
    st.data.army = {}
  end
end

return Army
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000006">
<Properties>
<string name="Name">Battle</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：战斗推演（服务器）。只管数字：位置、血量、选目标、开火、溅射、炮弹 / 火箭弹 / 炸弹落地、导弹飞行、拦截、机降；
-- 模型、特效、玩家角色的血交给调用方传进来的回调 B.cb（world / muzzle / aim / fx / hurt / die / heroHurt / kill / hit / spawn）。
-- 伤害来源 src = { team, player（玩家亲手：开枪、开车、支援技能）, drive, unit（哪个单位打的：记老兵战功）}；
-- 打死的单位记进 B.deaths（战报滚动条用，Combat 每半秒发一次）。
-- 坐标都是相对战场原点的 (x, z)；y 是离地高度（飞机）；h 是车身朝向（CFrame.Angles(0, h, 0)，模型正前方 −Z），ty 是炮塔相对车身的转角。
-- 单位：u = { t, def, team, x, y, z, h, ty, hp, max, dm（伤害倍数）, cd, rt, alive, tgt, hero（玩家本人）, driver（玩家在开）, hold（守着不出击）, temp（机降的步兵）}
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))

local Battle = {}

local F = Config.Field
local UNITS = Config.Units
local XMAX = F.width / 2 - 6
local ZMIN = F.center - F.length / 2 + 5
local ZMAX = F.center + F.length / 2 - 5
-- 喷气机转弯半径大，可以飞出战场一些（别飞到隔壁基地的战场上）
local JX = F.width / 2 + 160
local JZ0, JZ1 = ZMIN - 200, ZMAX + 200
Battle.JX, Battle.JZ0, Battle.JZ1 = JX, JZ0, JZ1
local BOMB_FALL = 2.2   -- 炸弹从投下到落地几秒（往前飘 speed × 这么远）
local nextShell = 0     -- 炮弹编号（客户端按编号找到半空中的炮弹，拦截时打爆它）

Battle.HERO = { name = "玩家", hp = Config.Hero.hp, size = Config.Hero.size, speed = 0, range = 0, hero = true, foot = true }

-- 打得到吗：飞机看飞多高（reach 是能打多高；还在地上的飞机谁都能打），只打飞机的打不了地面
local function canHit(ad, e)
  if e.def.stealth and not (ad.homing and (ad.reach or 0) >= 400) then return false end   -- 隐身：只有爱国者、战斗机够得着
  if e.def.air then return (ad.reach or 0) >= (e.y or 0) - 3 end
  return not ad.airOnly
end
Battle.canHit = canHit

-- 伤害倍数：按目标是飞机 / 装甲 / 步兵（玩家本人算步兵）
local function mult(ad, td)
  if td.air then return ad.vsAir or 0 end
  if td.armor then return ad.vsArmor or 1 end
  return ad.vsInf or 1
end
Battle.mult = mult

local function prefers(ad, td)
  local p = ad.prefer
  if p == "air" then return td.air == true end
  if p == "armor" then return td.armor == true end
  if p == "inf" then return not td.armor and not td.air end
  return false
end

local function wrap(a)
  return (a + math.pi) % (2 * math.pi) - math.pi
end

-- 选目标：最近的、打得到的；喜欢的兵种算近四成；破障车（诱饵）算近一半多；够不着的近距离目标（火炮）往后排；
-- 原来的目标稍微优先；玩家本人略微优先（敌人认得出指挥官）
local function pick(U, u)
  local d = u.def
  local best, bs = nil, math.huge
  for _, e in ipairs(U) do
    if e.alive and e.team ~= u.team and canHit(d, e) then
      local dx, dz = e.x - u.x, e.z - u.z
      local s = math.sqrt(dx * dx + dz * dz)
      if d.minRange and s < d.minRange then s = s + 400 end
      if prefers(d, e.def) then s = s * 0.6 end
      if e.def.decoy then s = s * 0.45 end
      if e.def.camo then s = s * 1.6 end   -- 伪装：不显眼，排得靠后
      if e.hero then s = s * 0.8 end
      if e == u.tgt then s = s * 0.85 end
      if s < bs then
        bs, best = s, e
      end
    end
  end
  return best
end

local function hurt(B, u, dmg, src)
  if not u.alive or dmg <= 0 then return false end
  if u.takenK then dmg = dmg * u.takenK end   -- 技能「烟幕」：少挨打
  if u.hero then
    B.cb.heroHurt(u, dmg, src)
    return false
  end
  u.hp = u.hp - dmg
  local killed = false
  if u.hp <= 0 then
    u.hp = 0
    u.alive = false
    killed = true
    B.cb.die(u)
    if src then
      if src.unit and src.unit.team ~= u.team then src.unit.kills = (src.unit.kills or 0) + 1 end
      if B.cb.kill then B.cb.kill(u, src) end
    end
    if B.deaths then
      table.insert(B.deaths, { t = u.t, team = u.team, by = src and src.player and src.player.UserId or nil, uid = u.uid, owner = u.owner and u.owner.pl.UserId or nil })
    end
  else
    B.cb.hurt(u)
  end
  if src and src.player and B.cb.hit then B.cb.hit(u, dmg, killed, src) end
  return killed
end

-- 外部伤害（玩家开枪、开的车开火）：src = { team, player, drive }；返回打没打死
function Battle.damage(B, u, dmg, src)
  return hurt(B, u, dmg, src)
end

-- 溅射：地面单位按离爆点的距离衰减（中心满伤，边上四成）；ad 是攻击方的兵种（算伤害倍数）
local function splash(B, team, ad, x, z, r, dmg, skip, src)
  for _, e in ipairs(B.units) do
    if e.alive and e.team ~= team and e ~= skip and not (e.def.air and e.y > 3) then
      local dx, dz = e.x - x, e.z - z
      local dd = math.sqrt(dx * dx + dz * dz)
      local reach = r + e.def.size * 0.3
      if dd < reach then
        local k = 1 - 0.6 * math.min(1, dd / reach)
        hurt(B, e, dmg * k * mult(ad, e.def), src)
      end
    end
  end
end
Battle.splash = splash

-- 这一发算谁的：玩家在开的车算玩家的（亲手击毁），其余算这个单位的（老兵战功）
local function srcOf(u)
  if u.driver then return { team = u.team, player = u.driver, drive = true, unit = u } end
  return { team = u.team, unit = u }
end

-- 抛射弹（炮弹、火箭炮火箭弹、炸弹）：飞一会儿才落地；拦截炮能在半空打掉炮弹、火箭弹（炸弹不行）
local function lob(B, u, x, z, scatter, flight, kind, src)
  local a = math.random() * math.pi * 2
  local r = math.random() * scatter
  local sx, sz = x + math.cos(a) * r, z + math.sin(a) * r
  nextShell = nextShell + 1
  table.insert(B.shells, { id = nextShell, t0 = B.t, at = B.t + flight, x = sx, z = sz, team = u.team, def = u.def, dm = u.dm * (u.dmK or 1), src = src, kind = kind })
  B.cb.fx({ k = kind, id = nextShell, u = u.t, a = B.cb.muzzle(u), b = B.cb.world(sx, 0, sz), t = flight })
end

-- 敌人扎堆最密的地方（弹道导弹打这里）：每个地面敌人 45 格以内有多少兵力（按价钱算），挑最多的
local function densest(B, team, t)
  local best, bn = t, -1
  for _, e in ipairs(B.units) do
    if e.alive and e.team ~= team and not e.hero and not (e.def.air and (e.y or 0) > 3) then
      local n = 0
      for _, o in ipairs(B.units) do
        if o.alive and o.team ~= team and not (o.def.air and (o.y or 0) > 3) then
          local dx, dz = o.x - e.x, o.z - e.z
          if dx * dx + dz * dz < 45 * 45 then n = n + (o.def.price or 50) + 30 end
        end
      end
      if n > bn then best, bn = e, n end
    end
  end
  return best.x, best.z
end

-- 布雷车：开战在部队前方撒一片雷（敌人的地面单位走近就炸，炸完就没了）；之后隔一会儿在自己前面补一颗
local nextMine = 0
local function layMine(B, u, x, z)
  local m = u.def.mines
  nextMine = nextMine + 1
  local mine = { id = nextMine, x = math.clamp(x, -XMAX, XMAX), z = math.clamp(z, ZMIN, ZMAX), team = u.team, r = m.r, dm = u.dm,
    def = { dmg = m.dmg, splash = m.splash, vsArmor = 1.1, vsInf = 1, vsAir = 0 }, src = { team = u.team, unit = u } }
  B.mines = B.mines or {}
  table.insert(B.mines, mine)
  B.cb.fx({ k = "mine", id = mine.id, p = B.cb.world(mine.x, 0, mine.z), team = u.team })
end
local function mineLayStep(B, u, dt)
  local m = u.def.mines
  local dir = (u.team == 1) and 1 or -1
  if not u.mined then
    u.mined, u.mineMore, u.mineT = true, m.more, m.re
    -- 撒在敌人停下来开火的那一带：前后两排交错（我方前沿往前约 100、160 格，步兵、装甲车、坦克都在这一带停下来打）
    for i = 1, m.n do
      local row = (i % 2 == 0) and 160 or 100
      layMine(B, u, u.x + (i - (m.n + 1) / 2) * 15 + (math.random() - 0.5) * 8, u.z + dir * (row + (math.random() - 0.5) * 30))
    end
    return
  end
  u.mineT = u.mineT - dt
  if u.mineT <= 0 and (u.mineMore or 0) > 0 then
    u.mineT, u.mineMore = m.re, u.mineMore - 1
    layMine(B, u, u.x + (math.random() - 0.5) * 80, u.z + dir * (60 + math.random() * 90))
  end
end
local function minesStep(B)
  local list = B.mines
  if not list or #list == 0 then return end
  local i = 1
  while i <= #list do
    local m = list[i]
    local hit = false
    for _, e in ipairs(B.units) do
      if e.alive and e.team ~= m.team and not e.hero and not (e.def.air and (e.y or 0) > 2) then
        local dx, dz = e.x - m.x, e.z - m.z
        local rr = m.r + e.def.size * 0.3
        if dx * dx + dz * dz < rr * rr then
          hit = true
          break
        end
      end
    end
    if hit then
      table.remove(list, i)
      splash(B, m.team, m.def, m.x, m.z, m.def.splash, m.def.dmg * m.dm, nil, m.src)
      B.cb.fx({ k = "mineboom", id = m.id, p = B.cb.world(m.x, 0, m.z) })
    else
      i = i + 1
    end
  end
end
Battle.layMine = layMine

-- 支援火力（迫击炮急袭、炮火覆盖、空袭）：从 from（世界坐标）打一发到 (x, z) 附近（scatter 散布），flight 秒后落地；
-- def 给伤害、溅射、各类目标的倍数（同兵种表），dm 是战力倍数；kind：shell 炮弹（拦截炮能打）/ bomb 炸弹（打不了）
function Battle.strike(B, team, def, dm, x, z, scatter, flight, kind, src, from)
  local a = math.random() * math.pi * 2
  local r = math.sqrt(math.random()) * scatter
  local sx = math.clamp(x + math.cos(a) * r, -XMAX, XMAX)
  local sz = math.clamp(z + math.sin(a) * r, ZMIN, ZMAX)
  nextShell = nextShell + 1
  table.insert(B.shells, { id = nextShell, t0 = B.t, at = B.t + flight, x = sx, z = sz, team = team, def = def, dm = dm, src = src, kind = kind })
  B.cb.fx({ k = kind, id = nextShell, u = def.fxu or "skill", a = from, b = B.cb.world(sx, 0, sz), t = flight })
end
Battle.XMAX, Battle.ZMIN, Battle.ZMAX = XMAX, ZMIN, ZMAX
Battle.hurt = hurt

-- 导弹：飞到目标（客户端跟着目标画），到了才算伤害；没有目标（玩家对着地面打）就打那个点
local function missile(B, u, t, dmg, dist, src, px, py, pz)
  local d = u.def
  local fl = 0.35 + dist / (d.homing or 300)
  table.insert(B.missiles, { at = B.t + fl, tgt = t, dmg = dmg, def = d, team = u.team, src = src, x = px, z = pz })
  B.cb.fx({ k = "missile", u = u.t, a = B.cb.muzzle(u), b = t and B.cb.aim(t, true) or B.cb.world(px, py or 0, pz), bid = t and t.bid or nil, t = fl })
end

local function fire(B, u, t, dist)
  local d = u.def
  if d.kamikaze then   -- 巡飞弹：一头撞上去，连自己一起炸了
    local src = srcOf(u)
    local dmg = d.dmg * u.dm
    hurt(B, t, dmg * mult(d, t.def), src)
    splash(B, u.team, d, t.x, t.z, d.splash or 12, dmg * 0.5, t, src)
    B.cb.fx({ k = "boom", p = B.cb.world(t.x, (t.y or 0) + 2, t.z), s = 1.5 })
    u.hp = 0
    u.alive = false
    u.spent = true
    B.cb.die(u)
    return
  end
  if d.swarm then   -- 蜂群：放出几架自杀小无人机，各自去撞（小无人机这一仗打完就没了，不算损失）
    if B.cb.spawn then
      local sw = d.swarm
      for i = 1, sw.n do
        local a = (i / sw.n) * math.pi * 2
        local bu = B.cb.spawn(u, sw.t, u.x + math.cos(a) * 6, u.z + math.sin(a) * 6)
        if bu then
          bu.y = 4
          bu.tgt = t
          table.insert(B.pending, bu)
        end
      end
      B.cb.fx({ k = "swarm", p = B.cb.world(u.x, 3, u.z), n = sw.n })
    end
    return
  end
  if d.lob then   -- 空中炮艇：从天上往下打炮弹（打移动目标往前估一点）
    lob(B, u, t.x + (t.vx or 0) * 0.7, t.z + (t.vz or 0) * 0.7, 9, 1.4, "gshell", srcOf(u))
    return
  end
  if d.ballistic then   -- 弹道导弹：打敌人扎堆最密的地方，高高抛起来（只有爱国者拦得住）
    local x, z = densest(B, u.team, t)
    lob(B, u, x, z, 6, 6.5, "ballistic", srcOf(u))
    return
  end
  if d.pierce then   -- 电磁炮：一条线贯穿过去，线上的地面敌人都挨打（按离炮口远近排，越往后越弱）
    local dx, dz = (t.x - u.x) / math.max(dist, 0.01), (t.z - u.z) / math.max(dist, 0.01)
    local L = d.pierce
    local hits = {}
    for _, e in ipairs(B.units) do
      if e.alive and e.team ~= u.team and not (e.def.air and (e.y or 0) > 12) then
        local rx, rz = e.x - u.x, e.z - u.z
        local s = rx * dx + rz * dz
        if s > 0 and s < L then
          local px, pz = rx - dx * s, rz - dz * s
          local w = 4 + e.def.size * 0.4
          if px * px + pz * pz < w * w then table.insert(hits, { e = e, s = s }) end
        end
      end
    end
    table.sort(hits, function(a, b) return a.s < b.s end)
    local src = srcOf(u)
    local dmg = d.dmg * u.dm * (u.dmK or 1)
    for i, h in ipairs(hits) do hurt(B, h.e, dmg * math.max(0.4, 1 - 0.15 * (i - 1)) * mult(d, h.e.def), src) end
    B.cb.fx({ k = "rail", u = u.t, a = B.cb.muzzle(u), b = B.cb.world(u.x + dx * L, 2, u.z + dz * L), n = #hits })
    return
  end
  if d.salvo then   -- 火箭炮：一轮几发，陆续发射
    u.salvoLeft = d.salvo
    u.salvoAt = B.t
    u.salvoX, u.salvoZ = t.x + (t.vx or 0) * 2, t.z + (t.vz or 0) * 2
    return
  end
  if d.bombs then   -- 轰炸机：投一串
    u.bombLeft = d.bombs
    u.bombAt = B.t
    return
  end
  if d.minRange and d.splash then   -- 火炮、迫击炮：抛物线炮弹，落点有散布，打移动目标往前估一点
    local fl = 1.2 + dist / 170
    lob(B, u, t.x + (t.vx or 0) * fl * 0.5, t.z + (t.vz or 0) * fl * 0.5, d.foot and 10 or 14, fl, "shell", srcOf(u))
    return
  end
  local dmg = d.dmg * u.dm * (u.dmK or 1)
  if d.homing then
    missile(B, u, t, dmg, dist, srcOf(u))
    return
  end
  local hitP = d.hit or 0.92
  if t.def.air then
    hitP = t.def.jet and 0.55 or 0.75
    if d.foot then hitP = hitP * 0.65 end
  end
  if t.hero then hitP = hitP * 0.7 end
  if d.laser then hitP = 0.97 end   -- 激光：光速，几乎打不偏
  local hit = math.random() < hitP
  local src = srcOf(u)
  if hit then hurt(B, t, dmg * mult(d, t.def), src) end
  if d.splash and not t.def.air then splash(B, u.team, d, t.x, t.z, d.splash, dmg * 0.5, t, src) end
  B.cb.fx({ k = d.laser and "laser" or "shot", u = u.t, a = B.cb.muzzle(u), b = B.cb.aim(t, hit) })
end

local function salvoStep(B, u)
  if not u.salvoLeft or u.salvoLeft <= 0 then return end
  if B.t < u.salvoAt then return end
  u.salvoLeft = u.salvoLeft - 1
  u.salvoAt = B.t + 0.25
  local dx, dz = u.salvoX - u.x, u.salvoZ - u.z
  local fl = 2 + math.sqrt(dx * dx + dz * dz) / 220
  lob(B, u, u.salvoX, u.salvoZ, 30, fl, "mrocket", srcOf(u))
end

-- 炸弹：一颗一颗往下扔，带着飞机的速度往前飘
local function bombStep(B, u)
  if not u.bombLeft or u.bombLeft <= 0 or B.t < u.bombAt then return end
  u.bombLeft = u.bombLeft - 1
  u.bombAt = B.t + 0.16
  lob(B, u, u.x + (u.vx or 0) * BOMB_FALL, u.z + (u.vz or 0) * BOMB_FALL, 8, BOMB_FALL, "bomb", srcOf(u))
end

local function shells(B)
  local i = 1
  while i <= #B.shells do
    local s = B.shells[i]
    if s.dead then
      table.remove(B.shells, i)
    elseif B.t >= s.at then
      table.remove(B.shells, i)
      splash(B, s.team, s.def, s.x, s.z, s.def.splash or 10, s.def.dmg * s.dm, nil, s.src)
      local size = 1.3
      if s.kind == "bomb" then size = 1.9 elseif s.def.salvo then size = 1.5 elseif s.def.foot then size = 0.9 end
      if s.kind == "cruise" or s.kind == "ballistic" then
        B.cb.fx({ k = "bigboom", p = B.cb.world(s.x, 0, s.z), s = (s.kind == "cruise") and 3.6 or 3.2 })   -- 巡航导弹、弹道导弹：大火球、冲击波、震屏
      else
        B.cb.fx({ k = "boom", p = B.cb.world(s.x, 0, s.z), s = size })
      end
    else
      i = i + 1
    end
  end
end

local function missiles(B)
  local i = 1
  while i <= #B.missiles do
    local m = B.missiles[i]
    if B.t >= m.at then
      table.remove(B.missiles, i)
      local t = m.tgt
      if t then
        local p = 0.9
        if t.def.jet then p = 0.75 end   -- 喷气机放热诱弹、机动
        local jammed = false
        for _, e in ipairs(B.units) do   -- 目标附近有对方的电子战车：干扰
          if e.alive and e.def.jam and e.team ~= m.team then
            local dx, dz = e.x - t.x, e.z - t.z
            if dx * dx + dz * dz <= e.def.jam.r * e.def.jam.r then
              p = p * e.def.jam.p
              jammed = true
              break
            end
          end
        end
        if t.alive and math.random() < p then
          hurt(B, t, m.dmg * mult(m.def, t.def), m.src)
        elseif jammed and t.alive then
          B.cb.fx({ k = "jam", p = B.cb.world(t.x, (t.y or 0) + 6, t.z) })   -- 被干扰偏掉了
        end
      elseif m.x then
        splash(B, m.team, m.def, m.x, m.z, m.def.splash or 10, m.dmg, nil, m.src)
      end
    else
      i = i + 1
    end
  end
end

-- 拦截炮：每隔一会儿挑一发要落进自己附近的敌方炮弹 / 火箭弹打（每发只试一次，成功率 p）
local function interceptStep(B, u, dt)
  local ic = u.def.intercept
  u.icd = (u.icd or 0) - dt
  if u.icd > 0 then return end
  local best, bt = nil, math.huge
  local r2 = ic.range * ic.range
  for _, s in ipairs(B.shells) do
    if not s.dead and s.team ~= u.team and s.kind ~= "bomb" and s.kind ~= "cruise" and s.kind ~= "ballistic" and not (s.tried and s.tried[u]) and B.t >= s.t0 + (s.at - s.t0) * 0.3 then
      local dx, dz = s.x - u.x, s.z - u.z
      if dx * dx + dz * dz < r2 and s.at < bt then best, bt = s, s.at end
    end
  end
  if not best then return end
  u.icd = ic.rate
  best.tried = best.tried or {}
  best.tried[u] = true
  if math.random() < ic.p then
    best.dead = true
    B.cb.fx({ k = "intercept", id = best.id, a = B.cb.muzzle(u), laser = ic.laser })
  end
end

-- 爱国者反导：盯着飞过来的敌方弹道导弹，隔一会儿打一发拦截弹（每枚导弹每辆车只试一次）
local function abmStep(B, u, dt)
  local ab = u.def.abm
  u.acd = (u.acd or 0) - dt
  if u.acd > 0 then return end
  local best, bt = nil, math.huge
  local r2 = ab.range * ab.range
  for _, s in ipairs(B.shells) do
    if not s.dead and s.team ~= u.team and s.kind == "ballistic" and not (s.tried and s.tried[u]) and B.t >= s.t0 + (s.at - s.t0) * 0.35 then
      local dx, dz = s.x - u.x, s.z - u.z
      if dx * dx + dz * dz < r2 and s.at < bt then best, bt = s, s.at end
    end
  end
  if not best then return end
  u.acd = ab.rate
  best.tried = best.tried or {}
  best.tried[u] = true
  local ok = math.random() < ab.p
  if ok then best.dead = true end
  B.cb.fx({ k = "abm", id = best.id, a = B.cb.muzzle(u), miss = not ok })
end

-- 转向：最多每秒 rate 弧度，朝 (dx, dz)
local function turn(u, dx, dz, dt, rate)
  if dx == 0 and dz == 0 then return end
  local want = math.atan2(-dx, -dz)
  local diff = wrap(want - u.h)
  local m = rate * dt
  if diff > m then diff = m elseif diff < -m then diff = -m end
  u.h = u.h + diff
end
Battle.turn = turn

-- 炮塔对准世界方向 (dx, dz)：转角相对车身
local function aimTurret(u, dx, dz, dt)
  local want = wrap(math.atan2(-dx, -dz) - u.h)
  local diff = wrap(want - (u.ty or 0))
  local m = 2.6 * dt
  if diff > m then diff = m elseif diff < -m then diff = -m end
  u.ty = wrap((u.ty or 0) + diff)
  return math.abs(wrap(want - u.ty))
end
Battle.aimTurret = aimTurret

-- 运兵直升机放下步兵（机降的步兵这一仗打完就没了，不算损失）
local function dropTroops(B, u)
  local n = u.cargo or 0
  u.cargo = 0
  if n <= 0 or not B.cb.spawn then return end
  local rx, rz = math.cos(u.h), -math.sin(u.h)   -- 机身右边
  for i = 1, n do
    local side = (i % 2 == 1) and 1 or -1
    local off = side * (10 + math.floor((i - 1) / 2) * 10)
    local bu = B.cb.spawn(u, "inf", u.x + rx * off, u.z + rz * off)
    if bu then table.insert(B.pending, bu) end
  end
  B.cb.fx({ k = "boom", p = B.cb.world(u.x, 0, u.z), s = 0.5 })
end

-- 医疗兵、抢修车：半径里受伤的友军（步兵 / 车辆）每秒回 hps（跟着战力倍数）；玩家本人也算步兵；隔一会儿冒一圈绿光
local function healStep(B, u, dt)
  local h = u.def.heal
  local r2 = h.r * h.r
  local amt = h.hps * dt * (u.dm or 1)
  local any = false
  for _, e in ipairs(B.units) do
    if e.alive and e.team == u.team and e ~= u then
      local kind = e.def.foot or e.hero
      if (h.foot and kind) or (h.armor and not kind and not e.def.air) then
        local dx, dz = e.x - u.x, e.z - u.z
        if dx * dx + dz * dz <= r2 then
          if e.hero then
            local hum = e.model and e.model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
              hum.Health = math.min(hum.MaxHealth, hum.Health + amt * 0.6)
              any = true
            end
          elseif e.hp < e.max then
            e.hp = math.min(e.max, e.hp + amt)
            B.cb.hurt(e)
            any = true
          end
        end
      end
    end
  end
  u.healT = (u.healT or 0) - dt
  if any and u.healT <= 0 then
    u.healT = 2.5
    B.cb.fx({ k = "heal", p = B.cb.world(u.x, 0, u.z), s = h.r * 0.5 })
  end
end

local function act(B, u, dt)
  local d = u.def
  local range = d.range * (B.rangeK or 1)   -- 战区：巷战射程短
  u.cd = u.cd - dt
  salvoStep(B, u)
  if d.heal then healStep(B, u, dt) end
  if d.mines then mineLayStep(B, u, dt) end
  if d.cargo and u.cargo == nil then u.cargo = d.cargo end
  local t = u.tgt
  if t and not (t.alive and canHit(d, t)) then
    u.tgt, u.rt, t = nil, 0, nil
  end
  local mx, mz = 0, 0
  local inRange = false
  local wantY = d.alt or 0
  if t then
    local dx, dz = t.x - u.x, t.z - u.z
    local dist = math.sqrt(dx * dx + dz * dz)
    local tooClose = d.minRange ~= nil and dist < d.minRange
    local landing = d.cargo and (u.cargo or 0) > 0 and dist < d.drop
    if landing then                -- 运兵直升机：悬停、降低，放下步兵
      wantY = 6
      if u.y <= 7 then dropTroops(B, u) end
    elseif tooClose then
      mx, mz = -dx, -dz            -- 火炮被贴近：往后退
    elseif dist > range * 0.92 and not (u.hold and dist > range * 1.6) then
      mx, mz = dx, dz              -- 够不着：往前走（守方等敌人走近了才出击）
    end
    if dist <= range and not tooClose then
      inRange = true
      local err = 0
      if d.turret then
        err = aimTurret(u, dx, dz, dt)
        if mx == 0 and mz == 0 then turn(u, dx, dz, dt, 0.8) end   -- 停下打的时候车身慢慢转正
      elseif d.side then
        turn(u, dz, -dx, dt, 1.6)  -- 火箭炮发射箱朝右：右侧对准目标
        local want = math.atan2(-dz, dx)
        err = math.abs(wrap(want - u.h))
      else
        turn(u, dx, dz, dt, d.air and 3 or 2.4)
        err = math.abs(wrap(math.atan2(-dx, -dz) - u.h))
      end
      local ready = ((not d.air) or u.y >= d.alt * 0.5) and err < 0.35
      if u.cd <= 0 and ready then
        fire(B, u, t, dist)
        u.cd = d.rate * (0.85 + math.random() * 0.3) * (u.rtK or 1)
      end
    elseif d.turret then
      aimTurret(u, dx, dz, dt)
    end
  end
  if d.air then
    if u.y < wantY then u.y = math.min(wantY, u.y + 16 * dt) elseif u.y > wantY then u.y = math.max(wantY, u.y - 22 * dt) end
  end
  u.moving = false
  u.vx, u.vz = 0, 0
  if mx ~= 0 or mz ~= 0 then
    local l = math.sqrt(mx * mx + mz * mz)
    local sp = d.speed * dt * (d.air and 1 or (B.speedK or 1)) * (u.spK or 1)   -- 战区：沙地、雪地走得慢；技能「冲锋」跑得快
    local nx, nz = mx / l * sp, mz / l * sp
    u.x = u.x + nx
    u.z = u.z + nz
    u.vx, u.vz = nx / dt, nz / dt
    u.moving = true
    if d.turret or not inRange then turn(u, mx, mz, dt, 3) end
  end
  if u.x > XMAX then u.x = XMAX elseif u.x < -XMAX then u.x = -XMAX end
  if u.z > ZMAX then u.z = ZMAX elseif u.z < ZMIN then u.z = ZMIN end
end

-- 固定翼（攻击机、战斗机、轰炸机、无人机）：一直往前飞，按转弯角速度追目标；冲过头先直飞一段再掉头（打一个来回）；
-- 机头对准目标 cone 以内才开火；无人机绕着目标转圈打；轰炸机在目标前方正好的距离开始投弹；飞出范围就掉头回来
local function actJet(B, u, dt)
  local d = u.def
  u.cd = u.cd - dt
  bombStep(B, u)
  if u.y < d.alt then u.y = math.min(d.alt, u.y + 26 * dt) end
  local t = u.tgt
  if t and not (t.alive and canHit(d, t)) then
    u.tgt, u.rt, t = nil, 0, nil
  end
  local out = math.abs(u.x) > JX or u.z < JZ0 or u.z > JZ1
  local dx, dz, dist, err = 0, 0, 0, math.pi
  if t then
    dx, dz = t.x - u.x, t.z - u.z
    dist = math.sqrt(dx * dx + dz * dz)
    err = math.abs(wrap(math.atan2(-dx, -dz) - u.h))
  end
  local R = d.speed / d.turn   -- 转弯半径
  if out then
    turn(u, -u.x, F.center - u.z, dt, d.turn)
  elseif not t then
    turn(u, -u.x, F.center - u.z, dt, d.turn * 0.5)   -- 没有目标：在战场上空盘旋
  elseif d.orbit and dist < d.range * 0.8 then
    -- 绕目标转圈：切线方向（挑和现在机头同一边的），离得远往里收、太近往外放
    local tx, tz = -dz / dist, dx / dist
    if tx * -math.sin(u.h) + tz * -math.cos(u.h) < 0 then tx, tz = -tx, -tz end
    local k = (dist - d.range * 0.55) / (d.range * 0.55)
    turn(u, tx + dx / dist * k, tz + dz / dist * k, dt, d.turn)
  elseif u.extendT and B.t < u.extendT then
    -- 冲过头了：直飞拉开距离
  elseif dist < R * 1.3 and err > 1.6 then
    u.extendT = B.t + 1.4 + R / d.speed
  else
    turn(u, dx, dz, dt, d.turn)
  end
  u.vx, u.vz = -math.sin(u.h) * d.speed * (u.spK or 1), -math.cos(u.h) * d.speed * (u.spK or 1)
  u.x = math.clamp(u.x + u.vx * dt, -JX - 220, JX + 220)
  u.z = math.clamp(u.z + u.vz * dt, JZ0 - 220, JZ1 + 220)
  u.moving = true
  if not t or u.cd > 0 or u.y < d.alt * 0.5 then return end
  if d.bombs then
    local lead = d.speed * BOMB_FALL
    if err < d.cone and math.abs(dist - lead) < 60 then
      fire(B, u, t, dist)
      u.cd = d.rate
    end
  elseif dist <= d.range * (B.rangeK or 1) and err <= d.cone then
    fire(B, u, t, dist)
    u.cd = d.rate * (0.85 + math.random() * 0.3) * (u.rtK or 1)
  end
end

-- 挤在一起的推开一点（地面和地面、直升机和直升机；喷气机不推；玩家本人和玩家在开的车不推——位置归玩家）
local function separate(U)
  local n = #U
  for i = 1, n do
    local a = U[i]
    if a.alive and not a.hero and not a.def.jet then
      for j = i + 1, n do
        local b = U[j]
        if b.alive and not b.hero and not b.def.jet and (a.def.air == true) == (b.def.air == true) then
          local dx, dz = b.x - a.x, b.z - a.z
          local need = (a.def.size + b.def.size) * 0.5
          local d2 = dx * dx + dz * dz
          if d2 < need * need then
            local dd = math.sqrt(d2)
            if dd < 0.01 then
              local r = math.random() * math.pi * 2
              dx, dz, dd = math.cos(r), math.sin(r), 1
            end
            local push = math.min(1.2, (need - dd) * 0.5)
            local ux, uz = dx / dd, dz / dd
            if not a.driver then a.x, a.z = a.x - ux * push, a.z - uz * push end
            if not b.driver then b.x, b.z = b.x + ux * push, b.z + uz * push end
          end
        end
      end
    end
  end
end

-- 玩家开的车开火：打瞄准点附近的敌人（直瞄 / 导弹），没打着也在瞄准点炸（有溅射的）；轰炸机按一下投一串；返回开没开火
function Battle.driveFire(B, u, ax, az, ay)
  local d = u.def
  if not u.alive or u.cd > 0.2 then return false end   -- 客户端按服务器给的装填时间算，留一点网络误差
  local src = { team = u.team, player = u.driver, drive = true, unit = u }
  if d.bombs then
    u.cd = d.rate * 0.5
    u.bombLeft = d.bombs
    u.bombAt = B.t
    return true
  end
  local dx, dz = ax - u.x, az - u.z
  local dist = math.sqrt(dx * dx + dz * dz)
  if dist > d.range * 1.15 then return false end
  if d.minRange and dist < d.minRange * 0.6 then return false end
  u.cd = d.rate
  if d.salvo then
    u.salvoLeft = d.salvo
    u.salvoAt = B.t
    u.salvoX, u.salvoZ = ax, az
    return true
  end
  if d.minRange and d.splash then
    lob(B, u, ax, az, 6, 1.2 + dist / 170, "shell", src)
    return true
  end
  -- 瞄准点附近（目标大小以内，导弹放宽一些）最近的、打得到的敌人
  local best, bd = nil, math.huge
  local slack = d.homing and 30 or 6
  for _, e in ipairs(B.units) do
    if e.alive and e.team ~= u.team and canHit(d, e) then
      local ex, ez = e.x - ax, e.z - az
      local ey = (e.y or 0) - (ay or 0)
      local dd = math.sqrt(ex * ex + ez * ez + ey * ey * 0.3)
      if dd < e.def.size * 0.6 + slack and dd < bd then best, bd = e, dd end
    end
  end
  local dmg = d.dmg * u.dm
  if d.homing then
    if best then
      local ex, ez = best.x - u.x, best.z - u.z
      missile(B, u, best, dmg, math.sqrt(ex * ex + ez * ez), src)
    elseif not d.airOnly then
      missile(B, u, nil, dmg, dist, src, ax, ay, az)
    else
      u.cd = 0
      return false
    end
    return true
  end
  if best then hurt(B, best, dmg * mult(d, best.def), src) end
  if d.splash then splash(B, u.team, d, ax, az, d.splash, dmg * 0.5, best, src) end
  B.cb.fx({ k = "shot", u = u.t, a = B.cb.muzzle(u), b = best and B.cb.aim(best, true) or B.cb.world(ax, ay or 0, az) })
  return true
end

-- 推演一步；返回 nil（继续）或 "win" / "lose" / "timeout"（按第 1 队算；玩家本人不算兵力）
function Battle.step(B, dt)
  B.t = B.t + dt
  B.missiles = B.missiles or {}
  B.deaths = B.deaths or {}
  B.pending = {}
  local U = B.units
  for _, u in ipairs(U) do   -- 技能（冲锋、烟幕、全力开火、加力）：还在时效里就按它的倍数
    local b = u.buff
    if b and B.t < b.t then
      u.spK, u.rtK, u.dmK, u.takenK = b.sp, b.rate, b.dmg, b.taken
    elseif b then
      u.buff, u.spK, u.rtK, u.dmK, u.takenK = nil, nil, nil, nil, nil
    end
  end
  for _, u in ipairs(U) do
    if u.alive and not u.hero and not u.driver then
      u.rt = u.rt - dt
      if u.rt <= 0 or not (u.tgt and u.tgt.alive) then
        u.tgt = pick(U, u)
        u.rt = 0.4 + math.random() * 0.4
      end
    end
  end
  for _, u in ipairs(U) do
    if u.alive and not u.hero then
      local d = u.def
      if u.driver then
        u.cd = u.cd - dt
        salvoStep(B, u)
        bombStep(B, u)
        if d.cargo then   -- 玩家开的运兵直升机：飞起来以后再降到低空，自动放下步兵
          if u.cargo == nil then u.cargo = d.cargo end
          if u.y > 30 then u.flew = true end
          if u.flew and u.cargo > 0 and u.y <= 12 then dropTroops(B, u) end
        end
      elseif d.jet then
        actJet(B, u, dt)
      else
        act(B, u, dt)
      end
      if d.intercept then interceptStep(B, u, dt) end
      if d.abm then abmStep(B, u, dt) end
    end
  end
  for _, bu in ipairs(B.pending) do table.insert(U, bu) end
  separate(U)
  shells(B)
  missiles(B)
  minesStep(B)
  local a, e = 0, 0
  for _, u in ipairs(U) do
    if u.alive and not u.hero then
      if u.team == 1 then a = a + 1 else e = e + 1 end
    end
  end
  B.alive1, B.alive2 = a, e
  if e == 0 then return "win" end
  if a == 0 then return "lose" end
  if B.t >= Config.BattleTime then return "timeout" end
  return nil
end

-- 单位技能（玩家观战时点的）：按兵种的页签（步兵冲锋、装甲烟幕、防空全力开火、炮兵急速射、空中加力），时效 dur 秒
function Battle.ability(B, u)
  local ab = Config.Abilities and Config.Abilities[u.def.cat or ""]
  if not ab or not u.alive then return nil end
  u.buff = { t = B.t + ab.dur, sp = ab.sp, rate = ab.rate, dmg = ab.dmg, taken = ab.taken, id = ab.id }
  if ab.reload then u.cd = math.min(u.cd, 0.2) end   -- 炮兵、防空：马上装填好
  B.cb.fx({ k = "ability", id = ab.id, p = B.cb.world(u.x, (u.y or 0), u.z), bid = u.bid, s = u.def.size, dur = ab.dur })
  return ab
end

-- 关卡敌军：按预算随机买兵（同一关每次都一样）；超过人数上限的预算换成属性加成；首领关多一辆猛犸重坦
function Battle.genEnemy(level)
  local budget = Config.EnemyBudget(level)
  local types = Config.EnemyTypes(level)
  local rng = Random.new(level * 7919 + 101)
  local list, spent = {}, 0
  while #list < Config.MaxEnemy do
    local cand, tw = {}, 0
    for _, t in ipairs(types) do
      if spent + UNITS[t].price <= budget then
        table.insert(cand, t)
        tw = tw + (UNITS[t].ew or 1)
      end
    end
    if #cand == 0 then break end
    local r = rng:NextNumber() * tw
    local pickT = cand[#cand]
    for _, t in ipairs(cand) do
      r = r - (UNITS[t].ew or 1)
      if r <= 0 then
        pickT = t
        break
      end
    end
    table.insert(list, pickT)
    spent = spent + UNITS[pickT].price
  end
  if #list == 0 then
    list = { "inf" }
    spent = UNITS.inf.price
  end
  local k = 1
  if budget > spent * 1.05 then k = budget / spent end
  local m = math.sqrt(k)
  if Config.IsBoss(level) then table.insert(list, "boss") end
  return list, m, m   -- 兵种列表、血量倍数、伤害倍数
end

-- 排阵：按兵种的 row 从前往后（步兵、轻车、步战车、坦克、防空、直升机、迫击炮狙击、火炮、火箭炮、飞机），一行排满再起一行
-- zFront 是第一行前沿的 Z，dir 是往后排的方向（我方 −1，敌方 +1），depth 是可用纵深（排不下就压紧）
-- 同一 row 里按兵种名排（Army.arrange 用同样的顺序把部队对上位置）
Battle.ROW = {}
for t, d in pairs(UNITS) do Battle.ROW[t] = d.row or 5 end
function Battle.order(a, b)
  local ROW = Battle.ROW
  if ROW[a] ~= ROW[b] then return ROW[a] < ROW[b] end
  return a < b
end
function Battle.formation(types, zFront, dir, depth)
  local list = {}
  for i, t in ipairs(types) do list[i] = t end
  table.sort(list, Battle.order)
  local maxW = F.width - 40
  local lines, cur = {}, nil
  for _, t in ipairs(list) do
    local s = UNITS[t].size + 6
    if not cur or cur.w + s > maxW then
      cur = { items = {}, w = 0, deep = 0 }
      table.insert(lines, cur)
    end
    table.insert(cur.items, { t = t, s = s })
    cur.w = cur.w + s
    cur.deep = math.max(cur.deep, s)
  end
  local total = 0
  for _, l in ipairs(lines) do total = total + l.deep end
  local k = 1
  if depth and total > depth then k = depth / total end
  local out = {}
  local z = zFront
  for _, l in ipairs(lines) do
    local zc = z + dir * l.deep * k / 2
    local x = -l.w / 2
    for _, it in ipairs(l.items) do
      table.insert(out, { t = it.t, x = x + it.s / 2, z = zc })
      x = x + it.s
    end
    z = z + dir * l.deep * k
  end
  return out
end

return Battle
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000007">
<Properties>
<string name="Name">Combat</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：战斗编排——打 AI 关卡（pve）、突袭别人的防线（raid）、和真人对战（duel：同服点名约战是友谊赛，匹配来的是排位赛 ranked）；
-- 玩家本人上阵（小人：开战时传送到己方后方，敌人会打你，死了在基地复活、可以重返战场）、亲自驾驶自己的车 / 直升机
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local Combat = {}

function Combat.init(G)
  local Config, Models, Battle = G.Config, G.Models, G.Battle
  local V = Vector3.new
  local F = Config.Field
  local UNITS = Config.Units
  local RB = G.R.Battle
  local XMAX = F.width / 2 - 6
  local ZMIN, ZMAX = F.center - F.length / 2 + 5, F.center + F.length / 2 - 5
  local nextBid = 0

  -- later：推演进行中加进来的（机降的步兵）先不放进 B.units，由推演这一步结束时统一加
  local function addUnit(B, bu, later)
    nextBid = nextBid + 1
    bu.bid = nextBid
    B.byId[nextBid] = bu
    if bu.model and bu.model.Parent then bu.model:SetAttribute("BU", nextBid) end
    if not later then table.insert(B.units, bu) end
  end

  -- 两队玩家本人上阵的位置：第 1 队在部署区后面朝北，第 2 队在敌军区后面朝南
  local function heroSpot(B, team)
    if team == 1 then return B.origin + V(0, 4, F.deploy[1] + 14), 1 end
    return B.origin + V(0, 4, F.enemy[2] - 14), -1
  end

  local function callbacks(B)
    local cb = {}
    cb.fx = G.fx
    function cb.world(x, y, z)
      return B.origin + V(x, 1 + y, z)
    end
    function cb.muzzle(u)
      if not (u.root and u.root.Parent) then return B.origin + V(u.x, 4, u.z) end
      local cf = u.root.CFrame
      if u.ty and u.ty ~= 0 then cf = cf * CFrame.Angles(0, u.ty, 0) end
      return cf:PointToWorldSpace(Models.muzzle(u.t))
    end
    function cb.aim(t, hit)
      local p = B.origin + V(t.x, 1 + (t.y or 0) + (t.h3 or 2.5), t.z)
      if not hit then p = p + V(math.random() * 12 - 6, math.random() * 3, math.random() * 12 - 6) end
      return p
    end
    function cb.hurt(u)
      if u.fill then u.fill.Size = UDim2.fromScale(math.clamp(u.hp / u.max, 0, 1), 1) end
    end
    function cb.heroHurt(u, dmg, src)
      local hum = u.model and u.model:FindFirstChildOfClass("Humanoid")
      if hum and hum.Health > 0 then
        hum:TakeDamage(dmg * 0.5)
        if src and src.player and src.player ~= u.hero then cb.hit(u, dmg * 0.5, hum.Health <= 0, src) end
      end
    end
    -- 玩家亲手打中的（开枪、开车、支援技能）：告诉他——准星上的命中标记、飘出来的伤害数字、击毁提示
    function cb.hit(u, dmg, killed, src)
      local pl = src.player
      if not (pl and pl.Parent) then return end
      RB:FireClient(pl, { phase = "hit", p = B.origin + V(u.x, 1 + (u.y or 0) + (u.h3 or 2.5), u.z), d = math.floor(dmg + 0.5), k = killed, t = u.t, hero = u.hero ~= nil })
    end
    function cb.kill(u, src)
      local st = src.player and G.states[src.player]
      if not st or not st.data then return end
      B.pk = B.pk or {}
      B.pk[st] = (B.pk[st] or 0) + 1
      st.data.kills = st.data.kills + 1
      G.addXP(st, u.def.boss and 25 or 2)
      G.progress(st, "kill", 1)
      if src.drive then G.progress(st, "drivekill", 1) end
    end
    function cb.die(u)
      if u.bar then u.bar.Enabled = false end
      if u.driver then
        local st = G.states[u.driver]
        if st then G.driveStop(st) end
      end
      local m = u.model
      if not m or not m.Parent then return end
      m:SetAttribute("Dead", true)   -- 残骸：客户端布阵时不能选、画成烧黑的
      m:SetAttribute("Fly", false)
      local p = B.origin + V(u.x, 1 + u.y, u.z)
      if u.def.foot then
        G.fx({ k = "boom", p = p + V(0, 2, 0), s = 0.7 })
        m:Destroy()
        return
      end
      G.fx({ k = "boom", p = p + V(0, 3, 0), s = (u.def.boss or u.def.bombs) and 3 or 2 })
      if u.def.air then   -- 飞机摔到地上
        u.root.CFrame = G.unitCF(B.origin, u.x, 0, u.z, u.h) * CFrame.Angles(0.25, 0, 0.6)
        G.fx({ k = "boom", p = B.origin + V(u.x, 3, u.z), s = 1.6 })
      end
      for _, part in ipairs(m:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 1 and part.Name ~= "TeamRing" then
          part.Color = Color3.fromRGB(38, 35, 32)
          part.Material = Enum.Material.CorrodedMetal
        end
      end
      local fire = Instance.new("Fire")
      fire.Size = 8
      fire.Heat = 12
      fire.Parent = u.root
      local smoke = Instance.new("Smoke")
      smoke.Color = Color3.fromRGB(40, 40, 40)
      smoke.Opacity = 0.35
      smoke.RiseVelocity = 9
      smoke.Size = 6
      smoke.Parent = u.root
      Debris:AddItem(m, 6)
    end
    -- 运兵直升机放下的步兵：临时单位，模型放在直升机同一个文件夹里（客户端照样平滑显示），打完就删
    function cb.spawn(src, t, x, z)
      local def = UNITS[t]
      local color = (src.owner and src.owner.plot and src.owner.plot.color) or Config.EnemyColor
      local model, root = Models.unit(t, color)
      model.Name = "T" .. t
      model:SetAttribute("Type", t)
      model:SetAttribute("Fly", false)
      model.Parent = (src.model and src.model.Parent) or workspace
      root.CFrame = G.unitCF(B.origin, x, 0, z, src.h)
      local bar, fill = Models.hpBar(root, Models.heightOf(t) + 3, color)
      bar.Enabled = true
      local bu = { t = t, def = def, team = src.team, x = x, y = 0, z = z, h = src.h, ty = 0, hp = def.hp * src.dm, max = def.hp * src.dm, dm = src.dm,
        cd = math.random() * math.min(def.rate, 3), rt = 0, alive = true, temp = true, model = model, root = root, bar = bar, fill = fill, h3 = Models.heightOf(t) * 0.45 }
      addUnit(B, bu, true)
      return bu
    end
    return cb
  end

  local function newBattle(mode, origin)
    local B = { mode = mode, origin = origin, units = {}, shells = {}, missiles = {}, pending = {}, deaths = {}, t = 0, alive1 = 0, alive2 = 0, byId = {}, teamOf = {}, sts = {}, over = false }
    B.cb = callbacks(B)
    return B
  end

  -- 把玩家的部队加进战斗；mirror：放到对面（约战的应战方）
  local function enlist(B, st, team, mirror)
    local tm = G.powerOf(st.data)
    for _, u in pairs(st.units) do
      local def = UNITS[u.t]
      local stars = Config.StarsOf(u.v)
      local um = tm * (1 + Config.Vet.bonus * stars)   -- 老兵每星再加成
      u.path = nil
      local x, z, h = u.sx, u.sz, math.pi
      if mirror then x, z, h = -u.sx, F.enemy[1] + (F.deploy[2] - u.sz), 0 end
      u.x, u.y, u.z, u.h = x, 0, z, h
      if not u.bar then u.bar, u.fill = Models.hpBar(u.root, Models.heightOf(u.t) + 3, st.plot.color) end
      u.bar.Enabled = true
      u.fill.Size = UDim2.fromScale(1, 1)
      if def.air then G.setFly(u, true) end
      addUnit(B, {
        uid = u.uid, owner = st, t = u.t, def = def, team = team, x = x, y = 0, z = z, h = h, ty = 0, stars = stars, kills = 0,
        hp = def.hp * um, max = def.hp * um, dm = um, cd = math.random() * math.min(def.rate, 3), rt = 0, alive = true,
        model = u.model, root = u.root, bar = u.bar, fill = u.fill, h3 = Models.heightOf(u.t) * 0.45,
      })
    end
  end

  -- AI（或者防线快照）的部队：list = { { t, x, z, model?, root? } }，坐标是战场坐标
  local function enlistAI(B, list, hm, dm, hold, folder)
    for i, a in ipairs(list) do
      local def = UNITS[a.t]
      local model, root = a.model, a.root
      if not model then
        model, root = Models.unit(a.t, Config.EnemyColor)
        model.Name = "E" .. i
        model:SetAttribute("Type", a.t)
        model:SetAttribute("Fly", false)
        model.Parent = folder
      end
      root.CFrame = G.unitCF(B.origin, a.x, 0, a.z, 0)
      local bar, fill = Models.hpBar(root, Models.heightOf(a.t) + 3, Config.EnemyColor)
      bar.Enabled = true
      if def.air then model:SetAttribute("Fly", true) end
      local vm = 1 + Config.Vet.bonus * Config.StarsOf(a.v)   -- 突袭别人的防线：他的老兵也有加成
      addUnit(B, {
        t = a.t, def = def, team = 2, x = a.x, y = 0, z = a.z, h = 0, ty = 0, hp = def.hp * hm * vm, max = def.hp * hm * vm, dm = dm * vm,
        cd = math.random() * math.min(def.rate, 3), rt = 0, alive = true, hold = hold, model = model, root = root, bar = bar, fill = fill,
        h3 = Models.heightOf(a.t) * 0.45,
      })
    end
  end

  -- 把推演里的位置摆到模型上（没动的不改，省同步）；炮塔转角写在模型属性 TY 上（客户端转炮塔）
  local function placeAll(B)
    for _, u in ipairs(B.units) do
      if u.alive and not u.hero and u.root and u.root.Parent then
        if u.px == nil or math.abs(u.x - u.px) > 0.02 or math.abs(u.z - u.pz) > 0.02 or math.abs(u.y - u.py) > 0.02 or math.abs(u.h - u.ph) > 0.004 then
          u.px, u.pz, u.py, u.ph = u.x, u.z, u.y, u.h
          local cf = G.unitCF(B.origin, u.x, u.y, u.z, u.h)
          if u.def.air and u.moving and not u.def.jet then cf = cf * CFrame.Angles(-0.14, 0, 0) end   -- 直升机往前飞时低头（喷气机的坡度客户端算）
          u.root.CFrame = cf
        end
        local ty = math.floor((u.ty or 0) * 50 + 0.5) / 50
        if ty ~= u.pty then
          u.pty = ty
          u.model:SetAttribute("TY", ty)
        end
      end
    end
  end

  local function syncHeroes(B)
    for _, u in ipairs(B.units) do
      if u.hero and u.alive then
        local char = u.model
        local hum = char and char.Parent and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 or not (u.root and u.root.Parent) then
          u.alive = false
          local st = G.states[u.hero]
          if st and st.hero == u then
            st.hero = nil
            RB:FireClient(u.hero, { phase = "hero", alive = false })
          end
        else
          local p = u.root.Position - B.origin
          u.x, u.z = p.X, p.Z
        end
      end
    end
  end

  -- 玩家本人上阵：传送到己方后方，血量加到上阵的量；at 给了就在那里下车
  function G.heroJoin(st, at)
    local B = st.battle
    if not B or B.over or st.driving then return end
    local team = B.teamOf[st.pl]
    local char = st.pl.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) or hum.Health <= 0 then return end
    local pos, dir = heroSpot(B, team)
    if at then pos = at end
    char:PivotTo(CFrame.lookAt(pos, pos + V(0, 0, dir * 10)))
    hum.MaxHealth = Config.Hero.hp
    if not at then hum.Health = Config.Hero.hp end
    if st.hero then st.hero.alive = false end
    local bu = { hero = st.pl, owner = st, t = "hero", def = Battle.HERO, team = team, x = pos.X - B.origin.X, z = pos.Z - B.origin.Z, y = 0, h = 0,
      hp = 1, max = 1, dm = 1, cd = 0, rt = 0, alive = true, model = char, root = hrp, h3 = 2.5 }
    addUnit(B, bu)
    char:SetAttribute("BU", bu.bid)
    st.hero = bu
    RB:FireClient(st.pl, { phase = "hero", alive = true })
  end

  -- 开车时把角色藏起来（锚定、透明），下车放回车旁
  local function hideChar(st, hide, at)
    local char = st.pl.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hide then
      st.hidden = {}
      for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
          st.hidden[d] = d.Transparency
          d.Transparency = 1
        end
      end
      if hrp then hrp.Anchored = true end
    else
      for d, tr in pairs(st.hidden or {}) do
        if d.Parent then d.Transparency = tr end
      end
      st.hidden = nil
      if hrp then
        hrp.Anchored = false
        if at then char:PivotTo(CFrame.new(at)) end
      end
    end
  end

  function G.driveStart(st, uid)
    local B = st.battle
    if not B or B.over or st.driving or type(uid) ~= "number" then return end
    local bu
    for _, u in ipairs(B.units) do
      if u.owner == st and u.uid == uid and u.alive and not u.hero then bu = u end
    end
    if not bu then return end
    if bu.def.foot then
      G.toast(st, bu.def.name .. "不能开——你本人就是步兵", "info")
      return
    end
    bu.driver = st.pl
    bu.tgt = nil
    bu.salvoLeft = 0
    st.driving = bu
    st.driveT = os.clock()
    if st.hero then
      st.hero.alive = false
      st.hero = nil
    end
    hideChar(st, true)
    RB:FireClient(st.pl, { phase = "drive", uid = uid, t = bu.t, bid = bu.bid, origin = B.origin, cd = math.max(0, bu.cd) })   -- cd：还要装填几秒
  end

  function G.driveStop(st)
    local bu = st.driving
    if not bu then return end
    st.driving = nil
    bu.driver = nil
    local B = st.battle
    local at = nil
    if B then at = B.origin + V(bu.x + bu.def.size * 0.6 + 3, 4, bu.z) end
    hideChar(st, false, at)
    RB:FireClient(st.pl, { phase = "exit" })
    if B and not B.over then G.heroJoin(st, at) end
  end

  -- 玩家开的车：客户端算位置（不卡），服务器只检查速度、边界；喷气机的范围大一些
  function G.driveInput(st, d)
    local bu = st.driving
    if not bu or not bu.alive or type(d) ~= "table" then return end
    local x, z, h, y, ty = d.x, d.z, d.h, d.y, d.ty
    if type(x) ~= "number" or type(z) ~= "number" or type(h) ~= "number" or x ~= x or z ~= z or h ~= h then return end
    local def = bu.def
    local now = os.clock()
    local dt = math.min(0.5, now - (st.driveT or now))
    st.driveT = now
    local maxStep = def.speed * 1.5 * math.max(dt, 0.05) + 3
    local dx, dz = x - bu.x, z - bu.z
    local dist = math.sqrt(dx * dx + dz * dz)
    if dist > maxStep then x, z = bu.x + dx / dist * maxStep, bu.z + dz / dist * maxStep end
    local ox, oz = bu.x, bu.z
    if def.jet then
      bu.x = math.clamp(x, -Battle.JX, Battle.JX)
      bu.z = math.clamp(z, Battle.JZ0, Battle.JZ1)
    else
      bu.x = math.clamp(x, -XMAX, XMAX)
      bu.z = math.clamp(z, ZMIN, ZMAX)
    end
    local step = math.max(dt, 0.05)
    bu.vx, bu.vz = (bu.x - ox) / step, (bu.z - oz) / step   -- 轰炸机投弹要用速度
    bu.h = h
    bu.moving = dist > 0.05
    if def.air then
      bu.y = (type(y) == "number" and y == y) and math.clamp(y, def.cargo and 5 or 12, def.jet and 230 or 160) or def.alt
    end
    if type(ty) == "number" and ty == ty then bu.ty = ty end
  end

  function G.driveFire(st, aim)
    local bu = st.driving
    local B = st.battle
    if not bu or not bu.alive or not B or typeof(aim) ~= "Vector3" then return end
    local a = aim - B.origin
    Battle.driveFire(B, bu, a.X, a.Z, a.Y - 1)
  end

  -- 每半秒：双方还剩多少、这半秒里谁被打掉了（战报滚动条：en 是不是敌方的、me 是不是你亲手打的、mine 是不是你的部队）
  local function tick(B)
    local deaths = B.deaths or {}
    B.deaths = {}
    for st, team in pairs(B.sts) do
      if G.states[st.pl] == st then
        local a, e = B.alive1, B.alive2
        if team == 2 then a, e = e, a end
        local feed = nil
        for _, dd in ipairs(deaths) do
          feed = feed or {}
          if #feed >= 8 then break end
          table.insert(feed, { t = dd.t, en = dd.team ~= team, me = dd.by == st.pl.UserId, mine = dd.owner == st.pl.UserId })
        end
        RB:FireClient(st.pl, { phase = "tick", t = B.t, a = a, e = e, feed = feed })
      end
    end
  end

  -- 火山战区：隔一会儿在战场上随机一处先亮出红圈预警，再砸下几颗火山弹（敌我都伤）
  local LAVA = { dmg = 110, splash = 22, vsArmor = 0.7, vsInf = 1.2, vsAir = 0, fxu = "lava" }
  local function quakeStep(B, dt)
    B.quakeT = (B.quakeT or B.quake * 0.6) - dt
    if B.quakeT > 0 then return end
    B.quakeT = B.quake * (0.8 + math.random() * 0.4)
    local x = (math.random() - 0.5) * (F.width - 60)
    local z = F.deploy[2] + math.random() * (F.enemy[1] - F.deploy[2])
    local dm = 1 + (B.level or 41) * 0.05
    G.fx({ k = "quake", p = B.origin + V(x, 1, z), s = 30 })
    for i = 1, 3 do
      Battle.strike(B, 0, LAVA, dm, x, z, 24, 1.6 + i * 0.35, "bomb", nil, B.origin + V(x + math.random(-120, 120), 300, z + math.random(-120, 120)))
    end
  end

  -- 战况（打关卡时按关卡定）：大雾、夜战射程短；雷区开打前埋好；敌机突袭、空降增援到时候来
  local function eventSetup(B)
    local ev = B.event
    if ev.id == "fog" then
      B.rangeK = (B.rangeK or 1) * 0.7
    elseif ev.id == "night" then
      B.rangeK = (B.rangeK or 1) * 0.8
    elseif ev.id == "minefield" then   -- 中立的雷：谁踩上都炸
      local pseudo = { def = { mines = { dmg = 300, splash = 16, r = 11 } }, team = 0, dm = 1 }
      for _ = 1, 16 do
        Battle.layMine(B, pseudo, (math.random() - 0.5) * (F.width - 80), F.deploy[2] + 100 + math.random() * (F.enemy[1] - F.deploy[2] - 200))
      end
    end
  end
  local function eventSay(B, text, sub)
    for st in pairs(B.sts) do
      if G.states[st.pl] == st then RB:FireClient(st.pl, { phase = "event", text = text, sub = sub }) end
    end
  end
  local function eventStep(B)
    local ev = B.event
    if B.evDone then return end
    if ev.id == "airraid" and B.t >= (ev.at or 8) then
      B.evDone = true
      local sx, sz, n = 0, 0, 0
      for _, u in ipairs(B.units) do
        if u.alive and u.team == 1 and not u.hero and not u.def.air then sx, sz, n = sx + u.x, sz + u.z, n + 1 end
      end
      if n == 0 then return end
      local x, z = sx / n, sz / n
      local def = { dmg = 120, splash = 22, vsArmor = 0.9, vsInf = 1.3, vsAir = 0, fxu = "bomber" }
      local len, cnt, dm = 170, 12, B.enemyDm or 1
      eventSay(B, "敌机突袭！", "轰炸机从北边飞过来，沿着你的阵线扔炸弹")
      G.fx({ k = "flyover", a = B.origin + V(x, 95, z + len / 2 + 420), b = B.origin + V(x, 95, z - len / 2 - 420), t = 4.2, jet = true })
      for i = 1, cnt do
        local bz = z + len / 2 - (i - 1) * len / (cnt - 1)
        task.delay(1.55 + (i - 1) * 0.11, function()
          if B.over then return end
          Battle.strike(B, 2, def, dm, x + math.random(-8, 8), bz, 5, 1.1, "bomb", nil, B.origin + V(x, 92, bz + 30))
        end)
      end
    elseif ev.id == "reinforce" and B.t >= (ev.at or 10) then
      B.evDone = true
      eventSay(B, "敌军空降增援！", "战场中间落下一批步兵和机枪车")
      local x0, z0 = (math.random() - 0.5) * 160, F.center + 60
      G.fx({ k = "flyover", a = B.origin + V(x0 + 60, 70, z0 + 380), b = B.origin + V(x0 - 60, 70, z0 - 380), t = 3.2, heli = true })
      local src = { team = 2, h = 0, dm = B.enemyDm or 1, model = { Parent = B.enemyFolder } }
      local list = { "inf", "inf", "inf", "inf", "jeep", "jeep" }
      for i, t in ipairs(list) do
        task.delay(1.4 + i * 0.25, function()
          if B.over or not B.cb.spawn then return end
          local a = (i / #list) * math.pi * 2
          local px = math.clamp(x0 + math.cos(a) * 26, -Battle.XMAX, Battle.XMAX)
          local pz = math.clamp(z0 + math.sin(a) * 26, Battle.ZMIN, Battle.ZMAX)
          local bu = B.cb.spawn(src, t, px, pz)
          if bu then
            table.insert(B.units, bu)   -- 不在推演那一步里：直接加
            G.fx({ k = "drop", p = B.origin + V(px, 1, pz), s = 1 })
          end
        end)
      end
    else
      if ev.id ~= "airraid" and ev.id ~= "reinforce" then B.evDone = true end
    end
  end

  -- 单位技能：观战时点开自己的一个单位放（按兵种的页签：冲锋、烟幕、全力开火、急速射、加力冲刺），每个单位各自冷却
  function G.useAbility(st, bid)
    local B = st.battle
    if not B or B.over or type(bid) ~= "number" then return end
    local u = B.byId[bid]
    if not u or not u.alive or u.owner ~= st or u.hero or u.temp then return end
    local ab = Config.Abilities[u.def.cat or ""]
    if not ab then return end
    if (u.abReady or 0) > B.t then
      G.toast(st, "「" .. ab.name .. "」还要冷却 " .. math.ceil(u.abReady - B.t) .. " 秒", "info")
      return
    end
    u.abReady = B.t + ab.cd
    Battle.ability(B, u)
    RB:FireClient(st.pl, { phase = "ability", bid = bid, id = ab.id, name = ab.name, cd = ab.cd })
    G.progress(st, "skill", 1)
  end

  local finish, forceEnd
  local function begin(B, sides, title)
    for team, st in pairs(sides) do
      st.battle = B
      B.teamOf[st.pl] = team
      B.sts[st] = team
      if G.skillsReset then G.skillsReset(st) end
    end
    placeAll(B)
    for st, team in pairs(B.sts) do
      RB:FireClient(st.pl, { phase = "start", mode = B.mode, title = title, level = st.data.level, team = team, time = Config.BattleTime, origin = B.origin, boss = B.boss == true,
        event = B.event and { id = B.event.id, name = B.event.name, desc = B.event.desc } or nil })
      G.push(st)
      G.heroJoin(st)
    end
    task.spawn(function()
      local tickT, bad = 0, 0
      while not B.over do
        local dt = task.wait(Config.Tick)
        if B.over then break end
        G.try("战斗：玩家本人", syncHeroes, B)
        local ok, res = xpcall(Battle.step, debug.traceback, B, math.min(dt, 0.2))
        if not ok then
          G.reportError("战斗推演", res)
          bad = bad + 1
          res = (bad > 40) and "timeout" or nil   -- 偶尔一步出错就跳过这一步；一直出错才收场
        end
        G.try("战斗：摆模型", placeAll, B)
        if B.quake then G.try("战斗：火山弹", quakeStep, B, dt) end
        if B.event then G.try("战斗：战况", eventStep, B) end
        tickT = tickT + dt
        if tickT >= 0.5 then
          tickT = 0
          G.try("战斗：战报", tick, B)
        end
        if res then
          if not G.try("战斗结算", finish, B, res) then forceEnd(B) end
          break
        end
      end
    end)
  end

  -- 剩下的兵力（按价格算）：约战打到时间按这个判输赢
  local function valueLeft(B, team)
    local v = 0
    for _, u in ipairs(B.units) do
      if u.alive and not u.hero and u.team == team then v = v + (u.def.price or 0) * (u.hp / math.max(1, u.max)) end
    end
    return v
  end
  local function armyValue(st)
    local v = 0
    for _, u in pairs(st.units) do v = v + UNITS[u.t].price end
    return v
  end

  -- 老兵：活下来的 +1 经验，每击毁一个敌人再 +1；升星了记下来（打完一起提示）
  local function vetGain(st, u, bu, promos)
    local old = Config.StarsOf(u.v)
    u.v = (u.v or 0) + 1 + (bu.kills or 0)
    local new = Config.StarsOf(u.v)
    if new > old then
      table.insert(promos, UNITS[u.t].name .. " " .. string.rep("★", new))
      if G.vetTag then G.vetTag(st, u) end
    end
  end
  local function promoToast(st, promos)
    if #promos == 0 then return end
    local list = {}
    for i = 1, math.min(4, #promos) do list[i] = promos[i] end
    G.toast(st, "老兵晋升：" .. table.concat(list, "、") .. ((#promos > 4) and ("等 " .. #promos .. " 个") or "") ..
      "（每颗星血量、伤害 +" .. math.floor(Config.Vet.bonus * 100 + 0.5) .. "%）", "good")
  end

  -- 打完：清理、按模式算奖励；res 是第 1 队的结果
  function finish(B, res)
    if B.over then return end
    B.over = true
    for st in pairs(B.sts) do
      if st.driving then G.driveStop(st) end
      st.hero = nil
      local char = st.pl.Character
      local hum = char and char:FindFirstChildOfClass("Humanoid")
      if hum then
        hum.MaxHealth = 100
        if hum.Health > 100 then hum.Health = 100 end
      end
      if char then char:SetAttribute("BU", nil) end
    end
    for _, bu in ipairs(B.units) do
      if bu.bar then bu.bar.Enabled = false end
      if bu.temp then   -- 机降的步兵打完就撤
        if bu.model then bu.model:Destroy() end
      elseif bu.model and bu.model.Parent and not bu.hero then
        bu.model:SetAttribute("BU", nil)
        bu.model:SetAttribute("TY", 0)
      end
    end
    if B.mode == "duel" then
      local t1, t2 = B.sides[1], B.sides[2]   -- 中途走掉的人不在 B.sts 里了，排位照样算他输
      local winner = 0
      if res == "win" then winner = 1 elseif res == "lose" then winner = 2
      else
        local v1, v2 = valueLeft(B, 1), valueLeft(B, 2)
        winner = (v1 >= v2) and 1 or 2
      end
      if B.arena then B.arena.busy = false end
      -- 排位：ELO（赢的涨、输的掉同样多；走掉的人的存档在 PlayerRemoving 里存）
      local delta = 0
      local MC = Config.Match
      if B.ranked and t1 and t2 and t1.data and t2.data then
        local d1, d2 = t1.data, t2.data
        local E1 = 1 / (1 + 10 ^ ((d2.pvp - d1.pvp) / 400))
        delta = math.max(1, math.floor(MC.k * math.abs(((winner == 1) and 1 or 0) - E1) + 0.5))
        local w, l = d1, d2
        if winner == 2 then w, l = d2, d1 end
        w.pvp = w.pvp + delta
        l.pvp = math.max(0, l.pvp - delta)
        w.pvpWins = w.pvpWins + 1
        d1.pvpGames = d1.pvpGames + 1
        d2.pvpGames = d2.pvpGames + 1
      end
      for st, team in pairs(B.sts) do
        if G.states[st.pl] == st then
          local other = (team == 1) and t2 or t1
          local won = team == winner
          local reward = 0
          if B.ranked then
            reward = won and math.floor(MC.reward + MC.share * (other and armyValue(other) or 0)) or MC.lose
            G.addXP(st, won and 40 or 15)
          elseif won then
            reward = math.floor(Config.Duel.reward + Config.Duel.share * (other and armyValue(other) or 0))
            G.addXP(st, 30)
          else
            G.addXP(st, 10)
          end
          st.data.cash = st.data.cash + reward
          if won then st.data.duelWins = st.data.duelWins + 1 end
          G.progress(st, "duel", 1)
          -- 约战不损失部队：打没了的换新模型，全部放回阵位；活下来的照样攒老兵经验
          local promos = {}
          for _, bu in ipairs(B.units) do
            if bu.owner == st and not bu.hero and not bu.temp then
              local u = st.units[bu.uid]
              if u and not bu.alive then G.respawnModel(st, u) elseif u then vetGain(st, u, bu, promos) end
            end
          end
          G.homeSnap(st)
          promoToast(st, promos)
          st.battle = nil
          local oname = other and other.pl.DisplayName or "对手"
          local text = won and ("你赢了 " .. oname .. "！") or ("输给了 " .. oname .. "，部队没有损失")
          if B.ranked then
            text = text .. "\n对战积分 " .. (won and "+" or "-") .. delta .. "（现在 " .. st.data.pvp .. "）"
            if G.matchServer then text = text .. "\n" .. MC.back .. " 秒后送你回普通服务器" end
          end
          RB:FireClient(st.pl, { phase = "end", mode = "duel", ranked = B.ranked, result = won and "win" or "lose", reward = reward, lost = {}, lostN = 0, level = st.data.level, text = text,
            pk = (B.pk and B.pk[st]) or 0 })
          G.push(st)
          task.spawn(G.save, st)
        end
      end
      if G.onDuelEnd then G.onDuelEnd(B) end
      return
    end
    -- 关卡、突袭：第 1 队是玩家
    local st = nil
    for s in pairs(B.sts) do st = s end
    if not st or G.states[st.pl] ~= st then return end
    local d = st.data
    local lost, lostN, total = {}, 0, 0
    local promos = {}
    for _, bu in ipairs(B.units) do
      if bu.owner == st and not bu.hero and not bu.temp then
        local u = st.units[bu.uid]
        total = total + 1
        if u then
          if bu.alive then   -- 活着的开回战前的阵位，下一仗满血；攒老兵经验
            u.x, u.y, u.z, u.h = bu.x, bu.y, bu.z, bu.h
            G.goTo(u, u.sx, u.sz)
            vetGain(st, u, bu, promos)
          elseif bu.spent then   -- 巡飞弹撞上去了：用掉了，不算损失
            st.units[bu.uid] = nil
            total = total - 1
          else
            st.units[bu.uid] = nil
            lost[u.t] = (lost[u.t] or 0) + 1
            lostN = lostN + 1
          end
        end
      elseif bu.team == 2 and bu.alive and bu.model and bu.model.Parent then
        bu.model:SetAttribute("Fly", false)
      end
    end
    local reward, text, stars = 0, nil, nil
    local oldBest = d.best
    if B.mode == "pve" then
      if res == "win" then
        local beaten = d.level
        reward = Config.Reward(beaten)
        d.cash = d.cash + reward
        if Config.IsBoss(beaten) then
          G.progress(st, "boss", 1)
          text = "打掉了首领！奖励翻倍"
        end
        -- 评星：一个没丢三星，丢的不超过三成两星，其余一星
        stars = (lostN == 0) and 3 or ((lostN <= total * 0.3) and 2 or 1)
        local M = Config.Milestone
        if M and beaten % M.every == 0 then
          local bonus = math.floor(Config.Reward(beaten) * M.k)
          d.cash = d.cash + bonus
          reward = reward + bonus
          text = (text and (text .. "\n") or "") .. "里程碑：打通第 " .. beaten .. " 关，额外奖励 $" .. Config.Fmt(bonus)
        end
        G.addXP(st, 10 + d.level * 2)
        G.progress(st, "win", 1)
        d.level = d.level + 1
        d.best = math.max(d.best, d.level)
        d.wins = (d.wins or 0) + 1
        -- 打进新战区：战场整个换样子，过一会儿大字播报
        local th = Config.TheaterOf(d.level)
        if G.setTheater and G.setTheater(st, th) then
          text = (text and (text .. "\n") or "") .. "解锁新战区：" .. th.name .. "！" .. th.desc
          task.delay(3.5, function()
            if G.states[st.pl] == st then RB:FireClient(st.pl, { phase = "theater", name = th.name, desc = th.desc }) end
          end)
        end
      end
    else   -- 突袭
      local opp = B.raid
      local E = 1 / (1 + 10 ^ ((opp.rating - d.rating) / 400))
      local won = res == "win"
      local delta = math.floor(Config.Raid.k * ((won and 1 or 0) - E) + (won and 0.5 or -0.5))
      d.rating = math.max(0, d.rating + delta)
      if won then
        reward = math.floor(Config.Reward(opp.level) * Config.Raid.loot)
        d.cash = d.cash + reward
        d.raidWins = d.raidWins + 1
        G.addXP(st, 25)
        G.progress(st, "raidwin", 1)
      end
      text = "突袭" .. (won and "成功" or "失败") .. "：积分 " .. ((delta >= 0) and "+" or "") .. delta .. "（现在 " .. d.rating .. "）"
      if opp.key then G.logRaid(opp.key, { n = st.pl.DisplayName, w = not won, t = os.time() }) end
    end
    st.enemy = {}
    st.battle = nil
    RB:FireClient(st.pl, { phase = "end", mode = B.mode, result = res, reward = reward, lost = lost, lostN = lostN, level = d.level, text = text,
      stars = stars, record = d.best > oldBest and d.best > 2, pk = (B.pk and B.pk[st]) or 0, total = total })
    promoToast(st, promos)
    G.push(st)
    task.spawn(G.save, st)
    task.delay((res == "win") and 3 or 2, function()
      if G.states[st.pl] == st and not st.battle then
        G.makeEnemy(st)
        G.push(st)
      end
    end)
  end

  -- 结算出错时的保底收尾：至少让人退出「打仗中」、部队回到阵位，不然什么都点不了
  function forceEnd(B)
    B.over = true
    if B.arena then B.arena.busy = false end
    for st in pairs(B.sts) do
      pcall(function()
        if st.driving then G.driveStop(st) end
        st.hero = nil
        st.battle = nil
        for _, bu in ipairs(B.units) do
          if bu.temp and bu.model then pcall(function() bu.model:Destroy() end) end
          if bu.owner == st and not bu.hero and not bu.temp then
            local u = st.units[bu.uid]
            if u and not bu.alive then
              if B.mode == "duel" then G.respawnModel(st, u) else st.units[bu.uid] = nil end
            end
          end
        end
        G.homeSnap(st)
        RB:FireClient(st.pl, { phase = "end", mode = B.mode, result = "timeout", reward = 0, lost = {}, lostN = 0, level = st.data.level,
          text = "这一仗结算的时候出错了，已经强制结束，部队放回了阵位（出错信息在屏幕上方的红条里）" })
        G.push(st)
      end)
    end
  end

  -- 人走了：约战算他输；关卡、突袭直接结束（不算输赢、不扣兵）
  function G.abandon(st)
    local B = st.battle
    if not B or B.over then return end
    if B.mode == "duel" then
      B.sts[st] = nil
      if not G.try("约战结算", finish, B, (B.teamOf[st.pl] == 1) and "lose" or "win") then forceEnd(B) end
    else
      B.over = true
    end
  end

  local function canFight(st)
    if not st.ready or st.battle or st.busy then return false end
    if G.count(st) == 0 then
      G.toast(st, "还没有部队：先盖兵营，再在右边「兵工厂」生产", "bad")
      return false
    end
    return true
  end

  function G.startBattle(st)
    if not canFight(st) then return end
    if G.matchCancel then G.matchCancel(st, "开始打关卡，取消了匹配") end
    if #st.enemy == 0 then G.makeEnemy(st) end
    local B = newBattle("pve", st.plot.origin)
    B.level = st.data.level
    B.boss = Config.IsBoss(st.data.level)
    -- 战区：速度、射程倍数，火山弹
    local th = Config.TheaterOf(st.data.level)
    if G.setTheater then G.setTheater(st, th) end
    B.theater = th
    B.speedK = th.speed or 1
    B.rangeK = th.range or 1
    B.quake = th.quake
    enlist(B, st, 1, false)
    local list = {}
    for _, e in ipairs(st.enemy) do table.insert(list, { t = e.t, x = e.x, z = e.z, model = e.model, root = e.root }) end
    local hm, dm = 1, 1
    if st.enemy[1] then hm, dm = st.enemy[1].hm, st.enemy[1].dm end
    enlistAI(B, list, hm, dm, false, st.plot.Enemies)
    B.event = Config.EventOf(st.data.level)
    B.enemyDm, B.enemyFolder = dm, st.plot.Enemies
    if B.event then eventSetup(B) end
    local title = "第 " .. st.data.level .. " 关" .. (Config.IsBoss(st.data.level) and "（首领）" or "") .. (B.event and ("  · " .. B.event.name) or "")
    begin(B, { [1] = st }, title)
  end

  -- 找不到真人对手（或者存档服务不可用）：AI 指挥官，兵力和你差不多
  local BOTNAMES = { "雷霆", "钢铁", "猎鹰", "磐石", "暴风", "长弓", "铁壁", "毒蛇" }
  local function botOpponent(st)
    local value = armyValue(st) * G.powerOf(st.data)
    local budget = math.max(300, value * 0.85)
    local types = Config.EnemyTypes(math.max(5, st.data.level))
    local list, spent = {}, 0
    while #list < Config.MaxEnemy do
      local t = types[math.random(1, #types)]
      if spent + UNITS[t].price > budget then break end
      table.insert(list, t)
      spent = spent + UNITS[t].price
    end
    if #list == 0 then list = { "inf", "inf" } end
    local slots = Battle.formation(list, F.deploy[2] - 4, -1, F.deploy[2] - F.deploy[1] - 8)
    local army = {}
    for _, s in ipairs(slots) do table.insert(army, { t = s.t, x = s.x, z = s.z }) end
    return { key = nil, name = "AI 指挥官·" .. BOTNAMES[math.random(1, #BOTNAMES)], level = st.data.level, tech = st.data.tech, rebirth = 0, rating = st.data.rating, army = army }
  end

  function G.startRaid(st)
    if not canFight(st) then return end
    local now = os.clock()
    if now < (st.raidCD or 0) then
      G.toast(st, "部队还在休整：" .. math.ceil(st.raidCD - now) .. " 秒后才能再突袭", "info")
      return
    end
    st.raidCD = now + Config.Raid.cooldown
    if G.matchCancel then G.matchCancel(st, "开始突袭，取消了匹配") end
    st.busy = true
    G.toast(st, "侦察中：找一条差不多强的防线……", "info")
    local opp = G.findOpponent(st)
    st.busy = false
    if G.states[st.pl] ~= st or st.battle or not st.ready then return end
    if not opp then opp = botOpponent(st) end
    st.plot.Enemies:ClearAllChildren()
    st.enemy = {}
    local B = newBattle("raid", st.plot.origin)
    B.raid = opp
    enlist(B, st, 1, false)
    local tm = (1 + Config.Tech.bonus * opp.tech) * (1 + Config.Rebirth.power * opp.rebirth)
    local list = {}
    for _, a in ipairs(opp.army) do
      local z = math.clamp(F.enemy[1] + (F.deploy[2] - a.z), F.enemy[1] + 4, F.enemy[2] - 4)
      table.insert(list, { t = a.t, x = math.clamp(-a.x, -XMAX, XMAX), z = z, v = a.v })
    end
    enlistAI(B, list, tm, tm, true, st.plot.Enemies)
    begin(B, { [1] = st }, "突袭：" .. opp.name .. " 的防线（第 " .. opp.level .. " 关水平）")
  end

  -- 约战：挑战同服的玩家，对方接受后两边的部队、本人都传到竞技场
  function G.duelInvite(st, targetUid)
    if type(targetUid) ~= "number" or not canFight(st) then return end
    local target = Players:GetPlayerByUserId(targetUid)
    local ts = target and G.states[target]
    if not ts or ts == st or not ts.ready then return end
    if ts.battle then
      G.toast(st, target.DisplayName .. " 正在打仗，等一会儿", "info")
      return
    end
    if G.count(ts) == 0 then
      G.toast(st, target.DisplayName .. " 还没有部队", "info")
      return
    end
    ts.invite = { from = st.pl, untilT = os.clock() + Config.Duel.invite }
    G.R.Duel:FireClient(target, { from = st.pl.UserId, name = st.pl.DisplayName, level = st.data.level, n = G.count(st), rank = (Config.RankOf(st.data.xp)), time = Config.Duel.invite })
    G.toast(st, "已经向 " .. target.DisplayName .. " 发起约战，等对方接受", "info")
  end

  function G.duelAnswer(ts, fromUid, yes)
    local inv = ts.invite
    ts.invite = nil
    if not inv or inv.from.UserId ~= fromUid or os.clock() > inv.untilT then return end
    local st = G.states[inv.from]
    if not st then return end
    if not yes then
      G.toast(st, ts.pl.DisplayName .. " 拒绝了约战", "info")
      return
    end
    if not canFight(st) or not canFight(ts) then
      G.toast(ts, "约战没开成（对方在忙或者没有部队）", "info")
      return
    end
    G.startDuel(st, ts, false)
  end

  -- 两个人的部队、本人都传到空着的竞技场开打（st 在南边、ts 在北边）；ranked 排位赛记对战积分；返回开没开成
  function G.startDuel(st, ts, ranked)
    if not canFight(st) or not canFight(ts) then return false end
    local arena = nil
    for _, a in ipairs(G.arenas) do
      if not a.busy then
        arena = a
        break
      end
    end
    if not arena then
      G.toast(st, "竞技场都在用，过一会儿再打", "info")
      G.toast(ts, "竞技场都在用，过一会儿再打", "info")
      return false
    end
    if G.matchCancel then   -- 在排队的话不用排了
      G.matchCancel(st, true)
      G.matchCancel(ts, true)
    end
    arena.busy = true
    local B = newBattle("duel", arena.origin)
    B.arena = arena
    B.ranked = ranked == true
    B.sides = { [1] = st, [2] = ts }
    enlist(B, st, 1, false)
    enlist(B, ts, 2, true)
    begin(B, { [1] = st, [2] = ts }, (ranked and "排位对战：" or "约战：") .. st.pl.DisplayName .. " vs " .. ts.pl.DisplayName)
    return true
  end

  -- 战后或者想回去了：传送回自己的基地出生点
  function G.sendHome(st)
    if st.battle and not st.battle.over then return end
    local char = st.pl.Character
    if char then
      local S = Config.Spawn
      local o = st.plot.origin
      char:PivotTo(CFrame.lookAt(o + V(S.x, 5, S.z), o + V(S.x, 5, S.z + 10)))
    end
  end
end

return Combat
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000008">
<Properties>
<string name="Name">Crates</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：补给空投——不打仗的时候，隔一会儿往自己基地里空投一个补给箱（挂着降落伞慢慢落下，头顶有绿色信标），
-- 走过去碰一下（或按 E）就拿钱：这么多秒的收入，至少 Config.Crate.min；一直没人捡就收走
local Players = game:GetService("Players")

local Crates = {}

function Crates.init(G)
  local Config, Models = G.Config, G.Models
  local V = Vector3.new
  local C = Config.Crate
  local hs = Config.BaseSize / 2

  -- 落点：基地里空着的地方（离建筑、按钮远一点）；找不到就落在出生点旁边
  local function spot(st)
    local o = st.plot.origin
    for _ = 1, 40 do
      local x = math.random(-hs + 18, hs - 18)
      local z = math.random(-hs + 18, hs - 18)
      local ok = true
      for _, b in ipairs(Config.Buildings) do
        if math.abs(x - b.x) < b.size[1] / 2 + 14 and math.abs(z - b.z) < b.size[3] / 2 + 16 then
          ok = false
          break
        end
      end
      if ok and math.abs(x - Config.Spawn.x) < 10 and math.abs(z - Config.Spawn.z) < 10 then ok = false end
      if ok then return o + V(x, 1, z) end
    end
    return o + V(Config.Spawn.x + 22, 1, Config.Spawn.z + 18)
  end

  local function amountOf(st)
    return math.max(C.min, math.floor(st.income * C.sec))
  end

  local function give(st, crate)
    if st.crate ~= crate or crate.taken then return end
    crate.taken = true
    st.crate = nil
    local amt = amountOf(st)
    st.data.cash = st.data.cash + amt
    G.fx({ k = "coins", p = crate.pos + V(0, 3, 0), s = 1 })
    G.toast(st, "捡到补给箱：+$" .. Config.Fmt(amt), "good")
    G.progress(st, "crate", 1)
    crate.model:Destroy()
    G.push(st)
  end

  local function drop(st)
    local pos = spot(st)
    local amt = amountOf(st)
    local m, box, chute, label = Models.crate(st.plot.Drops, pos, "补给箱 +$" .. Config.Fmt(amt))
    local crate = { model = m, box = box, pos = pos, expire = os.clock() + C.life, taken = false }
    st.crate = crate
    box.Touched:Connect(function(hit)
      local who = Players:GetPlayerFromCharacter(hit.Parent)
      if who == st.pl and crate.landed then give(st, crate) end
    end)
    local pp = Instance.new("ProximityPrompt")
    pp.ActionText = "打开补给箱"
    pp.ObjectText = "+$" .. Config.Fmt(amt)
    pp.HoldDuration = 0
    pp.MaxActivationDistance = 14
    pp.RequiresLineOfSight = false
    pp.Parent = box
    pp.Triggered:Connect(function(who)
      if who == st.pl and crate.landed then give(st, crate) end
    end)
    G.toast(st, "补给空投来了！去基地里找绿色信标下面的箱子", "info")
    -- 挂着伞从天上慢慢落下来（服务器挪根零件，每秒 20 次）
    task.spawn(function()
      local h0, dur = 70, 3.2
      local t = 0
      while t < dur and m.Parent do
        local dt = task.wait(0.05)
        t = t + dt
        local k = math.min(1, t / dur)
        box.CFrame = CFrame.new(pos + V(0, 1.5 + h0 * (1 - k), 0)) * CFrame.Angles(0, t * 0.6, 0)
      end
      if not m.Parent then return end
      crate.landed = true
      if chute and chute.Parent then chute:Destroy() end
      if label then label.Enabled = true end
      G.fx({ k = "boom", p = pos + V(0, 1, 0), s = 0.45 })
    end)
  end

  task.spawn(function()
    while true do
      task.wait(2)
      local now = os.clock()
      for _, st in pairs(G.states) do
        G.try("补给空投", function()
          if not (st.ready and st.data) or G.matchServer then return end
          if st.crate then
            if now > st.crate.expire then
              st.crate.model:Destroy()
              st.crate = nil
            end
            return
          end
          st.nextCrate = st.nextCrate or (now + 35)   -- 进服 35 秒后先来一个
          if now >= st.nextCrate and not st.battle then
            st.nextCrate = now + C.every + math.random(-C.jitter, C.jitter)
            drop(st)
          end
        end)
      end
    end
  end)
end

return Crates
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000000000000000000000000000009">
<Properties>
<string name="Name">Economy</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：经济与成长（建筑、购买按钮、收入、指挥部、军工科技、重生、经验与军衔、每日奖励、每日任务、武器商店）
local Players = game:GetService("Players")

local Economy = {}

function Economy.init(G)
  local Config, Models = G.Config, G.Models
  local V = Vector3.new
  local BDEF, UNITS = Config.BuildingById, Config.Units
  local GREEN, RED = Color3.fromRGB(70, 220, 100), Color3.fromRGB(225, 70, 60)

  function G.incomeOf(d)
    local inc = 0
    for id in pairs(d.owned) do
      local b = BDEF[id]
      if b and b.income then inc = inc + Config.BuildingIncome(b, d.owned, d.lv and d.lv[id]) end
    end
    return inc * (1 + Config.Rebirth.income * (d.rebirth or 0))
  end

  function G.capOf(d)
    if d.owned.hq and d.hq >= 1 then return BDEF.hq.cap[d.hq] or BDEF.hq.cap[1] end
    return Config.BaseCap
  end

  -- 我方部队的血量、伤害倍数（军工科技 × 重生）
  function G.powerOf(d)
    return (1 + Config.Tech.bonus * d.tech) * (1 + Config.Rebirth.power * (d.rebirth or 0))
  end

  function G.recalc(st)
    local d = st.data
    st.income = G.incomeOf(d)
    for id in pairs(d.owned) do   -- 加成、级数变了：楼顶的收入牌子、升级提示跟着改
      if BDEF[id] and BDEF[id].income then G.refreshSign(st, id) end
    end
    if st.hqLabel then st.hqLabel.Text = "指挥部 " .. string.rep("★", d.hq) .. "  部队上限 " .. G.capOf(d) end
    if st.hqPrompt then
      if d.hq < #BDEF.hq.cap then
        st.hqPrompt.ObjectText = "$" .. Config.Fmt(BDEF.hq.up[d.hq]) .. " → 上限 " .. BDEF.hq.cap[d.hq + 1]
      else
        st.hqPrompt.Enabled = false
      end
    end
  end

  local function buildingPos(plot, b)
    return plot.origin + V(b.x, 1, b.z)
  end
  G.buildingPos = buildingPos

  -- 楼顶的牌子（名字、级数星星、现在每秒挣多少）、旁边的升级提示（按住 E）
  function G.refreshSign(st, id)
    local b, d = BDEF[id], st.data
    local lv = (d.lv and d.lv[id]) or 1
    local label = st.signs and st.signs[id]
    if label and label.Parent then
      local inc = Config.BuildingIncome(b, d.owned, lv) * (1 + Config.Rebirth.income * (d.rebirth or 0))
      label.Text = b.name .. "  <font color=\"#FFD24A\">Lv." .. lv .. " " .. string.rep("★", lv) .. "</font>  <font color=\"#7CFC8A\">+" .. Config.Fmt(inc) .. "/秒</font>"
    end
    local pp = st.upPrompts and st.upPrompts[id]
    if pp and pp.Parent then
      if lv >= Config.Upgrade.max then
        pp.Enabled = false
      else
        pp.Enabled = true
        pp.ActionText = "升级到 Lv." .. (lv + 1)
        pp.ObjectText = b.name .. "  $" .. Config.Fmt(Config.UpgradeCost(b, lv))
      end
    end
  end

  function G.placeBuilding(st, b, fresh)
    local d = st.data
    local lv = (d.lv and d.lv[b.id]) or 1
    local old = st.plot.Buildings:FindFirstChild(b.id)
    if old then old:Destroy() end   -- 升级：换成新样子
    local m, body = Models.building(st.plot.Buildings, b, buildingPos(st.plot, b), st.plot.color, fresh and workspace:GetServerTimeNow() or nil, lv)
    local size = Config.SizeAt(b, lv)
    local top = size[2] / 2 + 5   -- 牌子的偏移是从主体零件中心算的：大约在楼顶上方
    if b.income then
      local _, label = Models.sign(body, "", top, 22, 2.8, nil, 220)
      st.signs = st.signs or {}
      st.signs[b.id] = label
      -- 升级提示：挂在楼南边地面上（人走过来就看得见），按住 E
      local at = Instance.new("Attachment")
      at.Position = body.CFrame:PointToObjectSpace(buildingPos(st.plot, b) + V(0, 3, -size[3] / 2 - 3))
      at.Parent = body
      local pp = Instance.new("ProximityPrompt")
      pp.HoldDuration = 0.3
      pp.MaxActivationDistance = 16
      pp.RequiresLineOfSight = false
      pp.Parent = at
      st.upPrompts = st.upPrompts or {}
      st.upPrompts[b.id] = pp
      local id = b.id
      pp.Triggered:Connect(function(who)
        if who == st.pl then G.upgradeBuilding(st, id) end
      end)
      G.refreshSign(st, b.id)
    elseif b.kind == "mil" then
      Models.sign(body, b.name .. " · " .. Models.milDesc(b), top, 22, 2.8, nil, (b.id == "airbase") and 600 or 200)
      -- 走到旁边按 E：客户端打开兵工厂对应的页签（提示上的 Tab 属性）
      local pp = Instance.new("ProximityPrompt")
      pp.ActionText = "打开兵工厂"
      pp.ObjectText = b.name
      pp.HoldDuration = 0
      pp.MaxActivationDistance = 28
      pp.RequiresLineOfSight = false
      pp:SetAttribute("Tab", UNITS[b.units[1]].cat)
      pp.Parent = body
    elseif b.kind == "hq" then
      local _, label = Models.sign(body, "", top + 5, 24, 2.8, Color3.fromRGB(255, 220, 120), 240)
      st.hqLabel = label
      local pp = Instance.new("ProximityPrompt")
      pp.ActionText = "升级指挥部"
      pp.ObjectText = ""
      pp.HoldDuration = 0.4
      pp.MaxActivationDistance = 28
      pp.RequiresLineOfSight = false
      pp.Parent = body
      st.hqPrompt = pp
      pp.Triggered:Connect(function(who)
        if who == st.pl then G.upgradeHQ(st) end
      end)
    elseif b.kind == "power" then
      Models.sign(body, "发电厂 · 工厂收入 ×" .. Config.PowerBoost, top + 2, 20, 2.8, nil, 200)
    elseif b.kind == "radar" then
      Models.sign(body, "雷达站 · 支援技能冷却 -" .. math.floor((1 - Config.RadarCD) * 100 + 0.5) .. "%", top + 2, 22, 2.8, nil, 220)
    elseif b.kind == "silo" then
      Models.sign(body, "导弹发射井 · 支援技能「巡航导弹」", top + 4, 24, 2.8, nil, 220)
    end
    if fresh then G.fx({ k = "build", p = buildingPos(st.plot, b), s = math.max(b.size[1], b.size[3]) }) end
    return m
  end

  -- 重生开放的新区域（基地南边三块）：开放了的铺好地面、立区域名；没开放的围着铁丝网、立牌子；fresh：刚开放的那块（放个烟花）
  function G.areaRefresh(st, fresh)
    local f = st.plot.Areas
    if not f then return end
    f:ClearAllChildren()
    local rb = st.data.rebirth or 0
    for _, a in ipairs(Config.Areas) do
      Models.area(f, st.plot.origin, a, rb >= a.n, st.plot.color)
      if fresh == a.n then G.fx({ k = "build", p = st.plot.origin + V((a.x0 + a.x1) / 2, 1, (a.z0 + a.z1) / 2), s = 120 }) end
    end
  end

  -- 按钮颜色：买得起绿、买不起红（只在变的时候改，省得每秒同步）
  local function padColors(st)
    for _, p in pairs(st.pads) do
      local ok = st.data.cash >= p.b.price
      if p.ok ~= ok then
        p.ok = ok
        p.pad.Color = ok and GREEN or RED
      end
    end
  end

  -- 重新摆购买按钮：没盖、前置已经盖好的建筑才有
  function G.refreshPads(st)
    st.plot.Pads:ClearAllChildren()
    st.pads = {}
    local d = st.data
    for _, b in ipairs(Config.Buildings) do
      if not d.owned[b.id] and (not b.req or d.owned[b.req]) and Config.AreaOpen(b, d.rebirth) then
        local _, pad, pp = Models.pad(st.plot.Pads, b, buildingPos(st.plot, b), st.plot.color)
        local id = b.id
        pad.Touched:Connect(function(hit)
          local who = Players:GetPlayerFromCharacter(hit.Parent)
          if who == st.pl then G.tryBuild(st, id, true) end
        end)
        pp.Triggered:Connect(function(who)
          if who == st.pl then G.tryBuild(st, id, false) end
        end)
        st.pads[id] = { pad = pad, b = b }
        if id == "oil1" and not st.indHint then   -- 工业区在西墙外，第一次解锁时说一声
          st.indHint = true
          G.toast(st, "西边工业区开放了：从基地西墙南段的「工业区大门」出去，先盖油井 A；跟着地上的箭头走", "info")
        end
        if id == "airbase" and not st.airHint then   -- 空军基地盖在围墙外面，按钮在围墙里靠右
          st.airHint = true
          G.toast(st, "空军基地解锁了：购买按钮在基地里靠空军那边的围墙旁（面朝战场时的左手边），盖好后跑道在围墙外面；跟着地上的箭头走", "info")
        end
      end
    end
    padColors(st)
  end

  function G.tryBuild(st, id, touch)
    if not st.ready then return end
    local b = BDEF[id]
    local d = st.data
    if not b or d.owned[id] or (b.req and not d.owned[b.req]) or not Config.AreaOpen(b, d.rebirth) then return end
    if touch then   -- 踩着按钮不停触发：隔一会儿才算一次
      local now = os.clock()
      if now - (st.padT[id] or 0) < 1.2 then return end
      st.padT[id] = now
    end
    if d.cash < b.price then
      G.toast(st, "钱不够：" .. b.name .. " 还差 $" .. Config.Fmt(b.price - d.cash), "bad")
      return
    end
    d.cash = d.cash - b.price
    d.owned[id] = true
    if b.kind == "hq" then d.hq = 1 end
    G.placeBuilding(st, b, true)
    G.recalc(st)
    G.refreshPads(st)
    G.progress(st, "build", 1)
    local extra = ""
    if b.income then extra = "，收入 +" .. Config.Fmt(b.income) .. "/秒" end
    G.toast(st, "建成：" .. b.name .. extra, "good")
    if b.kind == "mil" then
      local names = {}
      for _, u in ipairs(b.units) do table.insert(names, UNITS[u].name) end
      G.toast(st, "可以生产" .. table.concat(names, "、") .. "了：右边「兵工厂」，或者走到建筑旁按 E", "info")
    elseif b.kind == "hq" then
      G.toast(st, "部队上限 " .. G.capOf(d) .. "；以后可以升级指挥部带更多兵", "info")
    elseif b.kind == "radar" then
      G.toast(st, "打仗时所有支援技能冷却快 " .. math.floor((1 - Config.RadarCD) * 100 + 0.5) .. "%", "info")
    elseif b.kind == "silo" then
      G.toast(st, "打仗时多一个支援技能「巡航导弹」（电脑按 M）：导弹从这口井里升空，炸平一大片", "info")
    end
    G.push(st)
  end

  -- 建筑升级：有收入的楼，一级一级升到 Config.Upgrade.max（收入涨、楼变样、从地里重新升起来）
  function G.upgradeBuilding(st, id)
    if not st.ready or type(id) ~= "string" then return end
    local d = st.data
    local b = BDEF[id]
    if not b or not b.income or not d.owned[id] then return end
    local lv = d.lv[id] or 1
    if lv >= Config.Upgrade.max then
      G.toast(st, b.name .. " 已经满级了", "info")
      return
    end
    local price = Config.UpgradeCost(b, lv)
    if d.cash < price then
      G.toast(st, "升级" .. b.name .. "还差 $" .. Config.Fmt(price - d.cash), "bad")
      return
    end
    local mul = 1 + Config.Rebirth.income * (d.rebirth or 0)
    local before = Config.BuildingIncome(b, d.owned, lv)
    d.cash = d.cash - price
    d.lv[id] = lv + 1
    G.placeBuilding(st, b, true)
    G.recalc(st)
    G.progress(st, "upgrade", 1)
    G.toast(st, b.name .. " 升到 Lv." .. (lv + 1) .. "：收入 +" .. Config.Fmt((Config.BuildingIncome(b, d.owned, lv + 1) - before) * mul) .. "/秒", "good")
    G.push(st)
  end

  function G.upgradeHQ(st)
    if not st.ready then return end
    local d = st.data
    if not d.owned.hq then
      G.toast(st, "先盖指挥部", "bad")
      return
    end
    if d.hq >= #BDEF.hq.cap then
      G.toast(st, "指挥部已经满级", "info")
      return
    end
    local price = BDEF.hq.up[d.hq]
    if d.cash < price then
      G.toast(st, "升级指挥部还差 $" .. Config.Fmt(price - d.cash), "bad")
      return
    end
    d.cash = d.cash - price
    d.hq = d.hq + 1
    G.recalc(st)
    G.fx({ k = "build", p = buildingPos(st.plot, BDEF.hq), s = 30 })
    G.toast(st, "指挥部升到 " .. d.hq .. " 级：部队上限 " .. G.capOf(d), "good")
    G.push(st)
  end

  function G.upgradeTech(st)
    if not st.ready then return end
    local d = st.data
    if d.tech >= Config.Tech.max then
      G.toast(st, "军工科技已经满级", "info")
      return
    end
    local price = Config.TechCost(d.tech)
    if d.cash < price then
      G.toast(st, "升级军工科技还差 $" .. Config.Fmt(price - d.cash), "bad")
      return
    end
    d.cash = d.cash - price
    d.tech = d.tech + 1
    G.progress(st, "tech", 1)
    G.toast(st, "军工科技升到 " .. d.tech .. " 级：全军血量、伤害 +" .. math.floor(d.tech * Config.Tech.bonus * 100 + 0.5) .. "%", "good")
    G.push(st)
  end

  -- 能不能重生：还没重生满 max 次，开放了的区域里的建筑全部盖好
  function G.canRebirth(d)
    if (d.rebirth or 0) >= Config.Rebirth.max then return false end
    local built, total = Config.RebirthProgress(d.owned, d.rebirth)
    return built >= total
  end

  -- 重生：建筑、现金、关卡、部队、科技清零；武器、经验、军衔、积分留着；换永久加成，再开放一块新区域
  function G.rebirth(st)
    if not st.ready or st.battle then return end
    local d = st.data
    if (d.rebirth or 0) >= Config.Rebirth.max then
      G.toast(st, "已经重生满 " .. Config.Rebirth.max .. " 次了", "info")
      return
    end
    if not G.canRebirth(d) then
      local built, total = Config.RebirthProgress(d.owned, d.rebirth)
      G.toast(st, "基地里的建筑全部盖好才能重生（现在 " .. built .. " / " .. total .. " 栋）", "bad")
      return
    end
    d.rebirth = d.rebirth + 1
    d.cash = Config.StartCash
    d.owned = {}
    d.lv = {}
    st.signs, st.upPrompts = {}, {}
    d.hq = 0
    d.tech = 0
    d.level = 1
    for _, u in pairs(st.units) do
      if u.model then u.model:Destroy() end
    end
    st.units = {}
    st.hqLabel, st.hqPrompt = nil, nil
    st.plot.Buildings:ClearAllChildren()
    G.recalc(st)
    G.refreshPads(st)
    G.makeEnemy(st)
    G.addXP(st, 200)
    G.fx({ k = "build", p = st.plot.origin + V(0, 1, 0), s = 120 })
    G.toast(st, "重生第 " .. d.rebirth .. " 次！收入永久 +" .. math.floor(Config.Rebirth.income * 100 * d.rebirth) .. "%，部队永久 +" .. math.floor(Config.Rebirth.power * 100 * d.rebirth) .. "%", "good")
    local area = Config.Areas[d.rebirth]
    if area then
      G.toast(st, "新区域「" .. area.name .. "」开放了：从基地后墙中间的南门出去（" .. area.desc .. "）", "good")
      if G.areaRefresh then G.areaRefresh(st, area.n) end
    end
    G.rankTag(st)
    G.push(st)
    task.spawn(G.save, st)
  end

  -- 经验、军衔；头顶的名牌（[军衔] 名字 ★重生次数）
  function G.rankTag(st)
    local char = st.pl.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end
    local tag = head:FindFirstChild("RankTag")
    if not tag then
      tag = Instance.new("BillboardGui")
      tag.Name = "RankTag"
      tag.Size = UDim2.new(10, 0, 1.4, 0)
      tag.StudsOffsetWorldSpace = V(0, 2.6, 0)
      tag.MaxDistance = 160
      tag.LightInfluence = 0
      tag.AlwaysOnTop = false
      local t = Instance.new("TextLabel")
      t.Name = "T"
      t.Size = UDim2.fromScale(1, 1)
      t.BackgroundTransparency = 1
      t.Font = Enum.Font.GothamBold
      t.TextScaled = true
      t.RichText = true
      t.TextColor3 = Color3.new(1, 1, 1)
      t.TextStrokeTransparency = 0.3
      t.Parent = tag
      tag.Parent = head
    end
    local rank = Config.RankOf(st.data.xp)
    local stars = (st.data.rebirth > 0) and ("  <font color=\"#FFD24A\">★" .. st.data.rebirth .. "</font>") or ""
    tag.T.Text = "<font color=\"#FFD86A\">[" .. rank .. "]</font> " .. st.pl.DisplayName .. stars
  end

  function G.addXP(st, n)
    local d = st.data
    local old = Config.RankOf(d.xp)
    d.xp = d.xp + math.floor(n)
    local new = Config.RankOf(d.xp)
    if new ~= old then
      G.toast(st, "晋升：" .. new .. "！", "good")
      G.rankTag(st)
      if st.ls and st.ls.rank then st.ls.rank.Value = new end
    end
  end

  -- 每日任务：今天的三个（按日期定）；kind 对上的加进度
  local function missionsFresh(st)
    local d = st.data
    local day = Config.Day(os.time())
    if d.missions.day ~= day or #d.missions.list ~= 3 then
      d.missions = { day = day, list = {} }
      for _, m in ipairs(Config.MissionsOf(day)) do table.insert(d.missions.list, { id = m.id, prog = 0, claimed = false }) end
    end
  end
  G.missionsFresh = missionsFresh
  local MBYID = {}
  for _, m in ipairs(Config.Missions) do MBYID[m.id] = m end
  G.missionDef = MBYID
  function G.progress(st, kind, n)
    if not st.data then return end
    missionsFresh(st)
    local changed = false
    for _, m in ipairs(st.data.missions.list) do
      local def = MBYID[m.id]
      if def and def.kind == kind and not m.claimed and m.prog < def.goal then
        m.prog = math.min(def.goal, m.prog + (n or 1))
        changed = true
        if m.prog >= def.goal then G.toast(st, "任务完成：" .. def.text .. "（到「任务」里领奖励）", "good") end
      end
    end
    if changed then st.dirty = true end
  end
  function G.missionReward(st)
    return math.max(400, math.floor(st.income * Config.MissionRewardSec))
  end
  function G.claimMission(st, i)
    if type(i) ~= "number" then return end
    missionsFresh(st)
    local m = st.data.missions.list[i]
    local def = m and MBYID[m.id]
    if not def or m.claimed or m.prog < def.goal then return end
    m.claimed = true
    local r = G.missionReward(st)
    st.data.cash = st.data.cash + r
    G.addXP(st, 40)
    G.toast(st, "领到任务奖励 $" .. Config.Fmt(r), "good")
    G.push(st)
  end

  -- 每日奖励：连续登录天数越多越多（最多叠到 7 天）
  function G.dailyInfo(st)
    local d = st.data
    local day = Config.Day(os.time())
    if d.daily.day == day then return false, 0, d.daily.streak end
    local streak = (d.daily.day == day - 1) and math.min(Config.Daily.max, d.daily.streak + 1) or 1
    local amount = math.floor(math.max(Config.Daily.base, st.income * Config.Daily.incomeSec) * (1 + Config.Daily.step * (streak - 1)))
    return true, amount, streak
  end
  function G.claimDaily(st)
    local ok, amount, streak = G.dailyInfo(st)
    if not ok then return end
    local d = st.data
    d.daily.day = Config.Day(os.time())
    d.daily.streak = streak
    d.cash = d.cash + amount
    G.toast(st, "每日奖励（连续第 " .. streak .. " 天）：$" .. Config.Fmt(amount), "good")
    G.push(st)
  end

  function G.buyWeapon(st, id)
    local w = Config.Weapons[id]
    if not w or not st.ready then return end
    local d = st.data
    if d.weapons[id] then return end
    if d.cash < w.price then
      G.toast(st, "买" .. w.name .. "还差 $" .. Config.Fmt(w.price - d.cash), "bad")
      return
    end
    d.cash = d.cash - w.price
    d.weapons[id] = true
    G.giveTools(st)
    G.toast(st, "买到" .. w.name .. "：在下面的物品栏里（按数字键切换）", "good")
    G.push(st)
  end

  -- 每秒：收入、按钮颜色
  function G.econTick(st)
    st.data.cash = st.data.cash + st.income
    padColors(st)
  end

  -- 进服：盖好已有的建筑、摆按钮、今天的任务
  function G.econSetup(st)
    if G.areaRefresh then G.areaRefresh(st) end
    for _, b in ipairs(Config.Buildings) do
      if st.data.owned[b.id] then G.placeBuilding(st, b, false) end
    end
    G.recalc(st)
    G.refreshPads(st)
    missionsFresh(st)
  end
end

return Economy
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000A">
<Properties>
<string name="Name">Match</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：真人对战（排位）
--   服内快速匹配：同一个服务器里两个人都在排队，直接在本服的竞技场开打；
--   跨服匹配：排队的人写进 MemoryStore 的有序映射（每 10 秒刷新，60 秒过期），每个服务器每 3 秒看一遍：
--     积分差在窗口内（等得越久窗口越大）、在别的服务器、还没被认领的，userId 小的一方发起——先认领自己、再认领对方（UpdateAsync，谁先改到算谁的），
--     预留一个对战服务器（ReserveServer），把访问码写进对方的记录、再用 MessagingService 通知对方的服务器，两边各自存档后传送过去；
--   对战服务器（预留服务器：PrivateServerId 不空、PrivateServerOwnerId 为 0）：两个人都到了 5 秒后自动开打，打完记对战积分，8 秒后传送回普通服务器；
--     对手 75 秒还没来就把先到的人送回去（积分不变）。
-- 所有 MemoryStore / MessagingService / TeleportService 调用都包在 pcall 里（Studio 里传送不了：服内匹配照样能用）
local Players = game:GetService("Players")
local MSS = game:GetService("MemoryStoreService")
local MS = game:GetService("MessagingService")
local TS = game:GetService("TeleportService")

local Match = {}

function Match.init(G)
  local Config = G.Config
  local MC = Config.Match
  local TOPIC = "mt_match_v1"
  local inMatch = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
  G.matchServer = inMatch

  local map = nil
  do
    local ok, res = pcall(function() return MSS:GetSortedMap("mt_match_v1") end)
    if ok then map = res else warn("[军事大亨] MemoryStore 不可用，只能服内匹配：" .. tostring(res)) end
  end

  local queue = {}   -- [st] = { t0 = 开始排队的时刻, key = "u123", entryT = 上次写记录的时刻 }
  G.matchQueue = queue

  local function keyOf(uid)
    return "u" .. tostring(uid)
  end
  local function entryOf(st)
    return { u = st.pl.UserId, r = st.data.pvp, n = st.pl.DisplayName, job = game.JobId, t = os.time() }
  end
  local function windowOf(q)
    return math.min(MC.maxWindow, MC.window + MC.widen * (os.clock() - q.t0))
  end
  function G.matchInfo(st)
    local q = queue[st]
    if not q then return nil end
    return { since = math.floor(os.clock() - q.t0), window = math.floor(windowOf(q)) }
  end

  local function canQueue(st)
    return G.states[st.pl] == st and st.ready and not st.battle and not st.busy and not st.teleporting and G.count(st) > 0
  end

  -- 写 / 刷新自己的排队记录（被别人认领了就不动它）
  local function publish(st, q)
    if not map then return end
    local ok, err = pcall(function()
      map:UpdateAsync(q.key, function(old)
        if type(old) == "table" and old.claimed then return nil end
        return entryOf(st)
      end, MC.expire)
    end)
    if ok then q.entryT = os.clock() else warn("[军事大亨] 写排队记录失败：" .. tostring(err)) end
  end
  local function release(key, by)
    if not map then return end
    pcall(function()
      map:UpdateAsync(key, function(old)
        if type(old) == "table" and old.claimed == by then
          old.claimed, old.code = nil, nil
          return old
        end
        return nil
      end, MC.expire)
    end)
  end
  local function drop(key)
    if map then pcall(function() map:RemoveAsync(key) end) end
  end

  -- 传送到对战服务器（先存档：对战服务器读的就是这份）
  local function go(st, code, a, b)
    local q = queue[st]
    queue[st] = nil
    if q then task.spawn(drop, q.key) end
    if G.states[st.pl] ~= st or st.battle then return end
    st.teleporting = true
    G.push(st)
    G.save(st)
    local opts = Instance.new("TeleportOptions")
    opts.ReservedServerAccessCode = code
    opts:SetTeleportData({ mode = "match", a = a, b = b })
    local ok, err = pcall(function() TS:TeleportAsync(game.PlaceId, { st.pl }, opts) end)
    if not ok then
      st.teleporting = false
      G.toast(st, "传送失败：" .. tostring(err), "bad")
      G.push(st)
    end
  end

  -- 发起跨服对战：先认领自己，再认领对方，预留服务器，通知对方，自己传过去
  local function initiate(st, q, v)
    local me = st.pl.UserId
    local ok1, mine = pcall(function()
      return map:UpdateAsync(q.key, function(old)
        if type(old) == "table" and old.claimed then return nil end
        local e = entryOf(st)
        e.claimed = me
        return e
      end, MC.expire)
    end)
    if not ok1 or type(mine) ~= "table" or mine.claimed ~= me then return end
    local okey = keyOf(v.u)
    local ok2, theirs = pcall(function()
      return map:UpdateAsync(okey, function(old)
        if type(old) ~= "table" or old.claimed then return nil end
        old.claimed = me
        return old
      end, MC.expire)
    end)
    if not ok2 or type(theirs) ~= "table" then
      release(q.key, me)
      return
    end
    local ok3, code = pcall(function() return TS:ReserveServer(game.PlaceId) end)
    if not ok3 or type(code) ~= "string" then
      warn("[军事大亨] 预留对战服务器失败：" .. tostring(code))
      release(q.key, me)
      release(okey, me)
      return
    end
    if queue[st] ~= q or not canQueue(st) then   -- 预留的这一会儿玩家取消了 / 开打了：放开对方，让他配别人
      release(okey, me)
      return
    end
    -- 访问码写进对方的记录（消息丢了，对方的服务器下一轮也能自己看到），再发消息
    pcall(function()
      map:UpdateAsync(okey, function(old)
        if type(old) == "table" and old.claimed == me then
          old.code, old.a, old.b = code, me, v.u
          return old
        end
        return nil
      end, MC.expire)
    end)
    pcall(function() MS:PublishAsync(TOPIC, { to = v.u, code = code, a = me, b = v.u, an = st.pl.DisplayName, ar = st.data.pvp }) end)
    G.toast(st, "找到对手：" .. tostring(v.n) .. "（对战积分 " .. tostring(v.r) .. "）！传送到对战服务器……", "good")
    go(st, code, me, v.u)
  end

  -- 服内两个人：直接在本服竞技场打排位
  local function startLocal(a, b)
    queue[a], queue[b] = nil, nil
    task.spawn(drop, keyOf(a.pl.UserId))
    task.spawn(drop, keyOf(b.pl.UserId))
    G.toast(a, "找到对手：" .. b.pl.DisplayName .. "（同一个服务器）！", "good")
    G.toast(b, "找到对手：" .. a.pl.DisplayName .. "（同一个服务器）！", "good")
    if not G.startDuel(a, b, true) then   -- 竞技场都在用：放回队里
      queue[a] = { t0 = os.clock(), key = keyOf(a.pl.UserId), entryT = -100 }
      queue[b] = { t0 = os.clock(), key = keyOf(b.pl.UserId), entryT = -100 }
    end
  end

  local function cycle()
    local ready = {}
    for st in pairs(queue) do
      if canQueue(st) then table.insert(ready, st) end
    end
    table.sort(ready, function(x, y) return queue[x].t0 < queue[y].t0 end)
    -- 1）服内：先到先配，挑积分最接近的
    while #ready >= 2 do
      local a = table.remove(ready, 1)
      local bi, bd = 1, math.huge
      for i, b in ipairs(ready) do
        local d = math.abs(a.data.pvp - b.data.pvp)
        if d < bd then bi, bd = i, d end
      end
      startLocal(a, table.remove(ready, bi))
    end
    -- 2）跨服
    if not map or #ready == 0 then return end
    local ok, items = pcall(function() return map:GetRangeAsync(Enum.SortDirection.Ascending, 100) end)
    if not ok or type(items) ~= "table" then return end
    for _, st in ipairs(ready) do
      local q = queue[st]
      if q and canQueue(st) then
        local mine = nil
        for _, it in ipairs(items) do
          if it.key == q.key then mine = it.value end
        end
        if type(mine) == "table" and mine.claimed and mine.claimed ~= st.pl.UserId then
          if mine.code then go(st, mine.code, mine.a, mine.b) end   -- 别的服务器认领了我（消息没收到）：自己按记录传过去
        else
          if type(mine) ~= "table" or os.clock() - q.entryT > MC.refresh then publish(st, q) end
          local me, win = st.pl.UserId, windowOf(q)
          local best, bd = nil, math.huge
          for _, it in ipairs(items) do
            local v = it.value
            if type(v) == "table" and type(v.u) == "number" and v.u > me and v.job ~= game.JobId and not v.claimed then
              local d = math.abs((tonumber(v.r) or MC.start) - st.data.pvp)
              if d <= win and d < bd then best, bd = v, d end
            end
          end
          if best then initiate(st, q, best) end
        end
      end
    end
  end

  function G.matchJoin(st)
    if inMatch or queue[st] or not st.ready then return end
    if st.battle then
      G.toast(st, "打完这一仗再匹配", "info")
      return
    end
    if G.count(st) == 0 then
      G.toast(st, "还没有部队：先造兵再来对战", "bad")
      return
    end
    queue[st] = { t0 = os.clock(), key = keyOf(st.pl.UserId), entryT = -100 }
    G.toast(st, "开始匹配真人对手：先找同服务器的，再找全服积分差不多的", "info")
    G.push(st)
  end

  -- why：给了就是被动取消（开始打关卡、离开服务器），提示一句原因
  function G.matchCancel(st, why)
    local q = queue[st]
    if not q then return end
    queue[st] = nil
    task.spawn(drop, q.key)
    if why ~= true and G.states[st.pl] == st then
      G.toast(st, why or "取消了匹配", "info")
      G.push(st)
    end
  end

  if not inMatch then
    -- 订阅要等网络回话（Studio 里没发布的游戏可能一直等）：放到后台，别卡住开服
    task.spawn(function()
      local ok, err = pcall(function()
        MS:SubscribeAsync(TOPIC, function(msg)
          local d = type(msg) == "table" and msg.Data
          if type(d) ~= "table" or type(d.to) ~= "number" or type(d.code) ~= "string" then return end
          local pl = Players:GetPlayerByUserId(d.to)
          local st = pl and G.states[pl]
          if not st or not queue[st] then return end
          G.toast(st, "找到对手：" .. tostring(d.an) .. "（对战积分 " .. tostring(d.ar) .. "）！传送到对战服务器……", "good")
          go(st, d.code, d.a, d.b)
        end)
      end)
      if not ok then warn("[军事大亨] MessagingService 不可用（跨服通知收不到，匹配表里的访问码照样能用）：" .. tostring(err)) end
    end)
    task.spawn(function()
      while true do
        task.wait(MC.tick)
        if next(queue) then
          local ok, err = pcall(cycle)
          if not ok then warn("[军事大亨] 匹配出错：" .. tostring(err)) end
        end
      end
    end)
  end

  TS.TeleportInitFailed:Connect(function(pl, _, msg)
    local st = G.states[pl]
    if st and st.teleporting then
      st.teleporting = false
      G.toast(st, "传送失败：" .. tostring(msg), "bad")
      G.push(st)
    end
  end)

  ---------------------------------------------------------------- 对战服务器

  -- 送回普通服务器（随便哪个，进去以后读存档、照样是自己的基地）
  local function sendBack(st)
    if G.states[st.pl] ~= st or st.teleporting then return end
    st.teleporting = true
    G.save(st)
    local ok, err = pcall(function() TS:TeleportAsync(game.PlaceId, { st.pl }) end)
    if not ok then
      st.teleporting = false
      G.toast(st, "传送回去失败（" .. tostring(err) .. "），可以直接退出再进游戏", "bad")
    end
  end
  G.matchSendBack = sendBack

  local M = nil        -- 这一场：{ a, b, t0, started }
  local arrived = {}   -- userId → st
  local function tryStart()
    if not M or M.started then return end
    local sa, sb = arrived[M.a], arrived[M.b]
    if not (sa and sb and G.states[sa.pl] == sa and G.states[sb.pl] == sb) then return end
    M.started = true
    for _, st in ipairs({ sa, sb }) do G.toast(st, "对手到了！" .. MC.countdown .. " 秒后开打（排位对战：赢了涨对战积分，部队不会损失）", "good") end
    task.delay(MC.countdown, function()
      local okA, okB = G.states[sa.pl] == sa, G.states[sb.pl] == sb
      if okA and okB and G.startDuel(sa, sb, true) then return end
      for _, st in ipairs({ sa, sb }) do
        if G.states[st.pl] == st then
          G.toast(st, "对手走了，这一场不算，送你回去", "info")
          sendBack(st)
        end
      end
    end)
  end

  -- 进服读完档以后调：对战服务器里认人、到齐开打；普通服务器什么都不做
  function G.matchArrive(st)
    if not inMatch then return end
    local ok, jd = pcall(function() return st.pl:GetJoinData() end)
    local td = ok and type(jd) == "table" and jd.TeleportData or nil
    if type(td) ~= "table" or td.mode ~= "match" or (td.a ~= st.pl.UserId and td.b ~= st.pl.UserId) then
      G.toast(st, "这是对战服务器，送你回普通服务器", "info")
      task.delay(3, function() sendBack(st) end)
      return
    end
    if M and (td.a ~= M.a or td.b ~= M.b) then   -- 预留服务器只打一场：别的对局的人进错了
      G.toast(st, "这一场不是你的对局，送你回普通服务器", "info")
      task.delay(3, function() sendBack(st) end)
      return
    end
    arrived[st.pl.UserId] = st
    M = M or { a = td.a, b = td.b, t0 = os.clock(), started = false }
    if not M.started then G.toast(st, "进了对战服务器，等对手进场……", "info") end
    tryStart()
  end

  -- 对战打完（Combat 的 finish 调）：对战服务器里过几秒送回去
  function G.onDuelEnd(B)
    if not inMatch or not B.ranked then return end
    task.delay(MC.back, function()
      for _, st in pairs(B.sides or {}) do sendBack(st) end
    end)
  end

  if inMatch then
    task.spawn(function()
      while true do
        task.wait(2)
        if M and not M.started and os.clock() - M.t0 > MC.waitMax then
          M.started = true
          for _, st in pairs(arrived) do
            if G.states[st.pl] == st then
              G.toast(st, "对手没进来，这一场不算，送你回去（积分不变）", "info")
              sendBack(st)
            end
          end
        end
      end
    end)
  end
end

return Match
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000000000000000000000000000B">
<Properties>
<string name="Name">Models</string>
<ProtectedString name="Source"><![CDATA[-- 军事大亨：模型（地图、竞技场、建筑、购买按钮、兵种、武器、排行榜牌子、血条）
-- 兵种：优先用玩家在 Studio 里「导入 3D」进来的原模型（roblox/models/*.glb，名字 = 槽位：soldier、tank、heli、fighter……和 prop_* 道具），
--   没导入就用零件拼的。模型结构都一样：锚定的隐形 Root（原点在车底中心、正前方 −Z），其余零件焊在 Root 上；
--   炮塔、旋翼、尾桨各挂在一个用 Motor6D 接到 Root 的「毂」上（TurretMotor / RotorMotor / TailMotor），客户端转它们的 Transform。
-- 建筑、地面是锚定的静态零件。
local RS = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(RS:WaitForChild("Config"))

local Models = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local MAT = Enum.Material
local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local UP = CFrame.Angles(0, 0, math.pi / 2)   -- Roblox 圆柱的轴在 X 方向，转 90° 立起来

local C = {
  concrete = RGB(168, 168, 162), asphalt = RGB(52, 54, 58), dark = RGB(38, 40, 44), glass = RGB(66, 104, 134),
  olive = RGB(92, 104, 70), oliveDark = RGB(62, 72, 48), sand = RGB(196, 176, 128), metal = RGB(122, 126, 130),
  track = RGB(36, 36, 38), gun = RGB(46, 48, 50), skin = RGB(230, 188, 150), uniform = RGB(86, 96, 64),
  white = RGB(236, 236, 230), red = RGB(200, 50, 45), yellow = RGB(236, 190, 40), brick = RGB(150, 82, 62),
  roof = RGB(70, 72, 76), green = RGB(70, 220, 100), ground = RGB(124, 108, 78),
}
Models.C = C

local function darker(c, k)
  return c:Lerp(Color3.new(0, 0, 0), k or 0.35)
end

-- 静态零件：base 是整体的位置，off 是相对它的偏移（Shape 要在 Size 之前设，球会被改成等边）
local function block(parent, base, size, off, color, mat, shape)
  local p = Instance.new("Part")
  if shape then p.Shape = shape end
  p.Anchored = true
  p.Size = size
  p.CFrame = base * off
  p.Color = color
  p.Material = mat or MAT.SmoothPlastic
  p.TopSurface = Enum.SurfaceType.Smooth
  p.BottomSurface = Enum.SurfaceType.Smooth
  p.Parent = parent
  return p
end
Models.block = block

-- 竖直圆柱：height 高，dia 直径，off 是圆柱中心
local function cyl(parent, base, height, dia, off, color, mat)
  return block(parent, base, V(height, dia, dia), off * UP, color, mat, CYL)
end

-- 客户端播的小动画：零件属性 Anim = "spin"（绕竖轴转，Spd 每秒几圈）/ "blink"（一闪一闪，Spd 每秒几次）
local function anim(p, kind, spd)
  p:SetAttribute("Anim", kind)
  p:SetAttribute("Spd", spd)
  return p
end

-- 不挡人、不挡射线的装饰零件
local function ghostly(p)
  p.CanCollide = false
  p.CanQuery = false
  p.CanTouch = false
  return p
end

-- 头顶的字（大小按格算，离远了跟着变小）
function Models.sign(part, text, height, w, h, color, maxDist)
  local bb = Instance.new("BillboardGui")
  bb.Size = UDim2.new(w or 16, 0, h or 3, 0)
  bb.StudsOffsetWorldSpace = V(0, height, 0)
  bb.LightInfluence = 0
  bb.MaxDistance = maxDist or 220
  bb.Parent = part
  local t = Instance.new("TextLabel")
  t.Size = UDim2.fromScale(1, 1)
  t.BackgroundTransparency = 1
  t.Font = Enum.Font.GothamBold
  t.TextScaled = true
  t.RichText = true
  t.TextColor3 = color or Color3.new(1, 1, 1)
  t.TextStrokeTransparency = 0.35
  t.Text = text
  t.Parent = bb
  return bb, t
end

---------------------------------------------------------------- 地图

local function tree(f, pos, rng)
  local base = CF(pos)
  local h = rng:NextNumber(7, 12)
  cyl(f, base, h, 1.8, CF(0, h / 2, 0), RGB(108, 80, 56), MAT.Wood)
  local d = rng:NextNumber(10, 16)
  local g = RGB(56 + rng:NextInteger(0, 30), 116 + rng:NextInteger(0, 40), 48)
  block(f, base, V(d, d, d), CF(0, h + d * 0.3, 0), g, MAT.Grass, BALL)
  if rng:NextNumber() < 0.5 then
    local d2 = d * 0.7
    block(f, base, V(d2, d2, d2), CF(d * 0.3, h + d * 0.62, d * 0.15), g:Lerp(RGB(255, 255, 255), 0.06), MAT.Grass, BALL)
  end
end

-- 战场（基地前面的，或者竞技场）：地面、部署区、敌军区、沙袋、弹坑；colorA / colorB 是两边区域的颜色
-- 地上一块区域头顶的大字（总是面朝镜头，远处也看得见）
local function zoneLabel(f, base, at, text, color)
  local a = ghostly(block(f, base, V(1, 1, 1), at, C.white))
  a.Transparency = 1
  local bb = Models.sign(a, text, 0, 60, 7, color, 1400)
  bb.AlwaysOnTop = false
  return bb
end

local function battlefield(f, origin, colorA, colorB, rng, labels)
  local base = CF(origin)
  local Fd = Config.Field
  local D, E = Fd.deploy, Fd.enemy
  local field = block(f, base, V(Fd.width, 1, Fd.length), CF(0, 0.5, Fd.center), C.ground, MAT.Ground)
  field.Name = "Field"
  local dz = ghostly(block(f, base, V(Fd.width - 6, 0.1, D[2] - D[1]), CF(0, 1.06, (D[1] + D[2]) / 2), colorA, MAT.SmoothPlastic))
  dz.Name = "DeployZone"
  dz.Transparency = 0.86
  local ez = ghostly(block(f, base, V(Fd.width - 6, 0.1, E[2] - E[1]), CF(0, 1.06, (E[1] + E[2]) / 2), colorB, MAT.SmoothPlastic))
  ez.Name = "EnemyZone"
  ez.Transparency = 0.88
  -- 两个区的四条边：发光的边框
  for _, zone in ipairs({ { D, colorA }, { E, colorB } }) do
    local z0, z1, col = zone[1][1], zone[1][2], zone[2]
    ghostly(block(f, base, V(Fd.width - 6, 0.12, 0.8), CF(0, 1.08, z0), col, MAT.Neon))
    ghostly(block(f, base, V(Fd.width - 6, 0.12, 0.8), CF(0, 1.08, z1), col, MAT.Neon))
    for _, sx in ipairs({ -1, 1 }) do ghostly(block(f, base, V(0.8, 0.12, z1 - z0), CF(sx * (Fd.width / 2 - 3), 1.08, (z0 + z1) / 2), col, MAT.Neon)) end
  end
  if labels then
    zoneLabel(f, base, CF(0, 16, (D[1] + D[2]) / 2), labels[1], colorA:Lerp(Color3.new(1, 1, 1), 0.45))
    zoneLabel(f, base, CF(0, 16, (E[1] + E[2]) / 2), labels[2], RGB(255, 150, 140))
  end
  local z0, z1 = Fd.center - Fd.length / 2, Fd.center + Fd.length / 2
  block(f, base, V(3, 3, Fd.length), CF(-Fd.width / 2 - 1.5, 2.5, Fd.center), C.sand, MAT.Fabric)
  block(f, base, V(3, 3, Fd.length), CF(Fd.width / 2 + 1.5, 2.5, Fd.center), C.sand, MAT.Fabric)
  block(f, base, V(Fd.width + 6, 3, 3), CF(0, 2.5, z1 + 1.5), C.sand, MAT.Fabric)
  for _ = 1, 14 do   -- 弹坑、石头（只是装饰，不挡部队）
    local d = rng:NextNumber(10, 26)
    ghostly(cyl(f, base, 0.1, d, CF(rng:NextNumber(-200, 200), 1.04, rng:NextNumber(D[2] + 30, E[1] - 30)), RGB(92, 80, 60), MAT.Ground))
  end
  for _ = 1, 10 do
    local d = rng:NextNumber(4, 9)
    local side = (rng:NextNumber() < 0.5) and -1 or 1
    ghostly(block(f, base, V(d, d, d), CF(side * rng:NextNumber(190, 245), 1, rng:NextNumber(z0 + 40, z1 - 40)), RGB(120, 118, 112), MAT.Slate, BALL))
  end
  return field
end

-- 一块基地：地面、围墙、出生点、路、战场、树、头顶的名字、排行榜牌子。返回 { field, sign, board }
function Models.plot(f, origin, color, index)
  local base = CF(origin)
  local B = Config.BaseSize
  local hs = B / 2
  local Fd = Config.Field
  local rng = Random.new(index * 97 + 13)

  local S0 = Config.Spawn
  local slab = block(f, base, V(B, 1, B), CF(0, 0.5, 0), RGB(146, 148, 146), MAT.Concrete)
  slab.Name = "Base"
  -- 中轴大道：出生点往北一直通到横路（出生就能顺着它看到大门、战场）
  ghostly(block(f, base, V(22, 0.08, 60 - 14 - (S0.z - 6)), CF(S0.x, 1.04, (60 - 14 + S0.z - 6) / 2), RGB(92, 94, 96), MAT.Asphalt))
  for k = 0, 9 do ghostly(block(f, base, V(0.6, 0.06, 6), CF(S0.x, 1.09, S0.z + 12 + k * 16), C.white, MAT.SmoothPlastic)) end
  -- 部队开出去的通道（深色）：横穿 z = 60，再从中间往前到路上
  ghostly(block(f, base, V(B - 12, 0.08, 28), CF(0, 1.04, 60), RGB(92, 94, 96), MAT.Asphalt))
  ghostly(block(f, base, V(120, 0.08, hs - 60), CF(-10, 1.04, (hs + 60) / 2), RGB(92, 94, 96), MAT.Asphalt))
  -- 围墙、哨塔、大门在 Scenery.base 里
  -- 出生点
  local S = Config.Spawn
  cyl(f, base, 0.3, 12, CF(S.x, 1.15, S.z), color, MAT.SmoothPlastic)
  cyl(f, base, 0.32, 8, CF(S.x, 1.16, S.z), C.white, MAT.SmoothPlastic)
  -- 路（基地和战场之间）
  local fz0 = Fd.center - Fd.length / 2
  local roadZ, roadL = (hs + fz0) / 2, fz0 - hs
  block(f, base, V(B, 1, roadL), CF(0, 0.5, roadZ), C.asphalt, MAT.Asphalt)
  for k = -8, 8 do
    ghostly(block(f, base, V(8, 0.06, 0.8), CF(k * 15, 1.03, roadZ), C.white, MAT.SmoothPlastic))
  end
  local field = battlefield(f, origin, color, RGB(190, 50, 40), rng, { "我方部署区 · 布阵时把部队摆在这里", "敌军区 · 这一关的敌人在这" })
  -- 路牌：出生点北边，牌面朝出生点（面朝战场站着的时候正好看见）
  do
    local at = CF(S.x + 16, 0, S.z + 16)
    cyl(f, base, 9, 0.5, at * CF(0, 1 + 4.5, 0), C.metal, MAT.Metal)
    local board = block(f, base, V(13, 6.2, 0.4), at * CF(0, 1 + 8.6, 0), RGB(28, 70, 40), MAT.SmoothPlastic)
    board.Name = "Signpost"
    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Front
    sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.PixelsPerStud = 24
    sg.LightInfluence = 0
    sg.Parent = board
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Font = Enum.Font.GothamBold
    t.TextScaled = true
    t.TextColor3 = C.white
    t.Text = "↑ 战场、部署区（往前走过马路）\n← 空军基地（左边围墙外）\n踩亮绿色的圆按钮盖楼"
    t.Parent = sg
  end
  -- 树林在 Scenery.nature 里（长在基地之间的山丘上）
  -- 头顶的名字
  local anchor = ghostly(block(f, base, V(1, 1, 1), CF(0, 2, -20), C.white))
  anchor.Transparency = 1
  local _, label = Models.sign(anchor, "空基地", 70, 100, 13, color, 1600)
  -- 排行榜牌子（出生点后面的墙上，朝出生点）
  local board = block(f, base, V(54, 22, 1), CF(0, 14, -hs + 2), RGB(36, 42, 52), MAT.SmoothPlastic)
  board.Name = "Board"
  block(f, base, V(57, 1.4, 1.6), CF(0, 25.7, -hs + 2), RGB(60, 64, 70), MAT.Metal)
  block(f, base, V(57, 1.4, 1.6), CF(0, 2.3, -hs + 2), RGB(60, 64, 70), MAT.Metal)
  for _, sx in ipairs({ -1, 1 }) do block(f, base, V(1.6, 25, 1.6), CF(sx * 28, 13.5, -hs + 2), RGB(60, 64, 70), MAT.Metal) end
  ghostly(block(f, base, V(54, 0.4, 0.5), CF(0, 26.6, -hs + 1.6), color, MAT.Neon))
  local sg = Instance.new("SurfaceGui")
  sg.Face = Enum.NormalId.Back
  sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
  sg.PixelsPerStud = 20
  sg.LightInfluence = 0
  sg.Parent = board
  local cols = {}
  for i, title in ipairs({ "最高关卡", "突袭积分", "对战积分" }) do
    local col = Instance.new("TextLabel")
    col.Name = "Col" .. i
    col.BackgroundTransparency = 1
    col.Position = UDim2.fromScale((i - 1) / 3, 0)
    col.Size = UDim2.fromScale(1 / 3, 1)
    col.Font = Enum.Font.GothamBold
    col.TextScaled = true
    col.TextColor3 = C.white
    col.TextYAlignment = Enum.TextYAlignment.Top
    col.Text = title .. "\n（读取中）"
    col.Parent = sg
    cols[i] = col
  end
  return { field = field, sign = label, board = cols }
end

-- 约战竞技场：只有战场，南北两边的出发区，看台边上一圈旗子
function Models.arena(f, origin, index)
  local rng = Random.new(index * 53 + 991)
  local field = battlefield(f, origin, RGB(60, 140, 230), RGB(230, 70, 60), rng, { "挑战方出发区", "应战方出发区" })
  local Fd = Config.Field
  local base = CF(origin)
  local anchor = ghostly(block(f, base, V(1, 1, 1), CF(0, 2, Fd.center), C.white))
  anchor.Transparency = 1
  Models.sign(anchor, "约战竞技场 " .. index, 90, 120, 15, RGB(255, 220, 120), 2400)
  for k = -4, 4 do
    local z = Fd.center + k * Fd.length / 9
    for _, sx in ipairs({ -1, 1 }) do
      cyl(f, base, 18, 0.5, CF(sx * (Fd.width / 2 + 8), 9, z), C.metal, MAT.Metal)
      block(f, base, V(0.2, 3.5, 6), CF(sx * (Fd.width / 2 + 8), 16, z + 3), (k % 2 == 0) and RGB(60, 140, 230) or RGB(230, 70, 60), MAT.Fabric)
    end
  end
  return { field = field }
end

---------------------------------------------------------------- 建筑

-- 军工建筑能造什么（牌子上写；太多就写前两个加「等 N 种」）
function Models.milDesc(b)
  local names = {}
  for i, u in ipairs(b.units) do
    if i <= 2 then table.insert(names, Config.Units[u].name) end
  end
  local s = "生产" .. table.concat(names, "、")
  if #b.units > 2 then s = s .. "等 " .. #b.units .. " 种" end
  return s
end

local HOUSE = { house1 = RGB(226, 212, 186), house2 = RGB(186, 206, 222), house3 = RGB(222, 192, 180) }

local function slabUnder(m, base, w, d, color, mat)
  block(m, base, V(w + 3, 0.6, d + 3), CF(0, 0.3, 0), color or C.concrete, mat or MAT.Concrete)
end

-- 楼面上的招牌：一块板子 + 发光的字（face 是板子哪一面朝外）
local function facadeSign(m, base, cf, w, h, text, color, face)
  local board = block(m, base, V(w, h, 0.3), cf, RGB(28, 32, 38), MAT.SmoothPlastic)
  board.CastShadow = false
  local sg = Instance.new("SurfaceGui")
  sg.Face = face or Enum.NormalId.Front
  sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
  sg.PixelsPerStud = 30
  sg.LightInfluence = 0
  sg.Parent = board
  local t = Instance.new("TextLabel")
  t.Size = UDim2.fromScale(1, 1)
  t.BackgroundTransparency = 1
  t.Font = Enum.Font.GothamBlack
  t.TextScaled = true
  t.TextColor3 = color or RGB(255, 214, 90)
  t.Text = text
  t.Parent = sg
  return board
end
-- 屋顶的空调外机、通风口
local function roofStuff(m, base, w, d, y, n)
  for i = 1, n do
    local x = (i - (n + 1) / 2) * (w / (n + 1)) + ((i % 2 == 0) and 1.2 or -1.2)
    local z = ((i % 2 == 0) and 1 or -1) * d * 0.22
    block(m, base, V(2.4, 1.4, 1.8), CF(x, y + 0.7, z), RGB(190, 192, 190), MAT.Metal)
    ghostly(cyl(m, base, 0.1, 1.2, CF(x, y + 1.42, z), RGB(60, 60, 62), MAT.Metal))
  end
end

local function flag(m, base, at, color)
  cyl(m, base, 18, 0.4, at * CF(0, 0.6 + 9, 0), C.metal, MAT.Metal)
  block(m, base, V(0.15, 3, 5), at * CF(0, 0.6 + 16.4, 2.6), color, MAT.Fabric)
end

local function house(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, h, d), CF(0, 0.6 + h / 2, 0), HOUSE[b.id] or C.white, MAT.SmoothPlastic)
  for k = 1, math.floor(h / 4) do   -- 每层一圈窗户带
    local y = 0.6 + (k - 1) * 4 + 2.4
    if y + 1 < 0.6 + h then block(m, base, V(w + 0.3, 1.4, d + 0.3), CF(0, y, 0), C.glass, MAT.Glass) end
  end
  block(m, base, V(w + 0.8, 0.7, d + 0.8), CF(0, 0.6 + h + 0.35, 0), C.roof, MAT.Concrete)
  block(m, base, V(w * 0.3, 1.8, d * 0.3), CF(w * 0.2, 0.6 + h + 1.6, d * 0.15), C.metal, MAT.Metal)
  block(m, base, V(3.2, 4.4, 0.6), CF(0, 0.6 + 2.2, -d / 2 - 0.2), C.dark)
  block(m, base, V(w * 0.5, 0.4, 2.4), CF(0, 0.6 + 4.7, -d / 2 - 1.2), C.roof)
  for k = 1, math.floor(h / 4) - 1 do   -- 东边一层一个阳台
    local y = 0.6 + k * 4
    block(m, base, V(2.2, 0.35, d * 0.5), CF(w / 2 + 1.1, y, 0), RGB(200, 200, 196), MAT.Concrete)
    local rail = block(m, base, V(0.2, 1.1, d * 0.5), CF(w / 2 + 2.1, y + 0.7, 0), RGB(150, 190, 210), MAT.Glass)
    rail.Transparency = 0.4
  end
  for _, sx in ipairs({ -1, 1 }) do   -- 四角的竖线条
    for _, sz in ipairs({ -1, 1 }) do block(m, base, V(0.8, h, 0.8), CF(sx * (w / 2 + 0.1), 0.6 + h / 2, sz * (d / 2 + 0.1)), (HOUSE[b.id] or C.white):Lerp(C.dark, 0.25), MAT.SmoothPlastic) end
  end
  local roofY = 0.6 + h + 0.7
  for _, sx in ipairs({ -1, 1 }) do   -- 屋顶水箱（四条腿）
    for _, sz in ipairs({ -1, 1 }) do block(m, base, V(0.3, 2.2, 0.3), CF(-w * 0.22 + sx * 1.3, roofY + 1.1, -d * 0.18 + sz * 1.3), C.metal, MAT.Metal) end
  end
  cyl(m, base, 3, 3.6, CF(-w * 0.22, roofY + 3.7, -d * 0.18), RGB(120, 128, 132), MAT.Metal)
  roofStuff(m, base, w, d, roofY, 2)
  cyl(m, base, 6, 0.2, CF(w * 0.3, roofY + 3, -d * 0.3), C.metal, MAT.Metal)
  block(m, base, V(5, 0.5, 1.6), CF(0, 0.85, -d / 2 - 2.6), RGB(170, 170, 166), MAT.Concrete)
  for _, sx in ipairs({ -1, 1 }) do
    block(m, base, V(2.2, 1, 2.2), CF(sx * 3.6, 1.1, -d / 2 - 1.6), RGB(130, 110, 90), MAT.Brick)
    ghostly(block(m, base, V(1.8, 1.4, 1.8), CF(sx * 3.6, 2, -d / 2 - 1.6), RGB(70, 130, 60), MAT.Grass, BALL))
  end
  return body
end

local function factory(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local hh = h * 0.62
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, hh, d), CF(0, 0.6 + hh / 2, 0), C.brick, MAT.Brick)
  block(m, base, V(w + 0.6, 0.6, d + 0.6), CF(0, 0.6 + hh + 0.3, 0), C.roof, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    block(m, base, V(w * 0.8, 1.6, 2.4), CF(0, 0.6 + hh + 1.4, s * d * 0.22), C.glass, MAT.Glass)
  end
  block(m, base, V(w * 0.38, hh * 0.62, 0.6), CF(-w * 0.15, 0.6 + hh * 0.31, -d / 2 - 0.15), C.dark, MAT.DiamondPlate)
  local n = (b.id == "factory3") and 2 or 1
  for k = 1, n do   -- 烟囱冒烟
    local cx = w / 2 - 3 - (k - 1) * 5
    local top = h + 4
    cyl(m, base, top, 2.6, CF(cx, 0.6 + top / 2, d / 2 - 3), C.brick, MAT.Brick)
    local tip = ghostly(block(m, base, V(1.5, 1, 1.5), CF(cx, 0.6 + top + 0.6, d / 2 - 3), C.dark))
    tip.Transparency = 1
    local s = Instance.new("Smoke")
    s.Color = RGB(96, 96, 98)
    s.Opacity = 0.22
    s.RiseVelocity = 6
    s.Size = 3
    s.Parent = tip
  end
  block(m, base, V(3, 3, 3), CF(-w / 2 + 2, 0.6 + 1.5, -d / 2 - 3), C.olive, MAT.WoodPlanks)
  for k = 0, 3 do   -- 卷帘门上方的黄黑警示条
    block(m, base, V(w * 0.38 / 4, 0.5, 0.3), CF(-w * 0.15 - w * 0.19 + (k + 0.5) * w * 0.095, 0.6 + hh * 0.62 + 0.3, -d / 2 - 0.5), (k % 2 == 0) and C.yellow or C.dark)
  end
  for _, y in ipairs({ hh * 0.55, hh * 0.75 }) do   -- 东墙上的两根管道
    cyl(m, base, d * 0.9, 0.7, CF(w / 2 + 0.5, 0.6 + y, 0) * CFrame.Angles(math.pi / 2, 0, 0), RGB(150, 152, 150), MAT.Metal)
  end
  block(m, base, V(w * 0.3, 1.2, 4), CF(w * 0.25, 0.6 + 0.6, -d / 2 - 2), RGB(120, 120, 116), MAT.Concrete)   -- 装卸台
  for i = 1, 3 do block(m, base, V(1.8, 1.6, 1.8), CF(w * 0.25 + (i - 2) * 2.1, 0.6 + 2.0, -d / 2 - 1.8), RGB(150, 116, 74), MAT.WoodPlanks) end
  roofStuff(m, base, w, d, 0.6 + hh + 0.6, 3)
  facadeSign(m, base, CF(-w * 0.15, 0.6 + hh * 0.82, -d / 2 - 0.35), w * 0.36, 1.6, b.name, RGB(255, 214, 90))
  return body
end

local function power(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  slabUnder(m, base, w, d)
  local tx = -w / 2 + 6.5
  local body = cyl(m, base, h, 12, CF(tx, 0.6 + h / 2, 0), RGB(205, 205, 200), MAT.Concrete)   -- 冷却塔
  cyl(m, base, 1, 12.6, CF(tx, 0.6 + h - 0.5, 0), RGB(176, 176, 172), MAT.Concrete)
  local tip = ghostly(block(m, base, V(6, 1, 6), CF(tx, 0.6 + h + 1, 0), C.white))
  tip.Transparency = 1
  local s = Instance.new("Smoke")
  s.Color = RGB(240, 240, 240)
  s.Opacity = 0.3
  s.RiseVelocity = 8
  s.Size = 6
  s.Parent = tip
  block(m, base, V(8, 8, d - 2), CF(w / 2 - 4.5, 0.6 + 4, 0), RGB(110, 120, 130), MAT.Metal)
  for k = -1, 1 do block(m, base, V(2, 2.4, 2), CF(w / 2 - 4.5, 0.6 + 9.2, k * 4), C.yellow, MAT.Metal) end
  anim(block(m, base, V(0.8, 0.8, 0.8), CF(w / 2 - 4.5, 0.6 + 11, 0), RGB(255, 220, 90), MAT.Neon), "blink", 2)
  for _, sz in ipairs({ -1, 1 }) do   -- 变电站围栏
    block(m, base, V(10, 2.4, 0.15), CF(w / 2 - 4.5, 0.6 + 1.2, sz * (d / 2 - 0.5)), RGB(120, 124, 126), MAT.DiamondPlate)
  end
  for _, px in ipairs({ -w / 2 - 6, w / 2 + 6 }) do   -- 高压电塔（两根斜腿 + 横担）
    local c = CF(px, 0, -d / 2 - 4)
    for _, s2 in ipairs({ -1, 1 }) do block(m, base, V(0.5, 20, 0.5), c * CF(s2 * 1.6, 0.6 + 10, 0) * CFrame.Angles(0, 0, s2 * -0.08), RGB(150, 150, 154), MAT.Metal) end
    block(m, base, V(8, 0.5, 0.5), c * CF(0, 0.6 + 18, 0), RGB(150, 150, 154), MAT.Metal)
    block(m, base, V(5, 0.4, 0.4), c * CF(0, 0.6 + 14, 0), RGB(150, 150, 154), MAT.Metal)
  end
  for _, dz in ipairs({ -0.4, 0, 0.4 }) do   -- 电线
    ghostly(block(m, base, V(w + 12, 0.1, 0.1), CF(0, 0.6 + 17.8, -d / 2 - 4 + dz), RGB(40, 40, 40), MAT.Metal))
  end
  facadeSign(m, base, CF(w / 2 - 4.5, 0.6 + 5, -d / 2 + 0.85), 7, 1.4, "发电厂", RGB(255, 230, 120))
  return body
end

local function bank(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  block(m, base, V(w + 3, 1.2, d + 3), CF(0, 0.6, 0), RGB(220, 218, 210), MAT.Marble)
  local hb = h * 0.72
  local body = block(m, base, V(w - 2, hb, d - 5), CF(0, 1.2 + hb / 2, 2), RGB(236, 233, 224), MAT.Marble)
  for k = 0, 3 do
    cyl(m, base, hb, 1.6, CF(-w / 2 + 2.5 + k * (w - 5) / 3, 1.2 + hb / 2, -d / 2 + 2), RGB(242, 240, 232), MAT.Marble)
  end
  block(m, base, V(w, 2.4, d), CF(0, 1.2 + hb + 1.2, 0), RGB(225, 222, 212), MAT.Marble)
  block(m, base, V(w * 0.6, 3, d * 0.6), CF(0, 1.2 + hb + 3.9, 0), RGB(212, 175, 55), MAT.Metal)
  block(m, base, V(4, 6, 0.5), CF(0, 1.2 + 3, -d / 2 + 4.6), C.dark)
  for k = 0, 2 do block(m, base, V(w * 0.6 - k * 1.2, 0.4, 1.4), CF(0, 0.2 + k * 0.4, -d / 2 - 1.8 + k * 0.7), RGB(226, 224, 216), MAT.Marble) end
  facadeSign(m, base, CF(0, 1.2 + hb + 1.2, -d / 2 - 0.2), w * 0.55, 2, "银  行", RGB(255, 210, 90))
  return body
end

-- 兵营里、操场上的小人（不挡人、不挡射线）：cf 是脚底中心，面朝 −Z；pose = stand 站 / sit 坐（cf 在椅子前沿的地面上）/
--   lie 躺（cf 是床面中心，头朝 −Z）/ plank 俯卧撑（脚在 cf，头朝 −Z）。nod 给了的话，整个人绕脚尖一起点头（客户端 Anim = "nod"）
local function figure(m, base, cf, pose, nod)
  local U, P, S, H = C.uniform, darker(C.uniform, 0.25), C.skin, C.oliveDark
  local parts = {}
  local function add(size, off, color)
    local p = ghostly(block(m, base, size, cf * off, color, MAT.SmoothPlastic))
    table.insert(parts, p)
    return p
  end
  if pose == "stand" then
    add(V(1.0, 2.1, 0.6), CF(0, 1.05, 0), P)
    add(V(1.3, 1.8, 0.75), CF(0, 3.0, 0), U)
    add(V(0.4, 1.7, 0.45), CF(-0.86, 2.95, 0), U)
    add(V(0.4, 1.7, 0.45), CF(0.86, 2.95, 0), U)
    add(V(0.8, 0.8, 0.8), CF(0, 4.3, 0), S)
    add(V(1.0, 0.4, 1.0), CF(0, 4.8, 0), H)
  elseif pose == "sit" then
    add(V(1.0, 1.9, 0.5), CF(0, 0.95, -0.25), P)          -- 小腿
    add(V(1.0, 0.5, 1.7), CF(0, 2.05, 0.6), P)            -- 大腿（坐在 1.8 高的椅面上）
    add(V(1.3, 1.8, 0.75), CF(0, 3.2, 1.3), U)
    add(V(0.4, 0.45, 1.5), CF(-0.86, 3.05, 0.6), U)       -- 胳膊往前搭在桌上
    add(V(0.4, 0.45, 1.5), CF(0.86, 3.05, 0.6), U)
    add(V(0.8, 0.8, 0.8), CF(0, 4.5, 1.25), S)
    add(V(1.0, 0.36, 1.0), CF(0, 4.98, 1.25), H)
  elseif pose == "lie" then
    add(V(1.0, 0.6, 2.2), CF(0, 0.3, 1.1), P)
    add(V(1.3, 0.75, 1.8), CF(0, 0.38, -0.9), U)
    add(V(0.8, 0.8, 0.8), CF(0, 0.42, -2.3), S)
  elseif pose == "plank" then
    local a = math.rad(17)
    local ax = CF(0, 0.35, 0) * CFrame.Angles(a, 0, 0)    -- 身子从脚尖斜着往前上方
    add(V(1.0, 0.6, 2.3), ax * CF(0, 0, -1.15), P)
    add(V(1.3, 0.75, 1.9), ax * CF(0, 0, -3.2), U)
    add(V(0.8, 0.8, 0.8), ax * CF(0, 0.1, -4.6), S)
    local sh = (ax * CF(0, 0, -3.9)).Position
    add(V(0.4, sh.Y, 0.45), CF(-0.86, sh.Y / 2, sh.Z), U)
    add(V(0.4, sh.Y, 0.45), CF(0.86, sh.Y / 2, sh.Z), U)
  end
  if nod then
    local w = base * cf
    for _, p in ipairs(parts) do
      p:SetAttribute("Anim", "nod")
      p:SetAttribute("Piv", (w * CF(0, 0.3, 0)).Position)
      p:SetAttribute("Ax", w.RightVector)
      p:SetAttribute("Amp", nod.amp or 6)
      p:SetAttribute("Spd", nod.spd or 0.6)
      p:SetAttribute("Ph", nod.ph or 0)
    end
  end
  return parts
end

-- 一面墙：沿 X（along = "x"）或 Z 的一段，中心 (cx, cz)、长 L、厚 T；底下一段实墙（门洞挖掉）、中间一圈高窗（窗洞装玻璃、窗台）、顶上一段实墙
--   holes：门洞在这面墙上的区间（沿墙方向的坐标）；wins：窗户中心位置（沿墙方向）；y0 地面高、h 墙高；out = 墙外侧的法线方向（±1）
local function wallRun(m, base, along, cx, cz, L, T, y0, h, holes, wins, out, color)
  local yA, yB = y0 + 7.0, y0 + 10.0   -- 下段顶、窗带顶
  local function seg(a, b, ylo, yhi, col, mat)
    if b - a < 0.05 then return end
    local c = (a + b) / 2
    local size = (along == "x") and V(b - a, yhi - ylo, T) or V(T, yhi - ylo, b - a)
    local off = (along == "x") and CF(cx + c, (ylo + yhi) / 2, cz) or CF(cx, (ylo + yhi) / 2, cz + c)
    return block(m, base, size, off, col or color, mat or MAT.Concrete)
  end
  local function solids(a, b, cut)
    local out2, x = {}, a
    table.sort(cut, function(p, q) return p[1] < q[1] end)
    for _, hseg in ipairs(cut) do
      if hseg[1] > x then table.insert(out2, { x, hseg[1] }) end
      x = math.max(x, hseg[2])
    end
    if x < b then table.insert(out2, { x, b }) end
    return out2
  end
  for _, s in ipairs(solids(-L / 2, L / 2, holes or {})) do seg(s[1], s[2], y0, yA) end
  local wcut = {}
  for _, wx in ipairs(wins or {}) do table.insert(wcut, { wx - 1.9, wx + 1.9 }) end
  for _, s in ipairs(solids(-L / 2, L / 2, wcut)) do seg(s[1], s[2], yA, yB) end
  seg(-L / 2, L / 2, yB, y0 + h)
  for _, wx in ipairs(wins or {}) do
    local g = seg(wx - 1.9, wx + 1.9, yA, yB, C.glass, MAT.Glass)
    g.Size = (along == "x") and V(3.8, 3.0, 0.2) or V(0.2, 3.0, 3.8)
    g.Transparency = 0.45
    local sill = (along == "x") and V(4.4, 0.3, T + 0.8) or V(T + 0.8, 0.3, 4.4)
    local so = (along == "x") and CF(cx + wx, yA - 0.15, cz + out * 0.2) or CF(cx + out * 0.2, yA - 0.15, cz + wx)
    block(m, base, sill, so, RGB(196, 196, 186), MAT.Concrete)
  end
end

-- 兵营：能走进去。前面（+Z）正中一扇门，四面高窗；左边宿舍（双层床、床头箱、储物柜、有人在睡觉），右边作战室（作战桌和地图、椅子、
--   枪架、公告栏、电台、饮水机）；天花板三条日光灯；门口操场上一排人做俯卧撑、教官看着，旁边单杠和轮胎
local function barracks(m, base, b, team)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local T, y0 = 0.8, 0.6
  local WALL, INNER, DADO = RGB(116, 126, 96), RGB(212, 208, 190), RGB(94, 106, 78)
  local METAL, WOOD = RGB(70, 82, 64), RGB(132, 98, 64)
  slabUnder(m, base, w, d)
  -- 主体：看不见、不挡人的整块（挂牌子、提示、升起动画的脚手架用它的大小）
  local body = ghostly(block(m, base, V(w, h, d), CF(0, y0 + h / 2, 0), WALL, MAT.Concrete))
  body.Transparency = 1
  body.CastShadow = false
  -- 墙、门洞、窗、屋顶
  local ix, iz = w / 2 - T, d / 2 - T   -- 屋里的半宽、半深
  wallRun(m, base, "x", 0, -d / 2 + T / 2, w, T, y0, h, nil, { -11, -4, 4, 11 }, -1, WALL)
  wallRun(m, base, "x", 0, d / 2 - T / 2, w, T, y0, h, { { -2.6, 2.6 } }, { -10, 10 }, 1, WALL)
  wallRun(m, base, "z", -w / 2 + T / 2, 0, d - 2 * T, T, y0, h, nil, { -5, 5 }, -1, WALL)
  wallRun(m, base, "z", w / 2 - T / 2, 0, d - 2 * T, T, y0, h, nil, { -5, 5 }, 1, WALL)
  block(m, base, V(w + 1.2, 0.8, d + 1.2), CF(0, y0 + h + 0.4, 0), C.oliveDark, MAT.Concrete)
  roofStuff(m, base, w, d, y0 + h + 0.8, 3)
  -- 屋里墙面：下半截墙裙、上半截浅色（门洞那段不贴）
  local function clad(along, cx, cz, a, bb)
    for _, band in ipairs({ { y0, y0 + 3.2, DADO }, { y0 + 3.2, y0 + 7.0, INNER } }) do
      local len, c = bb - a, (a + bb) / 2
      local size = (along == "x") and V(len, band[2] - band[1], 0.1) or V(0.1, band[2] - band[1], len)
      local off = (along == "x") and CF(c, (band[1] + band[2]) / 2, cz) or CF(cx, (band[1] + band[2]) / 2, c)
      ghostly(block(m, base, size, off, band[3], MAT.SmoothPlastic))
    end
  end
  clad("x", 0, -iz - 0.05 + 0.1, -ix, ix)
  clad("x", 0, iz - 0.05, -ix, -2.6)
  clad("x", 0, iz - 0.05, 2.6, ix)
  clad("z", -ix + 0.05, 0, -iz, iz)
  clad("z", ix - 0.05, 0, -iz, iz)
  -- 地面：水磨石地、中间一条走道地胶
  ghostly(block(m, base, V(2 * ix, 0.08, 2 * iz), CF(0, y0 + 0.04, 0), RGB(156, 152, 140), MAT.Slate))
  ghostly(block(m, base, V(2 * ix - 2, 0.06, 3.2), CF(0, y0 + 0.1, 0), RGB(64, 84, 62), MAT.Fabric))
  -- 门：门框、开着的门板、门口台阶、门上的灯
  block(m, base, V(0.5, 7.2, T + 0.4), CF(-2.85, y0 + 3.6, d / 2 - T / 2), C.dark, MAT.Metal)
  block(m, base, V(0.5, 7.2, T + 0.4), CF(2.85, y0 + 3.6, d / 2 - T / 2), C.dark, MAT.Metal)
  block(m, base, V(6.2, 0.5, T + 0.4), CF(0, y0 + 7.25, d / 2 - T / 2), C.dark, MAT.Metal)
  ghostly(block(m, base, V(2.6, 6.9, 0.25), CF(-2.6, y0 + 3.45, d / 2 + 0.1) * CFrame.Angles(0, math.rad(-80), 0) * CF(1.3, 0, 0), METAL, MAT.Metal))
  ghostly(block(m, base, V(2.6, 6.9, 0.25), CF(2.6, y0 + 3.45, d / 2 + 0.1) * CFrame.Angles(0, math.rad(80), 0) * CF(-1.3, 0, 0), METAL, MAT.Metal))
  block(m, base, V(7, 0.3, 2.2), CF(0, y0 + 0.15, d / 2 + 1.1), RGB(150, 150, 142), MAT.Concrete)
  local lampO = ghostly(block(m, base, V(1.6, 0.5, 0.6), CF(0, y0 + 8.1, d / 2 + 0.3), RGB(255, 240, 200), MAT.Neon))
  local pl0 = Instance.new("PointLight")
  pl0.Range, pl0.Brightness, pl0.Color = 14, 0.9, RGB(255, 226, 170)
  pl0.Parent = lampO
  -- 天花板日光灯（三条，带灯光）
  for _, lx in ipairs({ -9.5, 0, 9.5 }) do
    block(m, base, V(6.4, 0.25, 1.1), CF(lx, y0 + h - 0.35, 0), RGB(200, 200, 196), MAT.Metal)
    local tube = ghostly(block(m, base, V(6, 0.18, 0.7), CF(lx, y0 + h - 0.55, 0), RGB(250, 248, 236), MAT.Neon))
    local pl = Instance.new("PointLight")
    pl.Range, pl.Brightness, pl.Color, pl.Shadows = 22, 1.25, RGB(255, 246, 228), false
    pl.Parent = tube
  end

  ---------------- 左边宿舍
  -- 双层床：四根柱子、上下两层床板和床垫、枕头、叠好的军被；爬梯在床尾
  local function bunk(x, z, headSign)   -- headSign：床头朝 −Z（-1）还是 +Z（+1）
    local L = 7.2
    for _, ox in ipairs({ -1.6, 1.6 }) do
      for _, oz in ipairs({ -L / 2 + 0.15, L / 2 - 0.15 }) do block(m, base, V(0.25, 6.6, 0.25), CF(x + ox, y0 + 3.3, z + oz), METAL, MAT.Metal) end
    end
    for _, ly in ipairs({ 1.5, 4.7 }) do
      block(m, base, V(3.4, 0.3, L), CF(x, y0 + ly, z), METAL, MAT.Metal)
      ghostly(block(m, base, V(3.0, 0.5, L - 0.4), CF(x, y0 + ly + 0.4, z), RGB(214, 210, 196), MAT.Fabric))
      ghostly(block(m, base, V(2.2, 0.35, 1.0), CF(x, y0 + ly + 0.82, z + headSign * (L / 2 - 0.9)), RGB(236, 236, 230), MAT.Fabric))
      ghostly(block(m, base, V(2.6, 0.32, 1.6), CF(x, y0 + ly + 0.8, z - headSign * (L / 2 - 1.3)), RGB(84, 98, 66), MAT.Fabric))   -- 叠成豆腐块的被子
    end
    local fz = z - headSign * (L / 2 - 0.05)
    for _, ox in ipairs({ 0.6, 1.4 }) do ghostly(block(m, base, V(0.14, 4.6, 0.14), CF(x + ox, y0 + 2.9, fz - headSign * 0.12), METAL, MAT.Metal)) end
    for _, ly in ipairs({ 2.6, 3.6 }) do ghostly(block(m, base, V(0.95, 0.12, 0.14), CF(x + 1.0, y0 + ly, fz - headSign * 0.12), METAL, MAT.Metal)) end
    -- 床尾的床头箱
    block(m, base, V(2.6, 1.3, 1.2), CF(x, y0 + 0.65, z - headSign * (L / 2 + 0.75)), RGB(70, 80, 56), MAT.WoodPlanks)
  end
  local bz = -iz + 3.7
  for i, bx in ipairs({ -12.4, -8.0, -3.6 }) do
    bunk(bx, bz, -1)
    if i == 2 then ghostly(block(m, base, V(1.0, 0.5, 1.1), CF(bx, y0 + 1.55, bz + 3.6 + 0.75), C.oliveDark, MAT.SmoothPlastic)) end   -- 箱子上的头盔
  end
  for _, bx in ipairs({ -12.4, -8.0 }) do bunk(bx, iz - 3.7, 1) end
  figure(m, base, CF(-8.0, y0 + 2.15, bz), "lie")   -- 下铺有人在睡觉
  -- 储物柜：左墙，一排三个（门缝、通风口、把手）
  for k, lz in ipairs({ -1.95, 0, 1.95 }) do
    local lx = -ix + 0.75
    block(m, base, V(1.5, 6.4, 1.9), CF(lx, y0 + 3.2, lz), RGB(104, 116, 92), MAT.Metal)
    for v = 0, 2 do ghostly(block(m, base, V(0.06, 0.12, 1.2), CF(lx + 0.76, y0 + 5.6 + v * 0.3, lz), C.dark, MAT.Metal)) end
    ghostly(block(m, base, V(0.1, 0.7, 0.14), CF(lx + 0.78, y0 + 3.4, lz + 0.6), RGB(200, 200, 196), MAT.Metal))
    if k < 3 then ghostly(block(m, base, V(0.06, 6.2, 0.08), CF(lx + 0.76, y0 + 3.2, lz + 0.97), C.dark, MAT.Metal)) end
  end
  figure(m, base, CF(-11.2, y0, 0) * CFrame.Angles(0, math.rad(90), 0), "stand")   -- 在储物柜前

  ---------------- 右边作战室
  -- 作战桌：桌面上一张地图（SurfaceGui 画的：地块、河、路、红蓝两方的标记和箭头）、四把椅子
  local tx, tz = 8.0, -4.6
  block(m, base, V(6.4, 0.3, 4.0), CF(tx, y0 + 3.0, tz), WOOD, MAT.Wood)
  for _, o in ipairs({ { -2.9, -1.7 }, { 2.9, -1.7 }, { -2.9, 1.7 }, { 2.9, 1.7 } }) do block(m, base, V(0.3, 2.85, 0.3), CF(tx + o[1], y0 + 1.43, tz + o[2]), RGB(70, 60, 48), MAT.Wood) end
  local map = ghostly(block(m, base, V(5.6, 0.06, 3.4), CF(tx, y0 + 3.18, tz), RGB(120, 140, 96), MAT.SmoothPlastic))
  do
    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Top
    sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.PixelsPerStud = 40
    sg.LightInfluence = 1
    sg.Parent = map
    local function fr(x, y, ww, hh, col, rot)
      local f = Instance.new("Frame")
      f.Position = UDim2.fromScale(x, y)
      f.Size = UDim2.fromScale(ww, hh)
      f.AnchorPoint = Vector2.new(0.5, 0.5)
      f.BackgroundColor3 = col
      f.BorderSizePixel = 0
      f.Rotation = rot or 0
      f.Parent = sg
      return f
    end
    fr(0.5, 0.5, 1, 1, RGB(206, 196, 160))
    fr(0.25, 0.35, 0.4, 0.45, RGB(150, 172, 112))
    fr(0.75, 0.62, 0.38, 0.5, RGB(162, 182, 120))
    fr(0.5, 0.5, 1.1, 0.07, RGB(80, 130, 190), 12)        -- 河
    fr(0.45, 0.5, 0.05, 1.1, RGB(120, 100, 80))           -- 路
    for _, e in ipairs({ { 0.2, 0.75, RGB(60, 110, 210) }, { 0.32, 0.8, RGB(60, 110, 210) }, { 0.7, 0.22, RGB(210, 50, 45) }, { 0.82, 0.3, RGB(210, 50, 45) }, { 0.6, 0.15, RGB(210, 50, 45) } }) do
      fr(e[1], e[2], 0.07, 0.11, e[3])
    end
    fr(0.4, 0.52, 0.32, 0.03, RGB(60, 110, 210), -35)     -- 进攻箭头
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Position = UDim2.fromScale(0.02, 0.02)
    t.Size = UDim2.fromScale(0.5, 0.14)
    t.Font = Enum.Font.GothamBold
    t.TextScaled = true
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextColor3 = RGB(60, 50, 40)
    t.Text = "作战地图"
    t.Parent = sg
  end
  local function chair(x, z, yaw)
    local c = CF(x, 0, z) * CFrame.Angles(0, yaw, 0)
    block(m, base, V(1.2, 1.6, 1.2), c * CF(0, y0 + 0.8, 0), C.dark, MAT.Metal)
    block(m, base, V(1.6, 0.25, 1.6), c * CF(0, y0 + 1.75, 0), RGB(60, 70, 52), MAT.Fabric)
    block(m, base, V(1.6, 1.9, 0.22), c * CF(0, y0 + 2.8, 0.75), RGB(60, 70, 52), MAT.Fabric)
  end
  chair(tx - 1.6, tz + 3.0, 0)
  chair(tx + 1.6, tz + 3.0, 0)
  chair(tx - 1.6, tz - 3.0, math.pi)
  chair(tx + 4.6, tz, math.rad(90))
  figure(m, base, CF(tx - 1.6, y0, tz + 2.2), "sit")                                   -- 坐着看地图
  figure(m, base, CF(tx + 1.6, y0, tz - 2.9) * CFrame.Angles(0, math.pi, 0), "stand")  -- 对面站着讲解的军官
  -- 枪架：右墙，一排六支步枪（枪托、枪身、弹匣）
  local rx = ix - 0.6
  block(m, base, V(0.4, 4.6, 7.2), CF(rx + 0.25, y0 + 2.3, 3.6), WOOD, MAT.Wood)
  block(m, base, V(1.6, 0.3, 7.2), CF(rx - 0.3, y0 + 0.45, 3.6), WOOD, MAT.Wood)
  block(m, base, V(1.2, 0.25, 7.2), CF(rx - 0.15, y0 + 3.6, 3.6), WOOD, MAT.Wood)
  for k = 0, 5 do
    local gz = 1.0 + k * 1.05
    ghostly(block(m, base, V(0.35, 1.0, 0.3), CF(rx - 0.45, y0 + 1.1, gz), RGB(96, 72, 48), MAT.Wood))
    ghostly(block(m, base, V(0.22, 3.4, 0.22), CF(rx - 0.45, y0 + 3.2, gz), RGB(40, 42, 44), MAT.Metal))
    ghostly(block(m, base, V(0.26, 0.7, 0.2), CF(rx - 0.75, y0 + 2.4, gz), RGB(40, 42, 44), MAT.Metal))
  end
  figure(m, base, CF(rx - 2.4, y0, 2.4) * CFrame.Angles(0, math.rad(-90), 0), "stand")   -- 在枪架前
  -- 公告栏（后墙，SurfaceGui：标题和几张贴着的纸）
  local board = block(m, base, V(5.2, 3.2, 0.15), CF(tx, y0 + 4.8, -iz + 0.08), RGB(150, 112, 70), MAT.Wood)
  do
    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Back
    sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.PixelsPerStud = 40
    sg.Parent = board
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Size = UDim2.fromScale(1, 0.24)
    t.Font = Enum.Font.GothamBlack
    t.TextScaled = true
    t.TextColor3 = RGB(255, 240, 200)
    t.Text = "公 告 栏"
    t.Parent = sg
    for k, txt in ipairs({ "值班表", "训练计划", "作战命令", "内务条令" }) do
      local p = Instance.new("TextLabel")
      p.Position = UDim2.fromScale(0.04 + (k - 1) * 0.24, 0.3 + (k % 2) * 0.08)
      p.Size = UDim2.fromScale(0.2, 0.55)
      p.BackgroundColor3 = RGB(244, 242, 232)
      p.BorderSizePixel = 0
      p.Rotation = (k % 2 == 0) and 3 or -2
      p.Font = Enum.Font.GothamBold
      p.TextScaled = true
      p.TextYAlignment = Enum.TextYAlignment.Top
      p.TextColor3 = RGB(50, 50, 60)
      p.Text = txt
      p.Parent = sg
    end
  end
  -- 电台桌（右前角）、坐着值班的通信兵；饮水机、灭火器；墙上的队旗和钟
  local dx, dz = ix - 2.2, iz - 1.3
  block(m, base, V(3.6, 0.25, 1.8), CF(dx, y0 + 2.8, dz), WOOD, MAT.Wood)
  block(m, base, V(3.4, 2.7, 0.2), CF(dx, y0 + 1.35, dz + 0.75), RGB(70, 60, 48), MAT.Wood)
  block(m, base, V(1.8, 1.1, 1.0), CF(dx - 0.5, y0 + 3.5, dz + 0.2), RGB(64, 78, 58), MAT.Metal)
  anim(ghostly(block(m, base, V(0.2, 0.2, 0.06), CF(dx - 0.9, y0 + 3.6, dz - 0.31), RGB(90, 255, 120), MAT.Neon)), "blink", 1.5)
  ghostly(cyl(m, base, 2.6, 0.08, CF(dx + 0.2, y0 + 5.3, dz + 0.4), C.dark, MAT.Metal))
  chair(dx, dz - 2.2, math.pi)
  figure(m, base, CF(dx, y0, dz - 1.4) * CFrame.Angles(0, math.pi, 0), "sit")
  block(m, base, V(1.3, 2.8, 1.3), CF(3.8, y0 + 1.4, iz - 1.0), RGB(226, 226, 222), MAT.SmoothPlastic)
  local jug = ghostly(cyl(m, base, 1.6, 1.0, CF(3.8, y0 + 3.6, iz - 1.0), RGB(140, 190, 230), MAT.Glass))
  jug.Transparency = 0.35
  ghostly(cyl(m, base, 1.4, 0.55, CF(-3.4, y0 + 0.9, iz - 0.6), RGB(200, 40, 36), MAT.SmoothPlastic))
  ghostly(block(m, base, V(0.1, 2.6, 3.6), CF(ix - 0.06, y0 + 8.5, 0), team or C.red, MAT.Fabric))
  local clock = ghostly(cyl(m, base, 0.15, 1.6, CF(0, y0 + 8.6, iz - 0.1) * CFrame.Angles(math.rad(90), 0, 0), RGB(240, 240, 236), MAT.SmoothPlastic))
  clock.CastShadow = false
  ghostly(block(m, base, V(0.12, 0.6, 0.06), CF(0, y0 + 8.85, iz - 0.2), C.dark, MAT.SmoothPlastic))
  ghostly(block(m, base, V(0.45, 0.12, 0.06), CF(0.18, y0 + 8.6, iz - 0.2), C.dark, MAT.SmoothPlastic))

  ---------------- 外面
  flag(m, base, CF(w / 2 + 2, 0, d / 2 + 2), team)
  for _, sx in ipairs({ -6.5, 6.5 }) do block(m, base, V(5, 1.8, 1.4), CF(sx, y0 + 0.9, d / 2 + 4.2), C.sand, MAT.Fabric) end
  facadeSign(m, base, CF(0, y0 + h - 1.3, d / 2 + 0.35), 9, 1.6, "兵  营", RGB(255, 226, 140), Enum.NormalId.Back)
  -- 门前操场：一排人做俯卧撑（客户端让他们一起一上一下），教官在旁边看着；西头单杠、轮胎
  local pz = d / 2 + 8.5   -- 操场靠着兵营（再往北是部队开出去的横通道，吉普车在那上面跑）
  ghostly(block(m, base, V(w, 0.06, 8), CF(0, 0.66, pz), RGB(110, 112, 104), MAT.SmoothPlastic))
  for k = -2, 2 do ghostly(block(m, base, V(0.5, 0.08, 6.4), CF(k * 4 + 2, 0.7, pz), C.white, MAT.SmoothPlastic)) end
  for _, fx in ipairs({ -5, -1.5, 2, 5.5 }) do figure(m, base, CF(fx, 0.7, pz + 3.2), "plank", { amp = 6, spd = 0.55 }) end
  figure(m, base, CF(10.5, 0.7, pz + 0.5) * CFrame.Angles(0, math.rad(90), 0), "stand")
  for _, sx in ipairs({ -15.4, -10.6 }) do cyl(m, base, 7.4, 0.35, CF(sx, 0.7 + 3.7, pz - 2.4), C.metal, MAT.Metal) end
  cyl(m, base, 5.0, 0.25, CF(-13, 0.7 + 7.0, pz - 2.4) * CFrame.Angles(0, 0, math.pi / 2), C.metal, MAT.Metal)
  for r = 0, 1 do
    for k = 0, 2 do
      block(m, base, V(0.8, 2.4, 2.4), CF(-14.6 + k * 2.6 + r * 1.3, 0.7 + 0.4, pz + 0.6 + r * 2.4) * UP, RGB(32, 32, 34), MAT.SmoothPlastic, CYL)
    end
  end
  return body
end

local function hangar(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local wall = h * 0.5
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, wall, d), CF(0, 0.6 + wall / 2, 0), RGB(112, 120, 100), MAT.Metal)
  local r = w * 0.47
  block(m, base, V(d, r * 2, r * 2), CF(0, 0.6 + wall - r * 0.42, 0) * CFrame.Angles(0, math.pi / 2, 0), RGB(100, 108, 90), MAT.CorrodedMetal, CYL)
  block(m, base, V(w * 0.62, wall * 0.92, 0.6), CF(0, 0.6 + wall * 0.46, d / 2 + 0.15), C.dark, MAT.DiamondPlate)
  local seg = w * 0.62 / 6
  for k = 0, 5 do
    block(m, base, V(seg, 0.8, 0.7), CF(-w * 0.31 + (k + 0.5) * seg, 0.6 + wall * 0.92 + 0.4, d / 2 + 0.2), (k % 2 == 0) and C.yellow or C.dark)
  end
  for _, sx in ipairs({ -1, 1 }) do block(m, base, V(0.4, 4, 3), CF(sx * (w / 2 + 0.1), 0.6 + 2, -d * 0.2), C.dark, MAT.DiamondPlate) end
  for k = -1, 1 do
    local sky = block(m, base, V(2, 0.3, d * 0.7), CF(k * w * 0.2, 0.6 + wall + r * 0.52, 0) * CFrame.Angles(0, 0, -k * 0.35), C.glass, MAT.Glass)
    sky.CastShadow = false
  end
  facadeSign(m, base, CF(0, 0.6 + wall + 2.2, d / 2 + 0.5), 12, 1.8, "装甲车厂", RGB(255, 214, 90), Enum.NormalId.Back)
  return body
end

local function aaShop(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local hh = h * 0.6
  slabUnder(m, base, w, d)
  local body = block(m, base, V(w, hh, d), CF(0, 0.6 + hh / 2, 0), RGB(118, 126, 112), MAT.Concrete)
  block(m, base, V(w * 0.55, hh * 0.8, 0.6), CF(0, 0.6 + hh * 0.4, d / 2 + 0.15), C.dark, MAT.DiamondPlate)
  cyl(m, base, 7, 0.6, CF(-w / 2 + 3, 0.6 + hh + 3.5, -d / 2 + 3), C.metal, MAT.Metal)
  anim(block(m, base, V(6, 3, 0.4), CF(-w / 2 + 3, 0.6 + hh + 7.5, -d / 2 + 3) * CFrame.Angles(math.rad(-20), math.rad(30), 0), C.white, MAT.Metal), "spin", 0.4)
  block(m, base, V(3, 1.6, 3), CF(w / 4, 0.6 + hh + 0.8, 0), C.olive, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    block(m, base, V(0.3, 0.3, 4), CF(w / 4 + s * 0.7, 0.6 + hh + 2.4, 1.4) * CFrame.Angles(math.rad(-35), 0, 0), C.gun, MAT.Metal)
  end
  block(m, base, V(3, 1, 3), CF(w / 2 + 4, 0.6 + 0.5, d * 0.2), C.oliveDark, MAT.Metal)   -- 门外的发射架
  block(m, base, V(2.4, 2.2, 6), CF(w / 2 + 4, 0.6 + 3.2, d * 0.2) * CFrame.Angles(math.rad(-40), 0, 0), C.olive, MAT.Metal)
  facadeSign(m, base, CF(0, 0.6 + hh - 1.2, d / 2 + 0.35), 10, 1.5, "防空车间", RGB(255, 214, 90), Enum.NormalId.Back)
  return body
end

local function artyPos(m, base, b)
  local w, d = b.size[1], b.size[3]
  block(m, base, V(w + 3, 0.6, d + 3), CF(0, 0.3, 0), C.sand, MAT.Sand)
  block(m, base, V(w, 3, 2), CF(0, 0.6 + 1.5, -d / 2 + 1), C.sand, MAT.Fabric)
  block(m, base, V(2, 3, d - 2), CF(-w / 2 + 1, 0.6 + 1.5, 0), C.sand, MAT.Fabric)
  block(m, base, V(2, 3, d - 2), CF(w / 2 - 1, 0.6 + 1.5, 0), C.sand, MAT.Fabric)
  local body = block(m, base, V(3.6, 1.2, 5), CF(0, 0.6 + 1.6, -1), C.olive, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    block(m, base, V(0.8, 2.6, 2.6), CF(s * 2.2, 0.6 + 1.3, -0.5), C.track, MAT.Metal, CYL)
    block(m, base, V(0.4, 0.4, 6), CF(s * 1.2, 0.6 + 0.6, -5) * CFrame.Angles(0, s * 0.25, 0), C.olive, MAT.Metal)
  end
  block(m, base, V(0.5, 0.5, 8), CF(0, 0.6 + 3.2, 2.5) * CFrame.Angles(math.rad(-28), 0, 0), C.gun, MAT.Metal)
  for k = 0, 2 do block(m, base, V(2.2, 1.2, 1.4), CF(-w / 2 + 4, 0.6 + 0.6 + k * 1.2, -d / 2 + 4), C.oliveDark, MAT.WoodPlanks) end
  local net = block(m, base, V(w * 0.85, 0.2, d * 0.75), CF(0, 0.6 + 7, 0), RGB(70, 88, 52), MAT.Fabric)
  net.Transparency = 0.15
  for _, sx in ipairs({ -1, 1 }) do
    for _, sz in ipairs({ -1, 1 }) do cyl(m, base, 7, 0.3, CF(sx * w * 0.4, 0.6 + 3.5, sz * d * 0.35), C.oliveDark, MAT.Wood) end
  end
  return body
end

-- 停在直升机场 / 机场上的展示飞机：客户端（Anim.lua）按属性 Show 隔一会儿让它起飞、飞一圈、落回来（服务器上一直停着）
local function showPlane(m, base, t, cf, team)
  local ok, um, root = pcall(function() return Models.unit(t, team or C.olive) end)
  if not ok or not um then return end
  local r = um:FindFirstChild("TeamRing")
  if r then r:Destroy() end
  for _, d in ipairs(um:GetDescendants()) do
    if d:IsA("BasePart") then
      d.CanQuery = false
      d.CanTouch = false
      d.CanCollide = false
    end
  end
  root.CFrame = base * cf
  um.Name = "Show"
  um:SetAttribute("Show", t)
  um.Parent = m
end

local function helipad(m, base, b, team)
  local w, d = b.size[1], b.size[3]
  local body = block(m, base, V(w, 0.8, d), CF(0, 0.4, 0), C.asphalt, MAT.Asphalt)
  ghostly(cyl(m, base, 0.1, w * 0.78, CF(0, 0.85, 0), C.yellow))
  ghostly(cyl(m, base, 0.12, w * 0.7, CF(0, 0.86, 0), C.asphalt, MAT.Asphalt))
  ghostly(block(m, base, V(2, 0.1, 14), CF(-4.5, 0.95, 0), C.white))
  ghostly(block(m, base, V(2, 0.1, 14), CF(4.5, 0.95, 0), C.white))
  ghostly(block(m, base, V(9, 0.1, 2), CF(0, 0.95, 0), C.white))
  for _, sx in ipairs({ -1, 1 }) do
    for _, sz in ipairs({ -1, 1 }) do anim(block(m, base, V(1, 1, 1), CF(sx * (w / 2 - 1), 1.2, sz * (d / 2 - 1)), RGB(80, 255, 120), MAT.Neon), "blink", 0.8) end
  end
  cyl(m, base, 9, 0.3, CF(w / 2 + 2, 4.5, -d / 2 + 2), C.metal, MAT.Metal)
  block(m, base, V(0.9, 0.9, 3), CF(w / 2 + 2, 8.5, -d / 2 + 3.5), RGB(240, 120, 30), MAT.Fabric)
  showPlane(m, base, "heli", CF(0, 0.9, 0), team)
  return body
end

-- 空军基地：在围墙外的草地上（底板从地面铺起），跑道沿 Z（喷气机从 −Z 那头滑跑，往战场方向起飞），右边两座机库，左边塔台
local function airbase(m, base, b, team)
  local w, d = b.size[1], b.size[3]
  local body = block(m, base, V(w, 1.2, d), CF(0, -0.4, 0), RGB(150, 152, 148), MAT.Concrete)
  ghostly(block(m, base, V(22, 0.1, d - 8), CF(0, 0.25, 0), C.asphalt, MAT.Asphalt))
  for k = -7, 7 do ghostly(block(m, base, V(0.8, 0.06, 8), CF(0, 0.32, k * 15), C.white)) end
  for _, sx in ipairs({ -1, 1 }) do ghostly(block(m, base, V(0.5, 0.06, d - 10), CF(sx * 10, 0.32, 0), C.white)) end
  for _, sz in ipairs({ -1, 1 }) do
    for k = -4, 4 do anim(block(m, base, V(0.6, 0.4, 0.6), CF(k * 2.4, 0.4, sz * (d / 2 - 2)), (sz < 0) and RGB(80, 255, 120) or RGB(255, 80, 70), MAT.Neon), "blink", 1.2) end
  end
  for _, hz in ipairs({ -60, 20 }) do   -- 机库：门朝跑道
    local hb = CF(21, 0.2, hz)
    block(m, base, V(16, 6, 22), hb * CF(0, 3, 0), RGB(112, 120, 100), MAT.Metal)
    block(m, base, V(16, 22, 22), hb * CF(0, 6 - 11 * 0.42, 0), RGB(100, 108, 90), MAT.CorrodedMetal, CYL)
    block(m, base, V(0.4, 5.4, 14), hb * CF(-8.1, 2.7, 0), C.dark, MAT.DiamondPlate)
  end
  cyl(m, base, 12, 4, CF(-22, 6.2, -90), C.concrete, MAT.Concrete)   -- 塔台
  block(m, base, V(6, 3, 6), CF(-22, 13.7, -90), C.glass, MAT.Glass)
  block(m, base, V(6.6, 0.6, 6.6), CF(-22, 15.5, -90), C.roof, MAT.Metal)
  cyl(m, base, 8, 0.3, CF(-22, 4.2, 40), C.metal, MAT.Metal)   -- 风向袋
  block(m, base, V(0.9, 0.9, 3), CF(-22, 8, 41.5), RGB(240, 120, 30), MAT.Fabric)
  showPlane(m, base, "fighter", CF(0, 0.3, -d / 2 + 20) * CFrame.Angles(0, math.pi, 0), team)   -- 跑道南头，机头朝北
  return body
end

local function hq(m, base, b, team)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  slabUnder(m, base, w, d)
  local h1 = h * 0.6
  local body = block(m, base, V(w, h1, d), CF(0, 0.6 + h1 / 2, 0), RGB(96, 104, 86), MAT.Concrete)
  block(m, base, V(w + 0.3, 1.2, d + 0.3), CF(0, 0.6 + h1 * 0.6, 0), C.glass, MAT.Glass)
  local h2 = h * 0.4
  block(m, base, V(w * 0.55, h2, d * 0.55), CF(-w * 0.12, 0.6 + h1 + h2 / 2, 0), RGB(84, 92, 76), MAT.Concrete)
  block(m, base, V(w * 0.55 + 0.3, 1, d * 0.55 + 0.3), CF(-w * 0.12, 0.6 + h1 + h2 * 0.55, 0), C.glass, MAT.Glass)
  cyl(m, base, 14, 0.4, CF(w * 0.3, 0.6 + h1 + 7, -d * 0.25), C.metal, MAT.Metal)
  anim(block(m, base, V(0.7, 0.7, 0.7), CF(w * 0.3, 0.6 + h1 + 14.2, -d * 0.25), C.red, MAT.Neon), "blink", 1)
  anim(block(m, base, V(5, 2.4, 0.4), CF(w * 0.25, 0.6 + h1 + 2, d * 0.2) * CFrame.Angles(math.rad(-15), math.rad(-25), 0), C.white, MAT.Metal), "spin", 0.25)
  flag(m, base, CF(-w / 2 - 2, 0, d / 2 + 2), team)
  block(m, base, V(5, 5, 0.6), CF(0, 0.6 + 2.5, d / 2 + 0.15), C.dark)
  local top = 0.6 + h1 + h2
  cyl(m, base, 2, 0.8, CF(-w * 0.12, top + 1, -d * 0.12), C.metal, MAT.Metal)
  anim(block(m, base, V(0.6, 6, 6), CF(-w * 0.12, top + 4, -d * 0.12) * CFrame.Angles(0, 0, math.rad(55)), RGB(232, 232, 228), MAT.SmoothPlastic, CYL), "spin", 0.08)
  for k = 0, 2 do cyl(m, base, 6 + k * 2, 0.15, CF(-w * 0.32 + k * 1.4, top + 3 + k, d * 0.18), C.metal, MAT.Metal) end
  for _, sx in ipairs({ -1, 1 }) do cyl(m, base, 5, 0.9, CF(sx * 3.4, 0.6 + 2.5, d / 2 + 2.2), RGB(200, 200, 192), MAT.Concrete) end
  block(m, base, V(9, 0.6, 3.4), CF(0, 0.6 + 5.2, d / 2 + 1.7), RGB(84, 92, 76), MAT.Concrete)
  facadeSign(m, base, CF(0, 0.6 + h1 - 1.4, d / 2 + 0.35), 10, 1.6, "指 挥 部", RGB(255, 226, 140), Enum.NormalId.Back)
  return body
end

---------------------------------------------------------------- 西边工业区的建筑

-- 看不见、不挡人的整块主体（挂牌子、提示、升起动画的脚手架用它的大小）
local function hiddenBody(m, base, w, h, d)
  local body = ghostly(block(m, base, V(w, h, d), CF(0, 0.6 + h / 2, 0), C.concrete, MAT.Concrete))
  body.Transparency = 1
  body.CastShadow = false
  return body
end

-- 两点之间的一根杆（size 是粗细，沿杆方向自动拉长）
local function rod(m, base, a, b, t, color, mat)
  local mid, len = (a + b) / 2, (b - a).Magnitude
  return block(m, base, V(t, t, len), CFrame.lookAt(mid, b), color, mat or MAT.Metal)
end

-- 客户端动画的属性：绕 piv 点、ax 轴转 / 来回摆
local function spinAbout(p, piv, ax, spd)
  anim(p, "spin", spd)
  p:SetAttribute("Piv", piv)
  p:SetAttribute("Ax", ax)
  return p
end
local function nodAbout(p, piv, ax, amp, spd, ph)
  p:SetAttribute("Anim", "nod")
  p:SetAttribute("Piv", piv)
  p:SetAttribute("Ax", ax)
  p:SetAttribute("Amp", amp)
  p:SetAttribute("Spd", spd)
  p:SetAttribute("Ph", ph or 0)
  return p
end

-- 冒烟（服务器上放的粒子，客户端自己放，不占网络）：color 烟色、size 从多大长到多大、rate 每秒几团
local function smoke(p, color, s0, s1, rate, life, speed)
  local e = Instance.new("ParticleEmitter")
  e.Texture = "rbxasset://textures/particles/smoke_main.dds"
  e.Color = ColorSequence.new(color)
  e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s0), NumberSequenceKeypoint.new(1, s1) })
  e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.12, 0.45), NumberSequenceKeypoint.new(1, 1) })
  e.Lifetime = NumberRange.new(life * 0.8, life * 1.2)
  e.Speed = NumberRange.new(speed * 0.7, speed * 1.2)
  e.Rate = rate
  e.EmissionDirection = Enum.NormalId.Top
  e.SpreadAngle = Vector2.new(12, 12)
  e.Acceleration = V(1.2, 0.4, 0.4)
  e.Rotation = NumberRange.new(0, 360)
  e.RotSpeed = NumberRange.new(-15, 15)
  e.LightInfluence = 1
  e.Parent = p
  return e
end

-- 一盏灯（PointLight）挂在零件上
local function glow(p, range, bright, color)
  local l = Instance.new("PointLight")
  l.Range, l.Brightness, l.Color, l.Shadows = range, bright, color, false
  l.Parent = p
  return l
end

-- 油井：一台抽油机（游梁带着驴头绕支架顶上下点头、后面的曲柄和配重一圈圈转、电机）、井口采油树、小储油罐和管子、地上一摊油
local function oilWell(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(146, 142, 132), MAT.Concrete)
  local Y = 0.6
  local ph = (#b.id + string.byte(b.id, -1)) % 7   -- 几口井别一起点头
  local W = base   -- 世界坐标换算
  local DARK, BODY, HEAD = RGB(58, 60, 64), RGB(214, 170, 40), RGB(40, 42, 46)
  block(m, base, V(3.4, 0.8, 15), CF(0, Y + 0.4, 0.5), DARK, MAT.Metal)
  -- 支架：四条斜腿撑到顶上的轴
  local top = V(0, Y + 7.4, 0)
  for _, sx in ipairs({ -1.2, 1.2 }) do
    for _, sz in ipairs({ -2.6, 2.6 }) do rod(m, base, V(sx, Y + 0.8, sz), V(sx * 0.45, top.Y - 0.2, 0), 0.4, BODY) end
  end
  block(m, base, V(2.2, 0.6, 0.8), CF(0, top.Y, 0), DARK, MAT.Metal)
  -- 游梁和驴头：绕轴点头
  local piv, ax = (W * CF(top)).Position, V(1, 0, 0)
  nodAbout(block(m, base, V(0.9, 1.1, 14), CF(0, top.Y + 0.75, -1), BODY, MAT.Metal), piv, ax, 13, 0.32, ph)
  nodAbout(block(m, base, V(1.3, 4.6, 1.4), CF(0, top.Y - 0.5, -8.4), HEAD, MAT.Metal), piv, ax, 13, 0.32, ph)
  nodAbout(block(m, base, V(1.3, 1.6, 1.6), CF(0, top.Y + 1.4, -7.6), HEAD, MAT.Metal), piv, ax, 13, 0.32, ph)
  -- 曲柄、配重：绕横轴转（和点头一个周期）
  local cpiv = (W * CF(0, Y + 3.2, 5.6)).Position
  for _, sx in ipairs({ -1.6, 1.6 }) do
    spinAbout(block(m, base, V(0.45, 6.4, 1.2), CF(sx, Y + 3.2, 5.6), BODY, MAT.Metal), cpiv, ax, 0.32)
    spinAbout(block(m, base, V(0.9, 1.8, 2.8), CF(sx, Y + 3.2 - 2.4, 5.6), RGB(170, 40, 34), MAT.Metal), cpiv, ax, 0.32)
  end
  block(m, base, V(2.4, 1.2, 1.2), CF(0, Y + 3.2, 5.6), DARK, MAT.Metal, CYL)
  -- 电机和皮带罩
  block(m, base, V(1.8, 1.8, 2.6), CF(0, Y + 1.7, 8.6), RGB(70, 110, 150), MAT.Metal)
  block(m, base, V(0.5, 2.6, 3.6), CF(1.3, Y + 2.4, 7.2), DARK, MAT.Metal)
  -- 井口采油树、阀门、通到储罐的管子；储罐、爬梯
  cyl(m, base, 3.0, 1.0, CF(0, Y + 1.5, -8.4), RGB(150, 150, 150), MAT.Metal)
  block(m, base, V(2.6, 0.5, 0.5), CF(0, Y + 2.2, -8.4), RGB(150, 150, 150), MAT.Metal)
  for _, sx in ipairs({ -1.4, 1.4 }) do block(m, base, V(0.15, 1.0, 1.0), CF(sx, Y + 2.2, -8.4), C.red, MAT.Metal, CYL) end
  block(m, base, V(5.2, 0.45, 0.45), CF(2.9, Y + 0.6, -8.4), DARK, MAT.Metal, CYL)
  cyl(m, base, 6, 4.6, CF(6.0, Y + 3.0, -7.0), RGB(226, 226, 220), MAT.Metal)
  cyl(m, base, 0.3, 4.9, CF(6.0, Y + 6.15, -7.0), RGB(180, 60, 50), MAT.Metal)
  block(m, base, V(0.6, 6, 0.15), CF(6.0, Y + 3.0, -4.6), DARK, MAT.Metal)
  local puddle = ghostly(block(m, base, V(4, 0.06, 3), CF(-1.6, Y + 0.03, -6.5), RGB(18, 18, 20), MAT.Glass))
  puddle.CastShadow = false
  return body
end

-- 炼油厂：两个大储罐、两座蒸馏塔（黄色平台圈）、管廊上红黄蓝三根管子、火炬顶上烧着火、控制室
local function refinery(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(150, 148, 140), MAT.Concrete)
  local Y = 0.6
  local GREY = RGB(96, 98, 102)
  for _, x in ipairs({ -15, -1 }) do
    cyl(m, base, 11, 12, CF(x, Y + 5.5, -7), RGB(234, 234, 228), MAT.Metal)
    cyl(m, base, 0.7, 12.6, CF(x, Y + 11.2, -7), RGB(196, 196, 192), MAT.Metal)
    block(m, base, V(1.2, 0.25, 13), CF(x + 6.4, Y + 5.6, -7) * CFrame.Angles(math.rad(-52), 0, 0), GREY, MAT.Metal)
    ghostly(block(m, base, V(6, 1.2, 0.1), CF(x, Y + 6, -0.95), RGB(40, 90, 160), MAT.SmoothPlastic))   -- 罐身上的蓝色条
  end
  for i, x in ipairs({ 11, 17.5 }) do
    local th = 20 + i * 3
    cyl(m, base, th, 3.4, CF(x, Y + th / 2, -6), RGB(196, 198, 194), MAT.Metal)
    for k = 1, 3 do cyl(m, base, 0.3, 5.2, CF(x, Y + k * 6.5, -6), RGB(236, 190, 40), MAT.Metal) end
    cyl(m, base, 1.2, 2.2, CF(x, Y + th + 0.6, -6), GREY, MAT.Metal)
  end
  -- 管廊
  for k = -2, 2 do block(m, base, V(0.7, 6.4, 0.7), CF(k * 9.5, Y + 3.2, 9), GREY, MAT.Metal) end
  block(m, base, V(42, 0.5, 2.8), CF(0, Y + 6.6, 9), GREY, MAT.Metal)
  for k, col in ipairs({ RGB(196, 62, 50), RGB(230, 196, 60), RGB(70, 116, 176) }) do
    block(m, base, V(42, 0.75, 0.75), CF(0, Y + 7.3, 9 + (k - 2) * 0.9), col, MAT.Metal, CYL)
  end
  -- 火炬：细高的烟囱，顶上烧着火、亮光一闪一闪
  local fx, fz = 22.5, -13
  cyl(m, base, 30, 1.1, CF(fx, Y + 15, fz), RGB(160, 160, 158), MAT.Metal)
  for k = 1, 3 do rod(m, base, V(fx, Y + k * 8, fz), V(fx - 4, Y, fz + 3 - k * 0.5), 0.3, GREY) end
  local flame = ghostly(block(m, base, V(1.4, 2.2, 1.4), CF(fx, Y + 31.2, fz), RGB(255, 160, 50), MAT.Neon))
  anim(flame, "blink", 5)
  local fire = Instance.new("Fire")
  fire.Size, fire.Heat = 7, 14
  fire.Color, fire.SecondaryColor = RGB(255, 150, 40), RGB(255, 60, 20)
  fire.Parent = flame
  glow(flame, 32, 2.2, RGB(255, 170, 90))
  -- 控制室
  block(m, base, V(11, 5, 7), CF(-17, Y + 2.5, 10), RGB(214, 210, 196), MAT.SmoothPlastic)
  block(m, base, V(11.2, 1.3, 7.2), CF(-17, Y + 3.3, 10), C.glass, MAT.Glass)
  block(m, base, V(11.6, 0.4, 7.6), CF(-17, Y + 5.2, 10), C.roof, MAT.Metal)
  facadeSign(m, base, CF(-17, Y + 6.4, 13.6), 9, 1.6, "炼 油 厂", RGB(255, 226, 140), Enum.NormalId.Back)
  return body
end

-- 弹药厂：锯齿屋顶的车间，侧门出来一条传送带（客户端在上面跑弹药箱），尽头停着装货的卡车；成垛的弹药箱、叉车、屋顶通风帽
local function ammoPlant(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(150, 148, 140), MAT.Concrete)
  local Y = 0.6
  local hx, hw, hd = -7, 30, 24
  block(m, base, V(hw, 10, hd), CF(hx, Y + 5, 0), RGB(126, 96, 74), MAT.Brick)
  block(m, base, V(hw + 0.4, 1.2, hd + 0.4), CF(hx, Y + 6.8, 0), C.glass, MAT.Glass)
  for k = 0, 3 do   -- 锯齿屋顶：四道斜面（玻璃那面朝北）
    local x = hx - hw / 2 + 3.75 + k * 7.5
    local wd = Instance.new("WedgePart")
    wd.Anchored = true
    wd.Size = V(hd, 3.2, 7.5)
    wd.CFrame = base * CF(x, Y + 10 + 1.6, 0) * CFrame.Angles(0, math.rad(90), 0)
    wd.Color = RGB(96, 100, 104)
    wd.Material = MAT.Metal
    wd.Parent = m
    block(m, base, V(0.3, 3.0, hd), CF(x + 3.6, Y + 10 + 1.5, 0), C.glass, MAT.Glass)
  end
  -- 侧门、传送带（皮带 + 支腿 + 滚筒），皮带上 Anim = belt：客户端让一个个弹药箱从门里出来往卡车走
  block(m, base, V(0.4, 6, 5), CF(hx + hw / 2 + 0.1, Y + 3, -6), C.dark, MAT.Metal)
  local belt = block(m, base, V(11, 0.4, 2.4), CF(hx + hw / 2 + 5.6, Y + 2.2, -6), RGB(34, 34, 36), MAT.Fabric)
  belt:SetAttribute("Anim", "belt")
  belt:SetAttribute("Spd", 3.2)
  belt:SetAttribute("N", 4)
  belt:SetAttribute("Item", "crate")
  for k = 0, 3 do
    for _, sz in ipairs({ -1.1, 1.1 }) do block(m, base, V(0.3, 2.0, 0.3), CF(hx + hw / 2 + 1.2 + k * 3.0, Y + 1.0, -6 + sz), RGB(230, 190, 40), MAT.Metal) end
  end
  block(m, base, V(11, 0.3, 0.3), CF(hx + hw / 2 + 5.6, Y + 2.5, -7.3), RGB(230, 190, 40), MAT.Metal)
  block(m, base, V(11, 0.3, 0.3), CF(hx + hw / 2 + 5.6, Y + 2.5, -4.7), RGB(230, 190, 40), MAT.Metal)
  -- 卡车（车尾对着传送带）
  local tx, tz = hx + hw / 2 + 14, -6
  for _, sz in ipairs({ -1.5, 1.5 }) do
    for _, sx in ipairs({ -2.4, 1.6, 3.6 }) do block(m, base, V(0.8, 2.2, 2.2), CF(tx + sx, Y + 1.1, tz + sz) * CFrame.Angles(0, math.rad(90), 0), RGB(30, 30, 32), MAT.SmoothPlastic, CYL) end
  end
  block(m, base, V(9.6, 0.8, 3.4), CF(tx + 0.8, Y + 1.9, tz), RGB(52, 54, 52), MAT.Metal)
  block(m, base, V(6.2, 3.4, 3.4), CF(tx - 0.6, Y + 4.0, tz), RGB(84, 96, 64), MAT.Fabric)
  block(m, base, V(2.8, 2.8, 3.2), CF(tx + 4.2, Y + 3.7, tz), RGB(84, 96, 64), MAT.Metal)
  block(m, base, V(0.2, 1.1, 2.8), CF(tx + 5.62, Y + 4.4, tz), RGB(60, 90, 110), MAT.Glass)
  -- 成垛的弹药箱（托盘 + 一垛箱子 + 黄色标记）
  for i, p in ipairs({ { 12, 7 }, { 17, 7 }, { 12, 11.5 }, { -20, 13.5 } }) do
    block(m, base, V(4, 0.4, 3.6), CF(p[1], Y + 0.2, p[2]), RGB(140, 104, 66), MAT.WoodPlanks)
    local hh = (i % 2 == 0) and 2.6 or 3.6
    block(m, base, V(3.6, hh, 3.2), CF(p[1], Y + 0.4 + hh / 2, p[2]), RGB(78, 92, 58), MAT.Metal)
    ghostly(block(m, base, V(3.65, 0.3, 3.25), CF(p[1], Y + 0.4 + hh * 0.7, p[2]), RGB(236, 196, 50), MAT.SmoothPlastic))
  end
  -- 叉车
  local kx, kz = 18, 1.5
  block(m, base, V(2.2, 1.6, 3.2), CF(kx, Y + 1.3, kz), RGB(236, 190, 40), MAT.Metal)
  block(m, base, V(1.8, 1.4, 1.4), CF(kx, Y + 2.8, kz + 0.6), C.dark, MAT.Metal)
  block(m, base, V(0.3, 4.4, 0.3), CF(kx - 0.7, Y + 2.2, kz - 1.8), C.dark, MAT.Metal)
  block(m, base, V(0.3, 4.4, 0.3), CF(kx + 0.7, Y + 2.2, kz - 1.8), C.dark, MAT.Metal)
  block(m, base, V(1.8, 0.2, 2.2), CF(kx, Y + 0.6, kz - 3.0), C.dark, MAT.Metal)
  for _, sx in ipairs({ -1.15, 1.15 }) do block(m, base, V(0.5, 1.2, 1.2), CF(kx + sx, Y + 0.6, kz + 0.9) * CFrame.Angles(0, 0, math.pi / 2), RGB(30, 30, 32), MAT.SmoothPlastic, CYL) end
  -- 屋顶通风帽
  for _, x in ipairs({ hx - 9, hx + 2 }) do cyl(m, base, 2.4, 1.6, CF(x, Y + 14.4, 6), RGB(150, 150, 150), MAT.Metal) end
  facadeSign(m, base, CF(hx, Y + 8.8, hd / 2 + 0.25), 10, 1.6, "弹 药 厂", RGB(255, 226, 140), Enum.NormalId.Back)
  return body
end

-- 钢铁厂：人字屋顶的厂房、高炉（炉口发光、出铁沟里流着铁水）、三座热风炉、两根冒烟的大烟囱、钢梁和钢卷
local function steelMill(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(120, 118, 112), MAT.Concrete)
  local Y = 0.6
  local RUST, DARK = RGB(120, 70, 50), RGB(54, 56, 60)
  -- 厂房
  block(m, base, V(24, 13, 22), CF(-9, Y + 6.5, 4), RGB(84, 90, 96), MAT.CorrodedMetal)
  for _, s in ipairs({ -1, 1 }) do
    block(m, base, V(24.6, 0.6, 12.4), CF(-9, Y + 13 + 2.2, 4 + s * 5.4) * CFrame.Angles(s * math.rad(21), 0, 0), RGB(70, 74, 80), MAT.Metal)
  end
  block(m, base, V(24.4, 1.4, 22.4), CF(-9, Y + 9.6, 4), C.glass, MAT.Glass)
  -- 高炉：一节节往上收的炉身、炉顶、下降管
  local fx, fz = 10, -6
  cyl(m, base, 6, 10, CF(fx, Y + 3, fz), RUST, MAT.Metal)
  cyl(m, base, 9, 8.6, CF(fx, Y + 10.5, fz), RGB(130, 80, 58), MAT.Metal)
  cyl(m, base, 4, 6, CF(fx, Y + 17, fz), RUST, MAT.Metal)
  cyl(m, base, 3, 3.4, CF(fx, Y + 20.5, fz), DARK, MAT.Metal)
  rod(m, base, V(fx + 1.4, Y + 21.5, fz), V(fx + 7, Y + 14, fz + 6), 1.0, DARK)
  for k = 1, 3 do cyl(m, base, 0.3, 11, CF(fx, Y + k * 4.5, fz), RGB(230, 190, 40), MAT.Metal) end
  -- 炉口发光、出铁沟里的铁水
  local mouth = ghostly(block(m, base, V(3.2, 2.4, 0.4), CF(fx, Y + 1.6, fz + 5.05), RGB(255, 120, 30), MAT.Neon))
  anim(mouth, "blink", 2)
  glow(mouth, 22, 2, RGB(255, 140, 60))
  block(m, base, V(1.8, 0.3, 8), CF(fx, Y + 0.25, fz + 9), RGB(70, 66, 62), MAT.Slate)
  ghostly(block(m, base, V(1.0, 0.1, 7.6), CF(fx, Y + 0.45, fz + 9), RGB(255, 110, 20), MAT.Neon))
  -- 热风炉
  for i = 0, 2 do cyl(m, base, 18, 4, CF(17 + (i % 2) * 3, Y + 9, -14 + i * 4.2), RGB(150, 96, 74), MAT.Metal) end
  -- 烟囱（冒烟）
  for i, p in ipairs({ { -18, -10 }, { -12.5, -12 } }) do
    cyl(m, base, 26, 2.6, CF(p[1], Y + 13, p[2]), RGB(176, 74, 60), MAT.Brick)
    cyl(m, base, 2.4, 2.9, CF(p[1], Y + 21, p[2]), RGB(236, 236, 230), MAT.SmoothPlastic)
    local top = ghostly(block(m, base, V(2, 0.2, 2), CF(p[1], Y + 26.2, p[2]), DARK, MAT.Metal))
    smoke(top, RGB(110, 108, 106), 3, 11, 3 + i, 7, 6)
  end
  -- 钢梁、钢卷
  for k = 0, 2 do block(m, base, V(12, 0.9, 0.9), CF(-8, Y + 0.45 + k * 0.9, -14 + (k % 2) * 0.4), RGB(120, 124, 130), MAT.DiamondPlate) end
  for k = 0, 2 do block(m, base, V(2.4, 3.2, 3.2), CF(6 + k * 3, Y + 1.6, 14), RGB(150, 154, 160), MAT.Metal, CYL) end
  facadeSign(m, base, CF(-9, Y + 11.5, 15.3), 10, 1.6, "钢 铁 厂", RGB(255, 226, 140), Enum.NormalId.Back)
  return body
end

-- 矿场：一座石头山，山脚的坑道口（木支架），铁轨从坑道一直铺到矿仓（客户端让矿车来回跑），井架顶上的天轮在转，几堆矿石
local function mine(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(138, 122, 98), MAT.Ground)
  local Y = 0.6
  local ROCK, WOOD = RGB(118, 112, 104), RGB(112, 84, 56)
  -- 石头山（几个大球叠起来，埋一半在地里）
  for _, r in ipairs({ { -12, -4, 24 }, { -2, -9, 18 }, { -17, 7, 16 }, { 5, -11, 12 } }) do
    block(m, base, V(r[3], r[3], r[3]), CF(r[1], Y - r[3] * 0.18, r[2]), ROCK, MAT.Slate, BALL)
  end
  -- 坑道口：黑洞 + 木框
  local ex, ez = -4, 0.5
  ghostly(block(m, base, V(5.2, 6, 0.6), CF(ex, Y + 3, ez), RGB(12, 12, 14), MAT.SmoothPlastic))
  for _, sx in ipairs({ -2.9, 2.9 }) do block(m, base, V(0.8, 6.8, 0.8), CF(ex + sx, Y + 3.4, ez + 0.6), WOOD, MAT.Wood) end
  block(m, base, V(7.4, 0.9, 0.9), CF(ex, Y + 7.1, ez + 0.6), WOOD, MAT.Wood)
  -- 铁轨（两根轨 + 枕木），从坑道口往东铺到矿仓；皮带式动画让矿车沿着跑
  local rx0, rx1, rz = ex, 20, ez + 6
  local len = rx1 - rx0
  for k = 0, math.floor(len / 2.2) do ghostly(block(m, base, V(0.6, 0.2, 3.6), CF(rx0 + 1 + k * 2.2, Y + 0.1, rz), WOOD, MAT.Wood)) end
  for _, sz in ipairs({ -1.1, 1.1 }) do ghostly(block(m, base, V(len, 0.25, 0.25), CF((rx0 + rx1) / 2, Y + 0.32, rz + sz), RGB(90, 90, 94), MAT.Metal)) end
  local track = ghostly(block(m, base, V(len, 0.1, 2.6), CF((rx0 + rx1) / 2, Y + 0.3, rz), RGB(90, 90, 94), MAT.Metal))
  track.Transparency = 1
  track:SetAttribute("Anim", "belt")
  track:SetAttribute("Spd", 2.6)
  track:SetAttribute("N", 3)
  track:SetAttribute("Item", "cart")
  -- 坑道口和矿车之间：铁轨先从山里出来（-Z 那边转过来）
  ghostly(block(m, base, V(2.6, 0.2, 5.4), CF(ex, Y + 0.12, ez + 3.2), WOOD, MAT.Wood))
  -- 矿仓（高架的漏斗仓，下面能过矿车）
  local bx = rx1 + 1
  for _, o in ipairs({ { -2.6, -2.6 }, { 2.6, -2.6 }, { -2.6, 2.6 }, { 2.6, 2.6 } }) do block(m, base, V(0.7, 7, 0.7), CF(bx + o[1], Y + 3.5, rz + o[2]), WOOD, MAT.Wood) end
  block(m, base, V(6.6, 4, 6.6), CF(bx, Y + 9, rz), RGB(96, 84, 70), MAT.WoodPlanks)
  -- 井架和天轮
  local hx, hz = 13, -8
  for _, o in ipairs({ { -2.4, -2.4 }, { 2.4, -2.4 }, { -2.4, 2.4 }, { 2.4, 2.4 } }) do rod(m, base, V(hx + o[1] * 1.6, Y, hz + o[2] * 1.6), V(hx + o[1] * 0.5, Y + 16, hz + o[2] * 0.5), 0.6, RGB(150, 60, 44)) end
  for k = 1, 3 do block(m, base, V(6.4 - k * 1.1, 0.4, 6.4 - k * 1.1), CF(hx, Y + k * 4.4, hz), RGB(150, 60, 44), MAT.Metal) end
  local wheelC = CF(hx, Y + 17.6, hz)
  spinAbout(block(m, base, V(0.5, 5.4, 5.4), wheelC, RGB(70, 72, 78), MAT.Metal, CYL), (base * wheelC).Position, V(1, 0, 0), 0.25)
  for _, a in ipairs({ 0, 60, 120 }) do spinAbout(block(m, base, V(0.6, 5.0, 0.35), wheelC * CFrame.Angles(math.rad(a), 0, 0), RGB(200, 170, 50), MAT.Metal), (base * wheelC).Position, V(1, 0, 0), 0.25) end
  ghostly(block(m, base, V(0.15, 0.15, 14), CF(hx, Y + 17.6 - 2.6, hz + 6.5) * CFrame.Angles(math.rad(-48), 0, 0), C.dark, MAT.Metal))
  -- 矿石堆
  for _, p in ipairs({ { 18, 13, 7 }, { 13, 14.5, 5 }, { 22, 6, 5 } }) do
    block(m, base, V(p[3], p[3], p[3]), CF(p[1], Y - p[3] * 0.25, p[2]), RGB(74, 62, 52), MAT.Pebble, BALL)
  end
  facadeSign(m, base, CF(bx, Y + 11.6, rz + 3.35), 7, 1.4, "矿  场", RGB(255, 226, 140), Enum.NormalId.Back)
  return body
end

-- 核电站：两座冷却塔（一节节收腰的塔身，顶上冒白汽、塔顶红色航空障碍灯）、圆顶反应堆、汽轮机厂房、变压器和电线杆、辐射警告牌
local function nuclear(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(156, 156, 150), MAT.Concrete)
  local Y = 0.6
  local CON = RGB(222, 222, 216)
  for _, tx in ipairs({ -17, 5 }) do
    local tz = 7
    local y = Y
    for _, sec in ipairs({ { 21, 7 }, { 18.5, 7 }, { 16.5, 7 }, { 16.8, 6 }, { 18, 6 } }) do
      cyl(m, base, sec[2], sec[1], CF(tx, y + sec[2] / 2, tz), CON, MAT.Concrete)
      y = y + sec[2]
    end
    cyl(m, base, 0.6, 18.4, CF(tx, y + 0.3, tz), RGB(170, 170, 166), MAT.Concrete)
    local hole = ghostly(cyl(m, base, 0.2, 15.6, CF(tx, y + 0.65, tz), RGB(40, 42, 44), MAT.SmoothPlastic))
    -- 白汽：大团、慢慢往上飘、被风吹歪
    local e = smoke(hole, RGB(250, 250, 252), 10, 26, 4, 11, 5)
    e.SpreadAngle = Vector2.new(8, 8)
    e.Acceleration = V(1.6, 0.5, 0.6)
    e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.2, 0.25), NumberSequenceKeypoint.new(1, 1) })
    for _, sx in ipairs({ -1, 1 }) do anim(ghostly(block(m, base, V(0.8, 0.8, 0.8), CF(tx + sx * 9.1, y + 0.9, tz), RGB(255, 40, 30), MAT.Neon)), "blink", 0.7) end
  end
  -- 反应堆：圆柱 + 圆顶
  local rx, rz = 21, -12
  cyl(m, base, 14, 15, CF(rx, Y + 7, rz), RGB(206, 206, 200), MAT.Concrete)
  block(m, base, V(15, 15, 15), CF(rx, Y + 14, rz), RGB(214, 214, 208), MAT.Concrete, BALL)
  for _, a in ipairs({ 0, 120, 240 }) do ghostly(block(m, base, V(15.2, 0.6, 0.6), CF(rx, Y + 9 + a / 60, rz) * CFrame.Angles(0, math.rad(a), 0), RGB(170, 170, 166), MAT.Concrete)) end
  -- 汽轮机厂房、连廊
  block(m, base, V(22, 11, 11), CF(-1, Y + 5.5, -16), RGB(96, 120, 150), MAT.Metal)
  block(m, base, V(22.4, 1.2, 11.4), CF(-1, Y + 8.4, -16), C.glass, MAT.Glass)
  block(m, base, V(6, 4, 4), CF(12.5, Y + 6, -14), RGB(170, 170, 166), MAT.Concrete)
  -- 变压器、电线杆
  for k = 0, 2 do
    block(m, base, V(3, 3.4, 2.4), CF(-26 + k * 4.2, Y + 1.7, -18), RGB(110, 116, 110), MAT.Metal)
    for j = 0, 2 do cyl(m, base, 1.4, 0.35, CF(-26.8 + k * 4.2 + j * 0.8, Y + 4.1, -18), RGB(140, 100, 70), MAT.Glass) end
  end
  for _, px in ipairs({ -27, -15 }) do
    block(m, base, V(0.8, 16, 0.8), CF(px, Y + 8, -22.5), RGB(120, 124, 130), MAT.Metal)
    block(m, base, V(7, 0.5, 0.6), CF(px, Y + 15.4, -22.5), RGB(120, 124, 130), MAT.Metal)
  end
  for _, sz in ipairs({ -2.8, 0, 2.8 }) do ghostly(block(m, base, V(12, 0.1, 0.1), CF(-21, Y + 15.9, -22.5 + sz * 0.1), C.dark, MAT.Metal)) end
  -- 辐射警告牌（黄底黑圈）
  for _, sx in ipairs({ -8, 8 }) do
    block(m, base, V(0.3, 4, 0.3), CF(rx + sx, Y + 2, rz + 9.5), RGB(90, 90, 94), MAT.Metal)
    local sign = block(m, base, V(3, 3, 0.2), CF(rx + sx, Y + 4.5, rz + 9.5), RGB(240, 200, 30), MAT.SmoothPlastic)
    ghostly(cyl(m, base, 0.22, 1.6, CF(rx + sx, Y + 4.5, rz + 9.6) * CFrame.Angles(math.rad(90), 0, 0), RGB(30, 30, 30), MAT.SmoothPlastic))
    sign.CastShadow = false
  end
  facadeSign(m, base, CF(-1, Y + 12.2, -10.35), 12, 1.8, "核 电 站", RGB(255, 226, 140), Enum.NormalId.Back)
  return body
end

-- 雷达站：钢架塔顶上一面大雷达天线一直转（天线板、底框、馈源支臂绕塔的竖轴一起转）；白色球形雷达罩、两个设备方舱、带红灯的天线杆
local function radarStation(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(150, 150, 144), MAT.Concrete)
  local Y = 0.6
  local STEEL, WHITE = RGB(120, 124, 130), RGB(232, 232, 226)
  local tz = -3
  for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do rod(m, base, V(o[1] * 4.4, Y, tz + o[2] * 4.4), V(o[1] * 1.5, Y + 14, tz + o[2] * 1.5), 0.5, STEEL) end
  for k = 1, 3 do block(m, base, V(8.8 - k * 1.8, 0.35, 8.8 - k * 1.8), CF(0, Y + k * 3.6, tz), STEEL, MAT.Metal) end
  block(m, base, V(4.6, 1.0, 4.6), CF(0, Y + 14.4, tz), RGB(90, 92, 96), MAT.Metal)
  local dc = CF(0, Y + 18.2, tz)
  local piv, up = (base * dc).Position, V(0, 1, 0)
  anim(block(m, base, V(1.8, 1.6, 1.8), CF(0, Y + 15.7, tz), RGB(70, 72, 76), MAT.Metal), "spin", 0.18)
  spinAbout(block(m, base, V(11, 4.6, 0.5), dc * CF(0, 0, -0.9) * CFrame.Angles(math.rad(-14), 0, 0), WHITE, MAT.SmoothPlastic), piv, up, 0.18)
  spinAbout(block(m, base, V(11.4, 0.45, 0.9), dc * CF(0, -2.4, -0.5), STEEL, MAT.Metal), piv, up, 0.18)
  spinAbout(block(m, base, V(0.6, 2.6, 0.6), dc * CF(0, -1.3, 0.2), STEEL, MAT.Metal), piv, up, 0.18)
  spinAbout(block(m, base, V(0.3, 0.3, 4.2), dc * CF(0, 0.3, -3.2), STEEL, MAT.Metal), piv, up, 0.18)
  spinAbout(block(m, base, V(1.0, 1.0, 1.0), dc * CF(0, 0.3, -5.3), RGB(60, 62, 66), MAT.Metal), piv, up, 0.18)
  -- 球形雷达罩
  cyl(m, base, 2.4, 8, CF(8, Y + 1.2, 7), RGB(170, 170, 166), MAT.Concrete)
  block(m, base, V(9, 9, 9), CF(8, Y + 6.2, 7), WHITE, MAT.SmoothPlastic, BALL)
  -- 设备方舱（门、空调外机）
  for i, sz in ipairs({ 8, 2 }) do
    block(m, base, V(6.4, 3.4, 4.2), CF(-7.5, Y + 1.7, sz), RGB(92, 104, 74), MAT.Metal)
    block(m, base, V(1.4, 2.4, 0.15), CF(-7.5 + 1.6, Y + 1.2, sz + 2.15), C.dark, MAT.Metal)
    block(m, base, V(1.4, 1.0, 0.9), CF(-7.5 - 1.8, Y + 0.5, sz + 2.6), RGB(190, 192, 190), MAT.Metal)
    if i == 1 then facadeSign(m, base, CF(-7.5, Y + 2.6, sz + 2.2), 5.6, 1.1, "雷 达 站", RGB(255, 226, 140), Enum.NormalId.Back) end
  end
  -- 天线杆和顶上的红灯
  cyl(m, base, 19, 0.45, CF(10, Y + 9.5, -9), STEEL, MAT.Metal)
  anim(ghostly(block(m, base, V(0.8, 0.8, 0.8), CF(10, Y + 19.3, -9), RGB(255, 40, 30), MAT.Neon)), "blink", 0.8)
  for _, a in ipairs({ 0, 120, 240 }) do
    local r = math.rad(a)
    ghostly(rod(m, base, V(10, Y + 17, -9), V(10 + math.cos(r) * 6, Y, -9 + math.sin(r) * 6), 0.08, C.dark))
  end
  return body
end

-- 导弹发射井：带黄黑警示圈的混凝土台子，中间井口上两扇井盖（DoorL / DoorR：放「巡航导弹」时客户端把它们滑开、冒烟，导弹从井里升空），
--   井里白色的弹头，控制地堡（门、潜望镜、天线、状态灯），四角的警示灯，旁边停着一辆导弹运输车
local function missileSilo(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 1.2, d), CF(0, 0.6, 0), RGB(140, 140, 134), MAT.Concrete)
  local Y = 1.2
  local sx, sz = -2, -3   -- 井口中心
  ghostly(cyl(m, base, 0.06, 15, CF(sx, Y + 0.03, sz), RGB(236, 196, 40), MAT.SmoothPlastic))
  for k = 0, 7 do   -- 警示圈上的黑条
    local a = k * math.pi / 4
    ghostly(block(m, base, V(1.2, 0.08, 3.4), CF(sx + math.cos(a) * 6.6, Y + 0.05, sz + math.sin(a) * 6.6) * CFrame.Angles(0, -a, 0), RGB(30, 30, 30), MAT.SmoothPlastic))
  end
  ghostly(cyl(m, base, 0.1, 10, CF(sx, Y + 0.08, sz), RGB(16, 16, 18), MAT.SmoothPlastic))
  block(m, base, V(2.8, 2.8, 2.8), CF(sx, Y - 0.8, sz), RGB(240, 240, 236), MAT.SmoothPlastic, BALL)
  ghostly(block(m, base, V(1.0, 1.0, 1.0), CF(sx, Y + 0.3, sz), RGB(200, 50, 40), MAT.SmoothPlastic, BALL))
  for _, side in ipairs({ { "DoorL", -1 }, { "DoorR", 1 } }) do
    local x = sx + side[2] * 2.6
    local door = block(m, base, V(5.2, 0.6, 11), CF(x, Y + 0.45, sz), RGB(96, 102, 92), MAT.DiamondPlate)
    door.Name = side[1]
    for _, oz in ipairs({ -3, 0, 3 }) do
      local st = ghostly(block(m, base, V(4.6, 0.06, 1.0), CF(x, Y + 0.78, sz + oz) * CFrame.Angles(0, math.rad(35), 0), RGB(236, 196, 40), MAT.SmoothPlastic))
      st.Name = side[1]
    end
  end
  -- 控制地堡
  local bx, bz = -7, 8.5
  block(m, base, V(9, 4.2, 6.5), CF(bx, Y + 2.1, bz), RGB(120, 124, 112), MAT.Concrete)
  block(m, base, V(9.6, 0.6, 7.1), CF(bx, Y + 4.5, bz), RGB(100, 104, 94), MAT.Concrete)
  block(m, base, V(1.8, 2.8, 0.2), CF(bx + 2.2, Y + 1.4, bz - 3.3), C.dark, MAT.Metal)
  cyl(m, base, 2.6, 0.4, CF(bx - 2.5, Y + 6.1, bz), C.dark, MAT.Metal)
  ghostly(cyl(m, base, 5, 0.12, CF(bx + 3.4, Y + 7.3, bz + 2), C.dark, MAT.Metal))
  anim(ghostly(block(m, base, V(0.6, 0.4, 0.12), CF(bx - 1.2, Y + 2.9, bz - 3.3), RGB(90, 255, 120), MAT.Neon)), "blink", 1.2)
  facadeSign(m, base, CF(bx, Y + 3.3, bz - 3.35), 7, 1.1, "导弹发射井", RGB(255, 226, 140), Enum.NormalId.Front)
  -- 四角警示灯
  for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
    cyl(m, base, 1.4, 0.6, CF(o[1] * (w / 2 - 1.2), Y + 0.7, o[2] * (d / 2 - 1.2)), RGB(80, 80, 84), MAT.Metal)
    anim(ghostly(block(m, base, V(0.7, 0.7, 0.7), CF(o[1] * (w / 2 - 1.2), Y + 1.7, o[2] * (d / 2 - 1.2)), RGB(255, 120, 30), MAT.Neon)), "blink", 1.4)
  end
  -- 导弹运输车（车头朝 −Z，车上一根发射筒）
  local tx, tz = 8.5, 4
  for _, ox in ipairs({ -1.6, 1.6 }) do
    for _, oz in ipairs({ -4.2, -1.6, 1.6, 4.2 }) do block(m, base, V(0.8, 2.0, 2.0), CF(tx + ox, Y + 1.0, tz + oz), RGB(30, 30, 32), MAT.SmoothPlastic, CYL) end
  end
  block(m, base, V(3.6, 0.8, 12), CF(tx, Y + 1.9, tz), RGB(60, 66, 52), MAT.Metal)
  block(m, base, V(3.4, 2.6, 2.8), CF(tx, Y + 3.6, tz - 5.2), RGB(84, 96, 64), MAT.Metal)
  block(m, base, V(3.0, 1.0, 0.2), CF(tx, Y + 4.2, tz - 6.65), RGB(60, 90, 110), MAT.Glass)
  block(m, base, V(9.6, 2.2, 2.2), CF(tx, Y + 3.6, tz + 1.2) * CFrame.Angles(0, math.pi / 2, 0), RGB(84, 96, 64), MAT.Metal, CYL)
  block(m, base, V(0.3, 2.3, 2.3), CF(tx, Y + 3.6, tz + 6.0) * CFrame.Angles(0, math.pi / 2, 0), RGB(60, 62, 56), MAT.Metal, CYL)
  return body
end

---------------------------------------------------------------- 重生开放的新区域：港口区、导弹基地、航天中心

-- 一排集装箱（两层、颜色随机）
local CONT = { RGB(176, 64, 48), RGB(52, 104, 160), RGB(214, 160, 40), RGB(70, 130, 80), RGB(150, 150, 154), RGB(200, 96, 40) }
local function containers(m, base, x0, z, n, rng)
  for i = 0, n - 1 do
    for tier = 0, (rng:NextNumber() < 0.6) and 1 or 0 do
      local c = CONT[rng:NextInteger(1, #CONT)]
      block(m, base, V(5.8, 5.2, 2.6), CF(x0 + i * 6.2, 0.6 + 2.6 + tier * 5.3, z), c, MAT.CorrodedMetal)
    end
  end
end

-- 码头仓库：瓦楞铁皮的大仓库（两扇卷帘门、屋顶天窗）、门口两排集装箱、一台叉车、系船柱
local function dockWarehouse(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  local rng = Random.new(301)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(150, 150, 144), MAT.Concrete)
  local Y = 0.6
  local hw, hd = w * 0.6, d * 0.86
  local wx = -w / 2 + hw / 2 + 1
  block(m, base, V(hw, h - 1.5, hd), CF(wx, Y + (h - 1.5) / 2, 0), RGB(170, 160, 140), MAT.CorrodedMetal)
  block(m, base, V(hw + 1, 1, hd + 1), CF(wx, Y + h - 1, 0), RGB(96, 100, 104), MAT.Metal)
  for _, oz in ipairs({ -hd * 0.22, hd * 0.22 }) do
    block(m, base, V(0.3, h * 0.55, hd * 0.3), CF(wx + hw / 2 + 0.1, Y + h * 0.275, oz), RGB(70, 74, 78), MAT.DiamondPlate)
  end
  for k = -1, 1 do block(m, base, V(hw * 0.7, 0.4, 2), CF(wx, Y + h - 0.4, k * hd * 0.28), C.glass, MAT.Glass) end
  facadeSign(m, base, CF(wx + hw / 2 + 0.25, Y + h * 0.78, 0) * CFrame.Angles(0, math.pi / 2, 0), 14, 2.2, "码 头 仓 库", RGB(255, 226, 140))
  local cx = wx + hw / 2 + 4
  containers(m, base, cx, d * 0.32, 2, rng)
  containers(m, base, cx, -d * 0.36, 2, rng)
  -- 叉车：车身、门架、货叉
  local fx, fz = cx + 3, 0
  block(m, base, V(2.4, 1.6, 3.6), CF(fx, Y + 1.4, fz), RGB(236, 180, 30), MAT.Metal)
  block(m, base, V(2.2, 1.6, 0.3), CF(fx, Y + 2.9, fz + 0.6), C.dark, MAT.Metal)
  block(m, base, V(0.3, 4.2, 0.3), CF(fx - 0.9, Y + 2.7, fz - 1.9), C.dark, MAT.Metal)
  block(m, base, V(0.3, 4.2, 0.3), CF(fx + 0.9, Y + 2.7, fz - 1.9), C.dark, MAT.Metal)
  block(m, base, V(2.2, 0.2, 2.2), CF(fx, Y + 0.9, fz - 3), C.dark, MAT.Metal)
  for _, ox in ipairs({ -w / 2 + 4, 0, w / 2 - 4 }) do cyl(m, base, 1.4, 1.2, CF(ox, Y + 0.7, -d / 2 + 1.5), RGB(40, 40, 42), MAT.Metal) end
  return body
end

-- 造船厂：干船坞里一条造了一半的军舰（灰色船体、上层建筑、炮塔）、跨在船坞上的龙门吊（小车来回、顶上红灯）
local function shipyard(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(140, 140, 136), MAT.Concrete)
  local Y = 0.6
  -- 船坞：两边的坞墙、坞底
  block(m, base, V(w * 0.9, 0.2, d * 0.5), CF(0, Y + 0.1, 0), RGB(60, 64, 70), MAT.Concrete)
  for _, sz in ipairs({ -1, 1 }) do block(m, base, V(w * 0.9, 3, 2), CF(0, Y + 1.5, sz * d * 0.26), RGB(120, 120, 116), MAT.Concrete) end
  -- 船：船体（船头收窄）、甲板、舰桥、桅杆、主炮
  local HULL = RGB(120, 128, 136)
  block(m, base, V(w * 0.62, 4.2, d * 0.3), CF(-w * 0.06, Y + 2.3, 0), HULL, MAT.Metal)
  block(m, base, V(w * 0.16, 4.2, d * 0.21), CF(w * 0.31, Y + 2.3, 0), HULL, MAT.Metal)
  block(m, base, V(w * 0.08, 4.2, d * 0.11), CF(w * 0.42, Y + 2.3, 0), HULL, MAT.Metal)
  block(m, base, V(w * 0.86, 0.3, d * 0.3), CF(w * 0.05, Y + 4.55, 0), RGB(96, 100, 104), MAT.Metal)
  block(m, base, V(w * 0.18, 5, d * 0.2), CF(-w * 0.12, Y + 7.2, 0), RGB(150, 156, 162), MAT.Metal)
  block(m, base, V(w * 0.12, 3, d * 0.16), CF(-w * 0.14, Y + 11.2, 0), RGB(150, 156, 162), MAT.Metal)
  block(m, base, V(w * 0.12, 0.8, d * 0.165), CF(-w * 0.14, Y + 11.6, 0), C.glass, MAT.Glass)
  cyl(m, base, 8, 0.5, CF(-w * 0.14, Y + 16.6, 0), C.metal, MAT.Metal)
  block(m, base, V(3.2, 1.6, 3.2), CF(w * 0.22, Y + 5.5, 0), RGB(140, 146, 152), MAT.Metal)
  block(m, base, V(4, 0.4, 0.4), CF(w * 0.22 + 2.4, Y + 5.7, 0), C.gun, MAT.Metal)
  -- 焊花（一闪一闪）
  for _, p in ipairs({ { w * 0.1, 3.5 }, { -w * 0.3, 2.6 } }) do anim(ghostly(block(m, base, V(0.7, 0.7, 0.7), CF(p[1], Y + p[2], d * 0.15 + 0.4), RGB(180, 220, 255), MAT.Neon)), "blink", 2.6) end
  -- 龙门吊：两条腿、横梁、小车、吊钩
  local GY = RGB(236, 180, 30)
  for _, sx in ipairs({ -1, 1 }) do
    for _, sz in ipairs({ -1, 1 }) do block(m, base, V(1.4, h - 2, 1.4), CF(sx * w * 0.2, Y + (h - 2) / 2, sz * d * 0.4), GY, MAT.Metal) end
    block(m, base, V(1.6, 1.6, d * 0.84), CF(sx * w * 0.2, Y + h - 1.4, 0), GY, MAT.Metal)
  end
  block(m, base, V(w * 0.44, 1.8, 2), CF(0, Y + h - 0.2, 0), GY, MAT.Metal)
  block(m, base, V(3, 1.6, 3), CF(w * 0.05, Y + h - 1.8, 0), C.dark, MAT.Metal)
  ghostly(block(m, base, V(0.15, 8, 0.15), CF(w * 0.05, Y + h - 6.6, 0), C.dark, MAT.Metal))
  block(m, base, V(1.2, 1, 1.2), CF(w * 0.05, Y + h - 11, 0), GY, MAT.Metal)
  for _, sx in ipairs({ -1, 1 }) do anim(ghostly(block(m, base, V(0.8, 0.8, 0.8), CF(sx * w * 0.2, Y + h + 0.4, 0), RGB(255, 40, 30), MAT.Neon)), "blink", 0.8) end
  facadeSign(m, base, CF(0, Y + 4, -d / 2 + 0.6), 14, 2.2, "造 船 厂", RGB(255, 226, 140), Enum.NormalId.Front)
  return body
end

-- 海军司令部：白楼蓝腰线、玻璃大门、楼顶转的雷达、两根旗杆、门口的锚
local function navalHQ(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(160, 160, 156), MAT.Concrete)
  local Y = 0.6
  local WH, BL = RGB(236, 238, 240), RGB(40, 80, 150)
  block(m, base, V(w * 0.9, h * 0.62, d * 0.7), CF(0, Y + h * 0.31, 0), WH, MAT.SmoothPlastic)
  block(m, base, V(w * 0.92, 1.4, d * 0.72), CF(0, Y + h * 0.22, 0), BL, MAT.SmoothPlastic)
  block(m, base, V(w * 0.92, 1, d * 0.72), CF(0, Y + h * 0.62, 0), RGB(200, 204, 208), MAT.Concrete)
  for k = -2, 2 do block(m, base, V(w * 0.1, h * 0.18, 0.2), CF(k * w * 0.17, Y + h * 0.43, -d * 0.35 - 0.05), C.glass, MAT.Glass) end
  block(m, base, V(w * 0.3, h * 0.3, d * 0.4), CF(0, Y + h * 0.77, 0), WH, MAT.SmoothPlastic)
  block(m, base, V(w * 0.2, h * 0.22, 0.4), CF(0, Y + h * 0.13, -d * 0.35 - 0.1), C.glass, MAT.Glass)
  -- 雷达：杆子 + 转的天线
  local rx, rz = w * 0.08, 0
  cyl(m, base, 6, 0.8, CF(rx, Y + h * 0.92 + 3, rz), C.metal, MAT.Metal)
  local piv = (base * CF(rx, 0, rz)).Position
  spinAbout(block(m, base, V(9, 1.6, 0.6), CF(rx, Y + h * 0.92 + 6.4, rz), RGB(220, 222, 226), MAT.Metal), piv, V(0, 1, 0), 0.25)
  spinAbout(block(m, base, V(1, 1, 1.6), CF(rx, Y + h * 0.92 + 6.4, rz - 0.8), C.dark, MAT.Metal), piv, V(0, 1, 0), 0.25)
  for _, sx in ipairs({ -1, 1 }) do flag(m, base, CF(sx * w * 0.42, 0, -d * 0.45), (sx < 0) and BL or RGB(200, 40, 40)) end
  -- 锚：竖杆、横杆、两个爪
  local ax, az = -w * 0.3, -d * 0.45
  block(m, base, V(0.6, 4, 0.6), CF(ax, Y + 2.6, az), C.dark, MAT.Metal)
  block(m, base, V(3, 0.5, 0.5), CF(ax, Y + 3.8, az), C.dark, MAT.Metal)
  block(m, base, V(3.6, 0.5, 0.5), CF(ax, Y + 0.9, az), C.dark, MAT.Metal)
  facadeSign(m, base, CF(0, Y + h * 0.53, -d * 0.35 - 0.2), 14, 2, "海 军 司 令 部", RGB(255, 230, 150), Enum.NormalId.Front)
  return body
end

-- 推进剂工厂：三个球形储罐（支腿、黄黑警示带）、管廊、控制楼、火炬（一直烧着）
local function propellantPlant(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(150, 146, 136), MAT.Concrete)
  local Y = 0.6
  for i, tx in ipairs({ -w * 0.3, 0, w * 0.3 }) do
    local tz, r = d * 0.12, 11 - i
    for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do block(m, base, V(0.6, r * 0.7, 0.6), CF(tx + o[1] * r * 0.32, Y + r * 0.35, tz + o[2] * r * 0.32), C.metal, MAT.Metal) end
    block(m, base, V(r, r, r), CF(tx, Y + r * 0.62 + r * 0.3, tz), RGB(236, 236, 232), MAT.SmoothPlastic, BALL)
    ghostly(block(m, base, V(r + 0.2, 0.5, r + 0.2), CF(tx, Y + r * 0.62 + r * 0.3, tz), RGB(236, 190, 40), MAT.SmoothPlastic, CYL) )
  end
  -- 管廊
  block(m, base, V(w * 0.85, 0.6, 0.6), CF(0, Y + 4.5, -d * 0.18), RGB(170, 60, 50), MAT.Metal)
  block(m, base, V(w * 0.85, 0.6, 0.6), CF(0, Y + 5.4, -d * 0.18), RGB(60, 110, 170), MAT.Metal)
  for k = -2, 2 do block(m, base, V(0.5, 5.4, 0.5), CF(k * w * 0.2, Y + 2.7, -d * 0.18), C.metal, MAT.Metal) end
  -- 控制楼
  block(m, base, V(12, 6, 8), CF(-w * 0.3, Y + 3, -d * 0.36), RGB(200, 196, 186), MAT.Concrete)
  block(m, base, V(12.2, 1.2, 8.2), CF(-w * 0.3, Y + 4.4, -d * 0.36), C.glass, MAT.Glass)
  facadeSign(m, base, CF(-w * 0.3, Y + 7, -d * 0.36 - 4.2), 12, 1.8, "推 进 剂 工 厂", RGB(255, 226, 140), Enum.NormalId.Front)
  -- 火炬
  local fx, fz = w * 0.38, -d * 0.36
  cyl(m, base, h, 1, CF(fx, Y + h / 2, fz), C.metal, MAT.Metal)
  local fl = anim(ghostly(block(m, base, V(1.6, 2.4, 1.6), CF(fx, Y + h + 1.2, fz), RGB(255, 140, 40), MAT.Neon, BALL)), "blink", 3)
  local fire = Instance.new("Fire")
  fire.Size = 4
  fire.Heat = 9
  fire.Parent = fl
  return body
end

-- 导弹总装厂：高大的总装厂房（带黄黑条的大门、天窗）、门口运输车上一枚整弹（弹体、弹头、尾翼）
local function missileAssembly(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(146, 146, 140), MAT.Concrete)
  local Y = 0.6
  local hz = d * 0.12
  block(m, base, V(w * 0.86, h - 2, d * 0.62), CF(0, Y + (h - 2) / 2, hz), RGB(178, 176, 166), MAT.Concrete)
  block(m, base, V(w * 0.88, 1.2, d * 0.64), CF(0, Y + h - 1.4, hz), RGB(110, 112, 116), MAT.Metal)
  block(m, base, V(w * 0.44, h * 0.62, 0.4), CF(0, Y + h * 0.31, hz - d * 0.31 - 0.1), RGB(70, 74, 80), MAT.DiamondPlate)
  for k = 0, 5 do
    ghostly(block(m, base, V(1.4, h * 0.62, 0.1), CF(-w * 0.2 + k * w * 0.08, Y + h * 0.31, hz - d * 0.31 - 0.35), (k % 2 == 0) and RGB(236, 190, 40) or RGB(30, 30, 30), MAT.SmoothPlastic))
  end
  facadeSign(m, base, CF(0, Y + h * 0.78, hz - d * 0.31 - 0.3), 16, 2.4, "导 弹 总 装 厂", RGB(255, 226, 140), Enum.NormalId.Front)
  -- 运输车 + 导弹
  local tx, tz = w * 0.18, -d * 0.36
  block(m, base, V(22, 1.4, 4), CF(tx, Y + 1.6, tz), RGB(70, 84, 60), MAT.Metal)
  block(m, base, V(4, 3.4, 4), CF(tx + 12, Y + 2.6, tz), RGB(78, 94, 66), MAT.Metal)
  for k = 0, 4 do
    for _, sz in ipairs({ -1.9, 1.9 }) do block(m, base, V(1.8, 1.8, 0.8), CF(tx - 9 + k * 5, Y + 0.9, tz + sz), RGB(30, 30, 32), MAT.SmoothPlastic, CYL) end
  end
  local MS = RGB(228, 230, 226)
  block(m, base, V(18, 2.6, 2.6), CF(tx - 1, Y + 3.8, tz), MS, MAT.SmoothPlastic, CYL)
  block(m, base, V(2.6, 2.6, 2.6), CF(tx + 8.2, Y + 3.8, tz), RGB(60, 64, 60), MAT.SmoothPlastic, BALL)
  for _, a in ipairs({ 0, math.pi / 2 }) do block(m, base, V(2.4, 4.4, 0.2), CF(tx - 9, Y + 3.8, tz) * CFrame.Angles(a, 0, 0), RGB(60, 64, 60), MAT.Metal) end
  ghostly(block(m, base, V(2, 0.1, 2.7), CF(tx + 3, Y + 5.1, tz), RGB(200, 40, 40), MAT.SmoothPlastic))
  return body
end

-- 战略导弹营：两辆起竖的导弹发射车（发射筒斜着竖起来）、半埋的指挥掩体、伪装网
local function strategicBattalion(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(126, 130, 116), MAT.Concrete)
  local Y = 0.6
  local GR = RGB(70, 84, 58)
  for i, tx in ipairs({ -w * 0.22, w * 0.22 }) do
    local tz = d * 0.05
    block(m, base, V(4.4, 1.6, 20), CF(tx, Y + 2, tz), GR, MAT.Metal)
    block(m, base, V(4.4, 3.2, 4), CF(tx, Y + 2.6, tz - 10.5), RGB(80, 96, 64), MAT.Metal)
    block(m, base, V(4.2, 1, 0.2), CF(tx, Y + 3.4, tz - 12.55), C.glass, MAT.Glass)
    for k = 0, 3 do
      for _, sx in ipairs({ -2.3, 2.3 }) do block(m, base, V(0.9, 2, 2), CF(tx + sx, Y + 1, tz - 7 + k * 4.6), RGB(30, 30, 32), MAT.SmoothPlastic, CYL) end
    end
    local ang = (i == 1) and math.rad(62) or math.rad(40)   -- 一辆竖着，一辆在起竖
    block(m, base, V(2.8, 2.8, 18), CF(tx, Y + 3.2, tz + 6) * CFrame.Angles(ang, 0, 0) * CF(0, 0, -6), RGB(96, 110, 80), MAT.Metal)
    ghostly(block(m, base, V(2.9, 0.4, 0.4), CF(tx, Y + 3.2, tz + 6) * CFrame.Angles(ang, 0, 0) * CF(0, 1.5, -10), RGB(200, 40, 40), MAT.SmoothPlastic))
  end
  -- 掩体
  block(m, base, V(12, 4, 8), CF(0, Y + 2, -d * 0.38), RGB(120, 124, 110), MAT.Concrete)
  block(m, base, V(13, 0.8, 9), CF(0, Y + 4.4, -d * 0.38), RGB(100, 104, 92), MAT.Concrete)
  block(m, base, V(2.4, 2.8, 0.2), CF(0, Y + 1.4, -d * 0.38 - 4.05), C.dark, MAT.Metal)
  anim(ghostly(block(m, base, V(0.6, 0.4, 0.12), CF(1.8, Y + 3, -d * 0.38 - 4.05), RGB(90, 255, 120), MAT.Neon)), "blink", 1.1)
  local net = block(m, base, V(w * 0.9, 0.3, d * 0.5), CF(0, Y + 13.5, d * 0.08), RGB(80, 98, 58), MAT.Fabric)
  net.Transparency = 0.35
  for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do cyl(m, base, 13.5, 0.4, CF(o[1] * w * 0.44, Y + 6.75, d * 0.08 + o[2] * d * 0.24), RGB(90, 74, 50), MAT.Wood) end
  facadeSign(m, base, CF(0, Y + 6.2, -d * 0.38 - 4.6), 12, 1.8, "战 略 导 弹 营", RGB(255, 226, 140), Enum.NormalId.Front)
  return body
end

-- 卫星工厂：白色洁净厂房（一排窗、蓝色腰线）、屋顶一颗卫星样机（本体、两块太阳能板）、旁边三面测试天线
local function satelliteFactory(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(176, 178, 182), MAT.Concrete)
  local Y = 0.6
  local WH = RGB(240, 242, 246)
  block(m, base, V(w * 0.72, h * 0.6, d * 0.7), CF(-w * 0.1, Y + h * 0.3, 0), WH, MAT.SmoothPlastic)
  block(m, base, V(w * 0.73, 1, d * 0.71), CF(-w * 0.1, Y + h * 0.2, 0), RGB(50, 110, 200), MAT.SmoothPlastic)
  for k = -3, 3 do block(m, base, V(w * 0.06, h * 0.14, 0.2), CF(-w * 0.1 + k * w * 0.09, Y + h * 0.42, -d * 0.35 - 0.05), C.glass, MAT.Glass) end
  -- 卫星样机
  local sx, sy = -w * 0.1, Y + h * 0.6
  block(m, base, V(4, 4, 4), CF(sx, sy + 2.6, 0), RGB(214, 170, 60), MAT.Foil)
  for _, o in ipairs({ -1, 1 }) do
    block(m, base, V(8, 0.2, 3.4), CF(sx + o * 6.4, sy + 2.6, 0), RGB(30, 50, 110), MAT.Glass)
    block(m, base, V(1.6, 0.2, 0.2), CF(sx + o * 2.6, sy + 2.6, 0), C.metal, MAT.Metal)
  end
  cyl(m, base, 0.6, 2.6, CF(sx, sy + 4.9, 0), RGB(230, 230, 230), MAT.SmoothPlastic)
  -- 测试天线（碗朝天，慢慢转）
  for i, ax in ipairs({ w * 0.32, w * 0.32, w * 0.42 }) do
    local az = (i == 1) and -d * 0.25 or ((i == 2) and d * 0.2 or -d * 0.02)
    cyl(m, base, 4, 0.8, CF(ax, Y + 2, az), C.metal, MAT.Metal)
    local dish = block(m, base, V(0.6, 6, 6), CF(ax, Y + 5, az) * CFrame.Angles(0, 0, math.rad(60)), RGB(236, 236, 232), MAT.SmoothPlastic, CYL)
    spinAbout(dish, (base * CF(ax, 0, az)).Position, V(0, 1, 0), 0.05 + i * 0.02)
  end
  facadeSign(m, base, CF(-w * 0.1, Y + h * 0.53, -d * 0.35 - 0.2), 14, 2, "卫 星 工 厂", RGB(120, 200, 255), Enum.NormalId.Front)
  return body
end

-- 火箭发射台：混凝土台、导流槽、钢架发射塔（顶上红灯、摆杆）、一枚立着的运载火箭（芯级、两个助推器、整流罩）
local function launchPad(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 1.2, d), CF(0, 0.6, 0), RGB(160, 160, 156), MAT.Concrete)
  local Y = 1.2
  block(m, base, V(w * 0.3, 0.2, d * 0.9), CF(0, Y + 0.05, 0), RGB(40, 40, 42), MAT.Concrete)
  -- 发射塔
  local tx, tz, tw = w * 0.28, 0, 6
  local ST = RGB(200, 70, 40)
  for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do block(m, base, V(0.8, h, 0.8), CF(tx + o[1] * tw / 2, Y + h / 2, tz + o[2] * tw / 2), ST, MAT.Metal) end
  for y = 6, h - 4, 8 do
    block(m, base, V(tw, 0.5, 0.5), CF(tx, Y + y, tz - tw / 2), ST, MAT.Metal)
    block(m, base, V(tw, 0.5, 0.5), CF(tx, Y + y, tz + tw / 2), ST, MAT.Metal)
    block(m, base, V(0.5, 0.5, tw), CF(tx - tw / 2, Y + y, tz), ST, MAT.Metal)
    block(m, base, V(0.5, 0.5, tw), CF(tx + tw / 2, Y + y, tz), ST, MAT.Metal)
  end
  for _, y in ipairs({ h * 0.45, h * 0.78 }) do block(m, base, V(tx - 4, 0.8, 1.6), CF(tx / 2 + 1, Y + y, tz), RGB(170, 170, 166), MAT.Metal) end
  anim(ghostly(block(m, base, V(1.2, 1.2, 1.2), CF(tx, Y + h + 0.6, tz), RGB(255, 40, 30), MAT.Neon)), "blink", 0.7)
  -- 火箭
  local RW = RGB(240, 240, 236)
  local rh = h * 0.86
  cyl(m, base, rh * 0.8, 6, CF(0, Y + 1 + rh * 0.4, 0), RW, MAT.SmoothPlastic)
  for _, k in ipairs({ { 0.86, 5.4 }, { 0.92, 4.2 }, { 0.97, 2.6 } }) do cyl(m, base, rh * 0.06, k[2], CF(0, Y + 1 + rh * k[1], 0), RW, MAT.SmoothPlastic) end
  block(m, base, V(2, 2, 2), CF(0, Y + 1 + rh, 0), RW, MAT.SmoothPlastic, BALL)
  for _, y in ipairs({ 0.25, 0.55 }) do cyl(m, base, 1.2, 6.1, CF(0, Y + 1 + rh * y, 0), RGB(30, 30, 32), MAT.SmoothPlastic) end
  for _, sx in ipairs({ -1, 1 }) do
    cyl(m, base, rh * 0.4, 2.8, CF(sx * 4.4, Y + 1 + rh * 0.2, 0), RW, MAT.SmoothPlastic)
    block(m, base, V(2.8, 2.8, 2.8), CF(sx * 4.4, Y + 1 + rh * 0.4, 0), RW, MAT.SmoothPlastic, BALL)
  end
  ghostly(block(m, base, V(0.2, rh * 0.3, 3), CF(-3.05, Y + 1 + rh * 0.5, 0), RGB(200, 40, 40), MAT.SmoothPlastic))
  facadeSign(m, base, CF(0, Y + 3, -d / 2 + 0.6), 14, 2.2, "火 箭 发 射 台", RGB(120, 200, 255), Enum.NormalId.Front)
  return body
end

-- 太空指挥中心：玻璃幕墙的指挥楼、半个圆顶、屋顶一面大天线（慢慢转）、天线杆
local function spaceCommand(m, base, b)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local body = hiddenBody(m, base, w, h, d)
  block(m, base, V(w, 0.6, d), CF(0, 0.3, 0), RGB(176, 178, 182), MAT.Concrete)
  local Y = 0.6
  block(m, base, V(w * 0.8, h * 0.45, d * 0.6), CF(0, Y + h * 0.225, d * 0.05), RGB(60, 70, 86), MAT.Metal)
  block(m, base, V(w * 0.81, h * 0.36, d * 0.605), CF(0, Y + h * 0.24, d * 0.05), RGB(90, 150, 200), MAT.Glass)
  block(m, base, V(w * 0.82, 1, d * 0.62), CF(0, Y + h * 0.45, d * 0.05), RGB(220, 222, 226), MAT.Concrete)
  block(m, base, V(w * 0.5, w * 0.5, w * 0.5), CF(-w * 0.12, Y + h * 0.45, d * 0.05), RGB(236, 238, 242), MAT.SmoothPlastic, BALL)
  -- 大天线：底座、斜着的碗、馈源
  local ax, az = w * 0.24, d * 0.05
  local piv = (base * CF(ax, 0, az)).Position
  cyl(m, base, 4, 2, CF(ax, Y + h * 0.45 + 2, az), C.metal, MAT.Metal)
  spinAbout(block(m, base, V(0.8, 11, 11), CF(ax, Y + h * 0.45 + 8, az) * CFrame.Angles(0, 0, math.rad(55)), RGB(240, 240, 236), MAT.SmoothPlastic, CYL), piv, V(0, 1, 0), 0.04)
  spinAbout(block(m, base, V(0.4, 0.4, 5), CF(ax + 2, Y + h * 0.45 + 10, az), C.dark, MAT.Metal), piv, V(0, 1, 0), 0.04)
  cyl(m, base, 9, 0.4, CF(-w * 0.36, Y + h * 0.45 + 4.5, -d * 0.1), C.metal, MAT.Metal)
  anim(ghostly(block(m, base, V(0.8, 0.8, 0.8), CF(-w * 0.36, Y + h * 0.45 + 9.2, -d * 0.1), RGB(255, 40, 30), MAT.Neon)), "blink", 0.9)
  facadeSign(m, base, CF(0, Y + h * 0.53, d * 0.05 - d * 0.3 - 0.2), 16, 2.2, "太 空 指 挥 中 心", RGB(120, 200, 255), Enum.NormalId.Front)
  return body
end

-- 新区域的地皮：开放了的铺地面、北边一条路接南门外的大路、竖区域名（港口区还有伸进湖里的码头）；
-- 没开放的围一圈铁丝网，路边立块牌子「第 n 次重生开放」，摆几个路障
function Models.area(f, origin, a, open, team)
  local base = CF(origin)
  local w, d = a.x1 - a.x0, a.z1 - a.z0
  local cx, cz = (a.x0 + a.x1) / 2, (a.z0 + a.z1) / 2
  local g = Instance.new("Folder")
  g.Name = "Area_" .. a.id
  if open then
    local col = (a.id == "port") and RGB(146, 148, 146) or ((a.id == "missile") and RGB(138, 136, 124) or RGB(178, 180, 186))
    block(g, base, V(w, 1, d), CF(cx, 0.5, cz), col, MAT.Concrete)
    ghostly(block(g, base, V(w - 6, 0.08, 10), CF(cx, 1.04, a.z1 - 8), C.asphalt, MAT.Asphalt))
    for x = a.x0 + 10, a.x1 - 10, 14 do ghostly(block(g, base, V(6, 0.06, 0.5), CF(x, 1.1, a.z1 - 8), C.white, MAT.SmoothPlastic)) end
    for _, x in ipairs({ a.x0 + 3, a.x1 - 3 }) do ghostly(block(g, base, V(0.6, 0.06, d - 4), CF(x, 1.06, cz), a.color, MAT.Neon)) end
    if a.id == "port" then   -- 码头：木栈桥伸进湖里、系船柱、一条小艇
      block(g, base, V(16, 1, 50), CF(0, 0.6, a.z0 - 24), RGB(122, 92, 62), MAT.WoodPlanks)
      for k = 0, 4 do
        for _, sx in ipairs({ -7, 7 }) do block(g, base, V(1, 8, 1), CF(sx, -2.8, a.z0 - 4 - k * 11), RGB(104, 78, 54), MAT.Wood) end
      end
      for k = 0, 3 do cyl(g, base, 1.4, 1.2, CF(7.4, 1.8, a.z0 - 8 - k * 12), RGB(40, 40, 42), MAT.Metal) end
      block(g, base, V(5, 2.4, 16), CF(13, -2.2, a.z0 - 30), RGB(120, 128, 136), MAT.Metal)
      block(g, base, V(3.4, 2, 4), CF(13, -0.2, a.z0 - 27), RGB(200, 204, 208), MAT.SmoothPlastic)
    end
    zoneLabel(g, base, CF(cx, 34, cz), a.name, a.color:Lerp(Color3.new(1, 1, 1), 0.35))
  else
    local POST, MESH = RGB(84, 86, 90), RGB(150, 156, 160)
    local function fence(x0, z0, x1, z1)
      local p0, p1 = V(x0, 0, z0), V(x1, 0, z1)
      local len = (p1 - p0).Magnitude
      local mid = (p0 + p1) / 2
      local rot = CFrame.lookAt(mid, p1)
      rot = rot - rot.Position
      local mesh = block(g, base, V(0.15, 5, len), CF(mid + V(0, 3.5, 0)) * rot, MESH, MAT.SmoothPlastic)
      mesh.Transparency = 0.8
      ghostly(block(g, base, V(0.2, 0.2, len), CF(mid + V(0, 6.2, 0)) * rot, POST, MAT.Metal))
      local n = math.max(1, math.floor(len / 18))
      for k = 0, n do cyl(g, base, 6.4, 0.45, CF(p0:Lerp(p1, k / n) + V(0, 4.2, 0)), POST, MAT.Metal) end
    end
    fence(a.x0, a.z1, a.x1, a.z1)
    fence(a.x0, a.z0, a.x1, a.z0)
    fence(a.x0, a.z0, a.x0, a.z1)
    fence(a.x1, a.z0, a.x1, a.z1)
    -- 路边的牌子（朝北，对着路）
    for _, x in ipairs({ cx - 10, cx + 10 }) do block(g, base, V(0.5, 9, 0.5), CF(x, 5.5, a.z1 + 3), POST, MAT.Metal) end
    local board = block(g, base, V(24, 7, 0.4), CF(cx, 9, a.z1 + 3), RGB(28, 32, 38), MAT.SmoothPlastic)
    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Back
    sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.PixelsPerStud = 24
    sg.LightInfluence = 0
    sg.Parent = board
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1, 1)
    t.BackgroundTransparency = 1
    t.Font = Enum.Font.GothamBlack
    t.TextScaled = true
    t.RichText = true
    t.TextColor3 = a.color:Lerp(Color3.new(1, 1, 1), 0.4)
    t.Text = a.name .. "\n<font size=\"40\" color=\"#FFD24A\">第 " .. a.n .. " 次重生开放</font>"
    t.Parent = sg
    for k = -2, 2 do   -- 红白路障
      block(g, base, V(4, 1.4, 0.6), CF(cx + k * 6, 1.7, a.z1 - 1.5), (k % 2 == 0) and RGB(220, 50, 40) or C.white, MAT.SmoothPlastic)
    end
    zoneLabel(g, base, CF(cx, 30, cz), a.name .. "（第 " .. a.n .. " 次重生开放）", RGB(200, 200, 200))
  end
  g.Parent = f
  return g
end

local IND = { oil1 = oilWell, oil2 = oilWell, oil3 = oilWell, refinery = refinery, ammo = ammoPlant, steel = steelMill, mine = mine, nuclear = nuclear,
  radar = radarStation, silo = missileSilo, dock = dockWarehouse, shipyard = shipyard, navalhq = navalHQ, propellant = propellantPlant, assembly = missileAssembly,
  strategic = strategicBattalion, satfac = satelliteFactory, launchpad = launchPad, spacecmd = spaceCommand }
Models.IND = IND

local KIND = { house = house, factory = factory, power = power, bank = bank, hq = hq }
local MIL = { barracks = barracks, tankfac = hangar, aafac = aaShop, artyfac = artyPos, helipad = helipad, airbase = airbase }

-- 建筑：pos 是地面中心（基地地面顶上）；返回 model、主体零件（挂牌子、提示用）
function Models.building(parent, b, pos, team, builtAt, lv)
  local m = Instance.new("Model")
  m.Name = b.id
  if lv and lv > 1 then   -- 升过级的：照升级后的大小画（居民楼、工厂、银行更高）
    b = table.clone(b)
    b.size = Config.SizeAt(b, lv)
  end
  local f = IND[b.id] or KIND[b.kind]
  if b.kind == "mil" then f = MIL[b.id] or barracks end
  if not f then f = house end
  local body = f(m, CF(pos), b, team)
  body.Name = "Body"
  m.PrimaryPart = body
  if builtAt then m:SetAttribute("BuiltAt", builtAt) end   -- 刚盖的：客户端播「从地里升起来」（属性在放进场景前设好，和模型一起到客户端）
  m.Parent = parent
  return m, body
end

-- 购买按钮：建筑位置上一个全息虚影，前面（−Z 那边）一个发光的圆按钮，踩上去或按 E 就买
function Models.pad(parent, b, pos, team)
  local m = Instance.new("Model")
  m.Name = "Pad_" .. b.id
  local base = CF(pos)
  local w, h, d = b.size[1], b.size[2], b.size[3]
  local ghost = ghostly(block(m, base, V(w, h, d), CF(0, h / 2, 0), team, MAT.ForceField))
  ghost.CastShadow = false
  local px, pz = 0, -d / 2 - 6
  if b.pad then px, pz = b.pad[1], b.pad[2] end
  local pad = block(m, base, V(0.7, 7, 7), CF(px, 0.35, pz) * UP, C.green, MAT.Neon, CYL)
  pad.Name = "Pad"
  local desc = ""
  if b.income then desc = "收入 +" .. Config.Fmt(b.income) .. "/秒"
  elseif b.kind == "mil" then desc = Models.milDesc(b)
  elseif b.kind == "hq" then desc = "部队上限 " .. b.cap[1]
  elseif b.kind == "power" then desc = "工厂收入 ×" .. Config.PowerBoost
  end
  if b.kind == "radar" then desc = "支援技能冷却 -" .. math.floor((1 - Config.RadarCD) * 100 + 0.5) .. "%"
  elseif b.kind == "silo" then desc = "支援技能「巡航导弹」" end
  if b.kind == "refinery" then desc = desc .. "\n油井收入 ×" .. Config.RefineryBoost
  elseif b.kind == "nuclear" then desc = desc .. "\n工厂收入再 ×" .. Config.NuclearBoost end
  local _, label = Models.sign(pad, "<b>" .. b.name .. "</b>\n$" .. Config.Fmt(b.price) .. "  " .. desc, 5.5, 17, 4.2, nil, 220)
  local pp = Instance.new("ProximityPrompt")
  pp.ActionText = "建造"
  pp.ObjectText = b.name .. "  $" .. Config.Fmt(b.price)
  pp.HoldDuration = 0
  pp.MaxActivationDistance = 14
  pp.RequiresLineOfSight = false
  pp.Parent = pad
  m.Parent = parent
  return m, pad, pp, label
end

---------------------------------------------------------------- 兵种：零件

local function newPart(m, size, cf, color, mat, shape)
  local p = Instance.new("Part")
  if shape then p.Shape = shape end
  p.Size = size
  p.CFrame = cf
  p.Color = color
  p.Material = mat or MAT.SmoothPlastic
  p.TopSurface = Enum.SurfaceType.Smooth
  p.BottomSurface = Enum.SurfaceType.Smooth
  p.Anchored = false
  p.CanCollide = false
  p.CanTouch = false
  p.Massless = true
  p.Parent = m
  return p
end

local function weld(p0, p1, c0)
  local w = Instance.new("Weld")
  w.Part0 = p0
  w.Part1 = p1
  w.C0 = c0
  w.Parent = p1
  return w
end

-- 毂：一个隐形小零件，用 Motor6D 接在 root 上（转轴点 pivot），挂在它上面的零件跟着转
local function hub(m, root, name, pivot, tag)
  local h = newPart(m, V(0.2, 0.2, 0.2), CF(pivot), C.gun)
  h.Name = name .. "Hub"
  h.Transparency = 1
  local mot = Instance.new("Motor6D")
  mot.Name = name .. "Motor"
  mot.Part0 = root
  mot.Part1 = h
  mot.C0 = CF(pivot)
  mot.Parent = h
  if tag then CollectionService:AddTag(mot, tag) end
  return h
end

-- 零件模型的骨架：k 是按设计尺寸放大的倍数；add(尺寸, 相对位置, …) 焊在 root 上，turret(转轴点) 开一个炮塔毂，之后 addT 焊在炮塔毂上
local function kit(k)
  local m = Instance.new("Model")
  local root = Instance.new("Part")
  root.Name = "Root"
  root.Anchored = true
  root.CanCollide = false
  root.CanTouch = false
  root.Transparency = 1
  root.Size = V(1, 1, 1)
  root.CFrame = CF()
  root.Parent = m
  m.PrimaryPart = root
  local K = {}
  local function sc(off) return off - off.Position + off.Position * k end
  function K.add(size, off, color, mat, shape)
    local o = sc(off)
    local p = newPart(m, size * k, o, color, mat, shape)
    weld(root, p, o)
    return p
  end
  local th, tp = nil, nil
  function K.turret(pivot)
    tp = pivot * k
    th = hub(m, root, "Turret", tp)
  end
  function K.addT(size, off, color, mat, shape)
    local o = sc(off)
    local p = newPart(m, size * k, o, color, mat, shape)
    weld(th, p, CF(tp):Inverse() * o)
    return p
  end
  function K.rotor(y, span, color)
    local h = hub(m, root, "Rotor", V(0, y * k, 0), "Rotor")
    for _, sz in ipairs({ V(0.7, 0.12, span), V(span, 0.12, 0.7) }) do
      local blade = newPart(m, sz * k, CF(0, (y + 0.22) * k, 0), color, MAT.Metal)
      weld(h, blade, CF(0, 0.22 * k, 0))
    end
  end
  return m, root, K
end

local function soldier(K, ox, oz, col)
  K.add(V(0.9, 1.6, 0.55), CF(ox, 0.8, oz), C.uniform:Lerp(C.dark, 0.3))
  K.add(V(1.15, 1.5, 0.65), CF(ox, 2.35, oz), C.uniform)
  K.add(V(0.9, 1.0, 0.4), CF(ox, 2.4, oz + 0.5), C.oliveDark)
  K.add(V(0.7, 0.7, 0.7), CF(ox, 3.45, oz), C.skin)
  K.add(V(0.92, 0.38, 0.92), CF(ox, 3.86, oz), col)
  K.add(V(0.16, 0.22, 1.7), CF(ox + 0.42, 2.45, oz - 0.75), C.gun, MAT.Metal)
end

-- 设计尺寸（老版本的零件模型）× k = 配置里的长度
local PART = {}
PART.inf = { len = 4.1, h = 4.1, build = function(K, col)
  for _, o in ipairs({ { -1.8, 1 }, { 1.8, 1 }, { 0, -1.3 } }) do soldier(K, o[1], o[2], col) end
end }
PART.ifv = { len = 7.4, build = function(K, col)
  local dk = darker(col, 0.3)
  K.add(V(1.3, 1.5, 7.2), CF(-2.4, 0.75, 0), C.track, MAT.Metal)
  K.add(V(1.3, 1.5, 7.2), CF(2.4, 0.75, 0), C.track, MAT.Metal)
  K.add(V(3.9, 1.7, 7.0), CF(0, 1.7, 0.1), col, MAT.Metal)
  K.add(V(4.9, 0.3, 7.2), CF(0, 2.6, 0.1), dk, MAT.Metal)
  K.turret(V(0, 2.75, 0.4))
  K.addT(V(2.6, 1.0, 2.6), CF(0, 3.25, 0.4), col, MAT.Metal)
  K.addT(V(0.22, 0.22, 2.9), CF(0, 3.3, -2.3), C.gun, MAT.Metal)
  K.addT(V(0.7, 0.6, 1.6), CF(1.5, 3.3, 0.6), dk, MAT.Metal)
end }
PART.tank = { len = 12, build = function(K, col)
  local dk = darker(col, 0.3)
  K.add(V(1.5, 1.6, 9.2), CF(-2.85, 0.8, 0), C.track, MAT.Metal)
  K.add(V(1.5, 1.6, 9.2), CF(2.85, 0.8, 0), C.track, MAT.Metal)
  K.add(V(4.4, 1.3, 8.6), CF(0, 1.65, 0.1), col, MAT.Metal)
  K.add(V(5.9, 0.35, 8.8), CF(0, 2.45, 0.2), dk, MAT.Metal)
  K.turret(V(0, 2.6, 0.8))
  K.addT(V(3.8, 1.3, 4.4), CF(0, 3.25, 0.8), col, MAT.Metal)
  K.addT(V(3.2, 0.9, 1.4), CF(0, 3.2, 3.4), dk, MAT.Metal)
  K.addT(V(0.45, 0.45, 5.6), CF(0, 3.35, -4.0), C.gun, MAT.Metal)
  K.addT(V(0.75, 0.75, 0.8), CF(0, 3.35, -7.0), C.gun, MAT.Metal)
  K.addT(V(0.9, 0.55, 0.9), CF(1.0, 4.15, 1.6), dk, MAT.Metal)
end }
PART.aa = { len = 8.2, build = function(K, col)
  local dk = darker(col, 0.3)
  K.add(V(1.4, 1.4, 8.2), CF(-2.6, 0.7, 0), C.track, MAT.Metal)
  K.add(V(1.4, 1.4, 8.2), CF(2.6, 0.7, 0), C.track, MAT.Metal)
  K.add(V(4.2, 1.3, 7.8), CF(0, 1.55, 0), col, MAT.Metal)
  K.add(V(5.4, 0.3, 8.0), CF(0, 2.3, 0), dk, MAT.Metal)
  K.turret(V(0, 2.45, 0.6))
  K.addT(V(3.4, 1.8, 3.6), CF(0, 3.35, 0.6), col, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    K.addT(V(0.9, 1.0, 2.0), CF(s * 2.15, 3.4, 0.3), dk, MAT.Metal)
    K.addT(V(0.28, 0.28, 3.6), CF(s * 2.15, 4.4, -1.4) * CFrame.Angles(math.rad(32), 0, 0), C.gun, MAT.Metal)
  end
  K.addT(V(0.3, 1.6, 0.3), CF(0, 4.9, 2.0), C.metal, MAT.Metal)
  K.addT(V(2.6, 1.3, 0.25), CF(0, 5.9, 2.0) * CFrame.Angles(math.rad(-15), 0, 0), C.white, MAT.Metal)
end }
PART.arty = { len = 14.2, build = function(K, col)
  local dk = darker(col, 0.3)
  K.add(V(1.5, 1.6, 9.4), CF(-2.9, 0.8, 0), C.track, MAT.Metal)
  K.add(V(1.5, 1.6, 9.4), CF(2.9, 0.8, 0), C.track, MAT.Metal)
  K.add(V(4.4, 1.3, 9.0), CF(0, 1.65, 0), col, MAT.Metal)
  K.add(V(5.9, 0.3, 9.2), CF(0, 2.45, 0), dk, MAT.Metal)
  K.turret(V(0, 2.6, 1.4))
  K.addT(V(4.6, 2.3, 5.4), CF(0, 3.75, 1.4), col, MAT.Metal)
  local a = math.rad(22)
  local dir = V(0, math.sin(a), -math.cos(a))
  local r0 = V(0, 4.0, -1.2)
  K.addT(V(0.55, 0.55, 7.6), CF(r0 + dir * 3.8) * CFrame.Angles(a, 0, 0), C.gun, MAT.Metal)
  K.addT(V(0.85, 0.85, 0.9), CF(r0 + dir * 7.6) * CFrame.Angles(a, 0, 0), C.gun, MAT.Metal)
end }
PART.mlrs = { len = 8, build = function(K, col)
  local dk = darker(col, 0.3)
  K.add(V(1.4, 1.5, 8), CF(-2.5, 0.75, 0), C.track, MAT.Metal)
  K.add(V(1.4, 1.5, 8), CF(2.5, 0.75, 0), C.track, MAT.Metal)
  K.add(V(4.2, 1.6, 7.6), CF(0, 1.7, 0), col, MAT.Metal)
  K.add(V(4.2, 1.8, 2.4), CF(0, 3.3, -2.6), dk, MAT.Metal)   -- 驾驶室
  -- 发射箱朝右（+X）起竖：侧面朝敌开火
  K.add(V(3.6, 2.4, 4.6), CF(1.6, 4.0, 1.4) * CFrame.Angles(0, 0, math.rad(-35)), col:Lerp(C.olive, 0.3), MAT.Metal)
  for i = 0, 1 do
    for j = 0, 2 do
      K.add(V(0.2, 0.55, 0.55), CF(3.15, 4.9 + i * 0.75, 0.2 + j * 1.1) * CFrame.Angles(0, 0, math.rad(-35)), C.dark, MAT.Metal)
    end
  end
end }
PART.heli = { len = 15.2, build = function(K, col)
  local dk = darker(col, 0.3)
  for _, s in ipairs({ -1, 1 }) do
    K.add(V(0.25, 0.25, 6.2), CF(s * 1.5, 0.15, 0), C.gun, MAT.Metal)
    K.add(V(0.2, 1.4, 0.2), CF(s * 1.3, 0.9, -1.6), C.gun, MAT.Metal)
    K.add(V(0.2, 1.4, 0.2), CF(s * 1.3, 0.9, 1.6), C.gun, MAT.Metal)
  end
  K.add(V(2.4, 2.2, 6.4), CF(0, 2.7, 0.2), col, MAT.Metal)
  K.add(V(2.0, 1.6, 2.2), CF(0, 2.6, -3.9), col, MAT.Metal)
  local glass = K.add(V(1.7, 1.2, 2.6), CF(0, 3.5, -2.6), RGB(120, 180, 210), MAT.Glass)
  glass.Transparency = 0.25
  K.add(V(0.8, 0.8, 6.6), CF(0, 3.1, 6.6), col, MAT.Metal)
  K.add(V(0.25, 2.4, 1.4), CF(0, 4.0, 9.6), dk, MAT.Metal)
  K.add(V(3.2, 0.2, 1.0), CF(0, 3.0, 9.2), dk, MAT.Metal)
  K.add(V(5.8, 0.25, 1.3), CF(0, 2.5, 0.4), dk, MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do K.add(V(0.7, 0.7, 2.0), CF(s * 2.6, 2.05, 0.2), C.gun, MAT.Metal) end
  K.add(V(0.15, 1.8, 0.15), CF(0.3, 4.0, 9.9), C.gun, MAT.Metal)
  K.add(V(0.15, 0.15, 1.8), CF(0.3, 4.0, 9.9), C.gun, MAT.Metal)
  K.add(V(0.6, 0.8, 0.6), CF(0, 4.1, 0), C.gun, MAT.Metal)
  K.rotor(4.6, 13, dk)
end }

-- 步兵组：几个士兵 + 武器（零件版）；squad 2 / 3 个人的站位
local FOOTPOS = { [2] = { { -1.4, 0.5 }, { 1.4, 0.5 } }, [3] = { { -1.8, 1 }, { 1.8, 1 }, { 0, -1.3 } } }
local function footPart(extra)
  return { len = 4.1, h = 4.1, build = function(K, col, def)
    for _, o in ipairs(FOOTPOS[def.squad or 3]) do soldier(K, o[1], o[2], col) end
    if extra then extra(K, col) end
  end }
end

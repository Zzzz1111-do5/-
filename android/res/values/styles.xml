<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, no action bar, dark: the window background shows until the page paints. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/space</item>
        <item name="android:colorBackground">@color/space</item>
        <item name="android:colorPrimary">@color/space</item>
        <item name="android:colorPrimaryDark">@color/space</item>
        <item name="android:colorAccent">#FF5CC4E6</item>
        <item name="android:statusBarColor">@color/space</item>
        <item name="android:navigationBarColor">@color/space</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>

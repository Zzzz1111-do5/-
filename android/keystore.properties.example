# 复制成 keystore.properties（同一目录，已在 .gitignore 里，不会进仓库）并填好；路径相对 android/ 目录
# 生成签名文件（只做一次，文件和密码务必备份——丢了就没法给已安装的玩家更新）：
#   keytool -genkeypair -v -keystore darksword-release.jks -alias darksword -keyalg RSA -keysize 2048 -validity 36500
storeFile=darksword-release.jks
storePassword=签名文件密码
keyAlias=darksword
keyPassword=密钥密码
